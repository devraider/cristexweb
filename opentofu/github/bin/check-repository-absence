#!/usr/bin/env python3
"""Fail-closed, value-free duplicate inventory for the GitHub repository."""

from __future__ import annotations

import json
import os
import sys
import urllib.error
import urllib.parse
import urllib.request

OWNER = "devraider"
REPOSITORY = "cristex-reactive-resume"
API_ROOT = "https://api.github.com"


def fail(reason: str) -> None:
    print(f"repository_status=failed reason={reason}")
    raise SystemExit(1)


token = os.environ.get("GITHUB_TOKEN", "")
if not token or "\n" in token or "\r" in token:
    fail("protected_token_absent")
if os.environ.get("GITHUB_BASE_URL") or os.environ.get("GITHUB_API_URL"):
    fail("github_endpoint_override")
if any(os.environ.get(name) for name in ("HTTPS_PROXY", "HTTP_PROXY", "ALL_PROXY")):
    fail("proxy_override")

opener = urllib.request.build_opener(urllib.request.ProxyHandler({}))


def get_json(path: str, query: dict[str, str] | None = None) -> object:
    url = f"{API_ROOT}{path}"
    if query:
        url = f"{url}?{urllib.parse.urlencode(query)}"
    request = urllib.request.Request(
        url,
        method="GET",
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {token}",
            "X-GitHub-Api-Version": "2022-11-28",
            "User-Agent": "cristexweb-opentofu-inventory",
        },
    )
    try:
        with opener.open(request, timeout=20) as response:
            return json.load(response)
    except urllib.error.HTTPError as error:
        fail(f"github_http_{error.code}")
    except (OSError, ValueError, json.JSONDecodeError):
        fail("github_request")


identity = get_json("/user")
if not isinstance(identity, dict) or str(identity.get("login", "")).casefold() != OWNER.casefold():
    fail("canonical_owner_identity")

for page in range(1, 101):
    payload = get_json(
        "/user/repos",
        {
            "affiliation": "owner",
            "visibility": "all",
            "per_page": "100",
            "page": str(page),
        },
    )
    if not isinstance(payload, list):
        fail("repository_inventory_shape")
    for item in payload:
        if not isinstance(item, dict):
            fail("repository_inventory_item")
        full_name = str(item.get("full_name", ""))
        name = str(item.get("name", ""))
        if name.casefold() == REPOSITORY.casefold() or full_name.casefold() == f"{OWNER}/{REPOSITORY}".casefold():
            visibility = item.get("visibility")
            private = item.get("private")
            print(
                "repository_status=present "
                f"owner={OWNER} repository={REPOSITORY} visibility={visibility} private={str(private).lower()}"
            )
            raise SystemExit(2)
    if len(payload) < 100:
        print(f"repository_status=absent owner={OWNER} repository={REPOSITORY}")
        raise SystemExit(0)
fail("repository_inventory_pagination")
