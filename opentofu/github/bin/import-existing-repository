#!/bin/bash
# Guarded import only: this workflow never creates, deletes, or applies GitHub resources.
set -eu
set -o pipefail
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
export PATH

usage='usage: opentofu/github/bin/import-existing-repository check|import'
[ "$#" -eq 1 ] || { printf '%s\n' "$usage" >&2; exit 64; }
case "$1" in
    check) mode=check ;;
    import) mode=import ;;
    *) printf '%s\n' "$usage" >&2; exit 64 ;;
esac

# A caller must not preload or override the protected GitHub/OpenTofu transport.
# Reject set variables (including empty values) rather than only non-empty values;
# provider commands below are then launched from an explicit clean environment.
while IFS='=' read -r inherited_name _; do
    case "$inherited_name" in
        GITHUB_TOKEN|GITHUB_BASE_URL|GITHUB_API_URL|HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy|TF_CLI_ARGS|TF_CLI_ARGS_*|TF_LOG|TF_LOG_PATH|TF_CLI_CONFIG_FILE|TF_DATA_DIR|TF_WORKSPACE|TF_VAR_*|TERRAFORM_CONFIG|TERRAFORM_CONFIG_DIR|TOFU_CLI_CONFIG_FILE|TOFU_CLI_ARGS|TOFU_LOG|TOFU_LOG_PATH)
            printf 'Refusing inherited environment override: %s\n' "$inherited_name" >&2
            exit 65
            ;;
    esac
done <<EOF
$(/usr/bin/env | /usr/bin/sed 's/=.*//')
EOF

script=$0
[ ! -L "$script" ] || { printf '%s\n' 'Refusing symlinked entrypoint.' >&2; exit 66; }
dir=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script")" && pwd -P)
github_root=$(CDPATH= cd -- "$dir/.." && pwd -P)
repo_root=$(CDPATH= cd -- "$dir/../../.." && pwd -P)
[ "$github_root" = /home/paul/projects/cristexweb/opentofu/github ] || {
    printf '%s\n' 'Refusing non-canonical OpenTofu GitHub root.' >&2
    exit 78
}
[ -f "$github_root/backend.tf" ] && [ ! -L "$github_root/backend.tf" ] || exit 78
[ -x "$github_root/bin/check-repository-present" ] || exit 78
[ -x "$github_root/bin/validate-import-plan" ] || exit 78

# Bind the complete reviewed GitHub root before any token prompt, provider
# initialization, or import. SOURCE.sha256 enumerates every tracked root/source
# leaf except itself; the manifest and this entrypoint's canonical form are
# independently pinned below so a partial source review cannot authorize import.
source_manifest="$github_root/SOURCE.sha256"
source_manifest_expected_sha256='0b069a23a15087aac7455b326f36826f09adea36e7bf9461087fcbf2a0a2a0ef'
source_import_expected_canonical_sha256='59d819f031f848440d1160cc493a768b91f8dd3150bc8b1d2545ed03388b67d3'
source_work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-opentofu-github-source.XXXXXX)
chmod 0700 "$source_work"
trap '/usr/bin/rm -rf -- "$source_work"' EXIT HUP INT TERM
[ -f "$source_manifest" ] && [ ! -L "$source_manifest" ] || exit 78
[ "$(/usr/bin/stat -c '%U:%G:%a' "$source_manifest")" = 'paul:paul:644' ] || exit 78
[ "$(/usr/bin/sha256sum "$source_manifest" | /usr/bin/cut -d ' ' -f 1)" = "$source_manifest_expected_sha256" ] || {
    printf '%s\n' 'Refusing GitHub source-closure manifest drift.' >&2
    exit 78
}
source_expected_paths="$source_work/expected-paths"
source_actual_paths="$source_work/actual-paths"
/usr/bin/cat >"$source_expected_paths" <<'EOF'
.terraform.lock.hcl
README.md
backend.tf
bin/check-repository-absence
bin/check-repository-present
bin/import-existing-repository
bin/validate-create-plan
bin/validate-import-plan
github.tf
providers.tf
versions.tf
EOF
/usr/bin/awk '
    NF != 2 || $1 !~ /^[0-9a-f]{64}$/ || $2 ~ /^\// || $2 ~ /(^|\/)\.\.($|\/)/ || $2 ~ /[[:space:]]/ { bad = 1; next }
    { print $2 }
    END { if (bad) exit 1 }
' "$source_manifest" | /usr/bin/sort >"$source_actual_paths" || exit 78
[ "$(/usr/bin/wc -l <"$source_actual_paths")" -eq 11 ] || exit 78
[ "$(/usr/bin/sort -u "$source_actual_paths" | /usr/bin/wc -l)" -eq 11 ] || exit 78
/usr/bin/cmp -s "$source_expected_paths" "$source_actual_paths" || {
    printf '%s\n' 'Refusing incomplete or widened GitHub source closure.' >&2
    exit 78
}
while IFS= read -r source_line; do
    source_digest=${source_line%%  *}
    source_path=${source_line#*  }
    source_file="$github_root/$source_path"
    [ -f "$source_file" ] && [ ! -L "$source_file" ] || exit 78
    case "$source_path" in
        bin/*) source_mode=755 ;;
        *) source_mode=644 ;;
    esac
    [ "$(/usr/bin/stat -c '%a' "$source_file")" = "$source_mode" ] || exit 78
    if [ "$source_path" = 'bin/import-existing-repository' ]; then
        source_canonical="$source_work/import-existing-repository.canonical"
        /usr/bin/sed -E \
            -e "s/^source_manifest_expected_sha256='[0-9a-f]{64}'$/source_manifest_expected_sha256='__SOURCE_MANIFEST_SHA256__'/" \
            -e "s/^source_import_expected_canonical_sha256='[0-9a-f]{64}'$/source_import_expected_canonical_sha256='__SOURCE_IMPORT_SHA256__'/" \
            "$source_file" >"$source_canonical"
        source_actual_digest=$(/usr/bin/sha256sum "$source_canonical" | /usr/bin/cut -d ' ' -f 1)
        [ "$source_actual_digest" = "$source_import_expected_canonical_sha256" ] || exit 78
    else
        source_actual_digest=$(/usr/bin/sha256sum "$source_file" | /usr/bin/cut -d ' ' -f 1)
    fi
    [ "$source_actual_digest" = "$source_digest" ] || {
        printf 'Refusing GitHub source drift: %s\n' "$source_path" >&2
        exit 78
    }
done <"$source_manifest"

# The fixed path and pinned CLI are checked only after source closure validation.
tofu=/usr/local/bin/tofu
tofu_target=/opt/opentofu/1.12.5/tofu
[ -L "$tofu" ] && [ "$(/usr/bin/readlink -f -- "$tofu")" = "$tofu_target" ] || exit 69
[ -x "$tofu_target" ] && [ ! -L "$tofu_target" ] || exit 69
[ "$(/usr/bin/stat -c '%U:%G:%a' "$tofu_target")" = 'root:root:755' ] || exit 69
# Fixed backend state: /var/lib/opentofu/cristexweb/github.tfstate. The
# committed backend file is hash-bound so a caller cannot redirect imports to a
# different local state path by editing backend.tf in the working tree.
state_parent=/var/lib/opentofu/cristexweb
state_file="$state_parent/github.tfstate"
backend_file="$github_root/backend.tf"
backend_expected_state_path='/var/lib/opentofu/cristexweb/github.tfstate'
backend_expected_sha256='318f268e4f93ae5c7775b798a88db997f4e47d1e32374432cf5c438f63a8e487'
[ -f "$backend_file" ] && [ ! -L "$backend_file" ] || { printf '%s\n' 'Refusing backend file.' >&2; exit 78; }
[ "$(/usr/bin/sha256sum "$backend_file" | /usr/bin/cut -d ' ' -f 1)" = "$backend_expected_sha256" ] || {
    printf '%s\n' 'Refusing backend content drift.' >&2
    exit 78
}
/usr/bin/grep -Fxq "    path = \"$backend_expected_state_path\"" "$backend_file" || {
    printf '%s\n' 'Refusing backend state path drift.' >&2
    exit 78
}
[ "$state_file" = "$backend_expected_state_path" ] || exit 78
[ -d "$state_parent" ] && [ ! -L "$state_parent" ] || { printf '%s\n' 'Refusing state parent.' >&2; exit 65; }
[ "$(/usr/bin/realpath -e -- "$state_parent")" = "$state_parent" ] || exit 65
[ "$(/usr/bin/stat -c '%U:%G:%a' "$state_parent")" = 'paul:root:700' ] || exit 65
# Hold this lock from the first absence check through initialization and all
# three imports. The lock lives below the protected state parent, not /tmp.
lock_file="$state_parent/github-import.lock"
[ ! -L "$lock_file" ] || exit 65
[ ! -e "$lock_file" ] || [ -f "$lock_file" ] || exit 65
exec 9>"$lock_file"
chmod 0600 "$lock_file"
[ "$(/usr/bin/stat -c '%U:%G:%a' "$lock_file")" = 'paul:paul:600' ] || exit 65
/usr/bin/flock -n 9 || {
    printf '%s\n' 'Refusing concurrent first-genesis import.' >&2
    exit 75
}
state_absence_recheck() {
    [ ! -e "$state_file" ] && [ ! -L "$state_file" ] || {
        printf '%s\n' 'Refusing existing state during first-genesis import.' >&2
        exit 73
    }
}
state_absence_recheck

# Every provider command is captured in a private temporary log and only a
# sanitized receipt is emitted. The token is never an argument or a file.
work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-opentofu-github-import.XXXXXX)
chmod 0700 "$work"
log="$work/command.log"
plan="$work/github-import.tfplan"
plan_json="$work/github-import-plan.json"
github_token=
cleanup() {
    unset GITHUB_TOKEN github_token confirmation
    /usr/bin/rm -rf -- "$work" "$source_work"
}
trap cleanup EXIT HUP INT TERM
fail() {
    printf 'import_status=failed stage=%s\n' "$1" >&2
    exit 1
}
clean_exec() {
    /usr/bin/env -i \
        HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin \
        LC_ALL=C.UTF-8 TF_CLI_CONFIG_FILE=/dev/null \
        "$@"
}
clean_exec_with_token() {
    # The token crosses the process boundary through an anonymous pipe, never
    # as argv, a file, or a command-log value. pipefail preserves child errors.
    printf '%s\n' "$github_token" | /usr/bin/env -i \
        HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin \
        LC_ALL=C.UTF-8 TF_CLI_CONFIG_FILE=/dev/null \
        /bin/sh -c '
            IFS= read -r GITHUB_TOKEN || exit 74
            export GITHUB_TOKEN
            exec "$@"
        ' import-child "$@"
}
run_quiet() {
    : >"$log"
    chmod 0600 "$log"
    clean_exec "$@" >"$log" 2>&1 || fail command
}
run_quiet_with_token() {
    : >"$log"
    chmod 0600 "$log"
    clean_exec_with_token "$@" >"$log" 2>&1 || fail command
}
run_capture() {
    capture_file=$1
    shift
    : >"$log"
    chmod 0600 "$log"
    : >"$capture_file"
    chmod 0600 "$capture_file"
    clean_exec "$@" >"$capture_file" 2>"$log" || fail command
}
# Ansible backup modes use --ask-become-pass. Do not redirect their prompt to
# the provider log: nested backup calls must retain the controlling terminal so
# the operator can enter sudo credentials, while the backup source emits only
# sanitized receipts and never receives GITHUB_TOKEN.
run_backup_interactive() {
    printf 'import_stage=backup_%s sudo_prompt=interactive\n' "$1" >&2
    clean_exec "$backup_wrapper" "$1" || fail "backup_$1"
}

printf '%s' 'GitHub token (input hidden): ' >&2
IFS= read -r -s github_token || fail protected_token_input
printf '\n' >&2
[ "${#github_token}" -ge 20 ] || fail protected_token_contract
case "$github_token" in
    *[[:space:]]*) fail protected_token_contract ;;
esac
# Read-only identity and exact private repository preflight.
run_quiet_with_token "$github_root/bin/check-repository-present"

if [ "$mode" = check ]; then
    printf '%s\n' 'import_status=check_passed repository=devraider/cristex-reactive-resume state_absent=true mutation=none token_output=false'
    exit 0
fi

printf '%s' 'Type IMPORT EXISTING devraider/cristex-reactive-resume to continue: ' >&2
IFS= read -r confirmation || fail approval_input
[ "$confirmation" = 'IMPORT EXISTING devraider/cristex-reactive-resume' ] || fail explicit_approval
unset confirmation

# The first-genesis absence attestation/readback is a required separate gate;
# it never receives GITHUB_TOKEN and never writes the OpenTofu state.
backup_wrapper="$repo_root/ansible/bin/configure-opentofu-github-state-backup"
[ -x "$backup_wrapper" ] || fail backup_wrapper
run_backup_interactive restore-absence
# The token remains only in this shell variable while the backup lane runs
# without GITHUB_TOKEN. Recheck absence under the same lock immediately before
# initialization and again after init, before any import can create state.
state_absence_recheck
run_quiet "$tofu" -chdir="$github_root" init -input=false -no-color
state_absence_recheck
# These are the only import addresses and IDs. No create/delete/apply path exists.
run_quiet_with_token "$tofu" -chdir="$github_root" import -input=false -lock=true -no-color \
    github_repository.reactive_resume_mirror devraider/cristex-reactive-resume
[ -f "$state_file" ] && [ ! -L "$state_file" ] || fail first_import_state
run_quiet_with_token "$tofu" -chdir="$github_root" import -input=false -lock=true -no-color \
    github_repository_vulnerability_alerts.reactive_resume_mirror cristex-reactive-resume
run_quiet_with_token "$tofu" -chdir="$github_root" import -input=false -lock=true -no-color \
    github_actions_repository_permissions.reactive_resume_mirror cristex-reactive-resume

run_quiet_with_token "$tofu" -chdir="$github_root" plan -input=false -lock=true -no-color -out="$plan"
run_capture "$plan_json" "$tofu" -chdir="$github_root" show -json "$plan"
run_quiet "$github_root/bin/validate-import-plan" "$plan_json"

# Backup, immutable readback, and isolated restore are mandatory after genesis.
run_backup_interactive test
run_backup_interactive restore

# The documented final gate repeats both the no-op plan and the exact private
# repository postcheck after recovery operations have completed.
post_plan="$work/github-post-import.tfplan"
post_plan_json="$work/github-post-import-plan.json"
state_list="$work/github-state-list.txt"
run_quiet_with_token "$tofu" -chdir="$github_root" plan -input=false -lock=true -no-color -out="$post_plan"
run_capture "$post_plan_json" "$tofu" -chdir="$github_root" show -json "$post_plan"
run_quiet "$github_root/bin/validate-import-plan" "$post_plan_json"
run_quiet_with_token "$github_root/bin/check-repository-present"
run_capture "$state_list" "$tofu" -chdir="$github_root" state list -no-color
expected_state_list="$work/expected-state-list.txt"
printf '%s\n' \
    github_actions_repository_permissions.reactive_resume_mirror \
    github_repository.reactive_resume_mirror \
    github_repository_vulnerability_alerts.reactive_resume_mirror | /usr/bin/sort >"$expected_state_list"
if /usr/bin/sort "$state_list" | /usr/bin/comm -3 - "$expected_state_list" | /usr/bin/grep -q .; then
    fail post_state_scope
fi
printf '%s\n' 'import_status=success repository=devraider/cristex-reactive-resume addresses=3 plan=no-op second_plan=no-op postcheck=private-exact backup=immutable-readback restore=isolated token_output=false'
