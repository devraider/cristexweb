#!/bin/sh
# Source-only guarded reconciliation of the protected Cloudflare foundation.
# check is read-only; import imports exactly one already-live DNS record.
set -eu
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
LC_ALL=C
export PATH LC_ALL
case $- in
    *x*|*v*) printf '%s\n' 'Refusing traced shell execution.' >&2; exit 65 ;;
esac
[ "$(/usr/bin/readlink -f "/proc/$$/exe")" = /usr/bin/dash ] || {
    printf '%s\n' 'Refusing execution outside the canonical dash interpreter.' >&2
    exit 65
}
usage='usage: opentofu/bin/reconcile-foundation-state check|import'
[ "$#" -eq 1 ] || { printf '%s\n' "$usage" >&2; exit 64; }
case "$1" in
    check) mode=check ;;
    import) mode=import ;;
    *) printf '%s\n' "$usage" >&2; exit 64 ;;
esac

# Never inherit a provider, backend, Python, proxy, recovery, or task-selection
# override. The import token is introduced only through the anonymous pipe below.
while IFS='=' read -r inherited_name _; do
    case "$inherited_name" in
        BASH_ENV|ENV|SHELLOPTS|BASHOPTS|HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy|TF_CLI_ARGS|TF_CLI_ARGS_*|TF_PLUGIN_CACHE_DIR|TF_VAR_*|TF_*|TOFU_*|OPENTOFU_*|LD_*|DYLD_*|CLOUDFLARE_API_TOKEN|CLOUDFLARE_EMAIL|CLOUDFLARE_API_KEY|cloudflare_token|cloudflare_token_sha256|PYTHONNOUSERSITE|PYTHON*|ANSIBLE_*|RCLONE_*|INFISICAL_*|read_hidden_result)
            printf 'Refusing inherited environment override: %s\n' "$inherited_name" >&2
            exit 65
            ;;
    esac
done <<EOF
$(/usr/bin/env | /usr/bin/sed 's/=.*//')
EOF

script=$0
[ ! -L "$script" ] || { printf '%s\n' 'Refusing symlinked entrypoint.' >&2; exit 66; }
dir=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script")" && pwd -P)
root=$(CDPATH= cd -- "$dir/.." && pwd -P)
[ "$root" = /home/paul/projects/cristexweb/opentofu ] || {
    printf '%s\n' 'Refusing non-canonical OpenTofu root.' >&2
    exit 78
}
source_manifest="$root/bin/SOURCE.sha256"
# The two pins use the canonical placeholder form to avoid a self-referential
# digest cycle. They are refreshed together with SOURCE.sha256 below.
source_manifest_expected_sha256='1bd46fa688eebac73501be54630d1aa3642f23171d7e56c693bf2cac0f07aff0'
source_reconcile_expected_canonical_sha256='8e1d6f6e5047c5a89c5320d8f00019fff30c24be91af3a1eb97b692c06471c61'
validator="$root/bin/validate-foundation-state-scope"
# The validator digest is independently pinned from the verified source
# manifest. It is copied into a sealed memfd before execution, so pathname
# replacement and in-place edits cannot alter the executed bytes.
validator_sha256='4079ab77f44ce257fd68416e2cbe48f2b046d76df54cfbb63507684d46f88b88'
[ -f "$source_manifest" ] && [ ! -L "$source_manifest" ] || exit 78
[ -x "$validator" ] && [ ! -L "$validator" ] || exit 78
source_work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-opentofu-foundation-source.XXXXXX)
chmod 0700 "$source_work"
trap '/usr/bin/rm -rf -- "$source_work"' EXIT
trap '/usr/bin/rm -rf -- "$source_work"; exit 129' HUP
trap '/usr/bin/rm -rf -- "$source_work"; exit 130' INT
trap '/usr/bin/rm -rf -- "$source_work"; exit 143' TERM
source_expected_paths="$source_work/expected-paths"
source_actual_paths="$source_work/actual-paths"
bin_expected_paths="$source_work/bin-expected-paths"
bin_actual_paths="$source_work/bin-actual-paths"
/usr/bin/cat >"$source_expected_paths" <<'EOF'
.terraform.lock.hcl
README.md
backend.tf
bin/plan-foundation-prod-route
bin/reconcile-foundation-state
bin/validate-foundation-prod-plan
bin/validate-foundation-state-scope
cloudflare.tf
outputs.tf
providers.tf
variables.tf
versions.tf
EOF
/usr/bin/cat >"$bin_expected_paths" <<'EOF'
f SOURCE.sha256
f plan-foundation-prod-route
f reconcile-foundation-state
f validate-foundation-prod-plan
f validate-foundation-state-scope
EOF
root_expected_files="$source_work/root-expected-files"
root_actual_files="$source_work/root-actual-files"
refresh_root_expected_files() {
    /usr/bin/cat >"$root_expected_files" <<'EOF'
f .terraform.lock.hcl
f README.md
f backend.tf
f cloudflare.tf
d bin
d github
f outputs.tf
f providers.tf
f variables.tf
f versions.tf
EOF
    if [ -d "$root/.terraform" ] && [ ! -L "$root/.terraform" ]; then
        printf '%s\n' 'd .terraform' >>"$root_expected_files"
    fi
    /usr/bin/sort -o "$root_expected_files" "$root_expected_files"
}
revalidate_source_closure() {
    refresh_root_expected_files
    [ "$(/usr/bin/stat -c '%U:%G:%a:%F:%h' "$source_manifest")" = 'paul:paul:644:regular file:1' ] || exit 78
    [ -d "$root/bin" ] && [ ! -L "$root/bin" ] || exit 78
    [ "$(/usr/bin/stat -c '%U:%G:%a:%F' "$root/bin")" = 'paul:paul:755:directory' ] || exit 78
    [ "$(/usr/bin/sha256sum "$source_manifest" | /usr/bin/cut -d ' ' -f 1)" = "$source_manifest_expected_sha256" ] || {
        printf '%s\n' 'Refusing OpenTofu foundation source manifest drift.' >&2
        exit 78
    }
    /usr/bin/find "$root" -mindepth 1 -maxdepth 1 -printf '%y %f\n' | /usr/bin/sort >"$root_actual_files"
    /usr/bin/cmp -s "$root_expected_files" "$root_actual_files" || {
        printf '%s\n' 'Refusing extra or non-regular OpenTofu root entry.' >&2
        exit 78
    }
    /usr/bin/find "$root/bin" -mindepth 1 -maxdepth 1 -printf '%y %f\n' | /usr/bin/sort >"$bin_actual_paths"
    /usr/bin/cmp -s "$bin_expected_paths" "$bin_actual_paths" || {
        printf '%s\n' 'Refusing extra or non-regular OpenTofu bin entry.' >&2
        exit 78
    }
    source_manifest_snapshot="$source_work/source-manifest.current"
    /usr/bin/cat "$source_manifest" >"$source_manifest_snapshot"
    chmod 0600 "$source_manifest_snapshot"
    /usr/bin/awk '
        NF != 2 || $1 !~ /^[0-9a-f]{64}$/ || $2 ~ /^\// || $2 ~ /(^|\/)\.\.($|\/)|[[:space:]]/ { bad = 1; next }
        { print $2 }
        END { if (bad) exit 1 }
    ' "$source_manifest_snapshot" | /usr/bin/sort >"$source_actual_paths" || exit 78
    [ "$(/usr/bin/wc -l <"$source_actual_paths")" -eq 12 ] || exit 78
    /usr/bin/cmp -s "$source_expected_paths" "$source_actual_paths" || {
        printf '%s\n' 'Refusing incomplete or widened foundation source closure.' >&2
        exit 78
    }
    while IFS= read -r source_line; do
        source_digest=${source_line%%  *}
        source_path=${source_line#*  }
        source_file="$root/$source_path"
        [ -f "$source_file" ] && [ ! -L "$source_file" ] || exit 78
        case "$source_path" in
            bin/SOURCE.sha256) source_mode=644 ;;
            bin/*) source_mode=755 ;;
            *) source_mode=644 ;;
        esac
        [ "$(/usr/bin/stat -c '%U:%G:%a:%F:%h' "$source_file")" = "paul:paul:$source_mode:regular file:1" ] || exit 78
        if [ "$source_path" = 'bin/reconcile-foundation-state' ]; then
            source_canonical="$source_work/reconcile-foundation-state.canonical"
            /usr/bin/sed -E \
                -e "s/^source_manifest_expected_sha256='[0-9a-f]{64}'$/source_manifest_expected_sha256='__SOURCE_MANIFEST_SHA256__'/" \
                -e "s/^source_reconcile_expected_canonical_sha256='[0-9a-f]{64}'$/source_reconcile_expected_canonical_sha256='__SOURCE_RECONCILE_SHA256__'/" \
                "$source_file" >"$source_canonical"
            source_actual_digest=$(/usr/bin/sha256sum "$source_canonical" | /usr/bin/cut -d ' ' -f 1)
            [ "$source_actual_digest" = "$source_reconcile_expected_canonical_sha256" ] || exit 78
        elif [ "$source_path" = 'bin/plan-foundation-prod-route' ]; then
            source_canonical="$source_work/plan-foundation-prod-route.canonical"
            /usr/bin/sed -E \
                -e "s/^source_manifest_expected_sha256='[0-9a-f]{64}'$/source_manifest_expected_sha256='__SOURCE_MANIFEST_SHA256__'/" \
                -e "s/^source_prod_expected_canonical_sha256='[0-9a-f]{64}'$/source_prod_expected_canonical_sha256='__SOURCE_PROD_SHA256__'/" \
                "$source_file" >"$source_canonical"
            source_actual_digest=$(/usr/bin/sha256sum "$source_canonical" | /usr/bin/cut -d ' ' -f 1)
        else
            source_actual_digest=$(/usr/bin/sha256sum "$source_file" | /usr/bin/cut -d ' ' -f 1)
        fi
        [ "$source_actual_digest" = "$source_digest" ] || {
            printf 'Refusing OpenTofu foundation source drift: %s\n' "$source_path" >&2
            exit 78
        }
    done <"$source_manifest_snapshot"
}
revalidate_source_closure

backend="$root/backend.tf"
state_parent=/var/lib/opentofu/cristexweb
state_file="$state_parent/foundation.tfstate"
state_identity=
state_before_sha256=
state_content_mutation_expected=false
protected_account_id=8b0f511214c7a4a52ddfb62ca92c5e80
protected_zone_id=3cbee16e56d7656440f93e685807e779
protected_tunnel_id=f9442440-96df-4cf1-855b-7257868ed9bc
protected_tunnel_account_tag=8b0f511214c7a4a52ddfb62ca92c5e80
revalidate_state_metadata() {
    # This is metadata-only: no state bytes are opened or parsed here. It is
    # deliberately called after the lock and immediately before every state,
    # backup, import, and plan consumer so a pathname replacement cannot move
    # the operation to a different inode between the initial check and use.
    [ -f "$backend" ] && [ ! -L "$backend" ] || exit 78
    /usr/bin/grep -Fxq '    path = "/var/lib/opentofu/cristexweb/foundation.tfstate"' "$backend" || exit 78
    [ -d "$state_parent" ] && [ ! -L "$state_parent" ] || exit 65
    [ "$(/usr/bin/realpath -e -- "$state_parent")" = "$state_parent" ] || exit 65
    [ "$(/usr/bin/stat -c '%U:%G:%a:%F' "$state_parent")" = 'paul:root:700:directory' ] || exit 65
    state_parent_links=$(/usr/bin/stat -c '%h' "$state_parent") || exit 65
    [ "$state_parent_links" -ge 2 ] || exit 65
    [ -f "$state_file" ] && [ ! -L "$state_file" ] || exit 73
    [ "$(/usr/bin/realpath -e -- "$state_file")" = "$state_file" ] || exit 73
    [ "$(/usr/bin/stat -c '%U:%G:%a:%F:%h' "$state_file")" = 'paul:paul:600:regular file:1' ] || exit 73
    current_state_identity=$(/usr/bin/stat -Lc '%d:%i' "$state_file") || exit 73
    if [ -n "${state_identity-}" ] && [ "$current_state_identity" != "$state_identity" ]; then
        printf '%s\n' 'Refusing protected state inode replacement.' >&2
        exit 73
    fi
    state_identity=$current_state_identity
}
revalidate_state_content() {
    revalidate_state_metadata
    current_state_sha256=$(/usr/bin/sha256sum "$state_file" | /usr/bin/cut -d ' ' -f 1) || exit 73
    [ -n "${state_before_sha256-}" ] || exit 73
    if [ "${state_content_mutation_expected:-false}" != true ] \
        && [ "$current_state_sha256" != "$state_before_sha256" ]; then
        printf '%s\n' 'Refusing unexpected protected state content drift.' >&2
        exit 73
    fi
}
revalidate_state_metadata

tofu=/usr/local/bin/tofu
tofu_target=/opt/opentofu/1.12.5/tofu
tofu_sha256=36dae7ca1e4f1552a6faef27179dc16ef403203e956f31416c17b3d87a38c3f4
[ -L "$tofu" ] && [ "$(/usr/bin/readlink -f -- "$tofu")" = "$tofu_target" ] || exit 69
[ -f "$tofu_target" ] && [ ! -L "$tofu_target" ] || exit 69
[ "$(/usr/bin/stat -c '%U:%G:%a:%F:%h' "$tofu_target")" = 'root:root:755:regular file:1' ] || exit 69
[ "$(/usr/bin/sha256sum "$tofu_target" | /usr/bin/cut -d ' ' -f 1)" = "$tofu_sha256" ] || exit 69

expected_pre_addresses=5
expected_post_addresses=6
work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-opentofu-foundation-reconcile.XXXXXX)
chmod 0700 "$work"
terminal_echo_disabled=false
cleanup() {
    if [ "${terminal_echo_disabled:-false}" = true ]; then
        /bin/stty echo 2>/dev/null || true
    fi
    unset CLOUDFLARE_API_TOKEN cloudflare_token cloudflare_account_id cloudflare_zone_id cloudflare_dns_id_argocd cloudflare_dns_id_dev cloudflare_dns_id_keycloak cloudflare_dns_id_resume
    /usr/bin/rm -rf -- "$work" "$source_work"
}
trap cleanup EXIT
trap 'cleanup; exit 129' HUP
trap 'cleanup; exit 130' INT
trap 'cleanup; exit 143' TERM
log="$work/tofu.stderr"
state_identity_file="$work/foundation-import-identity.json"

# Open the state-parent directory only for a non-mutating lock. The lock spans
# every state/plan proof and the one approved import.
exec 9<"$state_parent"
/usr/bin/flock -n 9 || { printf '%s\n' 'Refusing concurrent foundation state reconciliation.' >&2; exit 75; }
revalidate_state_metadata
state_before_sha256=$(/usr/bin/sha256sum "$state_file" | /usr/bin/cut -d ' ' -f 1) || exit 73
# Every capture is created atomically by the same Python process that retains its
# descriptor while the producer runs.  os.O_NOFOLLOW, os.O_NONBLOCK, and O_EXCL
# ensure a
# pre-existing symlink/FIFO cannot be selected. The producer's dev/inode identity is
# returned on the runner's stdout; validators receive the inherited descriptor
# and verify its identity directly, rather than reopening the pathname.
# This closes both the FIFO-before-fstat and regular-file pathname replacement
# races without placing output or tokens in the shell command line.
safe_runner_code='
import os
import resource
import stat
import subprocess
import sys

# Every producer artifact (stdout, stderr, and the binary plan) is capped at
# this per-file limit. The bound is enforced in the producer process tree,
# not only checked after an unbounded write has exhausted /dev/shm.
MAX_CAPTURE_BYTES = 16 * 1024 * 1024

def apply_output_limit():
    resource.setrlimit(
        resource.RLIMIT_FSIZE, (MAX_CAPTURE_BYTES, MAX_CAPTURE_BYTES)
    )

def enforce_output_bound(fd, label):
    if os.fstat(fd).st_size > MAX_CAPTURE_BYTES:
        print(f"{label}_too_large", file=sys.stderr)
        raise SystemExit(78)

def new_output(path):
    flags = (os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
             | getattr(os, "O_NOFOLLOW", 0))
    fd = os.open(path, flags, 0o600)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_uid != os.getuid() or info.st_nlink != 1):
        os.close(fd)
        raise SystemExit(78)
    return fd, info

out_fd, out_info = new_output(sys.argv[1])
err_fd, err_info = new_output(sys.argv[2])
try:
    result = subprocess.run(
        sys.argv[3:],
        stdin=subprocess.DEVNULL,
        stdout=out_fd,
        stderr=err_fd,
        preexec_fn=apply_output_limit,
        check=False,
    )
    enforce_output_bound(out_fd, "stdout_capture")
    enforce_output_bound(err_fd, "stderr_capture")
finally:
    os.close(out_fd)
    os.close(err_fd)
print(f"{out_info.st_dev}:{out_info.st_ino}")
raise SystemExit(result.returncode)
'
safe_plan_runner_code='
import os
import resource
import stat
import subprocess
import sys

# Every producer artifact (stdout, stderr, and the binary plan) is capped at
# this per-file limit. The bound is enforced in the producer process tree,
# not only checked after an unbounded write has exhausted /dev/shm.
MAX_CAPTURE_BYTES = 16 * 1024 * 1024

def apply_output_limit():
    resource.setrlimit(
        resource.RLIMIT_FSIZE, (MAX_CAPTURE_BYTES, MAX_CAPTURE_BYTES)
    )

def enforce_output_bound(fd, label):
    if os.fstat(fd).st_size > MAX_CAPTURE_BYTES:
        print(f"{label}_too_large", file=sys.stderr)
        raise SystemExit(78)

def new_output(path):
    flags = (os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
             | getattr(os, "O_NOFOLLOW", 0))
    fd = os.open(path, flags, 0o600)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_uid != os.getuid() or info.st_nlink != 1):
        os.close(fd)
        raise SystemExit(78)
    return fd, info

def open_plan(path):
    flags = (os.O_RDWR | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
             | getattr(os, "O_NOFOLLOW", 0))
    fd = os.open(path, flags, 0o600)
    info = os.fstat(fd)
    if (not stat.S_ISREG(info.st_mode) or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_uid != os.getuid() or info.st_nlink != 1):
        os.close(fd)
        raise SystemExit(78)
    return fd

plan_path, stdout_path, json_path, stderr_path = sys.argv[1:5]
all_args = list(sys.argv[5:])
try:
    marker = all_args.index("--SHOW-COMMAND--")
except ValueError:
    raise SystemExit(78)
plan_args = all_args[:marker]
show_args = all_args[marker + 1:]
if not plan_args or not show_args:
    raise SystemExit(78)
plan_fd = open_plan(plan_path)
out_fd, out_info = new_output(stdout_path)
json_fd, json_info = new_output(json_path)
err_fd, err_info = new_output(stderr_path)
try:
    plan_args = [
        (f"-out=/proc/self/fd/{plan_fd}" if arg == f"-out={plan_path}" else arg)
        for arg in plan_args
    ]
    show_args = [
        (f"/proc/self/fd/{plan_fd}" if arg == plan_path else arg)
        for arg in show_args
    ]
    plan_result = subprocess.run(
        plan_args,
        stdin=subprocess.DEVNULL,
        stdout=out_fd,
        stderr=err_fd,
        pass_fds=(plan_fd,),
        preexec_fn=apply_output_limit,
        check=False,
    )
    if plan_result.returncode:
        raise SystemExit(plan_result.returncode)
    show_result = subprocess.run(
        show_args,
        stdin=subprocess.DEVNULL,
        stdout=json_fd,
        stderr=err_fd,
        pass_fds=(plan_fd,),
        preexec_fn=apply_output_limit,
        check=False,
    )
    enforce_output_bound(plan_fd, "binary_plan")
    enforce_output_bound(out_fd, "stdout_capture")
    enforce_output_bound(json_fd, "plan_json_capture")
    enforce_output_bound(err_fd, "stderr_capture")
finally:
    os.close(out_fd)
    os.close(json_fd)
    os.close(err_fd)
    os.close(plan_fd)
print(f"{json_info.st_dev}:{json_info.st_ino}")
raise SystemExit(show_result.returncode)
'
# Read the validator once, verify its exact manifest digest, then execute the
# verified bytes from a sealed Linux memfd. A regular-file descriptor alone does
# not prevent a later in-place edit; the sealed copy closes that race.
immutable_validator_runner_code='
import fcntl
import hashlib
import os
import re
import stat
import subprocess
import sys

# Validator source is repository-owned and normally below 100 KiB. Refuse an
# unexpectedly large source before allocating a bytearray or hashing it.
MAX_SOURCE_BYTES = 256 * 1024

F_ADD_SEALS = getattr(fcntl, "F_ADD_SEALS", 1033)
F_GET_SEALS = getattr(fcntl, "F_GET_SEALS", 1034)
F_SEAL_SEAL = getattr(fcntl, "F_SEAL_SEAL", 1)
F_SEAL_SHRINK = getattr(fcntl, "F_SEAL_SHRINK", 2)
F_SEAL_GROW = getattr(fcntl, "F_SEAL_GROW", 4)
F_SEAL_WRITE = getattr(fcntl, "F_SEAL_WRITE", 8)

source_path, expected_digest, *child_args = sys.argv[1:]
if not re.fullmatch(r"[0-9a-f]{64}", expected_digest):
    raise SystemExit(78)
source_fd = os.open(
    source_path,
    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK,
)
memfd = -1
opened_input_fds = []
try:
    source_info = os.fstat(source_fd)
    if (
        not stat.S_ISREG(source_info.st_mode)
        or stat.S_IMODE(source_info.st_mode) != 0o755
        or source_info.st_uid != os.getuid()
        or source_info.st_nlink != 1
        or source_info.st_size < 0
        or source_info.st_size > MAX_SOURCE_BYTES
    ):
        raise SystemExit(78)
    source_bytes = bytearray()
    while True:
        remaining = MAX_SOURCE_BYTES - len(source_bytes)
        chunk = os.read(source_fd, min(64 * 1024, remaining + 1))
        if len(source_bytes) + len(chunk) > MAX_SOURCE_BYTES:
            raise SystemExit(78)
        if not chunk:
            break
        source_bytes.extend(chunk)
    if hashlib.sha256(source_bytes).hexdigest() != expected_digest:
        raise SystemExit(78)
    memfd = os.memfd_create("cristexweb-verified-validator", os.MFD_ALLOW_SEALING)
    offset = 0
    while offset < len(source_bytes):
        written = os.write(memfd, source_bytes[offset:])
        if written <= 0:
            raise SystemExit(78)
        offset += written
    seals = F_SEAL_SEAL | F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE
    fcntl.fcntl(memfd, F_ADD_SEALS, seals)
    if fcntl.fcntl(memfd, F_GET_SEALS) & seals != seals:
        raise SystemExit(78)

    # Resolve each pathname input once, with O_NONBLOCK before fstat.  The
    # caller may provide an expected dev:ino (for a producer capture) or '-'
    # when the pathname itself is the sole input boundary.  The resulting
    # descriptors are inherited by the sealed validator; no shell redirection
    # can block on a FIFO and no child reopens a pathname after this point.
    resolved_args = []
    index = 0
    while index < len(child_args):
        argument = child_args[index]
        if argument == "--PATH-FD--":
            if index + 2 >= len(child_args):
                raise SystemExit(78)
            input_path = child_args[index + 1]
            expected_identity = child_args[index + 2]
            if expected_identity != "-" and not re.fullmatch(
                r"[0-9]+:[0-9]+", expected_identity
            ):
                raise SystemExit(78)
            input_fd = os.open(
                input_path,
                os.O_RDONLY
                | os.O_CLOEXEC
                | os.O_NOFOLLOW
                | os.O_NONBLOCK,
            )
            input_info = os.fstat(input_fd)
            actual_identity = f"{input_info.st_dev}:{input_info.st_ino}"
            if (
                not stat.S_ISREG(input_info.st_mode)
                or stat.S_IMODE(input_info.st_mode) != 0o600
                or input_info.st_uid != os.getuid()
                or input_info.st_nlink != 1
                or (
                    expected_identity != "-"
                    and actual_identity != expected_identity
                )
            ):
                os.close(input_fd)
                raise SystemExit(78)
            opened_input_fds.append(input_fd)
            resolved_args.append(f"fd:{input_fd}")
            index += 3
            continue
        resolved_args.append(argument)
        index += 1
    pass_fds = {memfd, *opened_input_fds}
    result = subprocess.run(
        ["/usr/bin/python3", f"/proc/self/fd/{memfd}", *resolved_args],
        stdin=None,
        stdout=None,
        stderr=None,
        pass_fds=tuple(sorted(pass_fds)),
        check=False,
    )
finally:
    for input_fd in opened_input_fds:
        os.close(input_fd)
    if memfd >= 0:
        os.close(memfd)
    os.close(source_fd)
raise SystemExit(result.returncode)
'
run_quiet_init() {
    # Provider installation may create a large temporary package file. Keep
    # init outside the bounded capture runner: its stdout/stderr are discarded
    # and it must not inherit that runner's file-size limit.
    revalidate_source_closure
    revalidate_state_metadata
    revalidate_state_content
    /usr/bin/mkdir -p -- "$work/tofu-tmp"
    if /usr/bin/env -i \
        HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C \
        TF_CLI_CONFIG_FILE=/dev/null TF_DATA_DIR="$work/tofu-data" TF_WORKSPACE=default \
        TMPDIR="$work/tofu-tmp" TOFU_DISABLE_CHECKPOINT=1 PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
        /usr/bin/timeout --foreground --kill-after=10s 60 \
        "$tofu" -chdir="$root" init -reconfigure -input=false -lockfile=readonly -no-color \
        >/dev/null 2>/dev/null; then
        :
    else
        init_status=$?
        revalidate_source_closure
        revalidate_state_metadata
        revalidate_state_content
        printf 'reconcile_status=failed stage=tofu_init\\n' >&2
        exit "$init_status"
    fi
    revalidate_source_closure
    revalidate_state_metadata
    revalidate_state_content
}
run_capture() {
    capture_file=$1
    shift
    revalidate_source_closure
    revalidate_state_metadata
    log_file="$capture_file.stderr"
    if capture_identity=$(
        /usr/bin/env -i \
            HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C \
            TF_CLI_CONFIG_FILE=/dev/null TF_DATA_DIR="$work/tofu-data" TF_WORKSPACE=default \
            TOFU_DISABLE_CHECKPOINT=1 PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
            /usr/bin/python3 -c "$safe_runner_code" "$capture_file" "$log_file" "$@"
    ); then
        :
    else
        producer_status=$?
        # Re-attest even when the producer fails after opening its captures.
        revalidate_source_closure
        revalidate_state_metadata
        revalidate_state_content
        printf 'reconcile_status=failed stage=tofu_command\n' >&2
        exit "$producer_status"
    fi
    # Re-attest the source closure after the producer closes its output. The
    # validator below is then pinned to its already-open descriptor, so a
    # pathname replacement cannot swap the code or capture between checks.
    revalidate_source_closure
    revalidate_state_metadata
    revalidate_state_content
}
run_capture_with_token() {
    capture_file=$1
    shift
    revalidate_source_closure
    revalidate_state_metadata
    log_file="$capture_file.stderr"
    if capture_identity=$(
        printf '%s\n' "$cloudflare_token" | /usr/bin/env -i \
            HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C \
            TF_CLI_CONFIG_FILE=/dev/null TF_DATA_DIR="$work/tofu-data" TF_WORKSPACE=default \
            TOFU_DISABLE_CHECKPOINT=1 PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
            TF_VAR_cloudflare_account_id="$cloudflare_account_id" \
            TF_VAR_cloudflare_zone_id="$cloudflare_zone_id" \
            /bin/sh -c 'IFS= read -r CLOUDFLARE_API_TOKEN || exit 74; export CLOUDFLARE_API_TOKEN; exec "$@"' \
            import-child /usr/bin/python3 -c "$safe_runner_code" "$capture_file" "$log_file" "$@"
    ); then
        :
    else
        producer_status=$?
        revalidate_source_closure
        revalidate_state_metadata
        revalidate_state_content
        printf 'reconcile_status=failed stage=provider_command\n' >&2
        exit "$producer_status"
    fi
    revalidate_source_closure
    revalidate_state_metadata
    revalidate_state_content
}
# The descriptor-retaining plan runner provides the same token transport as
# run_capture_with_token "$plan_stdout" while keeping the binary plan on one
# verified descriptor for both plan and show.
run_plan_capture_with_token() {
    plan_file=$1
    plan_stdout=$2
    plan_json=$3
    shift 3
    revalidate_source_closure
    revalidate_state_metadata
    log_file="$plan_json.stderr"
    if capture_identity=$(
        printf '%s\n' "$cloudflare_token" | /usr/bin/env -i \
            HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C \
            TF_CLI_CONFIG_FILE=/dev/null TF_DATA_DIR="$work/tofu-data" TF_WORKSPACE=default \
            TOFU_DISABLE_CHECKPOINT=1 PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
            TF_VAR_cloudflare_account_id="$cloudflare_account_id" \
            TF_VAR_cloudflare_zone_id="$cloudflare_zone_id" \
            /bin/sh -c 'IFS= read -r CLOUDFLARE_API_TOKEN || exit 74; export CLOUDFLARE_API_TOKEN; exec "$@"' \
            import-child /usr/bin/python3 -c "$safe_plan_runner_code" "$plan_file" "$plan_stdout" "$plan_json" "$log_file" "$@"
    ); then
        :
    else
        producer_status=$?
        revalidate_source_closure
        revalidate_state_metadata
        revalidate_state_content
        printf 'reconcile_status=failed stage=provider_plan_or_show\n' >&2
        exit "$producer_status"
    fi
    revalidate_source_closure
    revalidate_state_metadata
    revalidate_state_content
}
clean_python_validator() {
    capture_file=$1
    validator_args_phase=$2
    shift 2
    # The sealed runner opens pathname inputs with O_NONBLOCK before fstat and
    # passes only verified descriptors (the validator receives fd:8, fd:7,
    # or fd:6 after runner substitution) to the sealed validator. This avoids a
    # shell redirection hanging if a capture pathname is replaced by a FIFO;
    # any dev:ino mismatch is reported as capture inode replacement.
    revalidate_state_metadata
    if [ "$validator_args_phase" = plan ]; then
        plan_provenance=$1
        state_identity_file=$2
        revalidate_source_closure
        revalidate_state_metadata
        if /usr/bin/env -i HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin LC_ALL=C \
            PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
            /usr/bin/timeout --foreground --kill-after=5s 30 \
            /usr/bin/python3 -c "$immutable_validator_runner_code" \
            "$validator" "$validator_sha256" plan \
            --PATH-FD-- "$capture_file" "$capture_identity" \
            --PATH-FD-- "$plan_provenance" - \
            --PATH-FD-- "$state_identity_file" -; then
            result=0
        else
            result=$?
        fi
    elif [ "$validator_args_phase" = state ] && [ "$#" -eq 2 ]; then
        state_phase=$1
        state_identity_file=$2
        revalidate_source_closure
        revalidate_state_metadata
        if /usr/bin/env -i HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin LC_ALL=C \
            PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
            /usr/bin/timeout --foreground --kill-after=5s 30 \
            /usr/bin/python3 -c "$immutable_validator_runner_code" \
            "$validator" "$validator_sha256" state "$state_phase" \
            --PATH-FD-- "$state_identity_file" - \
            --PATH-FD-- "$capture_file" "$capture_identity"; then
            result=0
        else
            result=$?
        fi
    else
        revalidate_source_closure
        revalidate_state_metadata
        if /usr/bin/env -i HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin LC_ALL=C \
            PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
            /usr/bin/timeout --foreground --kill-after=5s 30 \
            /usr/bin/python3 -c "$immutable_validator_runner_code" \
            "$validator" "$validator_sha256" "$validator_args_phase" \
            --PATH-FD-- "$capture_file" "$capture_identity"; then
            result=0
        else
            result=$?
        fi
    fi
    revalidate_source_closure
    revalidate_state_metadata
    revalidate_state_content
    return "$result"
}
validate_scope() {
    phase=$1
    list_file=$work/state-$phase.list
    run_capture "$list_file" /usr/bin/timeout --foreground --kill-after=10s 60 "$tofu" -chdir="$root" state list -state="$state_file" -no-color
    revalidate_source_closure
    clean_python_validator "$list_file" "$phase" >/dev/null || {
        printf 'reconcile_status=failed stage=state_scope_%s\n' "$phase" >&2
        exit 1
    }
}
validate_state_json() {
    phase=$1
    state_json=$work/state-$phase.json
    run_capture "$state_json" /usr/bin/timeout --foreground --kill-after=10s 60 "$tofu" -chdir="$root" show -json -no-color "$state_file"
    revalidate_source_closure
    clean_python_validator "$state_json" state "$phase" "$state_identity_file" >/dev/null || {
        printf 'reconcile_status=failed stage=state_json_%s\n' "$phase" >&2
        exit 1
    }
}
provenance_writer_code='
import hashlib
import json
import os
import stat
import sys

plan_path, expected_identity, output_path, tofu_sha = sys.argv[1:]
plan_fd = os.open(
    plan_path,
    os.O_RDONLY | os.O_CLOEXEC | os.O_NOFOLLOW | os.O_NONBLOCK,
)
try:
    plan_info = os.fstat(plan_fd)
    if (
        not stat.S_ISREG(plan_info.st_mode)
        or stat.S_IMODE(plan_info.st_mode) != 0o600
        or plan_info.st_uid != os.getuid()
        or plan_info.st_nlink != 1
        or f"{plan_info.st_dev}:{plan_info.st_ino}" != expected_identity
    ):
        raise SystemExit(78)
    plan_bytes = bytearray()
    while True:
        chunk = os.read(plan_fd, 1024 * 1024)
        if not chunk:
            break
        plan_bytes.extend(chunk)
    if len(plan_bytes) > 4 * 1024 * 1024:
        raise SystemExit(78)
finally:
    os.close(plan_fd)
data = json.dumps(
    {
        "artifact": "refresh-only-plan-json",
        "artifact_sha256": hashlib.sha256(plan_bytes).hexdigest(),
        "tofu_path": "/opt/opentofu/1.12.5/tofu",
        "tofu_sha256": tofu_sha,
        "tofu_version": "1.12.5",
        "provider": "cloudflare",
        "provider_version": "5.23.0",
        "source": "pinned-cli-show-json",
    }, separators=(",", ":")
).encode()
fd = os.open(
    output_path,
    os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_CLOEXEC
    | getattr(os, "O_NOFOLLOW", 0),
    0o600,
)
try:
    info = os.fstat(fd)
    if (
        not stat.S_ISREG(info.st_mode)
        or stat.S_IMODE(info.st_mode) != 0o600
        or info.st_uid != os.getuid()
        or info.st_nlink != 1
    ):
        raise SystemExit(78)
    offset = 0
    while offset < len(data):
        written = os.write(fd, data[offset:])
        if written <= 0:
            raise SystemExit(78)
        offset += written
finally:
    os.close(fd)
'
write_plan_provenance() {
    plan_json=$1
    provenance=$2
    # Open plan_json once with O_NONBLOCK before fstat; no shell redirection
    # can block on a pathname that was swapped to a FIFO.
    /usr/bin/env -i HOME=/home/paul PATH=/usr/bin:/bin LC_ALL=C \
        PYTHONDONTWRITEBYTECODE=1 PYTHONNOUSERSITE=1 \
        /usr/bin/python3 -c "$provenance_writer_code" "$plan_json" "$capture_identity" "$provenance" "$tofu_sha256"
}
validate_plan_contract() {
    label=$1
    plan_file=$work/foundation-$label.tfplan
    plan_json=$work/foundation-$label-plan.json
    plan_stdout=$work/foundation-$label-plan.stdout
    plan_provenance=$work/foundation-$label-plan.provenance.json
    run_plan_capture_with_token "$plan_file" "$plan_stdout" "$plan_json" \
        /usr/bin/timeout --foreground --kill-after=10s 60 "$tofu" -chdir="$root" plan -refresh-only -input=false -lock=true -no-color "-out=$plan_file" \
        --SHOW-COMMAND-- \
        /usr/bin/timeout --foreground --kill-after=10s 60 "$tofu" -chdir="$root" show -json -no-color "$plan_file"
    write_plan_provenance "$plan_json" "$plan_provenance"
    revalidate_source_closure
    clean_python_validator "$plan_json" plan "$plan_provenance" "$state_identity_file" >/dev/null || {
        printf 'reconcile_status=failed stage=plan_%s\n' "$label" >&2
        exit 1
    }
}

backup_wrapper=/home/paul/projects/cristexweb/ansible/bin/configure-opentofu-state-backup
backup_playbook=/home/paul/projects/cristexweb/ansible/playbooks/configure_opentofu_state_backup.yml
backup_source=/home/paul/projects/cristexweb/ansible/files/backup
verify_backup_source() {
    [ -x "$backup_wrapper" ] && [ ! -L "$backup_wrapper" ] || exit 78
    [ -f "$backup_playbook" ] && [ ! -L "$backup_playbook" ] || exit 78
    [ -f "$backup_source/opentofu-state-backup" ] && [ ! -L "$backup_source/opentofu-state-backup" ] || exit 78
    [ -f "$backup_source/restore-opentofu-state-rehearsal" ] && [ ! -L "$backup_source/restore-opentofu-state-rehearsal" ] || exit 78
    [ -f "$backup_source/cristexweb-opentofu-state-backup.service" ] && [ ! -L "$backup_source/cristexweb-opentofu-state-backup.service" ] || exit 78
    [ -f "$backup_source/cristexweb-opentofu-state-backup.timer" ] && [ ! -L "$backup_source/cristexweb-opentofu-state-backup.timer" ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_wrapper")" = 755 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_playbook")" = 644 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_source/opentofu-state-backup")" = 755 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_source/restore-opentofu-state-rehearsal")" = 755 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_source/cristexweb-opentofu-state-backup.service")" = 644 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_source/cristexweb-opentofu-state-backup.timer")" = 644 ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_wrapper" | /usr/bin/cut -d ' ' -f 1)" = '7db15e9a20425da18a3a090900a1e50d0fcc09a31fc1b1a5073e3a19a2876cb6' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_playbook" | /usr/bin/cut -d ' ' -f 1)" = '8100bb432d89f58d7830e6bacb86edd8f089cf998f290e38daa5ade370498bdf' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_source/opentofu-state-backup" | /usr/bin/cut -d ' ' -f 1)" = '7d18ecff7ec7205be51f843ad751dfe182b70118e2b7a9f9d22bc717925ae5d0' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_source/restore-opentofu-state-rehearsal" | /usr/bin/cut -d ' ' -f 1)" = 'a4a528e3fd61932ed60fc967adbd86e0cf0e807dd38f698eb9de06c2d05e2de0' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_source/cristexweb-opentofu-state-backup.service" | /usr/bin/cut -d ' ' -f 1)" = '112a6792692809a2e39d0d3fd7b9da3806fc22e57837b249bb1a695a30e1cb2c' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_source/cristexweb-opentofu-state-backup.timer" | /usr/bin/cut -d ' ' -f 1)" = '64fa2f3fee275c3ad26d834dd2c51e1628ec20baf85b75e80da0d86b9bc35416' ] || exit 78
}
verify_backup_installed() {
    for backup_item in \
        '/usr/local/libexec/cristexweb/opentofu-state-backup:7d18ecff7ec7205be51f843ad751dfe182b70118e2b7a9f9d22bc717925ae5d0:755' \
        '/usr/local/libexec/cristexweb/restore-opentofu-state-rehearsal:a4a528e3fd61932ed60fc967adbd86e0cf0e807dd38f698eb9de06c2d05e2de0:755' \
        '/etc/systemd/system/cristexweb-opentofu-state-backup.service:112a6792692809a2e39d0d3fd7b9da3806fc22e57837b249bb1a695a30e1cb2c:644' \
        '/etc/systemd/system/cristexweb-opentofu-state-backup.timer:64fa2f3fee275c3ad26d834dd2c51e1628ec20baf85b75e80da0d86b9bc35416:644'; do
        backup_path=${backup_item%%:*}
        backup_expected_sha=${backup_item#*:}
        backup_expected_mode=${backup_expected_sha##*:}
        backup_expected_sha=${backup_expected_sha%:*}
        [ -f "$backup_path" ] && [ ! -L "$backup_path" ] || exit 78
        [ "$(/usr/bin/stat -c '%U:%G:%a' "$backup_path")" = "root:root:$backup_expected_mode" ] || exit 78
        [ "$(/usr/bin/sha256sum "$backup_path" | /usr/bin/cut -d ' ' -f 1)" = "$backup_expected_sha" ] || exit 78
    done
}
run_backup_gate() {
    verify_backup_source
    revalidate_source_closure
    revalidate_state_metadata
    revalidate_state_content
    "$backup_wrapper" "$1"
    revalidate_state_metadata
    revalidate_state_content
    verify_backup_installed
}

# Initialize before the first state consumer. This clean, non-token boundary
# uses only an ephemeral TF_DATA_DIR and performs no Cloudflare provider/API
# operation in check mode.
run_quiet_init
validate_scope pre
if [ "$mode" = check ]; then
    printf 'reconcile_status=check_passed state=foundation pre_addresses=%s post_addresses=%s import=not-run backup=required restore=required provider=not-contacted token_output=false\n' "$expected_pre_addresses" "$expected_post_addresses"
    exit 0
fi

printf '%s' 'Type IMPORT EXISTING reactive_resume_dev_tailscale DNS to continue: ' >&2
IFS= read -r confirmation || exit 74
[ "$confirmation" = 'IMPORT EXISTING reactive_resume_dev_tailscale DNS' ] || {
    printf '%s\n' 'Refusing missing explicit reconciliation approval.' >&2
    exit 65
}
unset confirmation
run_backup_gate test
run_backup_gate restore
validate_scope pre

printf '%s' 'Cloudflare account ID (input hidden): ' >&2
IFS= read -r cloudflare_account_id || exit 74
printf '%s' 'Cloudflare zone ID (input hidden): ' >&2
IFS= read -r cloudflare_zone_id || exit 74
printf '%s' 'Existing Argo DNS record ID (input hidden): ' >&2
IFS= read -r cloudflare_dns_id_argocd || exit 74
printf '%s' 'Existing CristexHub DEV DNS record ID (input hidden): ' >&2
IFS= read -r cloudflare_dns_id_dev || exit 74
printf '%s' 'Existing Keycloak DNS record ID (input hidden): ' >&2
IFS= read -r cloudflare_dns_id_keycloak || exit 74
printf '%s' 'Existing Reactive Resume DEV DNS record ID (input hidden): ' >&2
IFS= read -r cloudflare_dns_id_resume || exit 74
printf '%s' 'Cloudflare API token (input hidden): ' >&2
/bin/stty -echo
terminal_echo_disabled=true
IFS= read -r cloudflare_token || exit 74
/bin/stty echo
terminal_echo_disabled=false
printf '\n' >&2
case "$cloudflare_account_id" in *[!0-9a-f]*|'') exit 65 ;; esac
case "$cloudflare_zone_id" in *[!0-9a-f]*|'') exit 65 ;; esac
case "$cloudflare_dns_id_argocd" in *[!0-9a-f]*|'') exit 65 ;; esac
case "$cloudflare_dns_id_dev" in *[!0-9a-f]*|'') exit 65 ;; esac
case "$cloudflare_dns_id_keycloak" in *[!0-9a-f]*|'') exit 65 ;; esac
case "$cloudflare_dns_id_resume" in *[!0-9a-f]*|'') exit 65 ;; esac
[ "${#cloudflare_account_id}" -eq 32 ] || exit 65
[ "${#cloudflare_zone_id}" -eq 32 ] || exit 65
[ "${#cloudflare_dns_id_argocd}" -eq 32 ] || exit 65
[ "${#cloudflare_dns_id_dev}" -eq 32 ] || exit 65
[ "${#cloudflare_dns_id_keycloak}" -eq 32 ] || exit 65
[ "${#cloudflare_dns_id_resume}" -eq 32 ] || exit 65
[ "$cloudflare_account_id" = "$protected_account_id" ] || exit 65
[ "$cloudflare_zone_id" = "$protected_zone_id" ] || exit 65
[ "${#cloudflare_token}" -ge 20 ] || exit 65
case "$cloudflare_token" in *[[:space:]]*) exit 65 ;; esac
# Bind every operator-entered public identity to the post-import state and
# refresh-only plan proofs. Each pre-existing DNS record ID is required so a
# valid-but-wrong record cannot pass an otherwise sparse provider projection.
/usr/bin/cat >"$state_identity_file" <<EOF
{"schema":1,"scope":"cloudflare-foundation-import-reactive-resume-dev-tailscale","account_id":"$cloudflare_account_id","zone_id":"$cloudflare_zone_id","tunnel_id":"$protected_tunnel_id","tunnel_account_tag":"$protected_tunnel_account_tag","dns_record_ids":{"cloudflare_dns_record.argocd_tailscale":"$cloudflare_dns_id_argocd","cloudflare_dns_record.cristexhub_dev":"$cloudflare_dns_id_dev","cloudflare_dns_record.keycloak":"$cloudflare_dns_id_keycloak","cloudflare_dns_record.reactive_resume_dev_tailscale":"$cloudflare_dns_id_resume"}}
EOF
chmod 0600 "$state_identity_file"

# import is the only state-writing call in this entrypoint. No apply, destroy,
# state-transfer, or state-removal path exists. Each capture is created
# atomically inside its descriptor-retaining runner immediately before the
# producer starts; no pathname is truncated or reopened for consumption.
state_content_mutation_expected=true
run_capture_with_token "$work/import.stdout" /usr/bin/timeout --foreground --kill-after=10s 60 "$tofu" -chdir="$root" import -input=false -lock=true -no-color \
    cloudflare_dns_record.reactive_resume_dev_tailscale "$cloudflare_zone_id/$cloudflare_dns_id_resume"
state_content_mutation_expected=false
state_before_sha256=$(/usr/bin/sha256sum "$state_file" | /usr/bin/cut -d ' ' -f 1) || exit 73
validate_scope post
validate_state_json post
validate_plan_contract post-import
run_backup_gate test
run_backup_gate restore
validate_scope post
validate_state_json post
validate_plan_contract post-recovery
printf 'reconcile_status=success state=foundation imported=reactive_resume_dev_tailscale pre_addresses=%s post_addresses=%s backup=immutable-readback restore=isolated post_backup=verified plan=no-op refresh-only=true prod_plan=separate token_output=false\n' "$expected_pre_addresses" "$expected_post_addresses"
