#!/bin/sh
# Source-only guarded reconciliation of one already-live Cloudflare DNS record.
# This is the only entrypoint for the explicit import operation.
set -eu
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
LC_ALL=C
export PATH LC_ALL
case $- in
    *x*|*v*) printf '%s\n' 'Refusing traced shell execution.' >&2; exit 65 ;;
esac
[ "$(/usr/bin/readlink -f "/proc/$$/exe")" = /usr/bin/dash ] || {
    printf '%s\n' 'Refusing execution outside the canonical dash interpreter.' >&2
    exit 65
}
usage='usage: opentofu/bin/reconcile-foundation-state check|import'
[ "$#" -eq 1 ] || { printf '%s\n' "$usage" >&2; exit 64; }
case "$1" in
    check) mode=check ;;
    import) mode=import ;;
    *) printf '%s\n' "$usage" >&2; exit 64 ;;
esac

# Provider, state, backend, and shell configuration overrides are never accepted
# from the caller. Import receives the one provider token through an anonymous pipe
# only after the exact approval and all recovery gates have passed.
while IFS='=' read -r inherited_name _; do
    case "$inherited_name" in
        BASH_ENV|ENV|SHELLOPTS|BASHOPTS|HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy|TF_CLI_ARGS|TF_CLI_ARGS_*|TF_LOG|TF_LOG_PATH|TF_CLI_CONFIG_FILE|TF_DATA_DIR|TF_WORKSPACE|TF_VAR_*|TOFU_CLI_CONFIG_FILE|TOFU_CLI_ARGS|TOFU_LOG|TOFU_LOG_PATH|CLOUDFLARE_API_TOKEN|CLOUDFLARE_EMAIL|CLOUDFLARE_API_KEY)
            printf 'Refusing inherited environment override: %s\n' "$inherited_name" >&2
            exit 65
            ;;
    esac
done <<EOF
$(/usr/bin/env | /usr/bin/sed 's/=.*//')
EOF

script=$0
[ ! -L "$script" ] || { printf '%s\n' 'Refusing symlinked entrypoint.' >&2; exit 66; }
dir=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script")" && pwd -P)
root=$(CDPATH= cd -- "$dir/.." && pwd -P)
[ "$root" = /home/paul/projects/cristexweb/opentofu ] || {
    printf '%s\n' 'Refusing non-canonical OpenTofu root.' >&2
    exit 78
}
source_manifest="$root/bin/SOURCE.sha256"
source_manifest_expected_sha256='364f18059bad7efa9811557a29aadbbc62b657383361e50b39889ad332c3e8ab'
source_reconcile_expected_canonical_sha256='c88ce3a98bad3b003e968af791423fa17d8edba67470bc78c0fed21177807b1f'
validator="$root/bin/validate-foundation-state-scope"
[ -f "$source_manifest" ] && [ ! -L "$source_manifest" ] || exit 78
[ -x "$validator" ] && [ ! -L "$validator" ] || exit 78
source_work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-opentofu-foundation-source.XXXXXX)
chmod 0700 "$source_work"
trap '/usr/bin/rm -rf -- "$source_work"' EXIT HUP INT TERM
source_expected_paths="$source_work/expected-paths"
source_actual_paths="$source_work/actual-paths"
/usr/bin/cat >"$source_expected_paths" <<'EOF'
.terraform.lock.hcl
README.md
backend.tf
bin/reconcile-foundation-state
bin/validate-foundation-state-scope
cloudflare.tf
outputs.tf
providers.tf
variables.tf
versions.tf
EOF
root_expected_files="$source_work/root-expected-files"
root_actual_files="$source_work/root-actual-files"
/usr/bin/cat >"$root_expected_files" <<'EOF'
f .terraform.lock.hcl
f README.md
f backend.tf
f cloudflare.tf
d bin
d github
f outputs.tf
f providers.tf
f variables.tf
f versions.tf
EOF
if [ -d "$root/.terraform" ] && [ ! -L "$root/.terraform" ]; then
    printf '%s\n' 'd .terraform' >>"$root_expected_files"
fi
/usr/bin/sort -o "$root_expected_files" "$root_expected_files"
revalidate_source_closure() {
    [ "$(/usr/bin/stat -c '%U:%G:%a' "$source_manifest")" = 'paul:paul:644' ] || exit 78
    [ "$(/usr/bin/sha256sum "$source_manifest" | /usr/bin/cut -d ' ' -f 1)" = "$source_manifest_expected_sha256" ] || {
        printf '%s\n' 'Refusing OpenTofu foundation source manifest drift.' >&2
        exit 78
    }
    /usr/bin/find "$root" -mindepth 1 -maxdepth 1 -printf '%y %f\n' | /usr/bin/sort >"$root_actual_files"
    /usr/bin/cmp -s "$root_expected_files" "$root_actual_files" || {
        printf '%s\n' 'Refusing extra or non-regular OpenTofu root .tf, .tf.json, auto-var, override, or directory entry.' >&2
        exit 78
    }
    source_manifest_snapshot="$source_work/source-manifest.current"
    /usr/bin/cat "$source_manifest" >"$source_manifest_snapshot"
    chmod 0600 "$source_manifest_snapshot"
    /usr/bin/awk '
        NF != 2 || $1 !~ /^[0-9a-f]{64}$/ || $2 ~ /^\// || $2 ~ /(^|\/)\.\.($|\/)|[[:space:]]/ { bad = 1; next }
        { print $2 }
        END { if (bad) exit 1 }
    ' "$source_manifest_snapshot" | /usr/bin/sort >"$source_actual_paths" || exit 78
    [ "$(/usr/bin/wc -l <"$source_actual_paths")" -eq 10 ] || exit 78
    /usr/bin/cmp -s "$source_expected_paths" "$source_actual_paths" || {
        printf '%s\n' 'Refusing incomplete or widened foundation source closure.' >&2
        exit 78
    }
    while IFS= read -r source_line; do
        source_digest=${source_line%%  *}
        source_path=${source_line#*  }
        source_file="$root/$source_path"
        [ -f "$source_file" ] && [ ! -L "$source_file" ] || exit 78
        case "$source_path" in
            bin/*) source_mode=755 ;;
            *) source_mode=644 ;;
        esac
        [ "$(/usr/bin/stat -c '%a' "$source_file")" = "$source_mode" ] || exit 78
        if [ "$source_path" = 'bin/reconcile-foundation-state' ]; then
            source_canonical="$source_work/reconcile-foundation-state.canonical"
            /usr/bin/sed -E \
                -e "s/^source_manifest_expected_sha256='[0-9a-f]{64}'$/source_manifest_expected_sha256='__SOURCE_MANIFEST_SHA256__'/" \
                -e "s/^source_reconcile_expected_canonical_sha256='[0-9a-f]{64}'$/source_reconcile_expected_canonical_sha256='__SOURCE_RECONCILE_SHA256__'/" \
                "$source_file" >"$source_canonical"
            source_actual_digest=$(/usr/bin/sha256sum "$source_canonical" | /usr/bin/cut -d ' ' -f 1)
            [ "$source_actual_digest" = "$source_reconcile_expected_canonical_sha256" ] || exit 78
        else
            source_actual_digest=$(/usr/bin/sha256sum "$source_file" | /usr/bin/cut -d ' ' -f 1)
        fi
        [ "$source_actual_digest" = "$source_digest" ] || {
            printf 'Refusing OpenTofu foundation source drift: %s\n' "$source_path" >&2
            exit 78
        }
    done <"$source_manifest_snapshot"
}
revalidate_source_closure

# The backend is fixed by source closure and checked again before every state
# consumer.  No alternate state path, workspace, or backend configuration is
# accepted.
backend="$root/backend.tf"
state_parent=/var/lib/opentofu/cristexweb
state_file="$state_parent/foundation.tfstate"
[ -f "$backend" ] && [ ! -L "$backend" ] || exit 78
/usr/bin/grep -Fxq '    path = "/var/lib/opentofu/cristexweb/foundation.tfstate"' "$backend" || exit 78
[ -d "$state_parent" ] && [ ! -L "$state_parent" ] || exit 65
[ "$(/usr/bin/realpath -e -- "$state_parent")" = "$state_parent" ] || exit 65
[ "$(/usr/bin/stat -c '%U:%G:%a' "$state_parent")" = 'paul:root:700' ] || exit 65
[ -f "$state_file" ] && [ ! -L "$state_file" ] || exit 73
[ "$(/usr/bin/realpath -e -- "$state_file")" = "$state_file" ] || exit 73
[ "$(/usr/bin/stat -c '%U:%G:%a' "$state_file")" = 'paul:paul:600' ] || exit 73

tofu=/usr/local/bin/tofu
tofu_target=/opt/opentofu/1.12.5/tofu
[ -L "$tofu" ] && [ "$(/usr/bin/readlink -f -- "$tofu")" = "$tofu_target" ] || exit 69
[ -f "$tofu_target" ] && [ ! -L "$tofu_target" ] || exit 69
[ "$(/usr/bin/stat -c '%U:%G:%a' "$tofu_target")" = 'root:root:755' ] || exit 69

state_scope_validator="$validator"
expected_pre_addresses=5
expected_post_addresses=6
work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-opentofu-foundation-reconcile.XXXXXX)
chmod 0700 "$work"
terminal_echo_disabled=false
cleanup() {
    if [ "${terminal_echo_disabled:-false}" = true ]; then
        /bin/stty echo 2>/dev/null || true
    fi
    unset CLOUDFLARE_API_TOKEN cloudflare_token cloudflare_account_id cloudflare_zone_id cloudflare_record_id
    /usr/bin/rm -rf -- "$work" "$source_work"
}
trap cleanup EXIT HUP INT TERM
log="$work/tofu.stderr"

# Lock the protected state-parent inode for the whole transition.  This is a
# non-mutating directory lock and creates no lock file.
exec 9<"$state_parent"
/usr/bin/flock -n 9 || { printf '%s\n' 'Refusing concurrent foundation state reconciliation.' >&2; exit 75; }

clean_exec() {
    /usr/bin/env -i \
        HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin \
        LC_ALL=C TF_CLI_CONFIG_FILE=/dev/null TOFU_DISABLE_CHECKPOINT=1 \
        "$@"
}
run_capture() {
    revalidate_source_closure
    : >"$log"
    chmod 0600 "$log"
    capture_file=$1
    shift
    : >"$capture_file"
    chmod 0600 "$capture_file"
    clean_exec "$@" >"$capture_file" 2>"$log" || {
        printf 'reconcile_status=failed stage=tofu_command\n' >&2
        exit 1
    }
}
run_capture_with_token() {
    revalidate_source_closure
    : >"$log"
    chmod 0600 "$log"
    capture_file=$1
    shift
    : >"$capture_file"
    chmod 0600 "$capture_file"
    printf '%s\n' "$cloudflare_token" | /usr/bin/env -i \
        HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin \
        LC_ALL=C TF_CLI_CONFIG_FILE=/dev/null TOFU_DISABLE_CHECKPOINT=1 \
        TF_VAR_cloudflare_account_id="$cloudflare_account_id" \
        TF_VAR_cloudflare_zone_id="$cloudflare_zone_id" \
        /bin/sh -c 'IFS= read -r CLOUDFLARE_API_TOKEN || exit 74; export CLOUDFLARE_API_TOKEN; exec "$@"' import-child "$@" >"$capture_file" 2>"$log" || {
        printf 'reconcile_status=failed stage=provider_command\n' >&2
        exit 1
    }
}
validate_scope() {
    phase=$1
    list_file=$work/state-$phase.list
    run_capture "$list_file" /usr/bin/timeout --foreground --kill-after=10s 60 "$tofu" -chdir="$root" state list -state="$state_file" -no-color
    revalidate_source_closure
    /usr/bin/python3 "$state_scope_validator" "$phase" "$list_file" >/dev/null || {
        printf 'reconcile_status=failed stage=state_scope_%s\n' "$phase" >&2
        exit 1
    }
}
validate_resource_contract() {
    resource_file=$work/reactive-resume-dev-tailscale.state
    run_capture "$resource_file" /usr/bin/timeout --foreground --kill-after=10s 60 "$tofu" -chdir="$root" state show -state="$state_file" cloudflare_dns_record.reactive_resume_dev_tailscale
    revalidate_source_closure
    /usr/bin/python3 "$state_scope_validator" resource reactive_resume_dev_tailscale "$resource_file" >/dev/null || {
        printf '%s\n' 'reconcile_status=failed stage=reactive_resume_dev_tailscale_contract' >&2
        exit 1
    }
}

backup_wrapper=/home/paul/projects/cristexweb/ansible/bin/configure-opentofu-state-backup
backup_playbook=/home/paul/projects/cristexweb/ansible/playbooks/configure_opentofu_state_backup.yml
backup_source=/home/paul/projects/cristexweb/ansible/files/backup
verify_backup_source() {
    [ -x "$backup_wrapper" ] && [ ! -L "$backup_wrapper" ] || exit 78
    [ -f "$backup_playbook" ] && [ ! -L "$backup_playbook" ] || exit 78
    [ -f "$backup_source/opentofu-state-backup" ] && [ ! -L "$backup_source/opentofu-state-backup" ] || exit 78
    [ -f "$backup_source/restore-opentofu-state-rehearsal" ] && [ ! -L "$backup_source/restore-opentofu-state-rehearsal" ] || exit 78
    [ -f "$backup_source/cristexweb-opentofu-state-backup.service" ] && [ ! -L "$backup_source/cristexweb-opentofu-state-backup.service" ] || exit 78
    [ -f "$backup_source/cristexweb-opentofu-state-backup.timer" ] && [ ! -L "$backup_source/cristexweb-opentofu-state-backup.timer" ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_wrapper")" = 755 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_playbook")" = 644 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_source/opentofu-state-backup")" = 755 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_source/restore-opentofu-state-rehearsal")" = 755 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_source/cristexweb-opentofu-state-backup.service")" = 644 ] || exit 78
    [ "$(/usr/bin/stat -c '%a' "$backup_source/cristexweb-opentofu-state-backup.timer")" = 644 ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_wrapper" | /usr/bin/cut -d ' ' -f 1)" = '7db15e9a20425da18a3a090900a1e50d0fcc09a31fc1b1a5073e3a19a2876cb6' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_playbook" | /usr/bin/cut -d ' ' -f 1)" = 'c84b49e3b255167e04955149adadd85b01dc20df1e169bb55608604a8db0511c' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_source/opentofu-state-backup" | /usr/bin/cut -d ' ' -f 1)" = 'cb6a474ae732b3b07e11f58b3ca9a1a4f1531e6b750d2112c6c6aa36a6ada3a3' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_source/restore-opentofu-state-rehearsal" | /usr/bin/cut -d ' ' -f 1)" = '9f92a5bd48bd35d44177c83cc991fb95a6be5857c8a91602e8490afd68dd1e00' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_source/cristexweb-opentofu-state-backup.service" | /usr/bin/cut -d ' ' -f 1)" = 'bf5dfdf93fa3e4bfa5f8e933714faae33e139ae830d12d5c50e30a3ee946e925' ] || exit 78
    [ "$(/usr/bin/sha256sum "$backup_source/cristexweb-opentofu-state-backup.timer" | /usr/bin/cut -d ' ' -f 1)" = '64fa2f3fee275c3ad26d834dd2c51e1628ec20baf85b75e80da0d86b9bc35416' ] || exit 78
}
verify_backup_installed() {
    for backup_item in \
        '/usr/local/libexec/cristexweb/opentofu-state-backup:cb6a474ae732b3b07e11f58b3ca9a1a4f1531e6b750d2112c6c6aa36a6ada3a3:755' \
        '/usr/local/libexec/cristexweb/restore-opentofu-state-rehearsal:9f92a5bd48bd35d44177c83cc991fb95a6be5857c8a91602e8490afd68dd1e00:755' \
        '/etc/systemd/system/cristexweb-opentofu-state-backup.service:bf5dfdf93fa3e4bfa5f8e933714faae33e139ae830d12d5c50e30a3ee946e925:644' \
        '/etc/systemd/system/cristexweb-opentofu-state-backup.timer:64fa2f3fee275c3ad26d834dd2c51e1628ec20baf85b75e80da0d86b9bc35416:644'; do
        backup_path=${backup_item%%:*}
        backup_expected_sha=${backup_item#*:}
        backup_expected_mode=${backup_expected_sha##*:}
        backup_expected_sha=${backup_expected_sha%:*}
        [ -f "$backup_path" ] && [ ! -L "$backup_path" ] || exit 78
        [ "$(/usr/bin/stat -c '%U:%G:%a' "$backup_path")" = "root:root:$backup_expected_mode" ] || exit 78
        [ "$(/usr/bin/sha256sum "$backup_path" | /usr/bin/cut -d ' ' -f 1)" = "$backup_expected_sha" ] || exit 78
    done
}
run_backup_gate() {
    verify_backup_source
    revalidate_source_closure
    "$backup_wrapper" "$1"
    verify_backup_installed
}

validate_scope pre
if [ "$mode" = check ]; then
    printf 'reconcile_status=check_passed state=foundation pre_addresses=%s post_addresses=%s import=not-run backup=required restore=required provider=not-contacted token_output=false\n' "$expected_pre_addresses" "$expected_post_addresses"
    exit 0
fi

printf '%s' 'Type IMPORT EXISTING reactive_resume_dev_tailscale DNS to continue: ' >&2
IFS= read -r confirmation || exit 74
[ "$confirmation" = 'IMPORT EXISTING reactive_resume_dev_tailscale DNS' ] || {
    printf '%s\n' 'Refusing missing explicit reconciliation approval.' >&2
    exit 65
}
unset confirmation

# Existing protected backup and restore gates run before the state mutation and
# again after it.  Their wrappers retain the controlling terminal for become
# password entry and emit only sanitized receipts.
run_backup_gate test
run_backup_gate restore
validate_scope pre

printf '%s' 'Cloudflare account ID (input hidden): ' >&2
IFS= read -r cloudflare_account_id || exit 74
printf '%s' 'Cloudflare zone ID (input hidden): ' >&2
IFS= read -r cloudflare_zone_id || exit 74
printf '%s' 'Existing DNS record ID (input hidden): ' >&2
IFS= read -r cloudflare_record_id || exit 74
printf '%s' 'Cloudflare API token (input hidden): ' >&2
/bin/stty -echo
terminal_echo_disabled=true
IFS= read -r cloudflare_token || exit 74
/bin/stty echo
terminal_echo_disabled=false
printf '\n' >&2
case "$cloudflare_account_id" in *[!0-9a-f]*|'') exit 65 ;; esac
case "$cloudflare_zone_id" in *[!0-9a-f]*|'') exit 65 ;; esac
case "$cloudflare_record_id" in *[!0-9a-f]*|'') exit 65 ;; esac
[ "${#cloudflare_account_id}" -eq 32 ] || exit 65
[ "${#cloudflare_zone_id}" -eq 32 ] || exit 65
[ "${#cloudflare_record_id}" -eq 32 ] || exit 65
[ "${#cloudflare_token}" -ge 20 ] || exit 65
case "$cloudflare_token" in *[[:space:]]*) exit 65 ;; esac

# Only the pinned root is initialized; no backend path or workspace is selected
# from input.  Import is the sole state-writing OpenTofu subcommand here.
run_capture_with_token "$work/init.out" "$tofu" -chdir="$root" init -input=false -no-color
run_capture_with_token "$work/import.out" "$tofu" -chdir="$root" import -input=false -lock=true -no-color \
    cloudflare_dns_record.reactive_resume_dev_tailscale "$cloudflare_zone_id/$cloudflare_record_id"
validate_scope post
validate_resource_contract
run_backup_gate test
run_backup_gate restore
validate_scope post
validate_resource_contract
printf 'reconcile_status=success state=foundation imported=reactive_resume_dev_tailscale pre_addresses=%s post_addresses=%s backup=immutable-readback restore=isolated post_backup=verified prod_plan=separate token_output=false\n' "$expected_pre_addresses" "$expected_post_addresses"
