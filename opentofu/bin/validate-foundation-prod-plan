def fail(reason: str) -> NoReturn:
    print(f"prod_plan=refused reason={reason}")
    raise SystemExit(1)


FORBIDDEN_ENV_PREFIXES = ("CLOUDFLARE_", "cloudflare_", "LD_", "DYLD_")
FORBIDDEN_ENV_NAMES = frozenset({
    "read_hidden_result",
    "cloudflare_token",
    "cloudflare_token_sha256",
})


def reject_forbidden_environment() -> None:
    """Reject ambient credential or hidden-input variables on direct use."""
    for name in os.environ:
        if name in FORBIDDEN_ENV_NAMES or name.startswith(FORBIDDEN_ENV_PREFIXES):
            fail("forbidden_environment")


def reject_token_tree(value: Any, token: str) -> None:
    """Reject the exact provider token anywhere in a decoded plan tree."""
    if isinstance(value, str):
        if token in value:
            fail("plan_provider_token")
        return
    if isinstance(value, dict):
        for key, nested in value.items():
            if token in key:
                fail("plan_provider_token")
            reject_token_tree(nested, token)
    elif isinstance(value, list):
        for nested in value:
            reject_token_tree(nested, token)


def reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate_json_key")
        result[key] = value
    return result


def reject_nonstandard_constant(value: str) -> NoReturn:
    raise ValueError(f"nonstandard_json_constant:{value}")


def _open_input(source: Path | str, purpose: str = "input") -> bytes:
    """Consume one verified regular-file descriptor or one safe pathname.

    The guarded wrappers pass ``fd:N`` for plan, identity, and provenance
    captures after their producer-side device/inode checks.  A direct offline
    caller may still provide a mode-0600 pathname; it is opened once with
    ``O_NOFOLLOW`` and never lstat-then-reopen'd.
    """
    source_text = os.fspath(source)
    if not re.fullmatch(r"fd:[0-9]+", source_text) and not os.path.lexists(source_text):
        fail(f"{purpose}_absent")
    try:
        match = re.fullmatch(r"fd:([0-9]+)", source_text)
        inherited = match is not None
        fd = os.dup(int(match.group(1))) if match else os.open(
            source_text,
            os.O_RDONLY
            | os.O_CLOEXEC
            | getattr(os, "O_NOFOLLOW", 0)
            | getattr(os, "O_NONBLOCK", 0),
        )
    except (OSError, ValueError):
        fail(f"{purpose}_open")
    try:
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_uid != os.getuid()
            or info.st_nlink not in ({0, 1} if inherited else {1})
        ):
            fail(f"{purpose}_permissions")
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_INPUT_BYTES:
                fail(f"{purpose}_too_large")
            chunks.append(chunk)
        return b"".join(chunks)
    except OSError:
        fail(f"{purpose}_read")
    finally:
        os.close(fd)


def read_identity(source: Path | str) -> dict[str, Any]:
    """Read the prompt-bound six-address identity without provider access."""
    try:
        identity_bytes = _open_input(source, "identity_file")
        identity = json.loads(
            identity_bytes.decode("utf-8"),
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_nonstandard_constant,
            parse_float=reject_nonfinite_float,
        )
    except (UnicodeError, json.JSONDecodeError, TypeError, ValueError):
        fail("identity_file_parse")
    if not isinstance(identity, dict) or set(identity) != IDENTITY_KEYS:
        fail("identity_file_schema")
    if type(identity.get("schema")) is not int or identity["schema"] != 1:
        fail("identity_file_schema")
    if identity.get("scope") != IDENTITY_SCOPE:
        fail("identity_file_scope")
    if identity.get("account_id") != ACCOUNT_ID or identity.get("zone_id") != ZONE_ID:
        fail("identity_file_protected_account_zone")
    if identity.get("tunnel_id") != TUNNEL_ID:
        fail("identity_file_protected_tunnel")
    tag = identity.get("tunnel_account_tag")
    if not isinstance(tag, str) or not HEX_ID.fullmatch(tag):
        fail("identity_file_account_tag")
    # Cloudflare exposes Tunnel account_tag as the owning account ID, not an
    # unrelated opaque identifier. Bind the prompted profile to that exact
    # attested account so a coordinated profile/plan swap cannot pass format
    # validation alone.
    if tag != ACCOUNT_ID:
        fail("identity_file_account_tag")
    record_ids = identity.get("dns_record_ids")
    if not isinstance(record_ids, dict) or set(record_ids) != set(EXPECTED_DNS_STATES):
        fail("identity_file_dns_ids")
    values: list[str] = []
    for address in EXPECTED_DNS_STATES:
        value = record_ids.get(address)
        if not isinstance(value, str) or not HEX_ID.fullmatch(value):
            fail("identity_file_dns_ids")
        values.append(value)
    if len(values) != len(set(values)):
        fail("identity_file_dns_ids")
    expected_profile_sha256 = os.environ.get("CRISTEXWEB_PROD_ROUTE_IDENTITY_SHA256", "")
    attestation_path_text = os.environ.get("CRISTEXWEB_PROD_ROUTE_IDENTITY_ATTESTATION", "")
    if not re.fullmatch(r"[0-9a-f]{64}", expected_profile_sha256):
        fail("identity_profile_attestation")
    if not attestation_path_text:
        fail("identity_profile_attestation")
    try:
        observed_profile_sha256 = hashlib.sha256(identity_bytes).hexdigest()
        # Read the attestation through the same single verified descriptor
        # boundary as every other validator input.  Do not lstat and then
        # reopen a pathname: a FIFO/path replacement must fail immediately.
        attestation = _open_input(
            attestation_path_text, "identity_profile_attestation"
        ).decode("ascii")
    except (OSError, UnicodeError):
        fail("identity_profile_attestation")
    if (
        observed_profile_sha256 != expected_profile_sha256
        or attestation
        != f"identity_sha256={expected_profile_sha256}\nidentity_scope={IDENTITY_SCOPE}\n"
    ):
        fail("identity_profile_attestation")
    return identity


def reject_nonfinite_float(value: str) -> float:
    parsed = float(value)
    if not math.isfinite(parsed):
        raise ValueError(f"nonfinite_json_float:{value}")
    return parsed


def require_empty_object(value: Any, reason: str) -> None:
    """Require the exact empty object marker, never a recursively empty map."""
    if type(value) is not dict or value != {}:
        fail(reason)


def require_false_or_empty_object(value: Any, reason: str) -> None:
    """Require the only two scalar/object forms emitted for an empty marker."""
    if value is False:
        return
    require_empty_object(value, reason)


def require_empty_list(value: Any, reason: str) -> None:
    if type(value) is not list or value != []:
        fail(reason)


def require_null_or_empty_object(value: Any, reason: str) -> None:
    if value is None:
        return
    require_empty_object(value, reason)


def exact_equal(left: Any, right: Any) -> bool:
    """Compare JSON values without Python's bool/int equality coercion."""
    if type(left) is not type(right):
        return False
    if isinstance(left, dict):
        return set(left) == set(right) and all(
            exact_equal(left[key], right[key]) for key in left
        )
    if isinstance(left, list):
        return len(left) == len(right) and all(
            exact_equal(left_item, right_item)
            for left_item, right_item in zip(left, right)
        )
    return left == right


def require_exact_mapping(value: Any, expected: dict[str, Any], reason: str) -> None:
    if not isinstance(value, dict) or not exact_equal(value, expected):
        fail(reason)


def require_sensitive_values_marker(
    value: Any,
    resource_type: str | None,
    reason: str,
    address: str | None = None,
    resource_values: Any = None,
) -> None:
    """Validate the pinned provider's exact ``sensitive_values`` projection.

    The marker is metadata, not Secret data, but its shape is still part of the
    plan contract.  In particular, Cloudflare 5.23.0 emits ``settings`` only
    for CNAME records; accepting the marker for an arbitrary resource type or
    address would hide a provider/schema change.
    """
    if resource_type == "cloudflare_dns_record":
        cname_addresses = {
            "cloudflare_dns_record.cristexhub_dev",
            "cloudflare_dns_record.keycloak",
            CREATE_ADDRESS,
        }
        a_addresses = {
            "cloudflare_dns_record.argocd_tailscale",
            "cloudflare_dns_record.reactive_resume_dev_tailscale",
        }
        if address in cname_addresses or address in a_addresses:
            expected = {"settings": {}, "tags": []}
        else:
            fail(reason)
        if exact_equal(value, expected):
            return
    elif resource_type == "cloudflare_zero_trust_tunnel_cloudflared":
        connections = resource_values.get("connections") if isinstance(resource_values, dict) else None
        if (
            isinstance(connections, list)
            and isinstance(value, dict)
            and set(value) == {"connections", "tunnel_secret"}
            and value["tunnel_secret"] is True
            and value["connections"] == [{} for _ in connections]
        ):
            return
    elif resource_type == "cloudflare_zero_trust_tunnel_cloudflared_config" and address == UPDATE_ADDRESS:
        if isinstance(value, dict) and set(value) == {"config"} and isinstance(value["config"], dict):
            ingress = value["config"].get("ingress")
            if (
                set(value["config"]) == {"ingress"}
                and isinstance(ingress, list)
                and all(type(item) is dict and item == {} for item in ingress)
            ):
                return
    fail(reason)


def validate_sensitive_values_tree(
    value: Any,
    reason: str,
    resource_type: str | None = None,
    address: str | None = None,
) -> None:
    if isinstance(value, dict):
        marker_type = resource_type
        marker_address = address
        if isinstance(value.get("type"), str):
            marker_type = value["type"]
        if isinstance(value.get("address"), str):
            marker_address = value["address"]
        if "sensitive_values" in value:
            require_sensitive_values_marker(
                value["sensitive_values"], marker_type, reason, marker_address,
                value.get("values"),
            )
        for nested in value.values():
            validate_sensitive_values_tree(nested, reason, marker_type, marker_address)
    elif isinstance(value, list):
        for nested in value:
            validate_sensitive_values_tree(nested, reason, resource_type, address)


def scrub_sensitive_values(value: Any) -> Any:
    if isinstance(value, dict):
        return {
            key: scrub_sensitive_values(nested)
            for key, nested in value.items()
            if key != "sensitive_values"
        }
    if isinstance(value, list):
        return [scrub_sensitive_values(nested) for nested in value]
    return value


def require_safe_tree(value: Any, reason: str) -> None:
    """Reject sensitive/unknown marker fields outside their exact owner schema.

    Owner-specific validators consume the legitimate markers before this walk.
    This walk is intentionally conservative and does not recursively bless maps
    merely because all their leaves happen to be empty.
    """
    if isinstance(value, dict):
        for key, nested in value.items():
            if key == "sensitive_values":
                fail(reason)
            if key in {"before_unknown", "unknown", "proposed_unknown"}:
                require_false_or_empty_object(nested, reason)
            elif key in {"resource_drift", "deferred_changes"}:
                require_empty_list(nested, reason)
            elif key in {"before_identity", "after_identity", "importing"}:
                require_null_or_empty_object(nested, reason)
            elif key == "generated_config":
                if nested not in (None, ""):
                    fail(reason)
            elif key in {"errored", "tainted"}:
                if type(nested) is not bool or nested:
                    fail(reason)
            elif key == "complete":
                if type(nested) is not bool or not nested:
                    fail(reason)
            elif key in {"deposed", "deposed_key"}:
                if nested not in (None, ""):
                    fail(reason)
            require_safe_tree(nested, reason)
    elif isinstance(value, list):
        for nested in value:
            require_safe_tree(nested, reason)


def require_output_value_entry(
    name: str, output: Any, reason: str, expected_outputs: dict[str, str] | None
) -> None:
    if not isinstance(output, dict):
        fail(reason)
    if type(output) is not dict or set(output) != {"sensitive", "value", "type"}:
        fail(reason)
    if type(output["sensitive"]) is not bool or output["sensitive"]:
        fail(reason)
    if "value" not in output or not isinstance(output["value"], str):
        fail(reason)
    if expected_outputs is not None:
        if name not in expected_outputs or output["value"] != expected_outputs[name]:
            fail(reason)
    if output["type"] != "string":
        fail(reason)


EXPECTED_DEPENDS_ON = {
    "cloudflare_dns_record.cristexhub_dev": ["cloudflare_zero_trust_tunnel_cloudflared.keycloak"],
    "cloudflare_dns_record.keycloak": ["cloudflare_zero_trust_tunnel_cloudflared.keycloak"],
    UPDATE_ADDRESS: ["cloudflare_zero_trust_tunnel_cloudflared.keycloak"],
}


def require_resource_value_projection(
    resource: dict[str, Any],
    identity: dict[str, Any],
    reason: str,
    expected_state: dict[str, Any] | None,
) -> None:
    """Validate resource values recursively without admitting sensitive fields."""
    allowed_resource_keys = {
        "address", "mode", "type", "name", "provider_name", "schema_version",
        "values", "sensitive_values", "depends_on",
    }
    required_resource_keys = {
        "address", "mode", "type", "name", "provider_name", "schema_version",
        "values", "sensitive_values",
    }
    if set(resource) - allowed_resource_keys or required_resource_keys - set(resource):
        fail(reason)
    address = resource.get("address")
    if not isinstance(address, str) or address not in EXPECTED_ADDRESSES:
        fail(reason)
    resource_kind = resource_type(address)
    if resource.get("mode") != "managed" or resource.get("type") != resource_kind:
        fail(reason)
    if resource.get("name") != address.split(".", 1)[1] or resource.get("provider_name") != PROVIDER:
        fail(reason)
    if "depends_on" in resource:
        dependencies = resource["depends_on"]
        if type(dependencies) is not list or dependencies != EXPECTED_DEPENDS_ON.get(address, []):
            fail(reason)
    if type(resource["schema_version"]) is not int or resource["schema_version"] != 500:
        fail(reason)
    values = resource.get("values")
    if not isinstance(values, dict):
        fail(reason)
    require_sensitive_values_marker(
        resource["sensitive_values"], resource_kind, reason, address, values
    )
    if expected_state is not None and not exact_equal(values, expected_state):
        fail(reason)
    if resource_kind == "cloudflare_dns_record":
        if set(values) - DNS_STATE_KEYS:
            fail(reason)
        expected = EXPECTED_DNS_STATES[address] if address in EXPECTED_DNS_STATES else {
            "zone_id": ZONE_ID,
            "name": "hub.cristex-soft.com",
            "type": "CNAME",
            "content": TUNNEL_TARGET,
            "ttl": 1,
            "proxied": True,
            "comment": EXPECTED_COMMENT,
        }
        for key, expected_value in expected.items():
            if key in values and not exact_equal(values[key], expected_value):
                fail(reason)
        if "id" in values:
            if address not in identity["dns_record_ids"] or values["id"] != identity["dns_record_ids"][address]:
                fail(reason)
        for key in set(values) - DNS_CONFIG_KEYS:
            require_dns_computed_field(key, values[key], reason)
        if "settings" in values:
            require_dns_settings(values["settings"], address, reason)
    elif resource_kind == "cloudflare_zero_trust_tunnel_cloudflared":
        if set(values) - TUNNEL_STATE_KEYS:
            fail(reason)
        expected = EXPECTED_TUNNEL_STATE
        for key, expected_value in expected.items():
            if key in values and not exact_equal(values[key], expected_value):
                fail(reason)
        for key in set(values) - TUNNEL_CONFIG_KEYS:
            require_tunnel_computed_field(key, values[key], reason, identity)
    elif resource_kind == "cloudflare_zero_trust_tunnel_cloudflared_config":
        if set(values) - TUNNEL_CONFIG_STATE_KEYS:
            fail(reason)
        for key, expected_value in {
            "account_id": ACCOUNT_ID,
            "tunnel_id": TUNNEL_ID,
            "id": TUNNEL_ID,
            "source": "cloudflare",
        }.items():
            if key in values and not exact_equal(values[key], expected_value):
                fail(reason)
        if "config" in values:
            if not isinstance(values["config"], dict) or set(values["config"]) != {"ingress", "origin_request"}:
                fail(reason)
            ingress = values["config"].get("ingress")
            if not isinstance(ingress, list):
                fail(reason)
            for rule in ingress:
                if not isinstance(rule, dict) or set(rule) - {"hostname", "origin_request", "path", "service"}:
                    fail(reason)
                if not isinstance(rule.get("service"), str) or rule["service"] not in {EXPECTED_SERVICE, "http_status:404"}:
                    fail(reason)
                if rule.get("hostname") is not None and not isinstance(rule["hostname"], str):
                    fail(reason)
                if rule.get("origin_request") is not None or rule.get("path") is not None:
                    fail(reason)
    else:
        fail(reason)
    # Keys that look like sensitive state are rejected even when their marker is false.
    def reject_sensitive_key(node: Any) -> None:
        if isinstance(node, dict):
            for key, nested in node.items():
                if key in {"tunnel_secret", "token", "password", "api_token", "secret"}:
                    if key == "tunnel_secret" and nested is None:
                        continue
                    fail(reason)
                reject_sensitive_key(nested)
        elif isinstance(node, list):
            for nested in node:
                reject_sensitive_key(nested)
    reject_sensitive_key(values)


def require_state_values(
    value: Any,
    reason: str,
    identity: dict[str, Any],
    expected_addresses: set[str],
    expected_outputs: dict[str, str] | None,
    expected_states: dict[str, dict[str, Any]],
) -> None:
    if not isinstance(value, dict) or set(value) - STATE_VALUES_KEYS:
        fail(reason)
    if expected_outputs is not None and "outputs" not in value:
        fail(reason)
    if "outputs" in value:
        outputs = value["outputs"]
        if not isinstance(outputs, dict):
            fail(reason)
        if expected_outputs is not None and set(outputs) != set(expected_outputs):
            fail(reason)
        if set(outputs) - set(EXPECTED_OUTPUTS):
            fail(reason)
        for name, output in outputs.items():
            require_output_value_entry(name, output, reason, expected_outputs)
    if "root_module" not in value or not isinstance(value["root_module"], dict):
        fail(reason)
    module = value["root_module"]
    # The pinned root has no child modules, module address, or module-level
    # sensitive projection.  Accepting arbitrary empty module metadata would
    # permit an attacker to hide an unreviewed projection in this closure.
    if type(module) is not dict or set(module) != {"resources"}:
        fail(reason)
    resources = module.get("resources")
    if not isinstance(resources, list) or len(resources) != len(expected_addresses):
        fail(reason)
    seen: set[str] = set()
    for resource in resources:
        if not isinstance(resource, dict) or resource.get("address") in seen:
            fail(reason)
        seen.add(resource.get("address"))
        require_resource_value_projection(
            resource, identity, reason, expected_states.get(resource.get("address"))
        )
    if seen != expected_addresses:
        fail(reason)
    validate_sensitive_values_tree(value, reason)
    require_safe_tree(scrub_sensitive_values(value), reason)


def require_prior_identity(
    value: Any,
    identity: dict[str, Any],
    reason: str = "prior_state_identity",
) -> None:
    """Derive every prompted mutable identity from the exact prior-state view."""
    if type(value) is not dict or type(value.get("values")) is not dict:
        fail(reason)
    state_values = value["values"]
    root_module = state_values.get("root_module")
    resources = root_module.get("resources") if isinstance(root_module, dict) else None
    if type(resources) is not list:
        fail(reason)
    by_address: dict[str, dict[str, Any]] = {}
    for resource in resources:
        if type(resource) is not dict or resource.get("address") in by_address:
            fail(reason)
        address = resource.get("address")
        if address not in EXISTING:
            fail(reason)
        by_address[address] = resource
    if set(by_address) != set(EXISTING):
        fail(reason)
    for address in EXPECTED_DNS_STATES:
        values = by_address[address].get("values")
        if type(values) is not dict or values.get("id") != identity["dns_record_ids"][address]:
            fail(reason)
    tunnel = by_address["cloudflare_zero_trust_tunnel_cloudflared.keycloak"].get("values")
    if type(tunnel) is not dict:
        fail(reason)
    if tunnel.get("id") != TUNNEL_ID or tunnel.get("account_tag") != identity["tunnel_account_tag"]:
        fail(reason)
    config = by_address[UPDATE_ADDRESS].get("values")
    if type(config) is not dict or config.get("id") != TUNNEL_ID or config.get("tunnel_id") != TUNNEL_ID:
        fail(reason)


def require_state_envelope(
    value: Any,
    reason: str,
    identity: dict[str, Any],
    expected_addresses: set[str],
    expected_states: dict[str, dict[str, Any]],
) -> None:
    if type(value) is not dict or set(value) != STATE_KEYS:
        fail(reason)
    if value.get("format_version") != "1.0":
        fail(reason)
    if value.get("terraform_version") != "1.12.5":
        fail(reason)
    if "values" not in value or value["values"] is None:
        fail(reason)
    require_state_values(
        value["values"], reason, identity, expected_addresses, EXPECTED_OUTPUTS, expected_states
    )
    validate_sensitive_values_tree(value, reason)
    require_safe_tree(scrub_sensitive_values(value), reason)


def require_timestamp(value: Any) -> None:
    if not isinstance(value, str) or not TIMESTAMP.fullmatch(value):
        fail("timestamp")
    try:
        datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        fail("timestamp")


def _constant_expression(value: Any, reason: str = "configuration") -> None:
    if type(value) is not dict or set(value) != {"constant_value"}:
        fail(reason)


def _reference_expression(value: Any, references: list[str], reason: str = "configuration") -> None:
    if type(value) is not dict or set(value) != {"references"}:
        fail(reason)
    if not exact_equal(value["references"], references):
        fail(reason)


def _expected_configuration_resource_expressions(address: str) -> dict[str, Any]:
    if address.startswith("cloudflare_dns_record."):
        state = EXPECTED_DNS_STATES.get(address, {
            "zone_id": ZONE_ID,
            "name": "hub.cristex-soft.com",
            "type": "CNAME",
            "content": TUNNEL_TARGET,
            "ttl": 1,
            "proxied": True,
            "comment": EXPECTED_COMMENT,
        })
        expressions = {
            "comment": {"constant_value": state["comment"]},
            "name": {"constant_value": state["name"]},
            "proxied": {"constant_value": state["proxied"]},
            "ttl": {"constant_value": state["ttl"]},
            "type": {"constant_value": state["type"]},
            "zone_id": {"references": ["var.cloudflare_zone_id"]},
        }
        if address == "cloudflare_dns_record.keycloak":
            expressions["name"] = {"references": ["var.public_hostname"]}
        if state["type"] == "CNAME":
            expressions["content"] = {
                "references": [
                    "cloudflare_zero_trust_tunnel_cloudflared.keycloak.id",
                    "cloudflare_zero_trust_tunnel_cloudflared.keycloak",
                ]
            }
        else:
            expressions["content"] = {"constant_value": state["content"]}
        return expressions
    if address == "cloudflare_zero_trust_tunnel_cloudflared.keycloak":
        return {
            "account_id": {"references": ["var.cloudflare_account_id"]},
            "config_src": {"constant_value": "cloudflare"},
            "name": {"references": ["var.cloudflare_tunnel_name"]},
        }
    if address == UPDATE_ADDRESS:
        return {
            "account_id": {"references": ["var.cloudflare_account_id"]},
            "config": {
                "references": [
                    "var.public_hostname",
                    "var.traefik_origin_service",
                    "var.traefik_origin_service",
                    "var.traefik_origin_service",
                ]
            },
            "source": {"constant_value": "cloudflare"},
            "tunnel_id": {
                "references": [
                    "cloudflare_zero_trust_tunnel_cloudflared.keycloak.id",
                    "cloudflare_zero_trust_tunnel_cloudflared.keycloak",
                ]
            },
        }
    fail("configuration")


def require_configuration(value: Any) -> None:
    """Require the exact root configuration emitted by this pinned module.

    The provider credential is intentionally absent from this clean plan
    projection because it is supplied only through the provider process
    environment.  Every provider expression, output, variable, and resource
    field is compared to the committed source contract.
    """
    if type(value) is not dict or set(value) != {"provider_config", "root_module"}:
        fail("configuration")
    provider_config = value["provider_config"]
    if type(provider_config) is not dict or set(provider_config) != {"cloudflare"}:
        fail("configuration")
    provider = provider_config["cloudflare"]
    # With CLOUDFLARE_API_TOKEN supplied only in the provider process
    # environment, OpenTofu 1.12.5 omits provider expressions entirely from
    # show -json.  Keep this exact clean shape: accepting an expression here
    # would permit a credential-bearing or otherwise unbound plan projection.
    if type(provider) is not dict or set(provider) != {
        "name", "full_name", "version_constraint"
    }:
        fail("configuration")
    if provider["name"] != "cloudflare" or provider["full_name"] != PROVIDER:
        fail("configuration")
    if provider["version_constraint"] != "5.23.0":
        fail("configuration")

    root_module = value["root_module"]
    if type(root_module) is not dict or set(root_module) != {"outputs", "resources", "variables"}:
        fail("configuration")
    outputs = root_module["outputs"]
    if type(outputs) is not dict or set(outputs) != set(EXPECTED_OUTPUTS):
        fail("configuration")
    expected_output_references = {
        "tunnel_id": ["cloudflare_zero_trust_tunnel_cloudflared.keycloak.id", "cloudflare_zero_trust_tunnel_cloudflared.keycloak"],
        "tunnel_name": ["cloudflare_zero_trust_tunnel_cloudflared.keycloak.name", "cloudflare_zero_trust_tunnel_cloudflared.keycloak"],
        "public_hostname": ["var.public_hostname"],
        "dns_record_name": ["cloudflare_dns_record.keycloak.name", "cloudflare_dns_record.keycloak"],
    }
    for name, expected in EXPECTED_OUTPUTS.items():
        output = outputs.get(name)
        if type(output) is not dict or set(output) != {"description", "expression"}:
            fail("configuration")
        if output["description"] != EXPECTED_OUTPUT_DESCRIPTIONS[name]:
            fail("configuration")
        expression = output["expression"]
        if name == "token_handoff":
            if not exact_equal(expression, {"constant_value": expected}):
                fail("configuration")
        else:
            _reference_expression(expression, expected_output_references[name])

    resources = root_module["resources"]
    if type(resources) is not list or len(resources) != len(EXPECTED_ADDRESSES):
        fail("configuration")
    seen: set[str] = set()
    for resource in resources:
        if type(resource) is not dict:
            fail("configuration")
        required = {"address", "mode", "type", "name", "provider_config_key", "expressions", "schema_version"}
        if set(resource) != required:
            fail("configuration")
        address = resource["address"]
        if not isinstance(address, str) or address in seen or address not in EXPECTED_ADDRESSES:
            fail("configuration")
        seen.add(address)
        if (
            resource["mode"] != "managed"
            or resource["type"] != resource_type(address)
            or resource["name"] != address.split(".", 1)[1]
            or resource["provider_config_key"] != "cloudflare"
            or type(resource["schema_version"]) is not int
            or resource["schema_version"] != 500
        ):
            fail("configuration")
        if not exact_equal(
            resource["expressions"], _expected_configuration_resource_expressions(address)
        ):
            fail("configuration")
    if seen != EXPECTED_ADDRESSES:
        fail("configuration")

    variables = root_module["variables"]
    if type(variables) is not dict or set(variables) != set(EXPECTED_VARIABLES):
        fail("configuration")
    required_variables = {"cloudflare_account_id", "cloudflare_zone_id"}
    for name, expected in EXPECTED_VARIABLES.items():
        entry = variables[name]
        if type(entry) is not dict:
            fail("configuration")
        if name in required_variables:
            expected_entry = {
                "type": "string",
                "description": EXPECTED_VARIABLE_DESCRIPTIONS[name],
                "required": True,
            }
        else:
            expected_entry = {
                "type": "string",
                "description": EXPECTED_VARIABLE_DESCRIPTIONS[name],
                "default": expected,
            }
        if not exact_equal(entry, expected_entry):
            fail("configuration")
    require_safe_tree(value, "configuration")


def require_variables(value: Any) -> None:
    """Require the exact top-level variable projection from OpenTofu 1.12.5.

    ``deprecated`` is a configuration/schema concept, not a field emitted in
    this plan's evaluated variable entries.  Rejecting it prevents an attacker
    from smuggling an unreviewed variable or a misleading deprecation marker
    into an otherwise exact five-variable plan.
    """
    if type(value) is not dict or set(value) != set(EXPECTED_VARIABLES):
        fail("variables_scope")
    for name, expected in EXPECTED_VARIABLES.items():
        entry = value[name]
        if type(entry) is not dict or set(entry) != {"value"}:
            fail("variables_shape")
        if not exact_equal(entry["value"], expected):
            fail("variables_value")


def resource_type(address: str) -> str:
    parts = address.split(".")
    if len(parts) != 2 or not all(parts):
        fail("resource_address_shape")
    return parts[0]


def require_optional_timestamp(value: Any, reason: str) -> None:
    if value is not None:
        require_timestamp(value)


def require_dns_settings(value: Any, address: str, reason: str) -> None:
    # Cloudflare 5.23.0 normalizes the optional+computed settings object to
    # false-valued members for CNAME records and null-valued members for A records.
    if address in {
        "cloudflare_dns_record.cristexhub_dev",
        "cloudflare_dns_record.keycloak",
        CREATE_ADDRESS,
    }:
        if not isinstance(value, dict) or set(value) != DNS_SETTINGS_KEYS:
            fail(reason)
        if any(type(nested) is not bool or nested for nested in value.values()):
            fail(reason)
        return
    if not isinstance(value, dict) or set(value) != DNS_SETTINGS_KEYS:
        fail(reason)
    if any(nested is not None for nested in value.values()):
        fail(reason)


def require_dns_computed_field(key: str, value: Any, reason: str) -> None:
    if key == "id":
        # The pinned provider's DNS state ID is the plain record UUID.  It is
        # not the older zone_id/record_id composite form.
        if not isinstance(value, str) or not HEX_ID.fullmatch(value):
            fail(reason)
    elif key in {"created_on", "modified_on", "comment_modified_on", "tags_modified_on"}:
        require_optional_timestamp(value, reason)
    elif key == "proxiable":
        if type(value) is not bool:
            fail(reason)
    elif key == "data":
        # Every reviewed protected record is A or CNAME.  The provider's
        # record-data union is therefore null for this exact scope; accepting
        # an arbitrary object here would hide a type/record-kind transition.
        if value is not None:
            fail(reason)
    elif key == "meta":
        if value != "{}":
            fail(reason)
    elif key == "priority":
        if value is not None and (type(value) is not int or value < 0):
            fail(reason)
    elif key == "private_routing":
        if value is not None and type(value) is not bool:
            fail(reason)
    elif key == "settings":
        # The caller supplies the record address through the reason-free
        # wrapper below; this branch is only used for the generic type check.
        if value is not None and (
            not isinstance(value, dict)
            or set(value) != DNS_SETTINGS_KEYS
            or any(
                nested is not None and (type(nested) is not bool or nested)
                for nested in value.values()
            )
        ):
            fail(reason)
    elif key == "tags":
        if not isinstance(value, list) or not all(isinstance(tag, str) for tag in value):
            fail(reason)
    else:
        fail(reason)


def require_dns_state(
    value: Any, address: str, reason: str, identity: dict[str, Any]
) -> None:
    if not isinstance(value, dict):
        fail(reason)
    expected = EXPECTED_DNS_STATES[address]
    if set(value) != DNS_STATE_KEYS:
        fail(reason)
    for key, expected_value in expected.items():
        if not exact_equal(value.get(key), expected_value):
            fail(reason)
    if value.get("id") != identity["dns_record_ids"][address]:
        fail(reason)
    # A provider-computed field omitted by the provider is safe only when it is
    # omitted on both before and after.  The caller enforces pair presence and
    # exact equality, while this function enforces its schema/type.
    for key in set(value) - DNS_CONFIG_KEYS:
        require_dns_computed_field(key, value[key], reason)
    if "settings" in value:
        require_dns_settings(value["settings"], address, reason)


def require_tunnel_connection(value: Any, reason: str) -> None:
    if not isinstance(value, dict) or set(value) - TUNNEL_CONNECTION_KEYS:
        fail(reason)
    for key, nested in value.items():
        if key in {"id", "client_id", "client_version", "colo_name", "origin_ip", "uuid"}:
            if nested is not None and not isinstance(nested, str):
                fail(reason)
        elif key == "is_pending_reconnect":
            if nested is not None and type(nested) is not bool:
                fail(reason)
        elif key == "opened_at":
            if nested is not None:
                require_timestamp(nested)
        else:
            fail(reason)


def require_tunnel_computed_field(
    key: str, value: Any, reason: str, identity: dict[str, Any]
) -> None:
    if key == "account_tag":
        if value != identity["tunnel_account_tag"]:
            fail(reason)
    elif key == "connections":
        if value is not None and not isinstance(value, list):
            fail(reason)
        if value is not None:
            for item in value:
                require_tunnel_connection(item, reason)
    elif key in {"conns_active_at", "conns_inactive_at", "created_at", "deleted_at"}:
        require_optional_timestamp(value, reason)
    elif key == "metadata":
        # Provider schema type is string; the API's empty metadata object is
        # normalized to the JSON string "{}".
        if value != "{}":
            fail(reason)
    elif key == "remote_config":
        if value is not None and type(value) is not bool:
            fail(reason)
    elif key == "status":
        if value is not None and value not in {"inactive", "degraded", "healthy", "down"}:
            fail(reason)
    elif key == "tun_type":
        if value is not None and value not in {"cfd_tunnel", "warp_connector", "warp", "magic", "ip_sec", "gre", "cni"}:
            fail(reason)
    elif key == "tunnel_secret":
        # The field is provider-sensitive.  A non-empty value would violate
        # this validator's no-sensitive-values boundary even when equal on
        # both sides; the normal provider plan represents it as null.
        if value not in (None, ""):
            fail(reason)
    else:
        fail(reason)


def require_tunnel_state(value: Any, reason: str, identity: dict[str, Any]) -> None:
    if not isinstance(value, dict):
        fail(reason)
    if set(value) != TUNNEL_STATE_KEYS:
        fail(reason)
    require_exact_mapping(
        {key: value.get(key) for key in EXPECTED_TUNNEL_STATE},
        EXPECTED_TUNNEL_STATE,
        reason,
    )
    for key in set(value) - TUNNEL_CONFIG_KEYS:
        require_tunnel_computed_field(key, value[key], reason, identity)


def _connection_invariant_projection(value: dict[str, Any]) -> str:
    """Return a canonical projection with only provider-volatile leaves removed.

    ``require_tunnel_state`` validates each connection's complete schema and
    value types before this projection is used.  Consequently, removing only
    the explicitly volatile fields and canonicalizing the remaining mapping
    gives an exact invariant identity without pairing records by a volatile
    identifier.  The JSON string is suitable as a Counter key and preserves
    exact scalar types (including booleans versus integers).
    """
    return json.dumps(
        {
            key: value[key]
            for key in sorted(value)
            if key not in TUNNEL_VOLATILE_CONNECTION_KEYS
        },
        ensure_ascii=False,
        separators=(",", ":"),
    )


def require_tunnel_drift_equal(
    before: Any, after: Any, path: tuple[str | int, ...] = ()
) -> None:
    """Compare tunnel state recursively, allowing only named volatile leaves."""
    if path == ("conns_active_at",):
        return
    if (
        len(path) == 3
        and path[0] == "connections"
        and path[2] in TUNNEL_VOLATILE_CONNECTION_KEYS
    ):
        return
    if type(before) is not type(after):
        fail("tunnel_drift_unexpected")
    if isinstance(before, dict):
        if set(before) != set(after):
            fail("tunnel_drift_unexpected")
        for key in before:
            require_tunnel_drift_equal(after=after[key], before=before[key], path=path + (key,))
        return
    if isinstance(before, list):
        if path != ("connections",):
            if len(before) != len(after):
                fail("tunnel_drift_unexpected")
            for index, (left, right) in enumerate(zip(before, after)):
                require_tunnel_drift_equal(left, right, path + (index,))
            return
        if len(before) != len(after):
            fail("tunnel_drift_connections")
        # Connection identity fields are volatile and cannot safely pair live
        # records. Compare the complete invariant projections as a multiset so
        # duplicate projections and provider reordering remain valid while any
        # invariant multiplicity/add/remove/change fails closed.
        before_invariants = Counter(_connection_invariant_projection(item) for item in before)
        after_invariants = Counter(_connection_invariant_projection(item) for item in after)
        if before_invariants != after_invariants:
            fail("tunnel_drift_connections")
        return
    if not exact_equal(before, after):
        fail("tunnel_drift_unexpected")


def require_tunnel_drift_change(change: Any, identity: dict[str, Any]) -> None:
    if not isinstance(change, dict):
        fail("resource_drift_change_shape")
    required_keys = {
        "actions",
        "before",
        "after",
        "after_unknown",
        "before_sensitive",
        "after_sensitive",
    }
    if set(change) - CHANGE_KEYS or required_keys - set(change):
        fail("resource_drift_change_schema")
    if change["actions"] != ["update"]:
        fail("resource_drift_actions")
    require_sensitive_projection(
        change["before_sensitive"],
        "cloudflare_zero_trust_tunnel_cloudflared.keycloak",
        change["before"],
        "before",
    )
    require_sensitive_projection(
        change["after_sensitive"],
        "cloudflare_zero_trust_tunnel_cloudflared.keycloak",
        change["after"],
        "after",
    )
    # The tunnel resource has no accepted unknown projection in this pinned
    # plan.  In particular, a marker cannot hide a newly introduced field.
    require_unknown_projection(
        change["after_unknown"],
        "cloudflare_zero_trust_tunnel_cloudflared.keycloak",
        change["after"],
    )
    if "replace_paths" in change:
        if type(change["replace_paths"]) is not list or change["replace_paths"] != []:
            fail("resource_drift_replace_paths")
    for key in ("importing", "before_identity", "after_identity"):
        if key in change:
            require_null_or_empty_object(change[key], "resource_drift_metadata")
    if "generated_config" in change and change["generated_config"] not in (None, ""):
        fail("resource_drift_metadata")
    before, after = change["before"], change["after"]
    require_tunnel_state(before, "tunnel_drift_before", identity)
    require_tunnel_state(after, "tunnel_drift_after", identity)
    require_tunnel_drift_equal(before, after)


def require_resource_drift(value: Any, identity: dict[str, Any]) -> None:
    """Accept no drift, or one fully validated volatile tunnel refresh drift."""
    if value == []:
        return
    if type(value) is not list or len(value) != 1:
        fail("resource_drift")
    item = value[0]
    if not isinstance(item, dict):
        fail("resource_drift_schema")
    if set(item) - RESOURCE_KEYS or RESOURCE_REQUIRED_KEYS - set(item):
        fail("resource_drift_schema")
    if (
        item["address"] != "cloudflare_zero_trust_tunnel_cloudflared.keycloak"
        or item["mode"] != "managed"
        or item["type"] != "cloudflare_zero_trust_tunnel_cloudflared"
        or item["name"] != "keycloak"
        or item["provider_name"] != PROVIDER
    ):
        fail("resource_drift_identity")
    for key in ("previous_address", "module_address", "deposed", "action_reason"):
        if key in item and item[key] not in (None, ""):
            fail("resource_drift_metadata")
    if "index" in item and item["index"] is not None:
        fail("resource_drift_metadata")
    if "schema_version" in item and (
        type(item["schema_version"]) is not int or item["schema_version"] < 0
    ):
        fail("resource_drift_metadata")
    require_tunnel_drift_change(item["change"], identity)
    # Re-run the generic marker/tree guard after consuming the legitimate
    # tunnel marker fields.  This rejects future nested marker surfaces.
    require_safe_tree(scrub_sensitive_values(item), "resource_drift_safe_tree")


def expected_config(rules: list[dict[str, str]]) -> dict[str, Any]:
    return {
        "ingress": [
            {
                "hostname": rule.get("hostname"),
                "origin_request": None,
                "path": None,
                "service": rule["service"],
            }
            for rule in rules
        ],
        "origin_request": None,
    }


def require_tunnel_config_state(
    value: Any,
    rules: list[dict[str, str]],
    reason: str,
    require_computed: bool,
) -> None:
    if not isinstance(value, dict):
        fail(reason)
    if set(value) - TUNNEL_CONFIG_STATE_KEYS:
        fail(reason)
    for key in ("account_id", "tunnel_id", "config", "id", "source"):
        if key not in value:
            fail(reason)
    if value["account_id"] != ACCOUNT_ID or value["tunnel_id"] != TUNNEL_ID:
        fail(reason)
    if value["id"] != TUNNEL_ID or value["source"] != "cloudflare":
        fail(reason)
    require_exact_mapping(value["config"], expected_config(rules), reason)
    for key in ("created_at", "version"):
        if key not in value:
            if require_computed:
                fail(reason)
            continue
        if key == "created_at":
            require_timestamp(value[key])
        elif type(value[key]) is not int or value[key] < 0:
            fail(reason)


def require_update_delta(before: Any, after: Any, change: dict[str, Any]) -> None:
    before_rules = EXPECTED_TUNNEL_INGRESS
    after_rules = [
        EXPECTED_TUNNEL_INGRESS[0],
        EXPECTED_TUNNEL_INGRESS[1],
        EXPECTED_PROD_INGRESS,
        EXPECTED_TUNNEL_INGRESS[2],
    ]
    require_tunnel_config_state(
        before, before_rules, "tunnel_config_before_exact", require_computed=True
    )
    require_tunnel_config_state(
        after, after_rules, "tunnel_config_after_exact", require_computed=False
    )
    unknown = change.get("after_unknown")
    if unknown in (None, {}):
        if "created_at" not in after or "version" not in after:
            fail("tunnel_config_unknown")
    else:
        if not isinstance(unknown, dict) or set(unknown) - {"config", "created_at", "version"}:
            fail("tunnel_config_unknown")
        if "created_at" in unknown and (unknown["created_at"] is not True or "created_at" in after):
            fail("tunnel_config_unknown")
        if "version" in unknown and (unknown["version"] is not True or "version" in after):
            fail("tunnel_config_unknown")
        if "config" in unknown:
            marker = unknown["config"]
            if not isinstance(marker, dict) or set(marker) != {"ingress"}:
                fail("tunnel_config_unknown")
            ingress_marker = marker["ingress"]
            if not isinstance(ingress_marker, list) or len(ingress_marker) != len(after_rules):
                fail("tunnel_config_unknown")
            if any(item != {} for item in ingress_marker):
                fail("tunnel_config_unknown")
        if set(unknown) != {
            key for key in ("config", "created_at", "version")
            if key == "config" or key not in after
        }:
            fail("tunnel_config_unknown")


def require_dns_create_after(value: Any, reason: str) -> None:
    expected = {
        "zone_id": ZONE_ID,
        "name": "hub.cristex-soft.com",
        "type": "CNAME",
        "content": TUNNEL_TARGET,
        "ttl": 1,
        "proxied": True,
        "comment": EXPECTED_COMMENT,
    }
    if not isinstance(value, dict) or set(value) - DNS_STATE_KEYS or DNS_CONFIG_KEYS - set(value):
        fail(reason)
    for key, expected_value in expected.items():
        if not exact_equal(value.get(key), expected_value):
            fail(reason)
    # Provider-computed fields can be present as null/empty values in ``after``;
    # unknown computed fields are carried by after_unknown and checked separately.
    for key in set(value) - DNS_CONFIG_KEYS:
        require_dns_computed_field(key, value[key], reason)
    if "settings" in value:
        require_dns_settings(value["settings"], CREATE_ADDRESS, reason)


def require_output_changes(value: Any) -> None:
    """Validate the exact five root-output no-op changes from OpenTofu 1.12.5.

    A route plan created from the imported state reports each declared output as
    a no-op with concrete equal before/after values. Values are checked again
    against both state projections below; this function only accepts the exact
    output-change envelope and never accepts a deprecated or arbitrary field.
    """
    if type(value) is not dict or set(value) != set(EXPECTED_OUTPUTS):
        fail("output_changes")
    for name, expected in EXPECTED_OUTPUTS.items():
        change = value.get(name)
        if type(change) is not dict or set(change) != OUTPUT_CHANGE_KEYS:
            fail("output_change_schema")
        if change["actions"] != ["no-op"]:
            fail("output_change_actions")
        if not exact_equal(change["before"], expected) or not exact_equal(change["after"], expected):
            fail("output_change_value")
        if change["before_sensitive"] is not False or change["after_unknown"] is not False or change["after_sensitive"] is not False:
            fail("output_change_markers")


def require_output_change_bindings(
    output_changes: dict[str, Any],
    planned_values: dict[str, Any],
    prior_state: dict[str, Any],
    resource_changes: dict[str, dict[str, Any]],
) -> None:
    """Bind output changes to planned/prior surfaces and the Tunnel resource."""
    planned_outputs = planned_values.get("outputs")
    prior_values = prior_state.get("values") if isinstance(prior_state, dict) else None
    prior_outputs = prior_values.get("outputs") if isinstance(prior_values, dict) else None
    if not isinstance(planned_outputs, dict) or not isinstance(prior_outputs, dict):
        fail("output_change_binding")
    tunnel_change = resource_changes.get("cloudflare_zero_trust_tunnel_cloudflared.keycloak")
    if not isinstance(tunnel_change, dict):
        fail("tunnel_output_binding")
    tunnel_before = tunnel_change.get("change", {}).get("before")
    tunnel_after = tunnel_change.get("change", {}).get("after")
    if not isinstance(tunnel_before, dict) or not isinstance(tunnel_after, dict):
        fail("tunnel_output_binding")
    tunnel_id = tunnel_before.get("id")
    if not isinstance(tunnel_id, str) or tunnel_id != tunnel_after.get("id"):
        fail("tunnel_output_binding")
    if planned_outputs.get("tunnel_id", {}).get("value") != tunnel_id:
        fail("tunnel_output_binding")
    if prior_outputs.get("tunnel_id", {}).get("value") != tunnel_id:
        fail("tunnel_output_binding")
    for name in EXPECTED_OUTPUTS:
        change = output_changes.get(name)
        if not isinstance(change, dict):
            fail("output_change_binding")
        if not exact_equal(change.get("before"), prior_outputs[name]["value"]):
            fail("output_change_binding")
        if not exact_equal(change.get("after"), planned_outputs[name]["value"]):
            fail("output_change_binding")
    if prior_outputs["tunnel_id"]["value"] != tunnel_id:
        fail("tunnel_output_binding")


def require_plan_checks(value: Any) -> None:
    """Require all five passing source-variable validation checks."""
    if type(value) is not list or not exact_equal(value, EXPECTED_CHECKS):
        fail("checks")


def require_relevant_attributes(value: Any) -> None:
    """Require OpenTofu's exact dependency paths for the two route changes."""
    if type(value) is not list or not exact_equal(value, EXPECTED_RELEVANT_ATTRIBUTES):
        fail("relevant_attributes")


def require_unknown_projection(value: Any, address: str, after: Any) -> None:
    """Validate after_unknown against the provider schema and this exact plan."""
    if type(value) is not dict:
        fail("resource_unknown")
    if value == {}:
        if address == CREATE_ADDRESS:
            fail("prod_dns_unknown")
        if address == UPDATE_ADDRESS and isinstance(after, dict) and (
            "created_at" not in after or "version" not in after
        ):
            fail("tunnel_config_unknown")
        if address not in {UPDATE_ADDRESS, CREATE_ADDRESS}:
            return
        if address == UPDATE_ADDRESS:
            fail("tunnel_config_unknown")
    if address not in {CREATE_ADDRESS, UPDATE_ADDRESS}:
        fail("resource_unknown")
    if address == CREATE_ADDRESS:
        if set(value) != DNS_CREATE_UNKNOWN_KEYS or any(item is not True for item in value.values()):
            fail("prod_dns_unknown")
        if isinstance(after, dict) and any(key in after for key in value):
            fail("prod_dns_unknown")
        return
    if address == UPDATE_ADDRESS:
        if set(value) - {"config", "created_at", "version"}:
            fail("tunnel_config_unknown")
        if "created_at" in value and (value["created_at"] is not True or "created_at" in after):
            fail("tunnel_config_unknown")
        if "version" in value and (value["version"] is not True or "version" in after):
            fail("tunnel_config_unknown")
        if "config" in value:
            marker = value["config"]
            ingress = after.get("config", {}).get("ingress") if isinstance(after, dict) else None
            if (
                not isinstance(marker, dict)
                or set(marker) != {"ingress"}
                or not isinstance(marker["ingress"], list)
                or not isinstance(ingress, list)
                or len(marker["ingress"]) != len(ingress)
                or any(item != {} for item in marker["ingress"])
            ):
                fail("tunnel_config_unknown")
        expected = {key for key in ("config", "created_at", "version") if key == "config" or key not in after}
        if set(value) != expected:
            fail("tunnel_config_unknown")
        return
    # Existing no-op resources are required to have complete state values.
    fail("resource_unknown")


def require_sensitive_projection(
    value: Any, address: str, after: Any, side: str
) -> None:
    """Accept only the pinned provider's exact sensitivity marker for a side."""
    if address == CREATE_ADDRESS and side == "before":
        if value is not False:
            fail("resource_sensitive")
        return
    if address in EXPECTED_DNS_STATES or address == CREATE_ADDRESS:
        expected = {"settings": {}, "tags": []}
        if type(value) is not dict or not exact_equal(value, expected):
            fail("resource_sensitive")
        return
    if address == "cloudflare_zero_trust_tunnel_cloudflared.keycloak":
        if type(value) is not dict or set(value) != {"connections", "tunnel_secret"}:
            fail("resource_sensitive")
        if value["tunnel_secret"] is not True:
            fail("resource_sensitive")
        connections = after.get("connections") if isinstance(after, dict) else None
        markers = value["connections"]
        if (
            type(connections) is not list
            or type(markers) is not list
            or len(markers) != len(connections)
            or any(type(marker) is not dict or marker != {} for marker in markers)
        ):
            fail("resource_sensitive")
        return
    if address == UPDATE_ADDRESS:
        if type(value) is not dict or set(value) != {"config"}:
            fail("resource_sensitive")
        ingress = after.get("config", {}).get("ingress") if isinstance(after, dict) else None
        marker = value["config"]
        if type(marker) is not dict or set(marker) != {"ingress"} or not isinstance(ingress, list):
            fail("resource_sensitive")
        if marker["ingress"] != [{} for _ in ingress]:
            fail("resource_sensitive")
        return
    fail("resource_sensitive")


def validate_change(
    item: dict[str, Any], address: str, identity: dict[str, Any]
) -> None:
    change = item.get("change")
    if not isinstance(change, dict):
        fail("resource_change_shape")
    # OpenTofu 1.12.5 serializes an unset create value as explicit JSON null,
    # and emits the corresponding false sensitivity marker. Require that exact
    # representation rather than accepting an omitted or substituted pre-state.
    required_keys = {
        "actions",
        "before",
        "after",
        "after_unknown",
        "before_sensitive",
        "after_sensitive",
    }
    if set(change) - CHANGE_KEYS or required_keys - set(change):
        fail("resource_change_schema")
    actions = change["actions"]
    if not isinstance(actions, list) or not all(isinstance(action, str) for action in actions):
        fail("resource_actions_shape")
    require_sensitive_projection(
        change["before_sensitive"], address, change.get("before"), "before"
    )
    require_sensitive_projection(
        change["after_sensitive"], address, change.get("after"), "after"
    )
    require_unknown_projection(change["after_unknown"], address, change.get("after"))
    if "replace_paths" in change:
        if type(change["replace_paths"]) is not list or change["replace_paths"] != []:
            fail("replace_paths")
    if "importing" in change:
        require_null_or_empty_object(change["importing"], "importing")
    if "generated_config" in change and change["generated_config"] not in (None, ""):
        fail("generated_config")
    if "before_identity" in change:
        require_null_or_empty_object(change["before_identity"], "before_identity")
    if "after_identity" in change:
        require_null_or_empty_object(change["after_identity"], "after_identity")

    before = change.get("before")
    after = change.get("after")
    if address == UPDATE_ADDRESS:
        if actions != ["update"] or "before" not in change or "after" not in change:
            fail("tunnel_config_actions")
        require_update_delta(before, after, change)
    elif address == CREATE_ADDRESS:
        if actions != ["create"]:
            fail("prod_dns_actions")
        if before is not None:
            fail("prod_dns_before")
        if change.get("before_sensitive") is not False:
            fail("prod_dns_before_sensitive")
        require_dns_create_after(after, "prod_dns_exact")
    elif address in EXPECTED_DNS_STATES:
        if actions != ["no-op"] or "before" not in change or "after" not in change:
            fail("existing_resource_actions")
        if before is None or after is None:
            fail("existing_resource_state")
        require_dns_state(before, address, "existing_resource_state", identity)
        require_dns_state(after, address, "existing_resource_state", identity)
        if not exact_equal(before, after):
            fail("existing_resource_drift")
    elif address == "cloudflare_zero_trust_tunnel_cloudflared.keycloak":
        if actions != ["no-op"] or "before" not in change or "after" not in change:
            fail("existing_resource_actions")
        if before is None or after is None:
            fail("existing_resource_state")
        require_tunnel_state(before, "tunnel_resource_state", identity)
        require_tunnel_state(after, "tunnel_resource_state", identity)
        if not exact_equal(before, after):
            fail("existing_resource_drift")
    else:
        fail("resource_address_closure")


PROVENANCE_KEYS = frozenset(
    {
        "artifact",
        "artifact_sha256",
        "tofu_path",
        "tofu_sha256",
        "tofu_version",
        "provider",
        "provider_version",
        "source",
    }
)


def read_provenance(source: Path | str, plan_bytes: bytes) -> None:
    """Validate the descriptor-bound, sanitized ``tofu show`` receipt."""
    try:
        receipt = json.loads(
            _open_input(source, "plan_provenance").decode("utf-8"),
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_nonstandard_constant,
            parse_float=reject_nonfinite_float,
        )
    except (UnicodeError, json.JSONDecodeError, TypeError, ValueError):
        fail("plan_provenance_parse")
    if not isinstance(receipt, dict) or set(receipt) != PROVENANCE_KEYS:
        fail("plan_provenance_fields")
    if receipt["artifact"] != "refresh-only-plan-json":
        fail("plan_provenance_artifact")
    digest = receipt["artifact_sha256"]
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        fail("plan_provenance_digest")
    if digest != hashlib.sha256(plan_bytes).hexdigest():
        fail("plan_provenance_digest_mismatch")
    if (
        receipt["tofu_path"] != TOFU_PATH
        or receipt["tofu_sha256"] != TOFU_SHA256
        or receipt["tofu_version"] != "1.12.5"
        or receipt["provider"] != "cloudflare"
        or receipt["provider_version"] != "5.23.0"
        or receipt["source"] != "pinned-cli-show-json"
    ):
        fail("plan_provenance_identity")
    require_safe_tree(receipt, "plan_provenance_safe_tree")


def validate(
    source: Path | str,
    identity_source: Path | str,
    provenance_source: Path | str,
    provider_token: str | None = None,
) -> None:
    identity = read_identity(identity_source)
    try:
        plan_bytes = _open_input(source, "plan_json")
        plan = json.loads(
            plan_bytes.decode("utf-8"),
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_nonstandard_constant,
            parse_float=reject_nonfinite_float,
        )
    except (UnicodeError, json.JSONDecodeError, TypeError, ValueError):
        fail("plan_json_parse")
    if not provenance_source:
        fail("plan_provenance_required")
    read_provenance(provenance_source, plan_bytes)
    if not isinstance(plan, dict):
        fail("plan_json_shape")
    if provider_token is not None:
        if not provider_token or any(char.isspace() for char in provider_token):
            fail("provider_token_input")
        reject_token_tree(plan, provider_token)
    if set(plan) - TOP_LEVEL_KEYS or TOP_LEVEL_REQUIRED_KEYS - set(plan):
        fail("plan_top_level_schema")
    if plan["format_version"] != "1.2":
        fail("plan_format_version")
    if plan["terraform_version"] != "1.12.5":
        fail("terraform_version")
    if "resource_drift" in plan:
        require_resource_drift(plan["resource_drift"], identity)
    require_output_changes(plan["output_changes"])
    require_relevant_attributes(plan["relevant_attributes"])
    if type(plan["errored"]) is not bool or plan["errored"]:
        fail("errored")
    require_timestamp(plan["timestamp"])
    require_variables(plan["variables"])
    # planned_values, prior_state, and configuration are checked after
    # resource_changes establish the exact cross-state projections.
    require_configuration(plan["configuration"])
    require_plan_checks(plan["checks"])

    changes = plan["resource_changes"]
    if not isinstance(changes, list) or len(changes) != len(EXPECTED_ADDRESSES):
        fail("resource_changes")
    by_address: dict[str, dict[str, Any]] = {}
    dns_record_ids: set[str] = set()
    for item in changes:
        if not isinstance(item, dict):
            fail("resource_change_schema")
        if set(item) - RESOURCE_KEYS or RESOURCE_REQUIRED_KEYS - set(item):
            fail("resource_change_schema")
        address = item["address"]
        if not isinstance(address, str) or address in by_address:
            fail("resource_address_closure")
        by_address[address] = item
        expected_type = resource_type(address)
        expected_name = address.split(".", 1)[1]
        if (
            item["mode"] != "managed"
            or item["type"] != expected_type
            or item["name"] != expected_name
        ):
            fail("resource_identity")
        if item["provider_name"] != PROVIDER:
            fail("provider_scope")
        for key in ("previous_address", "module_address"):
            if key in item and item[key] not in (None, ""):
                fail("resource_address_metadata")
        if "index" in item and item["index"] is not None:
            fail("resource_index")
        if "deposed" in item and item["deposed"] not in (None, ""):
            fail("resource_deposed")
        if "schema_version" in item and (
            type(item["schema_version"]) is not int or item["schema_version"] < 0
        ):
            fail("resource_schema_version")
        if "action_reason" in item and item["action_reason"] not in (None, ""):
            fail("action_reason")
        validate_change(item, address, identity)
        if address in EXPECTED_DNS_STATES:
            record_id = item["change"]["after"].get("id")
            expected_record_id = identity["dns_record_ids"][address]
            if record_id != expected_record_id or record_id in dns_record_ids:
                fail("existing_resource_identity")
            dns_record_ids.add(record_id)
    if set(by_address) != EXPECTED_ADDRESSES:
        fail("resource_address_closure")
    if plan["planned_values"] is None or plan["prior_state"] is None:
        fail("state_projection_absent")
    require_prior_identity(plan["prior_state"], identity)
    require_state_values(
        plan["planned_values"],
        "planned_values",
        identity,
        set(EXPECTED_ADDRESSES),
        EXPECTED_OUTPUTS,
        {
            address: by_address[address]["change"]["after"]
            for address in EXPECTED_ADDRESSES
        },
    )
    require_state_envelope(
        plan["prior_state"],
        "prior_state",
        identity,
        set(EXISTING),
        {
            address: by_address[address]["change"]["before"]
            for address in EXISTING
        },
    )
    require_output_change_bindings(
        plan["output_changes"], plan["planned_values"], plan["prior_state"], by_address
    )
    print(
        "prod_plan=accepted existing_addresses=6 created=cloudflare_dns_record.cristexhub_prod "
        "updated=cloudflare_zero_trust_tunnel_cloudflared_config.keycloak actions=update,create "
        "apply=not-run provider=cloudflare sensitive=false unknown=false deferred=false outputs=no-op"
    )

def _validator_timeout(_signum: int, _frame: Any) -> NoReturn:
    fail("validator_timeout")


reject_forbidden_environment()
arguments = sys.argv[1:]
provenance_argument: str | None = None
provider_token_argument: str | None = None
if len(arguments) == 3:
    plan_argument, identity_argument, provenance_argument = arguments
elif len(arguments) == 4 and arguments[3] == "--token-stdin":
    plan_argument, identity_argument, provenance_argument = arguments[:3]
else:
    fail("usage")
if arguments[-1] == "--token-stdin":
    try:
        provider_token_argument = sys.stdin.buffer.readline().rstrip(b"\n").decode("utf-8")
    except (UnicodeError, OSError):
        fail("provider_token_input")
    if not provider_token_argument:
        fail("provider_token_input")
if __name__ == "__main__":
    signal.signal(signal.SIGALRM, _validator_timeout)
    signal.setitimer(signal.ITIMER_REAL, VALIDATOR_TIMEOUT_SECONDS)
    try:
        validate(plan_argument, identity_argument, provenance_argument, provider_token_argument)
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
