#!/usr/bin/python3
"""Validate the protected foundation state and refresh-only plan envelopes.

This helper consumes only mode-0600 captures made by a guarded wrapper. It
never opens the backend, invokes OpenTofu, loads a provider, or contacts an
API. The protected state proof and the refresh-only plan proof are deliberately
separate: a refresh-only no-op may have an empty planned root and no
``resource_changes`` surface, while the state JSON proves the exact managed
address and imported DNS-record set. Wrapper consumers pass verified ``fd:N``
inputs, including the plan provenance sidecar; pathname mode remains an
offline compatibility form and is opened once with ``O_NOFOLLOW``.
"""

from __future__ import annotations

import hashlib
import json
