# State and plan captures are produced locally and are expected to be small. A
# hard byte bound prevents an untrusted pathname/FIFO or provider response from
# growing validator memory without limit. The alarm is a second, independent
# bound for pathological JSON nesting/validation work.
MAX_INPUT_BYTES = 4 * 1024 * 1024
VALIDATOR_TIMEOUT_SECONDS = 15


def fail(reason: str) -> NoReturn:
    print(f"state_scope=refused reason={reason}")
    raise SystemExit(1)


def _reject_constant(value: str) -> NoReturn:
    raise ValueError(f"nonstandard JSON constant: {value}")


def _pairs_without_duplicates(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    result: dict[str, Any] = {}
    for key, value in pairs:
        if key in result:
            raise ValueError("duplicate JSON object key")
        result[key] = value
    return result


def _open_input(path: Path | str) -> bytes:
    """Read one verified regular-file descriptor, never a pathname twice.

    ``fd:N`` is supplied by the reconciler after it compares the descriptor's
    device/inode to the producer receipt.  Direct callers use a path, which is
    opened once with ``O_NOFOLLOW`` and is still checked for the strict mode,
    owner, link count, and regular-file contract before consumption.
    """
    path_text = os.fspath(path)
    try:
        fd_match = re.fullmatch(r"fd:([0-9]+)", path_text)
        inherited_fd = fd_match is not None
        if fd_match:
            fd = os.dup(int(fd_match.group(1)))
        else:
            # O_NONBLOCK is essential before fstat: opening a FIFO read-only
            # otherwise waits for a writer before we can reject its type.
            fd = os.open(
                path_text,
                os.O_RDONLY
                | os.O_CLOEXEC
                | getattr(os, "O_NOFOLLOW", 0)
                | getattr(os, "O_NONBLOCK", 0),
            )
    except (OSError, ValueError):
        fail("input_open")
    try:
        info = os.fstat(fd)
        if (
            not stat.S_ISREG(info.st_mode)
            or stat.S_IMODE(info.st_mode) != 0o600
            or info.st_uid != os.getuid()
            or info.st_nlink not in ({0, 1} if inherited_fd else {1})
        ):
            fail("input_permissions")
        chunks: list[bytes] = []
        total = 0
        while True:
            chunk = os.read(fd, 1024 * 1024)
            if not chunk:
                break
            total += len(chunk)
            if total > MAX_INPUT_BYTES:
                fail("input_too_large")
            chunks.append(chunk)
        return b"".join(chunks)
    except OSError:
        fail("input_read")
    finally:
        os.close(fd)


def _load_json_from_bytes(data: bytes) -> Any:
    try:
        return json.loads(
            data.decode("utf-8"),
            object_pairs_hook=_pairs_without_duplicates,
            parse_constant=_reject_constant,
            parse_int=int,
            parse_float=Decimal,
        )
    except (UnicodeDecodeError, json.JSONDecodeError, TypeError, ValueError):
        fail("json")


def _load_json(path: Path | str) -> Any:
    return _load_json_from_bytes(_open_input(path))


def _strict_equal(left: Any, right: Any) -> bool:
    """Compare decoded JSON without bool/int or decimal/float coercion."""
    if type(left) is not type(right):
        return False
    if isinstance(left, dict):
        return set(left) == set(right) and all(
            _strict_equal(left[key], right[key]) for key in left
        )
    if isinstance(left, list):
        return len(left) == len(right) and all(
            _strict_equal(a, b) for a, b in zip(left, right)
        )
    if isinstance(left, Decimal):
        return left.as_tuple() == right.as_tuple()
    return left == right


def _empty_marker(value: Any) -> bool:
    return value is None or value is False or (isinstance(value, dict) and not value)


_MARKER_KEYS = {
    "sensitivevalues",
    "beforesensitive",
    "aftersensitive",
    "unknown",
    "beforeunknown",
    "afterunknown",
    "beforeidentity",
    "afteridentity",
    "importing",
    "sensitive",
}
_SECRET_KEY_WORDS = {
    "secret",
    "token",
    "password",
    "credential",
    "apikey",
    "apitoken",
    "accesstoken",
    "clientsecret",
    "privatekey",
    "tunnelsecret",
}


def _normalise_key(key: str) -> str:
    # JSON keys are attacker-controlled input. Treat snake_case, camelCase,
    # kebab-case, and punctuation variants identically.
    return re.sub(r"[^a-z0-9]", "", key.lower())


def _is_secret_key(key: str) -> bool:
    normalised = _normalise_key(key)
    # Segment boundaries disappear after normalisation, so reject a secret
    # marker anywhere in the key (for example secretValue, nested-token, or
    # provider_apiKey), not only the snake_case forms.
    return normalised in _SECRET_KEY_WORDS or any(
        word in normalised
        for word in ("secret", "token", "password", "credential", "apikey", "privatekey")
    )


def _expected_state_sensitive_values(
    resource: dict[str, Any],
) -> dict[str, Any]:
    """Return the pinned OpenTofu 1.12.5 marker for one state resource."""
    address = resource.get("address")
    values = resource.get("values")
    if not isinstance(values, dict):
        return {}
    if address == "cloudflare_zero_trust_tunnel_cloudflared.keycloak":
        return {"connections": [], "tunnel_secret": True}
    if address == "cloudflare_zero_trust_tunnel_cloudflared_config.keycloak":
        config = values.get("config")
        ingress = config.get("ingress") if isinstance(config, dict) else None
        if not isinstance(ingress, list):
            return {}
        return {"config": {"ingress": [{} for _ in ingress]}}
    if address.startswith("cloudflare_dns_record."):
        record_type = values.get("type")
        if record_type == "CNAME":
            return {"settings": {}, "tags": []}
        return {"tags": []}
    return {}


def _validate_markers(
    value: Any,
    *,
    location: str = "root",
    allow_tunnel_secret: bool = False,
    allowed_resource_ids: frozenset[int] = frozenset(),
) -> None:
    """Reject markers and secret-shaped fields recursively.

    The sole value exception is the Cloudflare provider's explicit null
    ``values.tunnel_secret`` on a *direct* canonical tunnel resource.  Resource
    identity is carried by object identity collected from the already-validated
    resource list, rather than inferred from attacker-controlled nested
    ``address`` fields.  Consequently a nested object that merely resembles
    the tunnel resource cannot inherit the exception or a ``sensitive_values``
    projection.
    """
    if isinstance(value, dict):
        resource_projection = id(value) in allowed_resource_ids
        exact_tunnel_resource = resource_projection and (
            value.get("address") == "cloudflare_zero_trust_tunnel_cloudflared.keycloak"
        )
        for key, item in value.items():
            if not isinstance(key, str):
                fail(f"{location}.non_string_key")
            normalised = _normalise_key(key)
            if key == "sensitive_values":
                # This field is emitted only on validated direct resource
                # projections. Empty maps are valid for non-sensitive resources;
                # the only non-empty map is the exact null tunnel marker.
                if not isinstance(item, dict):
                    fail(f"{location}.sensitive_values_shape")
                expected_sensitive_values = (
                    _expected_state_sensitive_values(value)
                    if resource_projection
                    else {}
                )
                allowed = (
                    resource_projection
                    and _strict_equal(item, expected_sensitive_values)
                    and (
                        exact_tunnel_resource
                        or expected_sensitive_values != {}
                    )
                )
                if item and not allowed:
                    fail(f"{location}.sensitive_values_nonempty")
                if not resource_projection and item == {}:
                    fail(f"{location}.sensitive_values_location")
                if allowed:
                    continue
            elif normalised in {"beforesensitive", "aftersensitive"}:
                if not _empty_marker(item):
                    fail(f"{location}.{key}_nonempty")
            elif normalised in {
                "unknown",
                "beforeunknown",
                "afterunknown",
                "beforeidentity",
                "afteridentity",
                "importing",
            }:
                if not _empty_marker(item):
                    fail(f"{location}.{key}_nonempty")
            elif normalised == "sensitive":
                if item is not False:
                    fail(f"{location}.{key}")
            elif normalised == "tunnelsecret":
                if key == "tunnel_secret" and allow_tunnel_secret and item is None:
                    continue
                if key == "tunnel_secret" and allow_tunnel_secret:
                    fail(f"{location}.{key}_plaintext")
                fail(f"{location}.{key}_field")
            elif (
                normalised not in _MARKER_KEYS
                and _is_secret_key(key)
                and not (
                    key == "token_handoff"
                    and (location.endswith(".outputs") or location.endswith(".output_changes"))
                )
            ):
                # ``token_handoff`` is a reviewed, value-free output name; all
                # other token-shaped keys remain forbidden, including a nested
                # or relocated token_handoff field.
                fail(f"{location}.{key}_field")
            if key == "values":
                _validate_markers(
                    item,
                    location=f"{location}.{key}",
                    allow_tunnel_secret=exact_tunnel_resource,
                    allowed_resource_ids=allowed_resource_ids,
                )
            else:
                # The tunnel-secret exception does not propagate through a
                # nested dict/list: only the direct values member is allowed.
                _validate_markers(
                    item,
                    location=f"{location}.{key}",
                    allowed_resource_ids=allowed_resource_ids,
                )
    elif isinstance(value, list):
        for index, item in enumerate(value):
            _validate_markers(
                item,
                location=f"{location}[{index}]",
                allowed_resource_ids=allowed_resource_ids,
            )


def _require_dict(value: Any, reason: str) -> dict[str, Any]:
    if not isinstance(value, dict):
        fail(reason)
    return value


def _require_exact_type(value: Any, expected: type, reason: str) -> None:
    if type(value) is not expected:
        fail(reason)


def _validate_address_list(phase: str, path: Path) -> None:
    try:
        raw = _open_input(path).decode("utf-8")
    except UnicodeDecodeError:
        fail("state_address_encoding")
    lines = raw.splitlines()
    expected = PRE_ADDRESSES if phase == "pre" else POST_ADDRESSES
    if not lines or len(lines) != len(set(lines)):
        fail("state_address_duplicates_or_empty")
    if any(not ADDRESS_RE.fullmatch(line) for line in lines):
        fail("state_address_shape")
    if sorted(lines) != sorted(expected):
        fail("state_address_closure")
    print(f"state_scope=accepted phase={phase} addresses={len(expected)}")


def _resource_identity(resource: Any, *, config: bool = False) -> str:
    item = _require_dict(
        resource, "config_resource_shape" if config else "state_resource_shape"
    )
    allowed = (
        {
            "address",
            "mode",
            "type",
            "name",
            "provider_config_key",
            "expressions",
            "schema_version",
        }
        if config
        else {
            "address",
            "mode",
            "type",
            "name",
            "provider_name",
            "schema_version",
            "values",
            "sensitive_values",
            "index",
        }
    )
    if set(item) - allowed:
        fail("config_resource_fields" if config else "state_resource_fields")
    if config and set(item) != {
        "address",
        "mode",
        "type",
        "name",
        "provider_config_key",
        "expressions",
        "schema_version",
    }:
        # OpenTofu emits the provider schema version on configuration resource
        # entries. Count/for_each/dependency/provisioner metadata is absent from
        # this exact root configuration and is rejected by the set closure.
        fail("config_resource_fields")
    address = item.get("address")
    if not isinstance(address, str) or not ADDRESS_RE.fullmatch(address):
        fail("config_resource_address" if config else "state_resource_address")
    parts = address.split(".")
    if item.get("mode") != "managed":
        fail("config_resource_mode" if config else "state_resource_mode")
    if item.get("type") != parts[0] or item.get("name") != parts[1]:
        fail("config_resource_identity" if config else "state_resource_identity")
    if config:
        if item.get("provider_config_key") != "cloudflare":
            fail("config_resource_provider")
        if type(item.get("schema_version")) is not int or item["schema_version"] != 500:
            fail("config_resource_schema_version")
        expressions = item.get("expressions")
        if not isinstance(expressions, dict):
            fail("config_resource_expressions")
        expected_expressions = CONFIG_EXPECTED_EXPRESSIONS.get(address)
        if expected_expressions is None or not _strict_equal(
            expressions, expected_expressions
        ):
            fail("config_resource_expression_semantics")
    else:
        if item.get("provider_name") != RESOURCE_PROVIDER:
            fail("state_resource_provider")
        if "schema_version" not in item or type(item["schema_version"]) is not int:
            fail("state_resource_schema_version")
        if "index" in item and item["index"] is not None:
            fail("state_resource_index")
        if not isinstance(item.get("values"), dict):
            fail("state_resource_values")
        if not isinstance(item.get("sensitive_values"), dict):
            fail("state_resource_sensitive_values")
        if "tunnel_secret" in item["values"] and address != (
            "cloudflare_zero_trust_tunnel_cloudflared.keycloak"
        ):
            fail("state_resource_secret_field")
    return address


def _validate_state_outputs(outputs: Any, *, tunnel_id: str | None = None) -> None:
    if not isinstance(outputs, dict) or set(outputs) != set(OUTPUT_NAMES):
        fail("state_outputs_closure")
    for name in OUTPUT_NAMES:
        output = outputs[name]
        if not isinstance(output, dict):
            fail("state_output_shape")
        if set(output) - {"value", "type", "sensitive"}:
            fail("state_output_fields")
        if set(output) != {"value", "type", "sensitive"}:
            fail("state_output_shape")
        if output.get("type") != "string" or output.get("sensitive") is not False:
            fail("state_output_sensitive")
        value = output.get("value")
        if name == "tunnel_id":
            if not isinstance(value, str) or not UUID_RE.fullmatch(value):
                fail("state_tunnel_uuid")
            if tunnel_id is not None and value != tunnel_id:
                fail("state_tunnel_uuid_binding")
        elif not isinstance(value, str) or value != OUTPUT_VALUES[name]:
            fail("state_output_value")


def _validate_state_resource_projection(resource: dict[str, Any]) -> None:
    """Validate the provider's complete, exact state value projection.

    OpenTofu state is not treated as a loose bag of provider fields.  The
    pinned Cloudflare provider emits these exact value keys for each resource
    in the protected six-address state.  In particular, ``ttl`` must be a real
    JSON integer (not ``true``) and every configurable value is checked rather
    than merely checking a handful of required fields.
    """
    address = resource["address"]
    values = resource["values"]
    sensitive_values = resource["sensitive_values"]
    # Reject secret-shaped or malformed marker fields before exact projection
    # checks so an added field cannot be hidden behind a generic key failure.
    _validate_markers(resource, allowed_resource_ids=frozenset({id(resource)}))
    if address == "cloudflare_zero_trust_tunnel_cloudflared.keycloak":
        expected_values = {
            "id": FOUNDATION_TUNNEL_ID,
            "account_id": FOUNDATION_ACCOUNT_ID,
            "account_tag": FOUNDATION_ACCOUNT_ID,
            "tunnel_secret": None,
        }
        if set(values) != set(expected_values) or not _strict_equal(values, expected_values):
            fail("state_tunnel_values")
    elif address == "cloudflare_zero_trust_tunnel_cloudflared_config.keycloak":
        config = values.get("config")
        if not isinstance(config, dict) or set(config) != {"ingress", "origin_request"}:
            fail("state_tunnel_config_shape")
        if config.get("origin_request") is not None:
            fail("state_tunnel_origin_request")
        if not _strict_equal(config.get("ingress"), EXPECTED_STATE_TUNNEL_INGRESS):
            fail("state_tunnel_ingress")
        expected_values = {
            "account_id": FOUNDATION_ACCOUNT_ID,
            "tunnel_id": FOUNDATION_TUNNEL_ID,
            "config": {
                "origin_request": None,
                "ingress": EXPECTED_STATE_TUNNEL_INGRESS,
            },
        }
        if set(values) != set(expected_values) or not _strict_equal(values, expected_values):
            fail("state_tunnel_config_values")
    elif address == "cloudflare_dns_record.argocd_tailscale":
        expected_values = {"id": HEX32_RE, "zone_id": FOUNDATION_ZONE_ID}
        if set(values) != set(expected_values):
            fail("state_dns_values")
        if not isinstance(values.get("id"), str) or not HEX32_RE.fullmatch(values["id"]):
            fail("state_dns_id")
        if values.get("zone_id") != FOUNDATION_ZONE_ID:
            fail("state_dns_zone")
    elif address in {
        "cloudflare_dns_record.cristexhub_dev",
        "cloudflare_dns_record.keycloak",
    }:
        if set(values) != {"id", "zone_id", "type"}:
            fail("state_dns_values")
        if not isinstance(values.get("id"), str) or not HEX32_RE.fullmatch(values["id"]):
            fail("state_dns_id")
        if values.get("zone_id") != FOUNDATION_ZONE_ID or values.get("type") != "CNAME":
            fail("state_dns_identity")
    elif address == "cloudflare_dns_record.reactive_resume_dev_tailscale":
        expected_values = {
            "name": "resume-dev.cristex-soft.com",
            "type": "A",
            "content": "100.122.139.32",
            "ttl": 300,
            "proxied": False,
            "comment": "Managed by OpenTofu; private Reactive Resume DEV endpoint on Tailscale",
        }
        expected_keys = {"id", "zone_id", *expected_values}
        if set(values) != expected_keys:
            fail("state_reactive_resume_values")
        if not isinstance(values.get("id"), str) or not HEX32_RE.fullmatch(values["id"]):
            fail("state_dns_id")
        if values.get("zone_id") != FOUNDATION_ZONE_ID:
            fail("state_dns_zone")
        for key, expected_value in expected_values.items():
            if type(values.get(key)) is not type(expected_value):
                fail("state_reactive_resume_value")
            if not _strict_equal(values[key], expected_value):
                fail("state_reactive_resume_value")
    else:
        fail("state_resource_address")
    expected_sensitive_values = _expected_state_sensitive_values(resource)
    if not _strict_equal(sensitive_values, expected_sensitive_values):
        fail("state_resource_sensitive_values")


STATE_IDENTITY_KEYS = frozenset(
    {
        "schema",
        "scope",
        "account_id",
        "zone_id",
        "tunnel_id",
        "tunnel_account_tag",
        "dns_record_ids",
    }
)
STATE_IDENTITY_SCOPE = "cloudflare-foundation-import-reactive-resume-dev-tailscale"


def _load_state_identity(source: Path | str) -> dict[str, str]:
    identity = _load_json(source)
    if not isinstance(identity, dict) or set(identity) != STATE_IDENTITY_KEYS:
        fail("state_identity_schema")
    if type(identity.get("schema")) is not int or identity["schema"] != 1:
        fail("state_identity_schema")
    if identity.get("scope") != STATE_IDENTITY_SCOPE:
        fail("state_identity_scope")
    if identity.get("account_id") != FOUNDATION_ACCOUNT_ID:
        fail("state_identity_account")
    if identity.get("zone_id") != FOUNDATION_ZONE_ID:
        fail("state_identity_zone")
    if identity.get("tunnel_id") != FOUNDATION_TUNNEL_ID:
        fail("state_identity_tunnel")
    if identity.get("tunnel_account_tag") != FOUNDATION_ACCOUNT_ID:
        fail("state_identity_account_tag")
    record_ids = identity.get("dns_record_ids")
    if not isinstance(record_ids, dict) or set(record_ids) != set(DNS_RECORD_ADDRESSES):
        fail("state_identity_records")
    values: list[str] = []
    for address in DNS_RECORD_ADDRESSES:
        record_id = record_ids.get(address)
        if not isinstance(record_id, str) or not HEX32_RE.fullmatch(record_id):
            fail("state_identity_records")
        values.append(record_id)
    if len(values) != len(set(values)):
        fail("state_identity_records")
    return identity


def _validate_state_identity_bindings(
    resources: list[dict[str, Any]], identity: dict[str, Any]
) -> None:
    by_address = {resource["address"]: resource for resource in resources}
    record_ids = identity.get("dns_record_ids")
    if not isinstance(record_ids, dict):
        fail("state_identity_records")
    for address in DNS_RECORD_ADDRESSES:
        record = by_address.get(address)
        if not isinstance(record, dict) or not isinstance(record.get("values"), dict):
            fail("state_identity_record")
        record_values = record["values"]
        if record_values.get("id") != record_ids.get(address):
            fail("state_identity_record")
        if record_values.get("zone_id") != identity["zone_id"]:
            fail("state_identity_zone")
    tunnel = by_address.get("cloudflare_zero_trust_tunnel_cloudflared.keycloak")
    tunnel_values = tunnel.get("values") if isinstance(tunnel, dict) else None
    if not isinstance(tunnel_values, dict):
        fail("state_identity_tunnel")
    if tunnel_values.get("id") != identity["tunnel_id"]:
        fail("state_identity_tunnel")
    if tunnel_values.get("account_id") != identity["account_id"]:
        fail("state_identity_account")
    if tunnel_values.get("account_tag") != identity["tunnel_account_tag"]:
        fail("state_identity_account_tag")
    config = by_address.get("cloudflare_zero_trust_tunnel_cloudflared_config.keycloak")
    config_values = config.get("values") if isinstance(config, dict) else None
    if not isinstance(config_values, dict):
        fail("state_identity_tunnel_config")
    if config_values.get("tunnel_id") != identity["tunnel_id"]:
        fail("state_identity_tunnel_config")
    if config_values.get("account_id") != identity["account_id"]:
        fail("state_identity_tunnel_config")
    for resource in resources:
        address = resource["address"]
        values = resource["values"]
        if not isinstance(values, dict):
            fail("state_identity_values")
        if address.startswith("cloudflare_dns_record."):
            if address not in DNS_RECORD_ADDRESSES:
                fail("state_identity_record")
            if values.get("zone_id") != identity["zone_id"]:
                fail("state_identity_zone")
            expected_record_id = identity["dns_record_ids"].get(address)
            if values.get("id") != expected_record_id:
                fail("state_identity_record")
        elif address in {
            "cloudflare_zero_trust_tunnel_cloudflared.keycloak",
            "cloudflare_zero_trust_tunnel_cloudflared_config.keycloak",
        }:
            if "account_id" in values and values["account_id"] != identity["account_id"]:
                fail("state_identity_account")
            if address.endswith("_config.keycloak") and "tunnel_id" in values:
                tunnel = by_address.get("cloudflare_zero_trust_tunnel_cloudflared.keycloak")
                tunnel_values = tunnel.get("values") if isinstance(tunnel, dict) else None
                if not isinstance(tunnel_values, dict) or values["tunnel_id"] != tunnel_values.get("id"):
                    fail("state_identity_tunnel")


def _validate_state_json(
    phase: str, path: Path | str, identity_source: Path | str | None = None
) -> None:
    state = _load_json(path)
    if not isinstance(state, dict):
        fail("state_json_shape")
    if set(state) != {"format_version", "terraform_version", "values", "checks"}:
        fail("state_json_top_level")
    if state.get("format_version") != "1.0":
        fail("state_json_format_version")
    if state.get("terraform_version") != "1.12.5":
        fail("state_json_tofu_version")
    if state["checks"] != []:
        fail("state_checks")
    values = _require_dict(state.get("values"), "state_values_shape")
    if set(values) != {"outputs", "root_module"}:
        fail("state_values_shape")
    root = _require_dict(values.get("root_module"), "state_root_module")
    if set(root) - {"resources", "child_modules"}:
        fail("state_root_module_fields")
    if root.get("child_modules") not in (None, []):
        fail("state_child_modules")
    resources = root.get("resources")
    if not isinstance(resources, list):
        fail("state_resources")
    expected = PRE_ADDRESSES if phase == "pre" else POST_ADDRESSES
    addresses = [_resource_identity(resource) for resource in resources]
    if len(addresses) != len(set(addresses)) or sorted(addresses) != sorted(expected):
        fail("state_json_address_closure")
    # Run the recursive marker/key closure before semantic projections so a
    # malformed sensitive map is reported as such rather than being hidden by
    # a later resource-specific check.
    resource_ids = frozenset(id(resource) for resource in resources)
    _validate_markers(state, allowed_resource_ids=resource_ids)
    tunnel_id: str | None = None
    for resource in resources:
        resource_values = resource["values"]
        if resource["address"] == "cloudflare_zero_trust_tunnel_cloudflared.keycloak":
            tunnel_id = resource_values.get("id")
        _validate_state_resource_projection(resource)
    if tunnel_id is None:
        fail("state_tunnel_resource")
    if phase == "post" and identity_source is None:
        fail("state_identity_required")
    if identity_source is not None:
        identity = _load_state_identity(identity_source)
        _validate_state_identity_bindings(resources, identity)
    _validate_state_outputs(values.get("outputs"), tunnel_id=tunnel_id)
    print(
        f"state_scope=accepted phase={phase}-json addresses={len(expected)} outputs=5 sensitive=false"
    )


def _validate_resource_text(address: str, path: Path) -> None:
    try:
        text = _open_input(path).decode("utf-8")
    except UnicodeDecodeError:
        fail("resource_encoding")
    required = (
        'name = "resume-dev.cristex-soft.com"',
        'type = "A"',
        'content = "100.122.139.32"',
        "proxied = false",
        "ttl = 300",
    )
    if address != "reactive_resume_dev_tailscale" or not all(
        item in text for item in required
    ):
        fail("resource_contract")
    print("state_scope=accepted phase=resource address=reactive_resume_dev_tailscale")


def _validate_output_change(name: str, change: Any) -> None:
    item = _require_dict(change, "plan_output_shape")
    allowed = {
        "actions",
        "before",
        "after",
        "before_unknown",
        "after_unknown",
        "before_sensitive",
        "after_sensitive",
        "replace_paths",
        "action_reason",
    }
    if set(item) - allowed or not {
        "actions",
        "before",
        "after",
        "after_unknown",
        "before_sensitive",
        "after_sensitive",
    }.issubset(item):
        fail("plan_output_fields")
    if item.get("actions") != ["no-op"]:
        fail("plan_output_actions")
    if not _strict_equal(item.get("before"), item.get("after")):
        fail("plan_output_drift")
    for marker in (
        "before_unknown",
        "after_unknown",
        "before_sensitive",
        "after_sensitive",
    ):
        if marker in item and item[marker] is not False:
            fail(f"plan_output_{marker}")
    if "replace_paths" in item and item["replace_paths"] != []:
        fail("plan_output_replace")
    if "action_reason" in item and item["action_reason"] not in (None, "", "no-op"):
        fail("plan_output_reason")
    value = item["after"]
    if name == "tunnel_id":
        if not isinstance(value, str) or not UUID_RE.fullmatch(value):
            fail("plan_tunnel_uuid")
    elif not isinstance(value, str) or value != OUTPUT_VALUES[name]:
        fail("plan_output_value")


def _validate_output_surface(surface: Any, location: str) -> None:
    if not isinstance(surface, dict):
        fail(f"{location}_shape")
    # Both planned_values and prior_state are required to carry the complete
    # five-output projection.  A missing projection would make output_changes
    # unverifiable even if all actions claim no-op.
    outputs = surface.get("outputs")
    if not isinstance(outputs, dict) or set(outputs) != set(OUTPUT_NAMES):
        fail(f"{location}_outputs")
    for name in OUTPUT_NAMES:
        output = outputs[name]
        if not isinstance(output, dict) or set(output) != {
            "value",
            "type",
            "sensitive",
        }:
            fail(f"{location}_output_shape")
        if output.get("type") != "string" or output.get("sensitive") is not False:
            fail(f"{location}_output_sensitive")
        value = output["value"]
        if name == "tunnel_id":
            if not isinstance(value, str) or not UUID_RE.fullmatch(value):
                fail(f"{location}_tunnel_uuid")
        elif value != OUTPUT_VALUES[name]:
            fail(f"{location}_output_value")


def _validate_plan_output_bindings(
    output_changes: dict[str, Any],
    planned_values: dict[str, Any],
    prior_values: dict[str, Any],
    prior_resources: list[dict[str, Any]],
) -> None:
    """Tie the no-op output surface to the two state projections.

    OpenTofu emits an empty planned root for this refresh-only envelope, so the
    prior tunnel resource is the authoritative resource identity.  The
    planned/prior outputs and every output-change before/after value must all
    carry that same tunnel UUID; a different but well-formed UUID is refused.
    """
    planned_outputs = planned_values.get("outputs")
    prior_outputs = prior_values.get("outputs")
    if not isinstance(planned_outputs, dict) or not isinstance(prior_outputs, dict):
        fail("plan_output_surface_binding")
    tunnel_resources = [
        resource
        for resource in prior_resources
        if resource.get("address") == "cloudflare_zero_trust_tunnel_cloudflared.keycloak"
    ]
    if len(tunnel_resources) != 1:
        fail("plan_tunnel_resource_binding")
    tunnel_values = tunnel_resources[0].get("values")
    if not isinstance(tunnel_values, dict):
        fail("plan_tunnel_resource_binding")
    tunnel_id = tunnel_values.get("id")
    if tunnel_id != FOUNDATION_TUNNEL_ID:
        fail("plan_tunnel_resource_binding")
    if tunnel_values.get("account_id") != FOUNDATION_ACCOUNT_ID:
        fail("plan_tunnel_resource_binding")
    if tunnel_values.get("account_tag") != FOUNDATION_ACCOUNT_ID:
        fail("plan_tunnel_resource_binding")
    config_resources = [
        resource
        for resource in prior_resources
        if resource.get("address")
        == "cloudflare_zero_trust_tunnel_cloudflared_config.keycloak"
    ]
    if len(config_resources) != 1:
        fail("plan_tunnel_config_binding")
    config_values = config_resources[0].get("values")
    if (
        not isinstance(config_values, dict)
        or config_values.get("account_id") != FOUNDATION_ACCOUNT_ID
        or config_values.get("tunnel_id") != FOUNDATION_TUNNEL_ID
    ):
        fail("plan_tunnel_config_binding")
    if planned_outputs["tunnel_id"]["value"] != tunnel_id:
        fail("plan_tunnel_output_binding")
    if prior_outputs["tunnel_id"]["value"] != tunnel_id:
        fail("plan_tunnel_output_binding")
    for name in OUTPUT_NAMES:
        change = output_changes.get(name)
        if not isinstance(change, dict):
            fail("plan_output_surface_binding")
        if not _strict_equal(change.get("before"), prior_outputs[name]["value"]):
            fail("plan_output_surface_binding")
        if not _strict_equal(change.get("after"), planned_outputs[name]["value"]):
            fail("plan_output_surface_binding")


def _validate_variables(variables: Any) -> None:
    if not isinstance(variables, dict) or set(variables) != set(VARIABLE_NAMES):
        fail("plan_variables_closure")
    for name in VARIABLE_NAMES:
        variable = variables[name]
        if not isinstance(variable, dict) or set(variable) != {"value"}:
            fail("plan_variable_shape")
        value = variable["value"]
        if name == "cloudflare_account_id":
            if value != FOUNDATION_ACCOUNT_ID:
                fail("plan_variable_identity")
        elif name == "cloudflare_zone_id":
            if value != FOUNDATION_ZONE_ID:
                fail("plan_variable_identity")
        elif name == "cloudflare_tunnel_name" and value != "cristexhub-keycloak":
            fail("plan_variable_value")
        elif name == "public_hostname" and value != "auth.cristex-soft.com":
            fail("plan_variable_value")
        elif (
            name == "traefik_origin_service"
            and value != "http://traefik.kube-system.svc.cluster.local:80"
        ):
            fail("plan_variable_value")


def _validate_expression(value: Any, location: str) -> None:
    if isinstance(value, dict):
        if set(value) - {
            "constant_value",
            "references",
            "traversal",
            "function_name",
            "function_args",
            "index",
        }:
            fail(f"{location}_expression_fields")
        if not value:
            fail(f"{location}_expression_empty")
        for key, item in value.items():
            if key == "constant_value":
                # A constant expression may itself be any JSON object/list;
                # inspect it for marker/plaintext keys without interpreting
                # application object keys as expression fields.
                _validate_markers(item, location=f"{location}.{key}")
            elif key == "references":
                if not isinstance(item, list) or any(
                    not isinstance(reference, str) for reference in item
                ):
                    fail(f"{location}_expression_references")
            else:
                _validate_expression(item, f"{location}.{key}")
    elif isinstance(value, list):
        for index, item in enumerate(value):
            _validate_expression(item, f"{location}[{index}]")
    elif isinstance(value, str):
        if any(
            token in value.lower()
            for token in ("api_token", "client_secret", "private_key", "password")
        ):
            fail(f"{location}_plaintext")


def _validate_expression_map(value: Any, location: str) -> None:
    if not isinstance(value, dict) or not value:
        fail(f"{location}_expression_map")
    for key, item in value.items():
        if not isinstance(key, str) or not key:
            fail(f"{location}_expression_key")
        _validate_expression(item, f"{location}.{key}")


def _validate_configuration(configuration: Any) -> None:
    config = _require_dict(configuration, "plan_configuration_shape")
    if set(config) != {"provider_config", "root_module"}:
        fail("plan_configuration_fields")
    provider_config = config.get("provider_config")
    if not isinstance(provider_config, dict) or set(provider_config) != {"cloudflare"}:
        fail("plan_provider_config_closure")
    provider = _require_dict(
        provider_config["cloudflare"], "plan_provider_config_shape"
    )
    # OpenTofu 1.12.5 emits version_constraint for a provider configured by a
    # required_providers block; it does not emit Terraform's older alias or
    # expressions fields for this empty provider block.
    if set(provider) != {"name", "full_name", "version_constraint"}:
        fail("plan_provider_config_fields")
    if (
        provider.get("name") != "cloudflare"
        or provider.get("full_name") != RESOURCE_PROVIDER
        or provider.get("version_constraint") != "5.23.0"
    ):
        fail("plan_provider_config_identity")
    root = _require_dict(config.get("root_module"), "plan_configuration_root")
    if set(root) != {"resources", "outputs", "variables"}:
        fail("plan_configuration_root_fields")
    resources = root.get("resources")
    if not isinstance(resources, list):
        fail("plan_configuration_resources")
    addresses = [_resource_identity(resource, config=True) for resource in resources]
    if len(addresses) != len(set(addresses)) or sorted(addresses) != sorted(
        CONFIG_ADDRESSES
    ):
        fail("plan_configuration_resource_closure")
    for resource in resources:
        address = resource["address"]
        expressions = resource["expressions"]
        if set(expressions) != CONFIG_EXPRESSION_NAMES[address]:
            fail("plan_configuration_expression_closure")
        # _resource_identity already compares the full semantic expression
        # tree; this second walk rejects malformed marker/reference leaves.
        _validate_expression_map(expressions, f"plan_configuration.{address}")
    outputs = root["outputs"]
    if not isinstance(outputs, dict) or set(outputs) != set(OUTPUT_NAMES):
        fail("plan_configuration_outputs")
    for output_name, output in outputs.items():
        if not isinstance(output, dict) or set(output) != {
            "expression",
            "description",
        }:
            fail("plan_configuration_output_shape")
        expected = CONFIG_OUTPUT_EXPRESSIONS[output_name]
        if not _strict_equal(output["expression"], expected):
            fail("plan_configuration_output_semantics")
        if output.get("description") != CONFIG_OUTPUT_DESCRIPTIONS[output_name]:
            fail("plan_configuration_output_description")
        _validate_expression(
            output["expression"], f"plan_configuration.outputs.{output_name}"
        )
    variables = root["variables"]
    if not isinstance(variables, dict) or set(variables) != set(VARIABLE_NAMES):
        fail("plan_configuration_variables")
    for variable_name, variable in variables.items():
        if not isinstance(variable, dict) or not _strict_equal(
            variable, CONFIG_VARIABLES[variable_name]
        ):
            fail("plan_configuration_variable_semantics")
    _validate_markers(config, location="configuration")


def _validate_plan_provenance(plan_bytes: bytes, provenance_path: Path | str) -> None:
    receipt = _load_json(provenance_path)
    if not isinstance(receipt, dict) or set(receipt) != {
        "artifact",
        "artifact_sha256",
        "tofu_path",
        "tofu_sha256",
        "tofu_version",
        "provider",
        "provider_version",
        "source",
    }:
        fail("plan_provenance_fields")
    if receipt["artifact"] != "refresh-only-plan-json":
        fail("plan_provenance_artifact")
    digest = receipt["artifact_sha256"]
    if not isinstance(digest, str) or not re.fullmatch(r"[0-9a-f]{64}", digest):
        fail("plan_provenance_digest")
    if digest != hashlib.sha256(plan_bytes).hexdigest():
        fail("plan_provenance_digest_mismatch")
    if (
        receipt["tofu_path"] != TOFU_PATH
        or receipt["tofu_sha256"] != TOFU_SHA256
        or receipt["tofu_version"] != "1.12.5"
        or receipt["provider"] != "cloudflare"
        or receipt["provider_version"] != "5.23.0"
        or receipt["source"] != "pinned-cli-show-json"
    ):
        fail("plan_provenance_identity")
    _validate_markers(receipt, location="plan_provenance")


def _validate_plan(
    path: Path | str,
    provenance_path: Path | str,
    identity_source: Path | str,
) -> None:
    plan_bytes = _open_input(path)
    plan = _load_json_from_bytes(plan_bytes)
    _validate_plan_provenance(plan_bytes, provenance_path)
    identity = _load_state_identity(identity_source)
    if not isinstance(plan, dict):
        fail("plan_shape")
    allowed_top = {
        "format_version",
        "terraform_version",
        "variables",
        "planned_values",
        "resource_changes",
        "resource_drift",
        "deferred_changes",
        "output_changes",
        "prior_state",
        "configuration",
        "relevant_attributes",
        "checks",
        "errored",
        "complete",
        "timestamp",
    }
    if set(plan) - allowed_top:
        fail("plan_top_level_keys")
    required = {
        "format_version",
        "terraform_version",
        "variables",
        "planned_values",
        "output_changes",
        "prior_state",
        "configuration",
        "errored",
    }
    if not required.issubset(plan):
        fail("plan_required_fields")
    if plan.get("format_version") != "1.2":
        fail("plan_format_version")
    if plan.get("terraform_version") != "1.12.5":
        fail("plan_tofu_version")
    if plan.get("errored") is not False:
        fail("plan_errored")
    if "complete" in plan and plan["complete"] is not True:
        fail("plan_complete")
    if "timestamp" in plan and (
        not isinstance(plan["timestamp"], str)
        or not ISO_UTC_RE.fullmatch(plan["timestamp"])
    ):
        fail("plan_timestamp")
    for field in (
        "resource_changes",
        "resource_drift",
        "deferred_changes",
        "relevant_attributes",
    ):
        if field in plan and plan[field] not in (None, []):
            fail(f"plan_{field}")
    if "checks" in plan and plan["checks"] != []:
        fail("plan_checks")
    planned = _require_dict(plan["planned_values"], "plan_planned_values")
    if set(planned) - {"root_module", "outputs"}:
        fail("plan_planned_values_fields")
    root = _require_dict(planned.get("root_module"), "plan_planned_values_root_module")
    if root != {}:
        fail("plan_planned_values_root_module")
    _validate_output_surface(planned, "plan_planned_values")
    _validate_variables(plan["variables"])
    _validate_configuration(plan["configuration"])

    # The no-op output surface is only meaningful when both the planned values
    # and the exact prior-state projection are present.  An empty object here
    # would otherwise allow an arbitrary output_changes claim to pass.
    prior = plan["prior_state"]
    if not isinstance(prior, dict) or set(prior) != {
        "format_version",
        "terraform_version",
        "values",
    }:
        fail("plan_prior_state")
    if (
        prior.get("format_version") != "1.0"
        or prior.get("terraform_version") != "1.12.5"
    ):
        fail("plan_prior_state_version")
    prior_values = prior.get("values")
    if not isinstance(prior_values, dict) or set(prior_values) != {
        "outputs",
        "root_module",
    }:
        fail("plan_prior_state_values")
    prior_root = prior_values.get("root_module")
    if not isinstance(prior_root, dict) or set(prior_root) != {"resources"}:
        fail("plan_prior_state_root_module")
    prior_resources = prior_root.get("resources")
    if not isinstance(prior_resources, list) or len(prior_resources) != len(
        POST_ADDRESSES
    ):
        fail("plan_prior_state_resource_closure")
    prior_addresses = [_resource_identity(resource) for resource in prior_resources]
    if sorted(prior_addresses) != sorted(POST_ADDRESSES) or len(
        prior_addresses
    ) != len(set(prior_addresses)):
        fail("plan_prior_state_resource_closure")
    for resource in prior_resources:
        _validate_state_resource_projection(resource)
    _validate_state_identity_bindings(prior_resources, identity)
    _validate_output_surface(prior_values, "plan_prior_state")
    if not _strict_equal(planned["outputs"], prior_values["outputs"]):
        fail("plan_output_surface_mismatch")
    prior_resource_ids = frozenset(id(resource) for resource in prior_resources)
    _validate_markers(prior, location="prior_state", allowed_resource_ids=prior_resource_ids)
    outputs = plan["output_changes"]
    if not isinstance(outputs, dict) or set(outputs) != set(OUTPUT_NAMES):
        fail("plan_output_closure")
    for name in OUTPUT_NAMES:
        _validate_output_change(name, outputs[name])
    _validate_plan_output_bindings(outputs, planned, prior_values, prior_resources)
    _validate_markers(plan, allowed_resource_ids=prior_resource_ids)
    print(
        "state_scope=accepted phase=plan outputs=5 actions=no-op resource_changes=absent-or-empty configuration=7 variables=5"
    )


def _validator_timeout(_signum: int, _frame: Any) -> NoReturn:
    fail("validator_timeout")


def main() -> NoReturn:
    if len(sys.argv) == 3 and sys.argv[1] in {"pre", "post"}:
        _validate_address_list(sys.argv[1], Path(sys.argv[2]))
        raise SystemExit(0)
    if (
        len(sys.argv) == 5
        and sys.argv[1] in {"state", "state-json"}
        and sys.argv[2] in {"pre", "post"}
    ):
        # The identity profile and state JSON are both verified descriptors;
        # neither is reopened by pathname after the producer boundary.
        _validate_state_json(sys.argv[2], sys.argv[4], sys.argv[3])
        raise SystemExit(0)
    if (
        len(sys.argv) == 4
        and sys.argv[1] in {"state", "state-json"}
        and sys.argv[2] in {"pre", "post"}
    ):
        _validate_state_json(sys.argv[2], sys.argv[3])
        raise SystemExit(0)
    if len(sys.argv) == 3 and sys.argv[1] in {"state", "state-json"}:
        _validate_state_json("post", Path(sys.argv[2]))
        raise SystemExit(0)
    if (
        len(sys.argv) == 4
        and sys.argv[1] == "resource"
        and sys.argv[2] == "reactive_resume_dev_tailscale"
    ):
        _validate_resource_text(sys.argv[2], Path(sys.argv[3]))
        raise SystemExit(0)
    if len(sys.argv) == 5 and sys.argv[1] == "plan":
        _validate_plan(sys.argv[2], sys.argv[3], sys.argv[4])
        raise SystemExit(0)
    fail("usage")


if __name__ == "__main__":
    signal.signal(signal.SIGALRM, _validator_timeout)
    signal.setitimer(signal.ITIMER_REAL, VALIDATOR_TIMEOUT_SECONDS)
    try:
        main()
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
