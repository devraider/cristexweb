#!/usr/bin/python3
"""Validate exact protected foundation state scope and DNS resource metadata.

This helper consumes only mode-0600 temporary `tofu state list`/`state show`
results. It never opens the configured backend and never calls a provider.
"""
from __future__ import annotations

import os
import re
import stat
import sys
from pathlib import Path

PRE = (
    "cloudflare_dns_record.argocd_tailscale",
    "cloudflare_dns_record.cristexhub_dev",
    "cloudflare_dns_record.keycloak",
    "cloudflare_zero_trust_tunnel_cloudflared.keycloak",
    "cloudflare_zero_trust_tunnel_cloudflared_config.keycloak",
)
POST = PRE + ("cloudflare_dns_record.reactive_resume_dev_tailscale",)
ADDRESS = re.compile(r"^[a-z0-9_]+\.[a-z0-9_]+(?:\.[a-z0-9_]+)?$")


def fail(reason: str) -> "NoReturn":
    print(f"state_scope=refused reason={reason}")
    raise SystemExit(1)


if len(sys.argv) == 3 and sys.argv[1] in {"pre", "post"}:
    phase = sys.argv[1]
    path = Path(sys.argv[2])
elif len(sys.argv) == 4 and sys.argv[1] == "resource" and sys.argv[2] == "reactive_resume_dev_tailscale":
    phase = "resource"
    path = Path(sys.argv[3])
else:
    fail("usage")
try:
    info = path.lstat()
except OSError:
    fail("state_list_absent")
if not stat.S_ISREG(info.st_mode) or stat.S_ISLNK(info.st_mode):
    fail("state_list_type")
if stat.S_IMODE(info.st_mode) != 0o600 or info.st_uid != os.getuid():
    fail("state_list_permissions")
try:
    lines = path.read_text(encoding="utf-8").splitlines()
except (OSError, UnicodeError):
    fail("state_list_read")
if phase == "resource":
    text = "\n".join(lines)
    required = (
        'name = "resume-dev.cristex-soft.com"',
        'type = "A"',
        'content = "100.122.139.32"',
        "proxied = false",
        "ttl = 300",
    )
    if not all(item in text for item in required):
        fail("reactive_resume_dev_tailscale_contract")
    print("state_scope=accepted phase=resource address=reactive_resume_dev_tailscale")
    raise SystemExit(0)
expected = PRE if phase == "pre" else POST
if not lines or len(lines) != len(set(lines)):
    fail("state_list_duplicates_or_empty")
if any(not ADDRESS.fullmatch(line) for line in lines):
    fail("state_list_shape")
if sorted(lines) != sorted(expected):
    fail("state_address_closure")
print(f"state_scope=accepted phase={phase} addresses={len(expected)}")
