#!/bin/sh
set -eu
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
export PATH
state_parent=/var/lib/opentofu/cristexweb
state_file="$state_parent/github.tfstate"
recipient_file=/etc/cristexweb-backup/age.recipient
recipient_sha256=ce615905ec27fa6e085578d96e48dc798677b3f2ade5c417770f22e78248ad28
rclone_config=/home/paul/.config/rclone/rclone.conf
archive_root=/var/lib/cristexweb-backup/opentofu/github-absence
remote_root=drive:cristexweb-recovery/opentofu/github-absence
lock_file=/run/lock/cristexweb-opentofu-github-state-backup.lock
fail() { printf 'absence_status=failed stage=%s\n' "$1"; exit 1; }
check_parent() {
    [ -d "$state_parent" ] && [ ! -L "$state_parent" ] || fail parent_contract
    [ "$(/usr/bin/realpath -e -- "$state_parent")" = "$state_parent" ] || fail parent_symlink
    [ "$(/usr/bin/stat -c '%U:%G:%a' "$state_parent")" = 'paul:root:700' ] || fail parent_contract
}
check_absent() {
    [ ! -e "$state_file" ] && [ ! -L "$state_file" ] || fail state_present
}
check_parent
check_absent
[ -d "$archive_root" ] && [ ! -L "$archive_root" ] || fail archive_contract
[ "$(/usr/bin/realpath -e -- "$archive_root")" = "$archive_root" ] || fail archive_symlink
[ "$(/usr/bin/stat -c '%U:%G:%a' "$archive_root")" = 'paul:paul:700' ] || fail archive_contract
[ -f "$recipient_file" ] && [ ! -L "$recipient_file" ] || fail recipient_contract
[ "$(/usr/bin/stat -c '%U:%G:%a' "$recipient_file")" = 'root:paul:640' ] || fail recipient_contract
[ "$(/usr/bin/sha256sum "$recipient_file" | /usr/bin/cut -d ' ' -f1)" = "$recipient_sha256" ] || fail recipient_contract
recipient=$(/usr/bin/tr -d '\n' <"$recipient_file")
printf '%s\n' "$recipient" | /usr/bin/grep -Eq '^age1[0-9a-z]+$' || fail recipient_contract
[ -f "$rclone_config" ] && [ ! -L "$rclone_config" ] || fail rclone_config_contract
[ "$(/usr/bin/stat -c '%U:%G:%a' "$rclone_config")" = 'paul:paul:600' ] || fail rclone_config_contract
configured_remotes=$(/usr/local/bin/rclone --config "$rclone_config" listremotes --long) || fail rclone_backend
[ "$configured_remotes" = 'drive: drive' ] || fail rclone_backend
exec 9>"$lock_file"
/usr/bin/flock -n 9 || { printf '%s\n' 'absence_status=refused reason=concurrent_run'; exit 75; }
now_epoch=$(/usr/bin/date -u +%s)
timestamp=$(/usr/bin/date -u -d "@$now_epoch" +%Y%m%dT%H%M%SZ)
expires=$(/usr/bin/date -u -d "@$((now_epoch + 900))" +%Y%m%dT%H%M%SZ)
run_directory="$archive_root/$timestamp"
remote_directory="$remote_root/$timestamp"
[ ! -e "$run_directory" ] || { printf '%s\n' 'absence_status=refused reason=local_timestamp_collision'; exit 73; }
/usr/bin/install -d -m 0700 "$run_directory"
work="$run_directory/absence-attestation.json"
readback=
cleanup() { [ -z "$readback" ] || /usr/bin/rm -rf -- "$readback"; /usr/bin/rm -f -- "$work"; }
trap cleanup EXIT HUP INT TERM
/usr/bin/printf '{"schema":1,"service":"opentofu-github","artifact":"absence-attestation","state_path":"/var/lib/opentofu/cristexweb/github.tfstate","state_present":false,"parent_path":"/var/lib/opentofu/cristexweb","parent_realpath":"/var/lib/opentofu/cristexweb","parent_owner":"paul","parent_group":"root","parent_mode":"0700","attested_at_utc":"%s","expires_at_utc":"%s"}\n' "$timestamp" "$expires" >"$work"
/usr/bin/age -r "$recipient" -o "$run_directory/absence-attestation.json.age" "$work"
(cd "$run_directory" && /usr/bin/sha256sum absence-attestation.json.age >absence-attestation.json.age.sha256)
archive_bytes=$(/usr/bin/stat -c %s "$run_directory/absence-attestation.json.age")
archive_sha256=$(/usr/bin/cut -d ' ' -f1 "$run_directory/absence-attestation.json.age.sha256")
/usr/bin/printf '{"schema":1,"service":"opentofu-github","artifact":"absence-attestation","state":"github.tfstate","created_at_utc":"%s","expires_at_utc":"%s","archive":"absence-attestation.json.age","archive_bytes":%s,"archive_sha256":"%s","encryption":"age-x25519","state_path":"/var/lib/opentofu/cristexweb/github.tfstate","state_present":false}\n' "$timestamp" "$expires" "$archive_bytes" "$archive_sha256" >"$run_directory/manifest.json"
/usr/local/bin/rclone --config "$rclone_config" copyto --immutable "$run_directory/absence-attestation.json.age" "$remote_directory/absence-attestation.json.age"
/usr/local/bin/rclone --config "$rclone_config" copyto --immutable "$run_directory/absence-attestation.json.age.sha256" "$remote_directory/absence-attestation.json.age.sha256"
/usr/local/bin/rclone --config "$rclone_config" copyto --immutable "$run_directory/manifest.json" "$remote_directory/manifest.json"
readback=$(/usr/bin/mktemp -d "$run_directory/.readback.XXXXXX")
for leaf in absence-attestation.json.age absence-attestation.json.age.sha256 manifest.json; do /usr/local/bin/rclone --config "$rclone_config" copyto "$remote_directory/$leaf" "$readback/$leaf"; /usr/bin/cmp -s "$run_directory/$leaf" "$readback/$leaf" || fail readback; done
/usr/bin/rm -rf -- "$readback" "$work"
check_parent
check_absent
/usr/bin/find "$archive_root" -mindepth 1 -maxdepth 1 -type d -mtime +14 -name '20[0-9][0-9][01][0-9][0-3][0-9]T[0-2][0-9][0-5][0-9][0-5][0-9]Z' -exec /usr/bin/rm -rf -- {} +
printf 'absence_status=success service=opentofu-github artifact=absence-attestation state=github timestamp=%s readback=verified state_absent=verified encrypted=true expires_at=%s\n' "$timestamp" "$expires"
