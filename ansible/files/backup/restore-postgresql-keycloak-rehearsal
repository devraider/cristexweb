#!/bin/sh
set -eu

if [ "${CRISTEXWEB_RESTORE_TIMEOUT_GUARD:-}" != 1 ]; then
  export CRISTEXWEB_RESTORE_TIMEOUT_GUARD=1
  exec /usr/bin/timeout --foreground --kill-after=30s 3600 "$0" "$@"
fi
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
export PATH KUBECONFIG=/etc/rancher/k3s/k3s.yaml K3S_CONFIG_FILE=/dev/null

project_id=619656da-14f3-4872-857b-be103cdc5326
infisical_path=/shared-services/backup-recovery
remote_root=drive:cristexweb-recovery/postgresql/keycloak
source_closure_sha256=c05afb66756249152de4a5a289adc643b3a484db0fbc03eb6ed90606ba67dbe7
printf '%s' "$source_closure_sha256" | /usr/bin/grep -Eq '^[0-9a-f]{64}$' || {
  printf '%s\n' 'restore_status=failed stage=source_closure_contract'
  exit 1
}
rclone_config=/home/paul/.config/rclone/rclone.conf
namespace=shared-services
image='docker.io/library/postgres:17.10@sha256:dbbeb22a65db2503050cdbbe5e78f017478f10a1002a226463f049dbb017e99b'
run_id=$(/usr/bin/date -u +%Y%m%dt%H%M%Sz | /usr/bin/tr '[:upper:]' '[:lower:]')-$$
pod=keycloak-restore-rehearsal-$run_id
work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-keycloak-restore.XXXXXX)
uid=
restore_label=keycloak-restore-rehearsal
discover_restore_pod() {
  discovery="$work/pod-discovery"
  if ! /usr/local/bin/kubectl -n "$namespace" get pods \
      -l "app.kubernetes.io/name=$restore_label,cristex.io/run-id=$run_id" \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.uid}{"\n"}{end}' >"$discovery"; then
    return 1
  fi
  discovered_count=0
  discovered_name=
  discovered_uid=
  while IFS='	' read -r candidate_name candidate_uid; do
    [ -n "$candidate_name" ] || continue
    discovered_count=$((discovered_count + 1))
    [ "$candidate_name" = "$pod" ] || return 1
    [ -n "$candidate_uid" ] || return 1
    discovered_name="$candidate_name"
    discovered_uid="$candidate_uid"
  done <"$discovery"
  if [ "$discovered_count" -eq 0 ]; then
    return 0
  fi
  [ "$discovered_count" -eq 1 ] && [ "$discovered_name" = "$pod" ] || return 1
  uid="$discovered_uid"
}
delete_restore_pod() {
  if [ -z "$uid" ]; then
    discover_restore_pod || return 1
    [ "$discovered_count" -eq 0 ] && return 0
  fi
  if ! current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}'); then
    return 1
  fi
  [ -z "$current_uid" ] && { uid=; return 0; }
  [ "$current_uid" = "$uid" ] || return 1
  if ! current_owner=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.labels.app\\.kubernetes\\.io/name}'); then
    return 1
  fi
  if ! current_run_id=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.labels.cristex\\.io/run-id}'); then
    return 1
  fi
  [ "$current_owner" = "$restore_label" ] && [ "$current_run_id" = "$run_id" ] || return 1
  /usr/bin/printf '{"kind":"DeleteOptions","apiVersion":"v1","propagationPolicy":"Orphan","preconditions":{"uid":"%s"}}\n' "$uid" >"$work/delete.json"
  /usr/local/bin/kubectl delete --raw "/api/v1/namespaces/$namespace/pods/$pod" -f "$work/delete.json" >/dev/null
  if ! /usr/local/bin/kubectl -n "$namespace" wait --for=delete "pod/$pod" --timeout=120s >/dev/null 2>&1; then
    if ! current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}'); then
      return 1
    fi
    [ -z "$current_uid" ] || return 1
  fi
  if ! current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}'); then
    return 1
  fi
  [ -z "$current_uid" ] || return 1
  uid=
}
cleanup() {
  trap - EXIT HUP INT TERM
  cleanup_status=0
  delete_restore_pod || cleanup_status=1
  /usr/bin/rm -rf -- "$work" || cleanup_status=1
  if [ "$cleanup_status" -ne 0 ]; then
    printf '%s\n' 'restore_status=failed stage=cleanup' >&2
    exit 1
  fi
}
trap cleanup EXIT HUP INT TERM
chmod 0700 "$work"
archive_leaf=keycloak.dump.gz.age
checksum_leaf=keycloak.dump.gz.age.sha256
select_latest_complete_catalog() {
  expected="$work/expected-leaves"
  expected_sorted="$work/expected-leaves.sorted"
  catalog="$work/catalog-dirs"
  valid="$work/catalog-valid"
  printf '%s\n' "$archive_leaf" "$checksum_leaf" manifest.json >"$expected"
  if ! LC_ALL=C /usr/bin/sort "$expected" >"$expected_sorted"; then
    return 1
  fi
  if ! /usr/local/bin/rclone --config "$rclone_config" lsf --dirs-only "$remote_root" >"$catalog"; then
    return 1
  fi
  : >"$valid"
  latest=
  while IFS='	' read -r raw; do
    candidate=${raw%/}
    [ -n "$candidate" ] || continue
    printf '%s\n' "$candidate" >"$work/catalog-candidate"
    /usr/bin/grep -Eq '^20[0-9]{6}T[0-9]{6}Z$' "$work/catalog-candidate" || continue
    if /usr/bin/grep -Fxq "$candidate" "$valid"; then
      return 1
    fi
    printf '%s\n' "$candidate" >>"$valid"
    listing="$work/catalog-$candidate"
    if ! /usr/local/bin/rclone --config "$rclone_config" lsf --files-only "$remote_root/$candidate" >"$listing"; then
      return 1
    fi
    sorted="$work/catalog-$candidate.sorted"
    if ! LC_ALL=C /usr/bin/sort "$listing" >"$sorted"; then
      return 1
    fi
    if /usr/bin/cmp -s "$sorted" "$expected_sorted"; then
      if [ -z "$latest" ] || [ "$candidate" \> "$latest" ]; then
        latest="$candidate"
      fi
    fi
  done <"$catalog"
  [ -n "$latest" ]
}
if ! select_latest_complete_catalog; then
  printf '%s\n' 'restore_status=failed stage=remote_catalog'
  exit 1
fi
remote="$remote_root/$latest"
for leaf in keycloak.dump.gz.age keycloak.dump.gz.age.sha256 manifest.json; do
  /usr/local/bin/rclone --config "$rclone_config" copyto "$remote/$leaf" "$work/$leaf"
done
(cd "$work" && /usr/bin/sha256sum -c keycloak.dump.gz.age.sha256 >/dev/null)
expected_sha=$(/usr/bin/cut -d ' ' -f 1 "$work/keycloak.dump.gz.age.sha256")
archive_bytes=$(/usr/bin/stat -c %s "$work/keycloak.dump.gz.age")
if ! FILE="$work/manifest.json" TIMESTAMP="$latest" EXPECTED_SHA="$expected_sha" ARCHIVE_BYTES="$archive_bytes" EXPECTED_SOURCE_CLOSURE_SHA256="$source_closure_sha256" /usr/bin/python3 - <<'PY'
import json,os,re
x=json.load(open(os.environ['FILE']))
assert set(x)=={'schema','service','database','created_at_utc','archive','archive_bytes','archive_sha256','encryption','source_cluster','source_closure_sha256'}
assert x['schema']==1 and x['service']=='postgresql' and x['database']=='keycloak'
assert x['created_at_utc']==os.environ['TIMESTAMP'] and x['archive']=='keycloak.dump.gz.age'
assert x['encryption']=='age-x25519' and x['source_cluster']=='shared-postgresql'
assert x['archive_sha256']==os.environ['EXPECTED_SHA']
assert x['archive_bytes']==int(os.environ['ARCHIVE_BYTES'])
assert re.fullmatch(r'[0-9a-f]{64}', x['source_closure_sha256'])
assert x['source_closure_sha256']==os.environ['EXPECTED_SOURCE_CLOSURE_SHA256']
PY
then
  printf '%s\n' 'restore_status=failed stage=manifest_contract'
  exit 1
fi
/home/paul/.nvm/versions/node/v24.19.0/bin/infisical secrets get SHARED_DATABASE_BACKUP_AGE_IDENTITY \
  --projectId "$project_id" --env prod --path "$infisical_path" --plain --silent >"$work/identity"
chmod 0600 "$work/identity"
/usr/bin/age -d -i "$work/identity" "$work/keycloak.dump.gz.age" >"$work/keycloak.dump.gz" || {
  printf '%s\n' 'restore_status=failed stage=keycloak_decrypt' >&2
  exit 1
}
/usr/bin/gzip -d -c "$work/keycloak.dump.gz" >"$work/keycloak.dump" || {
  printf '%s\n' 'restore_status=failed stage=keycloak_decompress' >&2
  exit 1
}
/usr/bin/rm -f -- "$work/keycloak.dump.gz" "$work/identity"
[ -s "$work/keycloak.dump" ]
/usr/bin/rm -f -- "$work/identity"

cat >"$work/pod.yaml" <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: $pod
  namespace: $namespace
  labels:
    app.kubernetes.io/name: keycloak-restore-rehearsal
    cristex.io/run-id: $run_id
spec:
  automountServiceAccountToken: false
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 999
    runAsGroup: 999
    fsGroup: 999
    seccompProfile:
      type: RuntimeDefault
  initContainers:
    - name: initialize-data-permissions
      image: $image
      imagePullPolicy: IfNotPresent
      command: ["/bin/sh", "-ec", "chown 999:999 /var/lib/postgresql/data && chmod 0700 /var/lib/postgresql/data"]
      securityContext:
        runAsNonRoot: false
        runAsUser: 0
        runAsGroup: 0
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
          add: ["CHOWN", "FOWNER"]
      resources:
        requests: {cpu: 10m, memory: 32Mi}
        limits: {cpu: 100m, memory: 64Mi}
      volumeMounts:
        - {name: data, mountPath: /var/lib/postgresql/data}
  containers:
    - name: postgres
      image: $image
      imagePullPolicy: IfNotPresent
      args: ["-c", "listen_addresses="]
      env:
        - name: POSTGRES_HOST_AUTH_METHOD
          value: trust
        - name: POSTGRES_DB
          value: keycloak_restore
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
      resources:
        requests: {cpu: 100m, memory: 256Mi}
        limits: {cpu: "1", memory: 1Gi}
      volumeMounts:
        - {name: data, mountPath: /var/lib/postgresql/data}
        - {name: transfer, mountPath: /restore}
      readinessProbe:
        exec:
          command: ["/usr/bin/pg_isready", "-h", "/var/run/postgresql", "-d", "keycloak_restore"]
        periodSeconds: 2
        failureThreshold: 60
  volumes:
    - name: data
      emptyDir: {}
    - name: transfer
      emptyDir: {}
EOF
/usr/local/bin/kubectl apply -f "$work/pod.yaml" >/dev/null
if ! uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" -o jsonpath='{.metadata.uid}'); then
  uid=
fi
if [ -z "$uid" ]; then
  discover_restore_pod || {
    printf '%s\n' 'restore_status=failed stage=pod_uid_discovery' >&2
    exit 1
  }
fi
[ -n "$uid" ] || {
  printf '%s\n' 'restore_status=failed stage=pod_uid_discovery' >&2
  exit 1
}
/usr/local/bin/kubectl -n "$namespace" wait --for=condition=Ready "pod/$pod" --timeout=180s >/dev/null
/usr/local/bin/kubectl -n "$namespace" cp "$work/keycloak.dump" "$pod:/restore/keycloak.dump" -c postgres >/dev/null
/usr/local/bin/kubectl -n "$namespace" exec "$pod" -c postgres -- \
  /usr/bin/pg_restore --exit-on-error --no-owner --no-privileges --dbname=keycloak_restore /restore/keycloak.dump >/dev/null
catalog_count=$(/usr/local/bin/kubectl -n "$namespace" exec "$pod" -c postgres -- \
  /usr/bin/psql --no-psqlrc --tuples-only --no-align --dbname=keycloak_restore \
  --command="SELECT count(*) FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog','information_schema');")
printf '%s\n' "$catalog_count" | /usr/bin/grep -Eq '^[0-9]+$'
/usr/bin/rm -f -- "$work/keycloak.dump"
delete_restore_pod
printf 'restore_status=success schema=1 source_timestamp=%s source_closure_sha256=%s target=isolated-emptydir catalog_table_count=%s checksum=verified private_residue=none\n' "$latest" "$source_closure_sha256" "$catalog_count"
