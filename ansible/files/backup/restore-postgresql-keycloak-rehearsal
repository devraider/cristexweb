#!/bin/sh
set -eu

if [ "${CRISTEXWEB_RESTORE_TIMEOUT_GUARD:-}" != 1 ]; then
  export CRISTEXWEB_RESTORE_TIMEOUT_GUARD=1
  exec /usr/bin/timeout --foreground --kill-after=30s 3600 "$0" "$@"
fi
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
export PATH KUBECONFIG=/etc/rancher/k3s/k3s.yaml K3S_CONFIG_FILE=/dev/null

project_id=619656da-14f3-4872-857b-be103cdc5326
infisical_path=/shared-services/backup-recovery
remote_root=drive:cristexweb-recovery/postgresql/keycloak
rclone_config=/home/paul/.config/rclone/rclone.conf
namespace=shared-services
image='docker.io/library/postgres:17.10@sha256:dbbeb22a65db2503050cdbbe5e78f017478f10a1002a226463f049dbb017e99b'
run_id=$(/usr/bin/date -u +%Y%m%dt%H%M%Sz | /usr/bin/tr '[:upper:]' '[:lower:]')-$$
pod=keycloak-restore-rehearsal-$run_id
work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-keycloak-restore.XXXXXX)
uid=
delete_restore_pod() {
  [ -n "$uid" ] || return 0
  current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" -o jsonpath='{.metadata.uid}' 2>/dev/null || true)
  [ "$current_uid" = "$uid" ] || return 1
  /usr/bin/printf '{"kind":"DeleteOptions","apiVersion":"v1","propagationPolicy":"Orphan","preconditions":{"uid":"%s"}}\n' "$uid" >"$work/delete.json"
  /usr/local/bin/kubectl delete --raw "/api/v1/namespaces/$namespace/pods/$pod" -f "$work/delete.json" >/dev/null
  /usr/local/bin/kubectl -n "$namespace" wait --for=delete "pod/$pod" --timeout=120s >/dev/null 2>&1 || true
  [ -z "$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" -o name 2>/dev/null || true)" ]
  uid=
}
cleanup() {
  delete_restore_pod >/dev/null 2>&1 || true
  /usr/bin/rm -rf -- "$work"
}
trap cleanup EXIT HUP INT TERM
chmod 0700 "$work"

latest=$(/usr/local/bin/rclone --config "$rclone_config" lsf --dirs-only "$remote_root" | /usr/bin/sort | /usr/bin/tail -1 | /usr/bin/tr -d '/')
printf '%s\n' "$latest" | /usr/bin/grep -Eq '^20[0-9]{6}T[0-9]{6}Z$' || {
  printf '%s\n' 'restore_status=failed stage=remote_catalog'
  exit 1
}
remote="$remote_root/$latest"
for leaf in keycloak.dump.gz.age keycloak.dump.gz.age.sha256 manifest.json; do
  /usr/local/bin/rclone --config "$rclone_config" copyto "$remote/$leaf" "$work/$leaf"
done
(cd "$work" && /usr/bin/sha256sum -c keycloak.dump.gz.age.sha256 >/dev/null)
FILE="$work/manifest.json" TIMESTAMP="$latest" /usr/bin/python3 - <<'PY'
import json,os
x=json.load(open(os.environ['FILE']))
assert set(x)=={'schema','service','database','created_at_utc','archive','archive_bytes','archive_sha256','encryption','source_cluster'}
assert x['schema']==1 and x['service']=='postgresql' and x['database']=='keycloak'
assert x['created_at_utc']==os.environ['TIMESTAMP'] and x['archive']=='keycloak.dump.gz.age'
assert x['encryption']=='age-x25519' and x['source_cluster']=='shared-postgresql'
PY
/home/paul/.nvm/versions/node/v24.19.0/bin/infisical secrets get SHARED_DATABASE_BACKUP_AGE_IDENTITY \
  --projectId "$project_id" --env prod --path "$infisical_path" --plain --silent >"$work/identity"
chmod 0600 "$work/identity"
/usr/bin/age -d -i "$work/identity" "$work/keycloak.dump.gz.age" | /usr/bin/gzip -d >"$work/keycloak.dump"
[ -s "$work/keycloak.dump" ]
/usr/bin/rm -f -- "$work/identity"

cat >"$work/pod.yaml" <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: $pod
  namespace: $namespace
  labels:
    app.kubernetes.io/name: keycloak-restore-rehearsal
    cristex.io/run-id: $run_id
spec:
  automountServiceAccountToken: false
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 999
    runAsGroup: 999
    fsGroup: 999
    seccompProfile:
      type: RuntimeDefault
  initContainers:
    - name: initialize-data-permissions
      image: $image
      imagePullPolicy: IfNotPresent
      command: ["/bin/sh", "-ec", "chown 999:999 /var/lib/postgresql/data && chmod 0700 /var/lib/postgresql/data"]
      securityContext:
        runAsNonRoot: false
        runAsUser: 0
        runAsGroup: 0
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
          add: ["CHOWN", "FOWNER"]
      resources:
        requests: {cpu: 10m, memory: 32Mi}
        limits: {cpu: 100m, memory: 64Mi}
      volumeMounts:
        - {name: data, mountPath: /var/lib/postgresql/data}
  containers:
    - name: postgres
      image: $image
      imagePullPolicy: IfNotPresent
      args: ["-c", "listen_addresses="]
      env:
        - name: POSTGRES_HOST_AUTH_METHOD
          value: trust
        - name: POSTGRES_DB
          value: keycloak_restore
      securityContext:
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
      resources:
        requests: {cpu: 100m, memory: 256Mi}
        limits: {cpu: "1", memory: 1Gi}
      volumeMounts:
        - {name: data, mountPath: /var/lib/postgresql/data}
        - {name: transfer, mountPath: /restore}
      readinessProbe:
        exec:
          command: ["/usr/bin/pg_isready", "-h", "/var/run/postgresql", "-d", "keycloak_restore"]
        periodSeconds: 2
        failureThreshold: 60
  volumes:
    - name: data
      emptyDir: {}
    - name: transfer
      emptyDir: {}
EOF
/usr/local/bin/kubectl apply -f "$work/pod.yaml" >/dev/null
uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" -o jsonpath='{.metadata.uid}')
[ -n "$uid" ]
/usr/local/bin/kubectl -n "$namespace" wait --for=condition=Ready "pod/$pod" --timeout=180s >/dev/null
/usr/local/bin/kubectl -n "$namespace" cp "$work/keycloak.dump" "$pod:/restore/keycloak.dump" -c postgres >/dev/null
/usr/local/bin/kubectl -n "$namespace" exec "$pod" -c postgres -- \
  /usr/bin/pg_restore --exit-on-error --no-owner --no-privileges --dbname=keycloak_restore /restore/keycloak.dump >/dev/null
catalog_count=$(/usr/local/bin/kubectl -n "$namespace" exec "$pod" -c postgres -- \
  /usr/bin/psql --no-psqlrc --tuples-only --no-align --dbname=keycloak_restore \
  --command="SELECT count(*) FROM information_schema.tables WHERE table_schema NOT IN ('pg_catalog','information_schema');")
printf '%s\n' "$catalog_count" | /usr/bin/grep -Eq '^[0-9]+$'
/usr/bin/rm -f -- "$work/keycloak.dump"
delete_restore_pod
printf 'restore_status=success source_timestamp=%s target=isolated-emptydir catalog_table_count=%s checksum=verified private_residue=none\n' "$latest" "$catalog_count"
