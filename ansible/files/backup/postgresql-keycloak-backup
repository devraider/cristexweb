#!/bin/sh
set -eu
umask 077

PATH=/usr/local/bin:/usr/bin:/bin
export PATH KUBECONFIG=/etc/rancher/k3s/k3s.yaml K3S_CONFIG_FILE=/dev/null

namespace=shared-services
cluster=shared-postgresql
database=keycloak
recipient_file=/etc/cristexweb-backup/age.recipient
recipient_sha256=ce615905ec27fa6e085578d96e48dc798677b3f2ade5c417770f22e78248ad28
source_closure_sha256=9f19846c97ba16dcf7e394f430b4ac93c1c00a0113a95dddca74787d9518d3c9
printf '%s' "$source_closure_sha256" | /usr/bin/grep -Eq '^[0-9a-f]{64}$' || {
  printf '%s\n' 'backup_status=failed stage=source_closure_contract'
  exit 1
}
rclone_config=/home/paul/.config/rclone/rclone.conf
archive_root=/var/lib/cristexweb-backup/postgresql/keycloak
remote_root=drive:cristexweb-recovery/postgresql/keycloak
lock_file=/run/lock/cristexweb-postgresql-keycloak-backup.lock

exec 9>"$lock_file"
/usr/bin/flock -n 9 || {
  printf '%s\n' 'backup_status=refused reason=concurrent_run'
  exit 75
}

[ -f "$recipient_file" ] && [ ! -L "$recipient_file" ] || {
  printf '%s\n' 'backup_status=failed stage=recipient_metadata'
  exit 1
}
[ "$(/usr/bin/sha256sum "$recipient_file" | /usr/bin/cut -d ' ' -f 1)" = "$recipient_sha256" ] || {
  printf '%s\n' 'backup_status=failed stage=recipient_hash'
  exit 1
}
recipient=$(/usr/bin/tr -d '\n' <"$recipient_file")
printf '%s\n' "$recipient" | /usr/bin/grep -Eq '^age1[0-9a-z]+$' || {
  printf '%s\n' 'backup_status=failed stage=recipient_contract'
  exit 1
}
[ -f "$rclone_config" ] && [ ! -L "$rclone_config" ] &&
  [ "$(/usr/bin/stat -c '%U:%G:%a' "$rclone_config")" = 'paul:paul:600' ] || {
  printf '%s\n' 'backup_status=failed stage=rclone_config_contract'
  exit 1
}

primary=$(/usr/local/bin/kubectl -n "$namespace" get cluster "$cluster" -o jsonpath='{.status.currentPrimary}')
printf '%s\n' "$primary" | /usr/bin/grep -Eq '^shared-postgresql-[1-9][0-9]*$' || {
  printf '%s\n' 'backup_status=failed stage=primary_contract'
  exit 1
}
ready=$(/usr/local/bin/kubectl -n "$namespace" get pod "$primary" -o jsonpath='{.status.containerStatuses[?(@.name=="postgres")].ready}')
[ "$ready" = true ] || {
  printf '%s\n' 'backup_status=failed stage=primary_readiness'
  exit 1
}

timestamp=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
run_directory="$archive_root/$timestamp"
remote_directory="$remote_root/$timestamp"
[ ! -e "$run_directory" ] || {
  printf '%s\n' 'backup_status=refused reason=local_timestamp_collision'
  exit 73
}
/usr/bin/install -d -m 0700 "$run_directory"
cleanup_plaintext() {
  /usr/bin/rm -f -- "$run_directory/keycloak.dump" "$run_directory/keycloak.dump.gz"
}
trap cleanup_plaintext EXIT HUP INT TERM

start_epoch=$(/usr/bin/date +%s)
/usr/local/bin/kubectl -n "$namespace" exec "$primary" -c postgres -- \
  /usr/bin/pg_dump --format=custom --compress=0 --no-owner --no-privileges \
  --dbname="$database" >"$run_directory/keycloak.dump"
[ -s "$run_directory/keycloak.dump" ] || {
  printf '%s\n' 'backup_status=failed stage=pg_dump_empty'
  exit 1
}
/usr/bin/gzip -9 -c "$run_directory/keycloak.dump" >"$run_directory/keycloak.dump.gz"
/usr/bin/age -r "$recipient" -o "$run_directory/keycloak.dump.gz.age" "$run_directory/keycloak.dump.gz"
/usr/bin/rm -f -- "$run_directory/keycloak.dump.gz"
cleanup_plaintext
trap - EXIT HUP INT TERM
(cd "$run_directory" && /usr/bin/sha256sum keycloak.dump.gz.age >keycloak.dump.gz.age.sha256)
archive_bytes=$(/usr/bin/stat -c %s "$run_directory/keycloak.dump.gz.age")
archive_sha256=$(/usr/bin/cut -d ' ' -f 1 "$run_directory/keycloak.dump.gz.age.sha256")
end_epoch=$(/usr/bin/date +%s)
duration_seconds=$((end_epoch - start_epoch))
/usr/bin/printf '{"schema":1,"service":"postgresql","database":"keycloak","created_at_utc":"%s","archive":"keycloak.dump.gz.age","archive_bytes":%s,"archive_sha256":"%s","encryption":"age-x25519","source_cluster":"shared-postgresql","source_closure_sha256":"%s"}\n' \
  "$timestamp" "$archive_bytes" "$archive_sha256" "$source_closure_sha256" >"$run_directory/manifest.json"

for leaf in keycloak.dump.gz.age keycloak.dump.gz.age.sha256 manifest.json; do
  /usr/local/bin/rclone --config "$rclone_config" copyto --immutable \
    "$run_directory/$leaf" "$remote_directory/$leaf"
done

readback=$(/usr/bin/mktemp -d "$run_directory/.readback.XXXXXX")
cleanup_readback() { /usr/bin/rm -rf -- "$readback"; }
trap cleanup_readback EXIT HUP INT TERM
for leaf in keycloak.dump.gz.age keycloak.dump.gz.age.sha256 manifest.json; do
  /usr/local/bin/rclone --config "$rclone_config" copyto \
    "$remote_directory/$leaf" "$readback/$leaf"
  /usr/bin/cmp -s "$run_directory/$leaf" "$readback/$leaf" || {
    printf 'backup_status=failed stage=readback leaf=%s\n' "$leaf"
    exit 1
  }
done
cleanup_readback
trap - EXIT HUP INT TERM

/usr/bin/find "$archive_root" -mindepth 1 -maxdepth 1 -type d -mtime +14 \
  -name '20[0-9][0-9][01][0-9][0-3][0-9]T[0-2][0-9][0-5][0-9][0-5][0-9]Z' \
  -exec /usr/bin/rm -rf -- {} +
printf 'backup_status=success schema=1 service=postgresql database=keycloak timestamp=%s archive_bytes=%s duration_seconds=%s readback=verified private_residue=none source_closure_sha256=%s\n' \
  "$timestamp" "$archive_bytes" "$duration_seconds" "$source_closure_sha256"
