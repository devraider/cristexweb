#!/bin/sh
set -eu
umask 077

PATH=/usr/local/bin:/usr/bin:/bin
export PATH KUBECONFIG=/etc/rancher/k3s/k3s.yaml K3S_CONFIG_FILE=/dev/null

namespace=shared-services
cluster=shared-postgresql
database=reactive_resume_dev_successor
object_statefulset=reactive-resume-object-storage
object_pod=reactive-resume-object-storage-0
object_service=reactive-resume-object-storage
object_bucket=reactive-resume-dev
object_tls_secret=reactive-resume-object-storage-tls
object_auth_secret=reactive-resume-object-storage-auth
recipient_file=/etc/cristexweb-backup/age.recipient
recipient_sha256=ce615905ec27fa6e085578d96e48dc798677b3f2ade5c417770f22e78248ad28
shm_path=/dev/shm
shm_reserve_bytes=268435456
shm_min_free_bytes=67108864
rclone_config=/home/paul/.config/rclone/rclone.conf
archive_root=/var/lib/cristexweb-backup/reactive-resume/dev
remote_root=drive:cristexweb-recovery/reactive-resume/dev
lock_file=/run/lock/cristexweb-reactive-resume-dev-backup.lock
rclone_image='rclone/rclone:1.71.1@sha256:e99b4361672a8e5b41b557979b780a85797aef45a7da49629ad99cd39c59deae'

fail() { printf 'backup_status=failed stage=%s\n' "$1" >&2; exit 1; }
shm_capacity_preflight() {
  /usr/bin/python3 - "$shm_path" "$shm_reserve_bytes" "$shm_min_free_bytes" "$@" <<'PY'
import os
import sys
path, reserve, minimum, factor, *sizes = sys.argv[1:]
reserve = int(reserve)
minimum = int(minimum)
factor = int(factor)
required = max(minimum, reserve + factor * sum(int(value) for value in sizes))
stat = os.statvfs(path)
available = stat.f_bavail * stat.f_frsize
if available < required:
    raise SystemExit(1)
PY
}
[ "$#" -eq 1 ] && [ "$1" = backup ] || {
  printf '%s\n' 'usage: reactive-resume-dev-backup backup' >&2
  exit 64
}
[ "$(id -u)" -ne 0 ] || fail non_root_operator_required

exec 9>"$lock_file"
/usr/bin/flock -n 9 || {
  printf '%s\n' 'backup_status=refused reason=concurrent_run'
  exit 75
}

[ -f "$recipient_file" ] && [ ! -L "$recipient_file" ] || fail recipient_metadata
[ "$(/usr/bin/stat -c '%U:%G:%a' "$recipient_file")" = 'root:paul:640' ] || fail recipient_metadata
recipient_digest=$(/usr/bin/sha256sum "$recipient_file")
recipient_digest=${recipient_digest%% *}
[ "$recipient_digest" = "$recipient_sha256" ] || fail recipient_hash
recipient=$(/usr/bin/tr -d '\n' <"$recipient_file")
case "$recipient" in
  age1[0-9a-z]*) ;;
  *) fail recipient_contract ;;
esac

[ -f "$rclone_config" ] && [ ! -L "$rclone_config" ] || fail rclone_config_metadata
[ "$(/usr/bin/stat -c '%U:%G:%a' "$rclone_config")" = 'paul:paul:600' ] || fail rclone_config_metadata
remotes=$(/usr/local/bin/rclone --config "$rclone_config" listremotes --long)
[ "$remotes" = 'drive: drive' ] || fail rclone_remote_contract

primary=$(/usr/local/bin/kubectl -n "$namespace" get cluster "$cluster" -o jsonpath='{.status.currentPrimary}')
case "$primary" in
  shared-postgresql-*) ;;
  *) fail postgresql_primary_contract ;;
esac
primary_suffix=${primary#shared-postgresql-}
case "$primary_suffix" in
  ''|0*|*[!0-9]*) fail postgresql_primary_contract ;;
esac
primary_contract=$(/usr/local/bin/kubectl -n "$namespace" get pod "$primary" -o jsonpath='{.metadata.labels.cnpg\.io/cluster}:{.metadata.labels.cnpg\.io/instanceRole}:{.status.containerStatuses[?(@.name=="postgres")].ready}')
[ "$primary_contract" = 'shared-postgresql:primary:true' ] || fail postgresql_readiness

object_phase=$(/usr/local/bin/kubectl -n "$namespace" get statefulset "$object_statefulset" -o jsonpath='{.status.readyReplicas}:{.spec.replicas}')
[ "$object_phase" = '1:1' ] || fail object_storage_statefulset
object_ready=$(/usr/local/bin/kubectl -n "$namespace" get pod "$object_pod" -o jsonpath='{.status.phase}:{.status.containerStatuses[?(@.name=="seaweedfs")].ready}')
[ "$object_ready" = 'Running:true' ] || fail object_storage_readiness
service_contract=$(/usr/local/bin/kubectl -n "$namespace" get service "$object_service" -o jsonpath='{.spec.type}:{.spec.ports[0].port}:{.spec.ports[0].name}')
[ "$service_contract" = 'ClusterIP:8333:s3-https' ] || fail object_storage_service
tls_type=$(/usr/local/bin/kubectl -n "$namespace" get secret "$object_tls_secret" -o go-template='{{.type}}') || fail object_storage_tls_secret
tls_keys=$(/usr/local/bin/kubectl -n "$namespace" get secret "$object_tls_secret" -o go-template='{{range $key, $_ := .data}}{{printf "%s\n" $key}}{{end}}' | /usr/bin/sort) || fail object_storage_tls_secret
expected_tls_keys=$(/usr/bin/printf 'ca.crt\ntls.crt\ntls.key')
tls_contract=ok
[ "$tls_type" = 'kubernetes.io/tls' ] && [ "$tls_keys" = "$expected_tls_keys" ] || tls_contract=invalid
[ "$tls_contract" = ok ] || fail object_storage_tls_secret
auth_type=$(/usr/local/bin/kubectl -n "$namespace" get secret "$object_auth_secret" -o go-template='{{.type}}') || fail object_storage_auth_secret
auth_keys=$(/usr/local/bin/kubectl -n "$namespace" get secret "$object_auth_secret" -o go-template='{{range $key, $_ := .data}}{{printf "%s\n" $key}}{{end}}' | /usr/bin/sort) || fail object_storage_auth_secret
expected_auth_keys=$(/usr/bin/printf 'accessKey\nsecretKey')
auth_contract=ok
[ "$auth_type" = Opaque ] && [ "$auth_keys" = "$expected_auth_keys" ] || auth_contract=invalid
[ "$auth_contract" = ok ] || fail object_storage_auth_secret
shm_capacity_preflight 4 0 0 || fail shm_capacity
work=$(/usr/bin/mktemp -d "$shm_path/cristexweb-reactive-resume-dev-backup.XXXXXX")
start_epoch=$(/usr/bin/date +%s)
timestamp=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
run_id=$timestamp
pod_run_id=$(/usr/bin/printf '%s' "$run_id" | /usr/bin/tr '[:upper:]' '[:lower:]')
run_directory="$archive_root/$run_id"
remote_directory="$remote_root/$run_id"
backup_success=false
[ ! -e "$run_directory" ] || { /usr/bin/rm -rf -- "$work"; printf '%s\n' 'backup_status=refused reason=local_timestamp_collision'; exit 73; }
/usr/bin/install -d -m 0700 "$run_directory"
helper_pod=reactive-resume-dev-backup-$pod_run_id
helper_uid=
cleanup_helper() {
  [ -n "${helper_pod:-}" ] || return 0
  current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$helper_pod" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
  if [ -z "$helper_uid" ]; then
    [ -n "$current_uid" ] || return 0
    helper_uid=$current_uid
  fi
  if [ -z "$current_uid" ]; then
    helper_uid=
    return 0
  fi
  current_name=$(/usr/local/bin/kubectl -n "$namespace" get pod "$helper_pod" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}') || return 1
  current_run_id=$(/usr/local/bin/kubectl -n "$namespace" get pod "$helper_pod" -o jsonpath='{.metadata.labels.cristex\.io/run-id}') || return 1
  [ "$current_uid" = "$helper_uid" ] && [ "$current_name" = 'reactive-resume-dev-backup' ] && [ "$current_run_id" = "$pod_run_id" ] || return 1
  /usr/bin/printf '{"kind":"DeleteOptions","apiVersion":"v1","propagationPolicy":"Orphan","preconditions":{"uid":"%s"}}\n' "$helper_uid" >"$work/delete.json"
  /usr/local/bin/kubectl delete --raw "/api/v1/namespaces/$namespace/pods/$helper_pod" -f "$work/delete.json" >/dev/null || return 1
  if ! /usr/local/bin/kubectl -n "$namespace" wait --for=delete "pod/$helper_pod" --timeout=120s >/dev/null 2>&1; then
    current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$helper_pod" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
    [ -z "$current_uid" ] || return 1
  fi
  current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$helper_pod" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
  [ -z "$current_uid" ] || return 1
  helper_uid=
}
cleanup_plaintext() {
  trap - EXIT HUP INT TERM
  cleanup_status=0
  cleanup_helper || cleanup_status=1
  /usr/bin/rm -f -- "$work/reactive-resume-dev.dump" "$work/postgresql-size.raw" "$work/raw-manifest.json" "$work/object-manifest.json" "$work/object-storage.tar.gz" "$work/postgresql.dump.gz" || cleanup_status=1
  if [ "$backup_success" = true ]; then
    /usr/bin/rm -rf -- "$work" || cleanup_status=1
  else
    /usr/bin/rm -rf -- "$run_directory" "$work" || cleanup_status=1
  fi
  if [ "$cleanup_status" -ne 0 ]; then
    printf 'backup_status=failed stage=cleanup\n' >&2
    exit 1
  fi
}
trap cleanup_plaintext EXIT HUP INT TERM
/usr/bin/chmod 0700 "$work"

# Export objects through the S3 API using a temporary, service-account-free Pod.
cat >"$work/helper.yaml" <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: $helper_pod
  namespace: $namespace
  labels:
    app.kubernetes.io/name: reactive-resume-dev-backup
    cristex.io/object-storage-client: backup
    cristex.io/run-id: $pod_run_id
spec:
  automountServiceAccountToken: false
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 1000
    runAsGroup: 1000
    fsGroup: 1000
    seccompProfile: {type: RuntimeDefault}
  containers:
    - name: rclone
      image: $rclone_image
      imagePullPolicy: IfNotPresent
      command: [/bin/sh, -ec]
      args:
        - |
          set -eu
          test -n "\$RCLONE_CONFIG_S3_ACCESS_KEY_ID"
          test -n "\$RCLONE_CONFIG_S3_SECRET_ACCESS_KEY"
          mkdir -p /work/objects
          rclone lsjson --recursive --hash --metadata "s3:$object_bucket" >/work/raw-manifest.json.tmp
          mv /work/raw-manifest.json.tmp /work/raw-manifest.json
          rclone copy --s3-no-check-bucket "s3:$object_bucket" /work/objects
          touch /work/export.ready
          sleep 3600
      env:
        - {name: RCLONE_CONFIG_S3_TYPE, value: s3}
        - {name: RCLONE_CONFIG_S3_PROVIDER, value: Other}
        - {name: RCLONE_CONFIG_S3_ENDPOINT, value: https://$object_service.$namespace.svc.cluster.local:8333}
        - {name: RCLONE_CONFIG_S3_REGION, value: us-east-1}
        - {name: RCLONE_CONFIG_S3_FORCE_PATH_STYLE, value: "true"}
        - {name: RCLONE_CA_CERT, value: /tls/ca.crt}
        - name: RCLONE_CONFIG_S3_ACCESS_KEY_ID
          valueFrom: {secretKeyRef: {name: $object_auth_secret, key: accessKey, optional: false}}
        - name: RCLONE_CONFIG_S3_SECRET_ACCESS_KEY
          valueFrom: {secretKeyRef: {name: $object_auth_secret, key: secretKey, optional: false}}
      securityContext:
        allowPrivilegeEscalation: false
        readOnlyRootFilesystem: false
        capabilities: {drop: [ALL]}
      resources:
        requests: {cpu: 25m, memory: 64Mi}
        limits: {cpu: 250m, memory: 256Mi}
      readinessProbe:
        exec: {command: [/bin/sh, -ec, test -f /work/export.ready && test -s /work/raw-manifest.json]}
        periodSeconds: 2
        failureThreshold: 900
      volumeMounts:
        - {name: tls, mountPath: /tls, readOnly: true}
        - {name: work, mountPath: /work}
  volumes:
    - name: tls
      secret:
        secretName: $object_tls_secret
        defaultMode: 0440
        items: [{key: ca.crt, path: ca.crt}]
    - name: work
      emptyDir: {sizeLimit: 4Gi}
EOF
/usr/local/bin/kubectl apply -f "$work/helper.yaml" >/dev/null
helper_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$helper_pod" -o jsonpath='{.metadata.uid}')
[ -n "$helper_uid" ] || fail helper_uid
/usr/local/bin/kubectl -n "$namespace" wait --for=condition=Ready "pod/$helper_pod" --timeout=1800s >/dev/null
/usr/local/bin/kubectl -n "$namespace" cp "$helper_pod:/work/raw-manifest.json" "$work/raw-manifest.json" -c rclone >/dev/null
object_source_bytes=$(/usr/bin/python3 - "$work/raw-manifest.json" <<'PY'
import json, sys
allowed = ("uploads/user-pictures/", "pictures/", "uploads/user-agent/")
total = 0
for item in json.load(open(sys.argv[1], encoding="utf-8")):
    if item.get("IsDir"):
        continue
    key = item.get("Path") or item.get("Name")
    size = item.get("Size")
    assert isinstance(key, str) and key and key.startswith(allowed)
    assert not key.startswith("/") and ".." not in key.split("/") and "\\" not in key and "\x00" not in key
    assert isinstance(size, int) and size >= 0
    total += size
print(total)
PY
) || fail object_manifest_capacity
case "$object_source_bytes" in
  ''|*[!0-9]*) fail object_manifest_capacity ;;
esac
/usr/local/bin/kubectl -n "$namespace" exec "$primary" -c postgres -- \
  /usr/bin/psql --no-psqlrc --tuples-only --no-align --dbname="$database" \
  --command="SELECT pg_database_size('$database');" >"$work/postgresql-size.raw" || fail postgresql_size
postgres_source_bytes=$(/usr/bin/tr -d '[:space:]' <"$work/postgresql-size.raw")
case "$postgres_source_bytes" in
  ''|*[!0-9]*) fail postgresql_size ;;
esac
shm_capacity_preflight 4 "$postgres_source_bytes" "$object_source_bytes" || fail shm_capacity
# Stream the exported object tree to the host before host-side digest validation.
# The helper emptyDir is not mounted on the host, so raw manifest bytes alone are
# insufficient. Keep both the archive and an extracted validation copy in the
# protected tmpfs workspace; the capacity preflight above accounts for both.
/usr/local/bin/kubectl -n "$namespace" exec -i "$helper_pod" -c rclone -- \
  tar -C /work -czf - objects >"$work/object-storage.tar.gz" || fail object_archive_export
[ -s "$work/object-storage.tar.gz" ] || fail object_archive_empty
/usr/bin/install -d -m 0700 "$work/object-export"
ARCHIVE="$work/object-storage.tar.gz" OBJECT_EXPORT="$work/object-export" RAW_MANIFEST="$work/raw-manifest.json" /usr/bin/python3 - <<'PY' || fail object_archive_extract
import json
import os
import shutil
import tarfile
root = os.path.realpath(os.environ["OBJECT_EXPORT"])
raw = json.load(open(os.environ["RAW_MANIFEST"], encoding="utf-8"))
expected = {}
for item in raw:
    if item.get("IsDir"):
        continue
    key = item.get("Path") or item.get("Name")
    size = item.get("Size")
    assert isinstance(key, str) and key and isinstance(size, int) and size >= 0
    assert not key.startswith("/") and not any(char in key for char in ("\t", "\r", "\n", "\x00"))
    assert ".." not in key.split("/") and "\\" not in key
    assert key.startswith(("uploads/user-pictures/", "pictures/", "uploads/user-agent/"))
    assert key not in expected
    expected[key] = size
allowed_directories = {"objects"}
for key in expected:
    parts = key.split("/")[:-1]
    for index in range(1, len(parts) + 1):
        allowed_directories.add("objects/" + "/".join(parts[:index]))
with tarfile.open(os.environ["ARCHIVE"], mode="r:gz") as archive:
    members = []
    files = set()
    directories = set()
    member_limit = len(expected) + len(allowed_directories)
    for member in archive:
        members.append(member)
        assert len(members) <= member_limit
        path = member.name.rstrip("/")
        assert path and not path.startswith("/")
        assert path == "objects" or path.startswith("objects/")
        assert ".." not in path.split("/") and "\\" not in path and "\x00" not in path
        assert member.isdir() or member.isfile()
        assert member.linkname == "" and not member.pax_headers
        assert not getattr(member, "sparse", None)
        assert member.uid == 1000 and member.gid == 1000
        assert member.mode == (0o755 if member.isdir() else 0o644)
        if member.isdir():
            assert path in allowed_directories and path not in directories
            directories.add(path)
        else:
            key = path.removeprefix("objects/")
            assert key in expected and key not in files and member.size == expected[key]
            files.add(key)
    assert files == set(expected) and directories == allowed_directories
    for member in members:
        path = member.name.rstrip("/")
        target = os.path.realpath(os.path.join(root, path))
        assert os.path.commonpath((root, target)) == root
        if member.isdir():
            os.makedirs(target, mode=0o700, exist_ok=True)
            assert not os.path.islink(target)
            continue
        parent = os.path.dirname(target)
        os.makedirs(parent, mode=0o700, exist_ok=True)
        assert not os.path.islink(parent) and not os.path.lexists(target)
        source = archive.extractfile(member)
        assert source is not None
        descriptor = os.open(
            target,
            os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
            0o600,
        )
        with os.fdopen(descriptor, "wb") as destination:
            shutil.copyfileobj(source, destination, length=1024 * 1024)
PY
RAW="$work/raw-manifest.json" OUT="$work/object-manifest.json" OBJECT_ROOT="$work/object-export/objects" /usr/bin/python3 - <<'PY'
import hashlib, json, os
with open(os.environ["RAW"], encoding="utf-8") as stream:
    values = json.load(stream)
assert isinstance(values, list)
objects = []
seen = set()
for item in values:
    if item.get("IsDir"):
        continue
    key = item.get("Path") or item.get("Name")
    assert isinstance(key, str) and key and not key.startswith("/")
    assert ".." not in key.split("/") and "\\" not in key and "\x00" not in key
    assert key.startswith(("uploads/user-pictures/", "pictures/", "uploads/user-agent/"))
    assert key not in seen
    seen.add(key)
    expected_size = item.get("Size")
    assert isinstance(expected_size, int) and expected_size >= 0
    root = os.environ["OBJECT_ROOT"]
    path = os.path.join(root, key)
    assert os.path.commonpath((root, os.path.realpath(path))) == root
    assert os.path.isfile(path) and not os.path.islink(path)
    actual_size = os.stat(path).st_size
    assert actual_size == expected_size
    digest = hashlib.sha256()
    md5_digest = hashlib.md5()
    with open(path, "rb") as source:
        for chunk in iter(lambda: source.read(1024 * 1024), b""):
            digest.update(chunk)
            md5_digest.update(chunk)
    hashes = item.get("Hashes") if isinstance(item.get("Hashes"), dict) else {}
    md5 = hashes.get("md5")
    assert isinstance(md5, str) and len(md5) == 32
    assert all(char in "0123456789abcdef" for char in md5)
    assert md5_digest.hexdigest() == md5
    objects.append({"key": key, "size": actual_size, "sha256": digest.hexdigest(), "md5": md5})
actual = set()
object_root = os.environ["OBJECT_ROOT"]
for root, dirs, files in os.walk(object_root, followlinks=False):
    assert all(not os.path.islink(os.path.join(root, name)) for name in dirs)
    for name in files:
        path = os.path.join(root, name)
        assert not os.path.islink(path)
        actual.add(os.path.relpath(path, object_root))
assert actual == seen
objects.sort(key=lambda value: value["key"])
with open(os.environ["OUT"], "w", encoding="utf-8") as stream:
    json.dump({"schema": 2, "bucket": "reactive-resume-dev", "objects": objects}, stream, separators=(",", ":"))
PY
/usr/bin/age -r "$recipient" -o "$run_directory/object-storage.tar.gz.age" "$work/object-storage.tar.gz" || fail object_archive_encrypt
[ -s "$run_directory/object-storage.tar.gz.age" ] || fail object_archive_empty

# Dump only the successor logical database; no PostgreSQL PVC is copied.
/usr/local/bin/kubectl -n "$namespace" exec "$primary" -c postgres -- \
  /usr/bin/pg_dump --format=custom --compress=0 --no-owner --no-privileges \
  --dbname="$database" >"$work/reactive-resume-dev.dump" || fail pg_dump
[ -s "$work/reactive-resume-dev.dump" ] || fail pg_dump_empty
pg_logical_archive_bytes=$(/usr/bin/stat -c %s "$work/reactive-resume-dev.dump")
case "$pg_logical_archive_bytes" in
  ''|*[!0-9]*) fail pg_dump_size ;;
esac
[ "$pg_logical_archive_bytes" -gt 0 ] || fail pg_dump_size
/usr/bin/pg_restore --list "$work/reactive-resume-dev.dump" >"$work/postgresql.list" || fail pg_logical_list
pg_logical_counts=$(/usr/bin/python3 - "$work/postgresql.list" <<'PY'
import re, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    entries = [line for line in stream if line.strip() and not line.startswith(";")]
table_entry = re.compile(r"^\d+;\s+\d+\s+\d+\s+TABLE\s+(?!DATA\s|ATTACH\s)")
tables = [line for line in entries if table_entry.match(line)]
assert entries and tables
print(f"{len(entries)}:{len(tables)}")
PY
) || fail pg_logical_content
pg_logical_entry_count=${pg_logical_counts%%:*}
pg_logical_table_count=${pg_logical_counts#*:}
[ "$pg_logical_entry_count" -gt 0 ] && [ "$pg_logical_table_count" -gt 0 ] || fail pg_logical_content
/usr/bin/gzip -9 -c "$work/reactive-resume-dev.dump" >"$work/postgresql.dump.gz" || fail pg_compress
/usr/bin/age -r "$recipient" -o "$run_directory/postgresql.dump.gz.age" "$work/postgresql.dump.gz" || fail pg_encrypt
[ -s "$run_directory/postgresql.dump.gz.age" ] || fail pg_archive_empty
/usr/bin/rm -f -- "$work/reactive-resume-dev.dump" "$work/postgresql.dump.gz"
cleanup_helper
helper_uid=

(cd "$run_directory" && /usr/bin/sha256sum postgresql.dump.gz.age >postgresql.dump.gz.age.sha256)
(cd "$run_directory" && /usr/bin/sha256sum object-storage.tar.gz.age >object-storage.tar.gz.age.sha256)
object_counts=$(/usr/bin/python3 - "$work/object-manifest.json" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    objects = json.load(stream)["objects"]
print(f"{len(objects)}:{sum(item['size'] for item in objects)}")
PY
) || fail object_manifest_counts
object_count=${object_counts%%:*}
total_object_bytes=${object_counts#*:}
[ "$object_count" -gt 0 ] && [ "$total_object_bytes" -gt 0 ] || fail object_storage_empty
/usr/bin/cp --preserve=mode "$work/object-manifest.json" "$run_directory/object-storage.manifest.json"

pg_archive_bytes=$(/usr/bin/stat -c %s "$run_directory/postgresql.dump.gz.age")
object_archive_bytes=$(/usr/bin/stat -c %s "$run_directory/object-storage.tar.gz.age")
pg_archive_sha256=$(/usr/bin/cut -d ' ' -f 1 "$run_directory/postgresql.dump.gz.age.sha256")
object_archive_sha256=$(/usr/bin/cut -d ' ' -f 1 "$run_directory/object-storage.tar.gz.age.sha256")
completed_epoch=$(/usr/bin/date +%s)
[ "$completed_epoch" -ge "$start_epoch" ] || fail clock_skew
completed_at_utc=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
backup_duration_seconds=$(( completed_epoch - start_epoch ))
