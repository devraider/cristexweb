    if set(value) != expected_keys:
        raise ValueError("manifest_keys")
    if value["schema"] != 1 or value["service"] != "opentofu-github" or value["artifact"] != "absence-attestation":
        raise ValueError("manifest_identity")
    if value["state"] != "github.tfstate" or value["state_path"] != "/var/lib/opentofu/cristexweb/github.tfstate" or value["state_present"] is not False:
        raise ValueError("manifest_state")
    if value["created_at_utc"] != os.environ["PAYLOAD_TIMESTAMP"] or value["archive"] != "absence-attestation.json.age":
        raise ValueError("manifest_timestamp")
    if value["encryption"] != "age-x25519" or value["archive_sha256"] != os.environ["EXPECTED_SHA"] or value["archive_bytes"] != int(os.environ["ARCHIVE_BYTES"]):
        raise ValueError("manifest_integrity")
except (OSError, ValueError, TypeError, json.JSONDecodeError):
    sys.exit(1)
