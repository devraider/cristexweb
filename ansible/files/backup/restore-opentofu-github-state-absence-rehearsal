    /usr/local/bin/rclone --config "$rclone_config" copyto "$remote_root/$candidate/manifest.json" "$candidate_manifest" || { /usr/bin/rm -f -- "$candidate_manifest"; continue; }
    if ! /usr/local/bin/rclone --config "$rclone_config" copyto "$remote_root/$candidate/absence-attestation.json.age" "$work/absence-attestation.json.age" ||
       ! /usr/local/bin/rclone --config "$rclone_config" copyto "$remote_root/$candidate/absence-attestation.json.age.sha256" "$work/absence-attestation.json.age.sha256" ||
       ! (cd "$work" && /usr/bin/sha256sum -c absence-attestation.json.age.sha256 >/dev/null); then
        /usr/bin/rm -f -- "$candidate_manifest" "$work/absence-attestation.json.age" "$work/absence-attestation.json.age.sha256"
        continue
    fi
    if TIMESTAMP="$candidate" FILE="$candidate_manifest" EXPECTED_SHA="$(/usr/bin/cut -d ' ' -f1 "$work/absence-attestation.json.age.sha256")" ARCHIVE_BYTES="$(/usr/bin/stat -c %s "$work/absence-attestation.json.age")" /usr/bin/python3 - <<'PY'
import datetime
import json
import os
import re
import sys
try:
    with open(os.environ["FILE"], encoding="utf-8") as stream:
        value = json.load(stream)
    expected_keys = {"schema", "service", "artifact", "state", "created_at_utc", "expires_at_utc", "archive", "archive_bytes", "archive_sha256", "encryption", "state_path", "state_present"}
    if set(value) != expected_keys or value["schema"] != 1 or value["service"] != "opentofu-github" or value["artifact"] != "absence-attestation":
        raise ValueError("manifest_identity")
    if value["state"] != "github.tfstate" or value["state_path"] != "/var/lib/opentofu/cristexweb/github.tfstate" or value["state_present"] is not False or value["created_at_utc"] != os.environ["TIMESTAMP"] or value["archive"] != "absence-attestation.json.age" or value["encryption"] != "age-x25519":
        raise ValueError("manifest_contract")
    if not isinstance(value["archive_bytes"], int) or value["archive_bytes"] <= 0 or not re.fullmatch(r"[0-9a-f]{64}", value["archive_sha256"]):
        raise ValueError("manifest_shape")
    if value["archive_sha256"] != os.environ["EXPECTED_SHA"] or value["archive_bytes"] != int(os.environ["ARCHIVE_BYTES"]):
        raise ValueError("manifest_integrity")
    created = datetime.datetime.strptime(value["created_at_utc"], "%Y%m%dT%H%M%SZ")
    expires = datetime.datetime.strptime(value["expires_at_utc"], "%Y%m%dT%H%M%SZ")
    if expires != created + datetime.timedelta(minutes=15):
        raise ValueError("manifest_expiry")
except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError):
    sys.exit(1)
PY
    then
        :
    else
        /usr/bin/rm -f -- "$candidate_manifest" "$work/absence-attestation.json.age" "$work/absence-attestation.json.age.sha256"
        continue
    fi
    /usr/bin/rm -f -- "$candidate_manifest" "$work/absence-attestation.json.age" "$work/absence-attestation.json.age.sha256"
    latest="$candidate"
    break
done <<EOF
$candidates
EOF
[ -n "$latest" ] || { printf '%s\n' 'restore_status=failed stage=remote_catalog'; exit 1; }
remote="$remote_root/$latest"
for leaf in absence-attestation.json.age absence-attestation.json.age.sha256 manifest.json; do /usr/local/bin/rclone --config "$rclone_config" copyto "$remote/$leaf" "$work/$leaf"; done
(cd "$work" && /usr/bin/sha256sum -c absence-attestation.json.age.sha256 >/dev/null)
FILE="$work/manifest.json" PAYLOAD_TIMESTAMP="$latest" EXPECTED_SHA="$(/usr/bin/cut -d ' ' -f1 "$work/absence-attestation.json.age.sha256")" ARCHIVE_BYTES="$(/usr/bin/stat -c %s "$work/absence-attestation.json.age")" /usr/bin/python3 - <<'PY'
import json
import os
