/home/paul/.nvm/versions/node/v24.19.0/bin/infisical secrets get SHARED_DATABASE_BACKUP_AGE_IDENTITY --projectId "$project_id" --env prod --path "$infisical_path" --plain --silent >"$work/identity"
chmod 0600 "$work/identity"
/usr/bin/age -d -i "$work/identity" "$work/absence-attestation.json.age" >"$work/absence-attestation.json"
/usr/bin/rm -f -- "$work/identity"
FILE="$work/absence-attestation.json" MANIFEST="$work/manifest.json" EXPECTED_TIMESTAMP="$latest" /usr/bin/python3 - <<'PY'
import datetime
import json
import os
import sys
try:
    with open(os.environ["FILE"], encoding="utf-8") as stream:
        value = json.load(stream)
    with open(os.environ["MANIFEST"], encoding="utf-8") as stream:
        manifest = json.load(stream)
    expected_keys = {"schema", "service", "artifact", "state_path", "state_present", "parent_path", "parent_realpath", "parent_owner", "parent_group", "parent_mode", "attested_at_utc", "expires_at_utc"}
    if set(value) != expected_keys:
        raise ValueError("payload_keys")
    if value["schema"] != 1 or value["service"] != "opentofu-github" or value["artifact"] != "absence-attestation":
        raise ValueError("payload_identity")
    if value["state_path"] != "/var/lib/opentofu/cristexweb/github.tfstate" or value["state_present"] is not False:
        raise ValueError("payload_state")
    if value["parent_path"] != "/var/lib/opentofu/cristexweb" or value["parent_realpath"] != value["parent_path"] or value["parent_owner"] != "paul" or value["parent_group"] != "root" or value["parent_mode"] != "0700":
        raise ValueError("payload_parent")
    if value["attested_at_utc"] != os.environ["EXPECTED_TIMESTAMP"]:
        raise ValueError("payload_timestamp")
    if manifest["created_at_utc"] != value["attested_at_utc"] or manifest["expires_at_utc"] != value["expires_at_utc"]:
        raise ValueError("manifest_payload_binding")
    attested = datetime.datetime.strptime(value["attested_at_utc"], "%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
    expires = datetime.datetime.strptime(value["expires_at_utc"], "%Y%m%dT%H%M%SZ").replace(tzinfo=datetime.timezone.utc)
    if expires != attested + datetime.timedelta(minutes=15):
        raise ValueError("payload_expiry_window")
    now = datetime.datetime.now(datetime.timezone.utc)
    if expires <= now or expires > now + datetime.timedelta(minutes=15, seconds=5):
        raise ValueError("payload_expiry")
except (OSError, ValueError, TypeError, KeyError, json.JSONDecodeError):
    sys.exit(1)
