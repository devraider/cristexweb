    nested_dirs=$(/usr/local/bin/rclone --config "$rclone_config" lsf --dirs-only "$remote_root/$candidate")
    [ -z "$nested_dirs" ] || continue
    leaves=$(/usr/local/bin/rclone --config "$rclone_config" lsf --files-only "$remote_root/$candidate" | /usr/bin/sort)
    expected='absence-attestation.json.age
absence-attestation.json.age.sha256
manifest.json'
