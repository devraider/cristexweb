#!/bin/sh
set -eu

if [ "${CRISTEXWEB_RESTORE_TIMEOUT_GUARD:-}" != 1 ]; then
  export CRISTEXWEB_RESTORE_TIMEOUT_GUARD=1
  exec /usr/bin/timeout --foreground --kill-after=30s 3600 "$0" "$@"
fi
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
export PATH
project_id=619656da-14f3-4872-857b-be103cdc5326
infisical_path=/shared-services/backup-recovery
remote_root=drive:cristexweb-recovery/opentofu/foundation
source_closure_sha256=c9a04e04303b30148f410dd57c8c5c8cf69d0cbf58b88cbc70023c824e214fae
printf '%s' "$source_closure_sha256" | /usr/bin/grep -Eq '^[0-9a-f]{64}$' || { printf '%s\n' 'restore_status=failed stage=source_closure_contract'; exit 1; }
rclone_config=/home/paul/.config/rclone/rclone.conf
work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-opentofu-restore.XXXXXX)
cleanup() { /usr/bin/rm -rf -- "$work"; }
trap cleanup EXIT HUP INT TERM
chmod 0700 "$work"
latest=$(/usr/local/bin/rclone --config "$rclone_config" lsf --dirs-only "$remote_root" | /usr/bin/sort | /usr/bin/tail -1 | /usr/bin/tr -d '/')
printf '%s\n' "$latest" | /usr/bin/grep -Eq '^20[0-9]{6}T[0-9]{6}Z$' || { printf '%s\n' 'restore_status=failed stage=remote_catalog'; exit 1; }
remote="$remote_root/$latest"
for leaf in foundation.tfstate.age foundation.tfstate.age.sha256 manifest.json; do /usr/local/bin/rclone --config "$rclone_config" copyto "$remote/$leaf" "$work/$leaf"; done
(cd "$work" && /usr/bin/sha256sum -c foundation.tfstate.age.sha256 >/dev/null)
restore_run_id=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
if [ "$restore_run_id" = "$latest" ]; then
  /usr/bin/sleep 1
  restore_run_id=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
fi
[ "$restore_run_id" != "$latest" ] || { printf '%s\n' 'restore_status=failed stage=run_id_collision'; exit 1; }
FILE="$work/manifest.json" TIMESTAMP="$latest" EXPECTED_SHA="$(/usr/bin/cut -d ' ' -f1 "$work/foundation.tfstate.age.sha256")" ARCHIVE_BYTES="$(/usr/bin/stat -c %s "$work/foundation.tfstate.age")" EXPECTED_SOURCE_CLOSURE_SHA256="$source_closure_sha256" /usr/bin/python3 - <<'PY'
import json, os, re

def reject_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError('duplicate_manifest_key')
        value[key] = item
    return value

with open(os.environ['FILE'], encoding='utf-8') as stream:
    x = json.load(stream, object_pairs_hook=reject_duplicate_keys)
expected_keys = {
    'schema', 'service', 'state', 'run_id', 'created_at_utc', 'archive',
    'archive_bytes', 'archive_sha256', 'encryption', 'backend', 'state_path',
    'address_scope', 'source_closure_sha256',
}
assert set(x) == expected_keys
assert x['schema'] == 1 and x['service'] == 'opentofu' and x['state'] == 'foundation.tfstate'
assert re.fullmatch(r'20[0-9]{6}T[0-9]{6}Z', x['run_id'])
assert x['run_id'] == os.environ['TIMESTAMP']
assert x['created_at_utc'] == os.environ['TIMESTAMP'] and x['archive'] == 'foundation.tfstate.age'
assert x['encryption'] == 'age-x25519' and x['backend'] == 'local'
assert x['state_path'] == '/var/lib/opentofu/cristexweb/foundation.tfstate'
assert x['address_scope'] in {'exact-five', 'exact-six'}
assert re.fullmatch(r'[0-9a-f]{64}', x['source_closure_sha256'])
assert x['source_closure_sha256'] == os.environ['EXPECTED_SOURCE_CLOSURE_SHA256']
assert re.fullmatch(r'[0-9a-f]{64}', x['archive_sha256'])
assert x['archive_sha256'] == os.environ['EXPECTED_SHA']
assert x['archive_bytes'] == int(os.environ['ARCHIVE_BYTES'])
PY
/home/paul/.nvm/versions/node/v24.19.0/bin/infisical secrets get SHARED_DATABASE_BACKUP_AGE_IDENTITY --projectId "$project_id" --env prod --path "$infisical_path" --plain --silent >"$work/identity"
chmod 0600 "$work/identity"
/usr/bin/age -d -i "$work/identity" "$work/foundation.tfstate.age" >"$work/foundation.tfstate"
/usr/bin/rm -f -- "$work/identity"
[ -s "$work/foundation.tfstate" ]
STATE="$work/foundation.tfstate" /usr/bin/python3 - <<'PY'
import json, os

def reject_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError('duplicate_state_key')
        value[key] = item
    return value

with open(os.environ['STATE'], encoding='utf-8') as stream:
    x = json.load(stream, object_pairs_hook=reject_duplicate_keys)
assert isinstance(x, dict) and x.get('version') in (3, 4)
assert isinstance(x.get('lineage', ''), str) and isinstance(x.get('serial'), int)
PY
TOFU_DISABLE_CHECKPOINT=1 /usr/local/bin/tofu state list -state="$work/foundation.tfstate" >"$work/resources"
# The sanitized receipt emits address_scope=exact-five or address_scope=exact-six.
address_scope=$(/usr/bin/python3 - "$work/resources" "$work/manifest.json" <<'PY'
import json
import sys
from pathlib import Path


def reject_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError('duplicate_manifest_key')
        value[key] = item
    return value

actual = [line.strip() for line in Path(sys.argv[1]).read_text().splitlines() if line.strip()]
with open(sys.argv[2], encoding='utf-8') as stream:
    manifest = json.load(stream, object_pairs_hook=reject_duplicate_keys)
manifest_scope = manifest['address_scope']
expected = {
    'exact-five': {
        'cloudflare_dns_record.argocd_tailscale',
        'cloudflare_dns_record.cristexhub_dev',
        'cloudflare_dns_record.keycloak',
        'cloudflare_zero_trust_tunnel_cloudflared.keycloak',
        'cloudflare_zero_trust_tunnel_cloudflared_config.keycloak',
    },
    'exact-six': {
        'cloudflare_dns_record.argocd_tailscale',
        'cloudflare_dns_record.cristexhub_dev',
        'cloudflare_dns_record.keycloak',
        'cloudflare_dns_record.reactive_resume_dev_tailscale',
        'cloudflare_zero_trust_tunnel_cloudflared.keycloak',
        'cloudflare_zero_trust_tunnel_cloudflared_config.keycloak',
    },
}
assert len(actual) == len(set(actual))
actual_set = set(actual)
for label, addresses in expected.items():
    if actual_set == addresses and len(actual) == len(addresses):
        assert manifest_scope == label
        print(label)
        break
else:
    raise SystemExit('state address closure mismatch')
PY
)
/usr/bin/rm -f -- "$work/foundation.tfstate" "$work/resources"
printf 'restore_status=success schema=1 run_id=%s source_run_id=%s source_timestamp=%s target=isolated-tmpfs checksum=verified private_residue=none state_validation=tofu-state-list address_scope=%s source_closure_sha256=%s non_mutating=true\n' "$restore_run_id" "$latest" "$latest" "$address_scope" "$source_closure_sha256"
