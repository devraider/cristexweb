#!/bin/sh
set -eu

if [ "${CRISTEXWEB_RESTORE_TIMEOUT_GUARD:-}" != 1 ]; then
  export CRISTEXWEB_RESTORE_TIMEOUT_GUARD=1
  exec /usr/bin/timeout --foreground --kill-after=30s 3600 "$0" "$@"
fi
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
LC_ALL=C
export PATH LC_ALL

# Reject inherited OpenTofu CLI, backend, provider, registry, and proxy
# overrides before retrieving or validating any recovery material.
while IFS='=' read -r inherited_name _; do
    case "$inherited_name" in
        TF_CLI_CONFIG_FILE|TF_WORKSPACE|TOFU_DISABLE_CHECKPOINT)
            inherited_value=$(/usr/bin/printenv "$inherited_name" 2>/dev/null || true)
            case "$inherited_name=$inherited_value" in
                TF_CLI_CONFIG_FILE=/dev/null|TF_WORKSPACE=default|TOFU_DISABLE_CHECKPOINT=1)
                    continue
                    ;;
            esac
            ;;
    esac
    # PYTHON* includes PYTHONOPTIMIZE, PYTHONPATH, PYTHONHOME, and every
    # interpreter/import/startup override; no inherited Python setting is trusted.
    case "$inherited_name" in
        BASH_ENV|ENV|SHELLOPTS|BASHOPTS|HTTP_PROXY|HTTPS_PROXY|ALL_PROXY|NO_PROXY|http_proxy|https_proxy|all_proxy|no_proxy|TF_CLI_ARGS|TF_CLI_ARGS_*|TF_CLI_CONFIG_FILE|TF_DATA_DIR|TF_WORKSPACE|TF_VAR_*|TF_LOG|TF_LOG_PATH|TF_INPUT|TF_IN_AUTOMATION|TF_PLUGIN_CACHE_DIR|TF_REGISTRY_CLIENT_TIMEOUT|TF_REGISTRY_DISCOVERY_RETRY|TF_REATTACH_PROVIDERS|TF_APPEND_USER_AGENT|TF_DISABLE_PLUGIN_TLS|TF_HTTP_*|TF_REGISTRY_*|TOFU_*|OPENTOFU_*|TERRAFORM_*|CLOUDFLARE_*|AWS_*|GOOGLE_*|GCP_*|GCLOUD_*|AZURE_*|ARM_*|DIGITALOCEAN_*|GITHUB_*|GIT_*|GH_*|SCALR_*|TFE_*|TFC_*|CONSUL_*|VAULT_*|NOMAD_*|KUBE_CONFIG|KUBECONFIG|KUBERNETES_*|KUBE_*|HELM_*|RCLONE_*|INFISICAL_*|S3_*|GCS_*|MINIO_*|MONGODB_*|MONGO*|POSTGRES*|PG*|RABBITMQ_*|REDIS_*|AGE_*|PYTHON*|CHECKPOINT_DISABLE)
            printf 'restore_status=refused reason=inherited_environment_override name=%s\n' "$inherited_name"
            exit 65
            ;;
    esac
done <<EOF
$(/usr/bin/env | /usr/bin/sed 's/=.*//')
EOF

project_id=619656da-14f3-4872-857b-be103cdc5326
infisical_path=/shared-services/backup-recovery
remote_root=drive:cristexweb-recovery/opentofu/foundation
source_closure_sha256=c9a04e04303b30148f410dd57c8c5c8cf69d0cbf58b88cbc70023c824e214fae
printf '%s' "$source_closure_sha256" | /usr/bin/grep -Eq '^[0-9a-f]{64}$' || { printf '%s\n' 'restore_status=failed stage=source_closure_contract'; exit 1; }
rclone_config=/home/paul/.config/rclone/rclone.conf
run_rclone() {
    /usr/bin/env -i \
        HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin \
        LC_ALL=C XDG_CONFIG_HOME=/home/paul/.config \
        /usr/local/bin/rclone --config "$rclone_config" "$@"
}
infisical_launcher=/home/paul/.nvm/versions/node/v24.19.0/bin/infisical
run_infisical() {
    /usr/bin/env -i \
        HOME=/home/paul USER=paul LOGNAME=paul PATH=/home/paul/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin \
        LC_ALL=C XDG_CONFIG_HOME=/home/paul/.config \
        "$infisical_launcher" "$@"
}
work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-opentofu-restore.XXXXXX)
cleanup() { /usr/bin/rm -rf -- "$work"; }
trap cleanup EXIT HUP INT TERM
chmod 0700 "$work"
tofu=/usr/local/bin/tofu
tofu_target=/opt/opentofu/1.12.5/tofu
[ -L "$tofu" ] && [ "$(/usr/bin/readlink -f -- "$tofu")" = "$tofu_target" ] || { printf '%s\n' 'restore_status=failed stage=tofu_binary_contract'; exit 1; }
[ -f "$tofu_target" ] && [ ! -L "$tofu_target" ] && [ "$(/usr/bin/stat -c '%U:%G:%a' "$tofu_target")" = 'root:root:755' ] || { printf '%s\n' 'restore_status=failed stage=tofu_binary_contract'; exit 1; }
tofu_data_dir="$work/tofu-data"
/usr/bin/install -d -m 0700 "$tofu_data_dir"
run_tofu_state_list() {
    state_path=$1
    output_path=$2
    /usr/bin/env -i \
        HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin \
        LC_ALL=C XDG_CONFIG_HOME=/home/paul/.config \
        TF_CLI_CONFIG_FILE=/dev/null TF_DATA_DIR="$tofu_data_dir" \
        TF_WORKSPACE=default TOFU_DISABLE_CHECKPOINT=1 \
        "$tofu" state list -state="$state_path" -no-color >"$output_path"
}
archive_leaf=foundation.tfstate.age
checksum_leaf=foundation.tfstate.age.sha256
manifest_leaf=manifest.json
select_latest_complete_catalog() {
  expected="$work/expected-leaves"
  expected_sorted="$work/expected-leaves.sorted"
  catalog="$work/catalog-dirs"
  valid="$work/catalog-valid"
  printf '%s\n' "$archive_leaf" "$checksum_leaf" "$manifest_leaf" >"$expected"
  if ! LC_ALL=C /usr/bin/sort "$expected" >"$expected_sorted"; then
    return 1
  fi
  if ! run_rclone lsf --dirs-only "$remote_root" >"$catalog"; then
    return 1
  fi
  : >"$valid"
  latest=
  while IFS= read -r raw; do
    candidate=${raw%/}
    [ -n "$candidate" ] || continue
    printf '%s\n' "$candidate" >"$work/catalog-candidate"
    /usr/bin/grep -Eq '^20[0-9]{6}T[0-9]{6}Z$' "$work/catalog-candidate" || continue
    if /usr/bin/grep -Fxq "$candidate" "$valid"; then
      return 1
    fi
    printf '%s\n' "$candidate" >>"$valid"
    nested="$work/catalog-$candidate.dirs"
    if ! run_rclone lsf --dirs-only "$remote_root/$candidate" >"$nested"; then
      return 1
    fi
    [ ! -s "$nested" ] || continue
    listing="$work/catalog-$candidate.files"
    if ! run_rclone lsf --files-only "$remote_root/$candidate" >"$listing"; then
      return 1
    fi
    sorted="$work/catalog-$candidate.files.sorted"
    if ! LC_ALL=C /usr/bin/sort "$listing" >"$sorted"; then
      return 1
    fi
    duplicates="$work/catalog-$candidate.duplicates"
    if ! /usr/bin/uniq -d "$sorted" >"$duplicates"; then
      return 1
    fi
    [ ! -s "$duplicates" ] || continue
    if /usr/bin/cmp -s "$sorted" "$expected_sorted"; then
      if [ -z "$latest" ] || [ "$candidate" \> "$latest" ]; then
        latest="$candidate"
      fi
    fi
  done <"$catalog"
  [ -n "$latest" ]
}
if ! select_latest_complete_catalog; then
  printf '%s\n' 'restore_status=failed stage=remote_catalog'
  exit 1
fi
remote="$remote_root/$latest"
for leaf in foundation.tfstate.age foundation.tfstate.age.sha256 manifest.json; do run_rclone copyto "$remote/$leaf" "$work/$leaf"; done
(cd "$work" && /usr/bin/sha256sum -c foundation.tfstate.age.sha256 >/dev/null)
restore_run_id=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
if [ "$restore_run_id" = "$latest" ]; then
  /usr/bin/sleep 1
  restore_run_id=$(/usr/bin/date -u +%Y%m%dT%H%M%SZ)
fi
[ "$restore_run_id" != "$latest" ] || { printf '%s\n' 'restore_status=failed stage=run_id_collision'; exit 1; }
/usr/bin/env -i \
    HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin \
    LC_ALL=C XDG_CONFIG_HOME=/home/paul/.config \
    PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
    FILE="$work/manifest.json" TIMESTAMP="$latest" EXPECTED_SHA="$(/usr/bin/cut -d ' ' -f1 "$work/foundation.tfstate.age.sha256")" ARCHIVE_BYTES="$(/usr/bin/stat -c %s "$work/foundation.tfstate.age")" EXPECTED_SOURCE_CLOSURE_SHA256="$source_closure_sha256" \
    /usr/bin/python3 - <<'PY'
import json, os, re


def fail(reason):
    raise SystemExit(f'manifest_contract:{reason}')


def require(condition, reason):
    if not condition:
        fail(reason)


def reject_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError('duplicate_manifest_key')
        value[key] = item
    return value


def reject_json_constant(value):
    raise ValueError('nonstandard_json_constant')

try:
    with open(os.environ['FILE'], encoding='utf-8') as stream:
        x = json.load(
            stream,
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_json_constant,
        )
except (OSError, TypeError, ValueError) as exc:
    raise SystemExit('manifest_contract:invalid_json') from exc

expected_keys = {
    'schema', 'service', 'state', 'run_id', 'created_at_utc', 'archive',
    'archive_bytes', 'archive_sha256', 'encryption', 'backend', 'state_path',
    'address_scope', 'source_closure_sha256',
}
require(isinstance(x, dict), 'root_not_object')
require(set(x) == expected_keys, 'keys')
require(
    type(x['schema']) is int
    and x['schema'] == 1
    and x['service'] == 'opentofu'
    and x['state'] == 'foundation.tfstate',
    'identity',
)
require(
    isinstance(x['run_id'], str)
    and re.fullmatch(r'20[0-9]{6}T[0-9]{6}Z', x['run_id']),
    'run_id_format',
)
expected_timestamp = os.environ.get('TIMESTAMP')
require(expected_timestamp is not None and x['run_id'] == expected_timestamp, 'run_id')
require(
    x['created_at_utc'] == expected_timestamp
    and x['archive'] == 'foundation.tfstate.age',
    'archive_identity',
)
require(x['encryption'] == 'age-x25519' and x['backend'] == 'local', 'backend')
require(x['state_path'] == '/var/lib/opentofu/cristexweb/foundation.tfstate', 'state_path')
require(x['address_scope'] in {'exact-five', 'exact-six'}, 'address_scope')
require(
    isinstance(x['source_closure_sha256'], str)
    and re.fullmatch(r'[0-9a-f]{64}', x['source_closure_sha256']),
    'source_closure_format',
)
expected_source = os.environ.get('EXPECTED_SOURCE_CLOSURE_SHA256')
require(expected_source is not None and x['source_closure_sha256'] == expected_source, 'source_closure')
require(
    isinstance(x['archive_sha256'], str)
    and re.fullmatch(r'[0-9a-f]{64}', x['archive_sha256']),
    'archive_sha256_format',
)
expected_sha = os.environ.get('EXPECTED_SHA')
require(expected_sha is not None and x['archive_sha256'] == expected_sha, 'archive_sha256')
try:
    expected_bytes = int(os.environ['ARCHIVE_BYTES'])
except (KeyError, TypeError, ValueError) as exc:
    raise SystemExit('manifest_contract:archive_bytes_environment') from exc
require(type(x['archive_bytes']) is int and x['archive_bytes'] == expected_bytes, 'archive_bytes')
PY
run_infisical secrets get SHARED_DATABASE_BACKUP_AGE_IDENTITY --projectId "$project_id" --env prod --path "$infisical_path" --plain --silent >"$work/identity"
chmod 0600 "$work/identity"
/usr/bin/age -d -i "$work/identity" "$work/foundation.tfstate.age" >"$work/foundation.tfstate"
/usr/bin/rm -f -- "$work/identity"
[ -s "$work/foundation.tfstate" ]
/usr/bin/env -i \
    HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin \
    LC_ALL=C XDG_CONFIG_HOME=/home/paul/.config \
    PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
    STATE="$work/foundation.tfstate" /usr/bin/python3 - <<'PY'
import json, os


def fail(reason):
    raise SystemExit(f'state_contract:{reason}')


def reject_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError('duplicate_state_key')
        value[key] = item
    return value


def reject_json_constant(value):
    raise ValueError('nonstandard_json_constant')

try:
    with open(os.environ['STATE'], encoding='utf-8') as stream:
        x = json.load(
            stream,
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_json_constant,
        )
except (OSError, TypeError, ValueError) as exc:
    raise SystemExit('state_contract:invalid_json') from exc

if not isinstance(x, dict):
    fail('root_not_object')
if type(x.get('version')) is not int or x.get('version') not in (3, 4):
    fail('version')
if not isinstance(x.get('lineage', ''), str):
    fail('lineage')
if type(x.get('serial')) is not int:
    fail('serial')
PY
# The clean invocation above is the only tofu state list operation in restore.
run_tofu_state_list "$work/foundation.tfstate" "$work/resources"
# The sanitized receipt emits address_scope=exact-five or address_scope=exact-six.
address_scope=$(/usr/bin/env -i \
    HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin \
    LC_ALL=C XDG_CONFIG_HOME=/home/paul/.config \
    PYTHONNOUSERSITE=1 PYTHONDONTWRITEBYTECODE=1 \
    /usr/bin/python3 - "$work/resources" "$work/manifest.json" <<'PY'
import json
import sys
from pathlib import Path


def fail(reason):
    raise SystemExit(f'address_scope_contract:{reason}')


def reject_duplicate_keys(pairs):
    value = {}
    for key, item in pairs:
        if key in value:
            raise ValueError('duplicate_manifest_key')
        value[key] = item
    return value


def reject_json_constant(value):
    raise ValueError('nonstandard_json_constant')

try:
    actual = Path(sys.argv[1]).read_text(encoding='utf-8').splitlines()
    with open(sys.argv[2], encoding='utf-8') as stream:
        manifest = json.load(
            stream,
            object_pairs_hook=reject_duplicate_keys,
            parse_constant=reject_json_constant,
        )
except (OSError, TypeError, ValueError) as exc:
    raise SystemExit('address_scope_contract:invalid_input') from exc

if not actual or any(not line or line != line.strip() for line in actual):
    fail('state address closure mismatch')
seen = {}
for address in actual:
    if address in seen:
        fail('state address closure mismatch')
    seen[address] = None
if not isinstance(manifest, dict) or not isinstance(manifest.get('address_scope'), str):
    fail('manifest address scope')
manifest_scope = manifest['address_scope']
expected = {
    'exact-five': sorted([
        'cloudflare_dns_record.argocd_tailscale',
        'cloudflare_dns_record.cristexhub_dev',
        'cloudflare_dns_record.keycloak',
        'cloudflare_zero_trust_tunnel_cloudflared.keycloak',
        'cloudflare_zero_trust_tunnel_cloudflared_config.keycloak',
    ]),
    'exact-six': sorted([
        'cloudflare_dns_record.argocd_tailscale',
        'cloudflare_dns_record.cristexhub_dev',
        'cloudflare_dns_record.keycloak',
        'cloudflare_dns_record.reactive_resume_dev_tailscale',
        'cloudflare_zero_trust_tunnel_cloudflared.keycloak',
        'cloudflare_zero_trust_tunnel_cloudflared_config.keycloak',
    ]),
}
for label, addresses in expected.items():
    if len(actual) == len(addresses) and sorted(actual) == addresses:
        if manifest_scope != label:
            fail('manifest/state scope mismatch')
        print(label)
        break
else:
    fail('state address closure mismatch')
PY
)
/usr/bin/rm -f -- "$work/foundation.tfstate" "$work/resources"
printf 'restore_status=success schema=1 run_id=%s source_run_id=%s source_timestamp=%s target=isolated-tmpfs checksum=verified private_residue=none state_validation=tofu-state-list address_scope=%s source_closure_sha256=%s non_mutating=true\n' "$restore_run_id" "$latest" "$latest" "$address_scope" "$source_closure_sha256"
