#!/bin/sh
set -eu

if [ "${CRISTEXWEB_RESTORE_TIMEOUT_GUARD:-}" != 1 ]; then
  export CRISTEXWEB_RESTORE_TIMEOUT_GUARD=1
  exec /usr/bin/timeout --foreground --kill-after=30s 3600 "$0" "$@"
fi
umask 077
PATH=/usr/local/bin:/usr/bin:/bin
export PATH KUBECONFIG=/etc/rancher/k3s/k3s.yaml K3S_CONFIG_FILE=/dev/null
project_id=619656da-14f3-4872-857b-be103cdc5326
infisical_path=/shared-services/backup-recovery
remote_root=drive:cristexweb-recovery/mongodb/shared-mongodb
source_closure_sha256=37bb6333362f3f9553a8611dc81d0a68e2094ce8779db885c3128acaab61bcfc
printf '%s' "$source_closure_sha256" | /usr/bin/grep -Eq '^[0-9a-f]{64}$' || {
  printf '%s\n' 'restore_status=failed stage=source_closure_contract'
  exit 1
}
rclone_config=/home/paul/.config/rclone/rclone.conf
namespace=shared-services
image='quay.io/mongodb/mongodb-community-server:8.0.12-ubi8@sha256:5500852ab0693ac56134cecf5ad45d3b81d25e4681f4f960a834e48cd34fe71b'
run_id=$(/usr/bin/date -u +%Y%m%dt%H%M%Sz | /usr/bin/tr '[:upper:]' '[:lower:]')-$$
pod=mongodb-restore-rehearsal-$run_id
work=$(/usr/bin/mktemp -d /dev/shm/cristexweb-mongodb-restore.XXXXXX)
uid=
restore_label=mongodb-restore-rehearsal
discover_restore_pod() {
  discovery="$work/pod-discovery"
  if ! /usr/local/bin/kubectl -n "$namespace" get pods \
      -l "app.kubernetes.io/name=$restore_label,cristex.io/run-id=$run_id" \
      -o jsonpath='{range .items[*]}{.metadata.name}{"\t"}{.metadata.uid}{"\n"}{end}' >"$discovery"; then
    return 1
  fi
  discovered_count=0
  discovered_name=
  discovered_uid=
  while IFS='	' read -r candidate_name candidate_uid; do
    [ -n "$candidate_name" ] || continue
    discovered_count=$((discovered_count + 1))
    [ "$candidate_name" = "$pod" ] || return 1
    [ -n "$candidate_uid" ] || return 1
    discovered_name="$candidate_name"
    discovered_uid="$candidate_uid"
  done <"$discovery"
  if [ "$discovered_count" -eq 0 ]; then
    return 0
  fi
  [ "$discovered_count" -eq 1 ] && [ "$discovered_name" = "$pod" ] || return 1
  uid="$discovered_uid"
}
delete_restore_pod() {
  if [ -z "$uid" ]; then
    discover_restore_pod || return 1
    [ "$discovered_count" -eq 0 ] && return 0
  fi
  if ! current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}'); then
    return 1
  fi
  [ -z "$current_uid" ] && { uid=; return 0; }
  [ "$current_uid" = "$uid" ] || return 1
  if ! current_owner=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.labels.app\\.kubernetes\\.io/name}'); then
    return 1
  fi
  if ! current_run_id=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.labels.cristex\\.io/run-id}'); then
    return 1
  fi
  [ "$current_owner" = "$restore_label" ] && [ "$current_run_id" = "$run_id" ] || return 1
  /usr/bin/printf '{"kind":"DeleteOptions","apiVersion":"v1","propagationPolicy":"Orphan","preconditions":{"uid":"%s"}}\n' "$uid" >"$work/delete.json"
  /usr/local/bin/kubectl delete --raw "/api/v1/namespaces/$namespace/pods/$pod" -f "$work/delete.json" >/dev/null
  if ! /usr/local/bin/kubectl -n "$namespace" wait --for=delete "pod/$pod" --timeout=120s >/dev/null 2>&1; then
    if ! current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}'); then
      return 1
    fi
    [ -z "$current_uid" ] || return 1
  fi
  if ! current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" --ignore-not-found -o jsonpath='{.metadata.uid}'); then
    return 1
  fi
  [ -z "$current_uid" ] || return 1
  uid=
}
cleanup() {
  trap - EXIT HUP INT TERM
  cleanup_status=0
  delete_restore_pod || cleanup_status=1
  /usr/bin/rm -rf -- "$work" || cleanup_status=1
  if [ "$cleanup_status" -ne 0 ]; then
    printf '%s\n' 'restore_status=failed stage=cleanup' >&2
    exit 1
  fi
}
trap cleanup EXIT HUP INT TERM
chmod 0700 "$work"
archive_leaf=shared-mongodb.archive.gz.age
checksum_leaf=shared-mongodb.archive.gz.age.sha256
select_latest_complete_catalog() {
  expected="$work/expected-leaves"
  expected_sorted="$work/expected-leaves.sorted"
  catalog="$work/catalog-dirs"
  valid="$work/catalog-valid"
  printf '%s\n' "$archive_leaf" "$checksum_leaf" manifest.json >"$expected"
  if ! LC_ALL=C /usr/bin/sort "$expected" >"$expected_sorted"; then
    return 1
  fi
  if ! /usr/local/bin/rclone --config "$rclone_config" lsf --dirs-only "$remote_root" >"$catalog"; then
    return 1
  fi
  : >"$valid"
  latest=
  while IFS='	' read -r raw; do
    candidate=${raw%/}
    [ -n "$candidate" ] || continue
    printf '%s\n' "$candidate" >"$work/catalog-candidate"
    /usr/bin/grep -Eq '^20[0-9]{6}T[0-9]{6}Z$' "$work/catalog-candidate" || continue
    if /usr/bin/grep -Fxq "$candidate" "$valid"; then
      return 1
    fi
    printf '%s\n' "$candidate" >>"$valid"
    listing="$work/catalog-$candidate"
    if ! /usr/local/bin/rclone --config "$rclone_config" lsf --files-only "$remote_root/$candidate" >"$listing"; then
      return 1
    fi
    sorted="$work/catalog-$candidate.sorted"
    if ! LC_ALL=C /usr/bin/sort "$listing" >"$sorted"; then
      return 1
    fi
    if /usr/bin/cmp -s "$sorted" "$expected_sorted"; then
      if [ -z "$latest" ] || [ "$candidate" \> "$latest" ]; then
        latest="$candidate"
      fi
    fi
  done <"$catalog"
  [ -n "$latest" ]
}
if ! select_latest_complete_catalog; then
  printf '%s\n' 'restore_status=failed stage=remote_catalog'
  exit 1
fi
remote="$remote_root/$latest"
for leaf in shared-mongodb.archive.gz.age shared-mongodb.archive.gz.age.sha256 manifest.json; do
  /usr/local/bin/rclone --config "$rclone_config" copyto "$remote/$leaf" "$work/$leaf"
done
(cd "$work" && /usr/bin/sha256sum -c shared-mongodb.archive.gz.age.sha256 >/dev/null)
expected_sha=$(/usr/bin/cut -d ' ' -f 1 "$work/shared-mongodb.archive.gz.age.sha256")
archive_bytes=$(/usr/bin/stat -c %s "$work/shared-mongodb.archive.gz.age")
FILE="$work/manifest.json" TIMESTAMP="$latest" EXPECTED_SHA="$expected_sha" ARCHIVE_BYTES="$archive_bytes" EXPECTED_SOURCE_CLOSURE_SHA256="$source_closure_sha256" /usr/bin/python3 - <<'PY'
import json,os,re
x=json.load(open(os.environ['FILE']))
assert set(x)=={'schema','service','purpose','created_at_utc','archive','archive_bytes','archive_sha256','encryption','source_version','consistency','source_closure_sha256'}
assert x['schema']==1 and x['service']=='mongodb' and x['purpose']=='shared-mongodb'
assert x['created_at_utc']==os.environ['TIMESTAMP'] and x['archive']=='shared-mongodb.archive.gz.age'
assert x['encryption']=='age-x25519' and x['source_version']=='8.0.12' and x['consistency']=='replica-set-oplog'
assert x['archive_sha256']==os.environ['EXPECTED_SHA']
assert x['archive_bytes']==int(os.environ['ARCHIVE_BYTES'])
assert re.fullmatch(r'[0-9a-f]{64}', x['source_closure_sha256'])
assert x['source_closure_sha256']==os.environ['EXPECTED_SOURCE_CLOSURE_SHA256']
PY
/home/paul/.nvm/versions/node/v24.19.0/bin/infisical secrets get SHARED_DATABASE_BACKUP_AGE_IDENTITY \
  --projectId "$project_id" --env prod --path "$infisical_path" --plain --silent >"$work/identity"
chmod 0600 "$work/identity"
/usr/bin/age -d -i "$work/identity" "$work/shared-mongodb.archive.gz.age" >"$work/shared-mongodb.archive.gz" || {
  printf '%s\n' 'restore_status=failed stage=shared_mongodb_decrypt' >&2
  exit 1
}
/usr/bin/gzip -d -c "$work/shared-mongodb.archive.gz" >"$work/shared-mongodb.archive" || {
  printf '%s\n' 'restore_status=failed stage=shared_mongodb_decompress' >&2
  exit 1
}
/usr/bin/rm -f -- "$work/shared-mongodb.archive.gz" "$work/identity"
[ -s "$work/shared-mongodb.archive" ]
/usr/bin/rm -f -- "$work/identity"
cat >"$work/pod.yaml" <<EOF
apiVersion: v1
kind: Pod
metadata:
  name: $pod
  namespace: $namespace
  labels:
    app.kubernetes.io/name: mongodb-restore-rehearsal
    cristex.io/run-id: $run_id
spec:
  automountServiceAccountToken: false
  restartPolicy: Never
  securityContext:
    runAsNonRoot: true
    runAsUser: 2000
    runAsGroup: 2000
    fsGroup: 2000
    seccompProfile: {type: RuntimeDefault}
  initContainers:
    - name: initialize-data-permissions
      image: $image
      imagePullPolicy: IfNotPresent
      command: ["/bin/sh", "-ec", "chown 2000:2000 /data/db && chmod 0700 /data/db"]
      securityContext:
        runAsNonRoot: false
        runAsUser: 0
        runAsGroup: 0
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
          add: ["CHOWN", "FOWNER"]
      resources:
        requests: {cpu: 10m, memory: 32Mi}
        limits: {cpu: 100m, memory: 64Mi}
      volumeMounts:
        - {name: data, mountPath: /data/db}
  containers:
    - name: mongod
      image: $image
      imagePullPolicy: IfNotPresent
      command: ["/bin/sh", "-ec"]
      args: ["exec /usr/bin/mongod --dbpath /data/db --bind_ip 127.0.0.1 --port 27017 --logpath /tmp/mongod.log"]
      securityContext:
        runAsNonRoot: true
        runAsUser: 2000
        runAsGroup: 2000
        allowPrivilegeEscalation: false
        capabilities:
          drop: ["ALL"]
      resources:
        requests: {cpu: 100m, memory: 256Mi}
        limits: {cpu: "1", memory: 1Gi}
      volumeMounts:
        - {name: data, mountPath: /data/db}
        - {name: transfer, mountPath: /restore}
        - {name: tmp, mountPath: /tmp}
      readinessProbe:
        exec:
          command: ["/usr/bin/mongosh", "--quiet", "--norc", "--host", "127.0.0.1", "--eval", "quit(db.adminCommand({ping:1}).ok == 1 ? 0 : 1)"]
        periodSeconds: 2
        failureThreshold: 90
  volumes:
    - {name: data, emptyDir: {}}
    - {name: transfer, emptyDir: {}}
    - {name: tmp, emptyDir: {}}
EOF
/usr/local/bin/kubectl apply -f "$work/pod.yaml" >/dev/null
if ! uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$pod" -o jsonpath='{.metadata.uid}'); then
  uid=
fi
if [ -z "$uid" ]; then
  discover_restore_pod || {
    printf '%s\n' 'restore_status=failed stage=pod_uid_discovery' >&2
    exit 1
  }
fi
[ -n "$uid" ] || {
  printf '%s\n' 'restore_status=failed stage=pod_uid_discovery' >&2
  exit 1
}
/usr/local/bin/kubectl -n "$namespace" wait --for=condition=Ready "pod/$pod" --timeout=240s >/dev/null
/usr/local/bin/kubectl -n "$namespace" cp "$work/shared-mongodb.archive" "$pod:/restore/shared-mongodb.archive" -c mongod >/dev/null
/usr/local/bin/kubectl -n "$namespace" exec "$pod" -c mongod -- \
  /usr/bin/mongorestore --archive=/restore/shared-mongodb.archive --oplogReplay --stopOnError --quiet
/usr/local/bin/kubectl -n "$namespace" exec "$pod" -c mongod -- /usr/bin/mongosh --quiet --norc --host 127.0.0.1 \
  --eval 'EJSON.stringify(db.adminCommand({listDatabases:1,nameOnly:true}).databases.map(x=>x.name).sort())' >"$work/databases.json"
catalog_count=$(FILE="$work/databases.json" /usr/bin/python3 - <<'PY'
import json,os
x=set(json.load(open(os.environ['FILE'])))
assert x <= {'admin','config','local','cristexhub_dev','cristexhub_prod'}
assert {'admin','config','local'} <= x
print(len(x-{'admin','config','local'}))
PY
)
/usr/bin/rm -f -- "$work/shared-mongodb.archive" "$work/databases.json"
delete_restore_pod
printf 'restore_status=success schema=1 source_timestamp=%s source_closure_sha256=%s target=isolated-emptydir application_database_count=%s checksum=verified private_residue=none\n' "$latest" "$source_closure_sha256" "$catalog_count"
