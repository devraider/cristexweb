#!/bin/sh
set -eu
umask 077

PATH=/usr/local/bin:/usr/bin:/bin
export PATH KUBECONFIG=/etc/rancher/k3s/k3s.yaml K3S_CONFIG_FILE=/dev/null

project_id=619656da-14f3-4872-857b-be103cdc5326
infisical_path=/shared-services/backup-recovery
namespace=shared-services
bucket=reactive-resume-dev
service=reactive-resume-object-storage
tls_secret=reactive-resume-object-storage-tls
auth_secret=reactive-resume-object-storage-auth
postgres_image='docker.io/library/postgres:17.10@sha256:dbbeb22a65db2503050cdbbe5e78f017478f10a1002a226463f049dbb017e99b'
seaweed_image='chrislusf/seaweedfs:4.44@sha256:c927ea0755b1d7dd5a3101081e4717126d00e75e89d3142e21df374b0a90acad'
rclone_image='rclone/rclone:1.71.1@sha256:e99b4361672a8e5b41b557979b780a85797aef45a7da49629ad99cd39c59deae'
remote_root=drive:cristexweb-recovery/reactive-resume/dev
rclone_config=/home/paul/.config/rclone/rclone.conf
infisical_launcher=/home/paul/.nvm/versions/node/v24.19.0/bin/infisical
infisical_binary=/home/paul/.nvm/versions/node/v24.19.0/lib/node_modules/@infisical/cli/bin/infisical
infisical_version='0.43.121'
infisical_binary_sha256='21e24f040a09196fb1214873ef964ac74655b172575a78fd95e6c9f2ab1c8940'
lock_file=/run/lock/cristexweb-reactive-resume-dev-backup-restore.lock
declared_rpo_seconds=86400
declared_rto_seconds=14400
shm_path=/dev/shm
shm_reserve_bytes=268435456
shm_min_free_bytes=67108864

fail() { printf 'restore_status=failed stage=%s\n' "$1" >&2; exit 1; }
shm_capacity_preflight() {
  /usr/bin/python3 - "$shm_path" "$shm_reserve_bytes" "$shm_min_free_bytes" "$@" <<'PY'
import os
import sys
path, reserve, minimum, factor, *sizes = sys.argv[1:]
reserve = int(reserve)
minimum = int(minimum)
factor = int(factor)
required = max(minimum, reserve + factor * sum(int(value) for value in sizes))
stat = os.statvfs(path)
available = stat.f_bavail * stat.f_frsize
if available < required:
    raise SystemExit(1)
PY
}
[ "$#" -eq 1 ] && [ "$1" = restore ] || {
  printf '%s\n' 'usage: restore-reactive-resume-dev-backup-rehearsal restore' >&2
  exit 64
}
[ "$(id -u)" -ne 0 ] || fail non_root_operator_required
[ "${CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_ENTRYPOINT-}" = v1 ] || fail approval_entrypoint
[ "${CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_APPROVED-}" = true ] || fail approval_missing
approval_file=${CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_ATTESTATION_FILE-}
token=${CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_TOKEN-}
[ -n "$approval_file" ] && [ -f "$approval_file" ] && [ ! -L "$approval_file" ] || fail approval_attestation
case "$token" in
  ''|*[!0-9a-f]*) fail approval_token ;;
esac
[ "${#token}" -eq 64 ] || fail approval_token
[ "$(/usr/bin/stat -c '%U:%a' "$approval_file")" = "$(id -un):600" ] || fail approval_attestation
[ "$(/usr/bin/cat "$approval_file")" = "$token:restore" ] || fail approval_attestation

exec 9>"$lock_file"
/usr/bin/flock -n 9 || { printf '%s\n' 'restore_status=refused reason=concurrent_run'; exit 75; }
shm_capacity_preflight 8 0 0 || fail shm_capacity
[ -f "$rclone_config" ] && [ ! -L "$rclone_config" ] || fail rclone_config_metadata
[ "$(/usr/bin/stat -c '%U:%G:%a' "$rclone_config")" = 'paul:paul:600' ] || fail rclone_config_metadata
[ -L "$infisical_launcher" ] && [ "$(/usr/bin/readlink -f "$infisical_launcher")" = "$infisical_binary" ] || fail infisical_executable_metadata
[ -f "$infisical_binary" ] && [ ! -L "$infisical_binary" ] || fail infisical_executable_metadata
[ "$(/usr/bin/stat -c '%U:%G:%a' "$infisical_binary")" = 'paul:paul:755' ] || fail infisical_executable_metadata
[ "$(/usr/bin/sha256sum "$infisical_binary" | /usr/bin/cut -d ' ' -f 1)" = "$infisical_binary_sha256" ] || fail infisical_executable_hash
infisical_version_output=$(/usr/bin/env -i HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/local/bin:/usr/bin:/bin LC_ALL=C "$infisical_launcher" --version 2>&1) || fail infisical_version
[ "$infisical_version_output" = "infisical version $infisical_version" ] || fail infisical_version
remotes=$(/usr/local/bin/rclone --config "$rclone_config" listremotes --long)
[ "$remotes" = 'drive: drive' ] || fail rclone_remote_contract

work=$(/usr/bin/mktemp -d "$shm_path/cristexweb-reactive-resume-dev-restore.XXXXXX")
pg_uid=
pg_pod=
storage_uid=
storage_pod=
pg_policy_uid=
storage_policy_uid=
run_id=
pod_run_id=
cleanup_pod() {
  name=$1
  uid=$2
  expected_name=$3
  [ -n "$name" ] || return 0
  if [ -z "$uid" ]; then
    uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$name" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
    [ -n "$uid" ] || return 0
  fi
  current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$name" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
  [ -n "$current_uid" ] || return 0
  current_name=$(/usr/local/bin/kubectl -n "$namespace" get pod "$name" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}') || return 1
  current_run_id=$(/usr/local/bin/kubectl -n "$namespace" get pod "$name" -o jsonpath='{.metadata.labels.cristex\.io/run-id}') || return 1
  [ "$current_uid" = "$uid" ] && [ "$current_name" = "$expected_name" ] && [ "$current_run_id" = "$pod_run_id" ] || return 1
  /usr/bin/printf '{"kind":"DeleteOptions","apiVersion":"v1","propagationPolicy":"Orphan","preconditions":{"uid":"%s"}}\n' "$uid" >"$work/delete-$name.json"
  /usr/local/bin/kubectl delete --raw "/api/v1/namespaces/$namespace/pods/$name" -f "$work/delete-$name.json" >/dev/null || return 1
  if ! /usr/local/bin/kubectl -n "$namespace" wait --for=delete "pod/$name" --timeout=120s >/dev/null 2>&1; then
    current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$name" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
    [ -z "$current_uid" ] || return 1
  fi
  current_uid=$(/usr/local/bin/kubectl -n "$namespace" get pod "$name" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
  [ -z "$current_uid" ] || return 1
}
cleanup_policy() {
  name=$1
  uid=$2
  expected_name=$3
  [ -n "$name" ] || return 0
  if [ -z "$uid" ]; then
    uid=$(/usr/local/bin/kubectl -n "$namespace" get networkpolicy "$name" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
    [ -n "$uid" ] || return 0
  fi
  current_uid=$(/usr/local/bin/kubectl -n "$namespace" get networkpolicy "$name" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
  [ -n "$current_uid" ] || return 0
  current_name=$(/usr/local/bin/kubectl -n "$namespace" get networkpolicy "$name" -o jsonpath='{.metadata.labels.app\.kubernetes\.io/name}') || return 1
  current_run_id=$(/usr/local/bin/kubectl -n "$namespace" get networkpolicy "$name" -o jsonpath='{.metadata.labels.cristex\.io/run-id}') || return 1
  current_component=$(/usr/local/bin/kubectl -n "$namespace" get networkpolicy "$name" -o jsonpath='{.metadata.labels.cristex\.io/component}') || return 1
  [ "$current_uid" = "$uid" ] && [ "$current_name" = "$expected_name" ] && [ "$current_run_id" = "$pod_run_id" ] && [ "$current_component" = restore-networkpolicy ] || return 1
  /usr/bin/printf '{"kind":"DeleteOptions","apiVersion":"v1","preconditions":{"uid":"%s"}}\n' "$uid" >"$work/delete-policy-$name.json"
  /usr/local/bin/kubectl delete --raw "/apis/networking.k8s.io/v1/namespaces/$namespace/networkpolicies/$name" -f "$work/delete-policy-$name.json" >/dev/null || return 1
  current_uid=$(/usr/local/bin/kubectl -n "$namespace" get networkpolicy "$name" --ignore-not-found -o jsonpath='{.metadata.uid}') || return 1
  [ -z "$current_uid" ]
}
cleanup() {
  trap - EXIT HUP INT TERM
  cleanup_status=0
  cleanup_pod "${pg_pod:-}" "${pg_uid:-}" reactive-resume-dev-postgresql-restore || cleanup_status=1
  cleanup_pod "${storage_pod:-}" "${storage_uid:-}" reactive-resume-dev-storage-restore || cleanup_status=1
  cleanup_policy "${pg_policy:-}" "${pg_policy_uid:-}" reactive-resume-dev-postgresql-restore || cleanup_status=1
  cleanup_policy "${storage_policy:-}" "${storage_policy_uid:-}" reactive-resume-dev-storage-restore || cleanup_status=1
  /usr/bin/rm -rf -- "$work" || cleanup_status=1
  if [ "$cleanup_status" -ne 0 ]; then
    printf 'restore_status=failed stage=cleanup\n' >&2
    exit 1
  fi
}
trap cleanup EXIT HUP INT TERM
/usr/bin/chmod 0700 "$work"
restore_start_epoch=$(/usr/bin/date +%s)

# Select only a complete timestamp directory; partial immutable uploads are ignored.
/usr/local/bin/rclone --config "$rclone_config" lsf --dirs-only "$remote_root" >"$work/candidates.raw" || fail remote_catalog
/usr/bin/python3 - "$work/candidates.raw" "$work/candidates" <<'PY'
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    values = sorted((line.rstrip("/\n") for line in source if line.strip()), reverse=True)
with open(sys.argv[2], "w", encoding="utf-8") as target:
    target.write("\n".join(values))
    target.write("\n" if values else "")
PY
selected=
expected_leaves='object-storage.manifest.json
object-storage.tar.gz.age
object-storage.tar.gz.age.sha256
postgresql.dump.gz.age
postgresql.dump.gz.age.sha256
postgresql.manifest.json
run-manifest.json'
while IFS= read -r candidate; do
  [ -n "$candidate" ] || continue
  case "$candidate" in
    20[0-9][0-9][0-9][0-9][0-9][0-9]T[0-9][0-9][0-9][0-9][0-9][0-9]Z) ;;
    *) continue ;;
  esac
  /usr/local/bin/rclone --config "$rclone_config" lsf --files-only "$remote_root/$candidate" >"$work/leaves.raw" || fail remote_catalog
  /usr/bin/python3 - "$work/leaves.raw" "$work/leaves" <<'PY'
import sys
with open(sys.argv[1], encoding="utf-8") as source:
    values = sorted(line.rstrip("\n") for line in source if line.strip())
with open(sys.argv[2], "w", encoding="utf-8") as target:
    target.write("\n".join(values))
    target.write("\n" if values else "")
PY
  leaves=$(/usr/bin/cat "$work/leaves")
  [ "$leaves" = "$expected_leaves" ] || continue
  selected=$candidate
  break
done <"$work/candidates"
[ -n "$selected" ] || fail remote_catalog
run_id=$selected
pod_run_id=$(/usr/bin/printf '%s' "$run_id" | /usr/bin/tr '[:upper:]' '[:lower:]')
remote="$remote_root/$run_id"
/usr/local/bin/rclone --config "$rclone_config" size --json "$remote/postgresql.dump.gz.age" >"$work/postgresql-size.json" || fail remote_catalog
/usr/local/bin/rclone --config "$rclone_config" size --json "$remote/object-storage.tar.gz.age" >"$work/object-size.json" || fail remote_catalog
postgresql_remote_archive_bytes=$(/usr/bin/python3 - "$work/postgresql-size.json" <<'PY'
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
assert isinstance(value.get("bytes"), int) and value["bytes"] > 0
print(value["bytes"])
PY
) || fail remote_catalog
object_remote_archive_bytes=$(/usr/bin/python3 - "$work/object-size.json" <<'PY'
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
assert isinstance(value.get("bytes"), int) and value["bytes"] > 0
print(value["bytes"])
PY
) || fail remote_catalog
shm_capacity_preflight 8 "$postgresql_remote_archive_bytes" "$object_remote_archive_bytes" || fail shm_capacity
for leaf in object-storage.manifest.json object-storage.tar.gz.age object-storage.tar.gz.age.sha256 postgresql.dump.gz.age postgresql.dump.gz.age.sha256 postgresql.manifest.json run-manifest.json; do
  /usr/local/bin/rclone --config "$rclone_config" copyto "$remote/$leaf" "$work/$leaf" || fail remote_download
done
pg_actual_sha256=$(/usr/bin/sha256sum "$work/postgresql.dump.gz.age" | /usr/bin/cut -d ' ' -f 1)
object_actual_sha256=$(/usr/bin/sha256sum "$work/object-storage.tar.gz.age" | /usr/bin/cut -d ' ' -f 1)
[ "$(/usr/bin/cat "$work/postgresql.dump.gz.age.sha256")" = "$pg_actual_sha256  postgresql.dump.gz.age" ] || fail postgresql_checksum
[ "$(/usr/bin/cat "$work/object-storage.tar.gz.age.sha256")" = "$object_actual_sha256  object-storage.tar.gz.age" ] || fail object_checksum
(cd "$work" && /usr/bin/sha256sum -c postgresql.dump.gz.age.sha256 >/dev/null) || fail postgresql_checksum
(cd "$work" && /usr/bin/sha256sum -c object-storage.tar.gz.age.sha256 >/dev/null) || fail object_checksum
pg_actual_bytes=$(/usr/bin/stat -c %s "$work/postgresql.dump.gz.age")
object_actual_bytes=$(/usr/bin/stat -c %s "$work/object-storage.tar.gz.age")
RUN_MANIFEST="$work/run-manifest.json" PG_MANIFEST="$work/postgresql.manifest.json" OBJECT_MANIFEST="$work/object-storage.manifest.json" RUN_ID="$run_id" PG_ACTUAL_SHA256="$pg_actual_sha256" OBJECT_ACTUAL_SHA256="$object_actual_sha256" PG_ACTUAL_BYTES="$pg_actual_bytes" OBJECT_ACTUAL_BYTES="$object_actual_bytes" /usr/bin/python3 - <<'PY' || fail manifest_contract
import json, os
from datetime import datetime, timezone
run = json.load(open(os.environ["RUN_MANIFEST"], encoding="utf-8"))
pg = json.load(open(os.environ["PG_MANIFEST"], encoding="utf-8"))
obj = json.load(open(os.environ["OBJECT_MANIFEST"], encoding="utf-8"))
assert set(run) == {"schema", "service", "run_id", "created_at_utc", "completed_at_utc", "backup_duration_seconds", "encryption", "database", "object_storage"}
assert run["schema"] == 2 and run["service"] == "reactive-resume-dev"
assert run["run_id"] == os.environ["RUN_ID"] and run["created_at_utc"] == os.environ["RUN_ID"] and run["encryption"] == "age-x25519"
completion = datetime.strptime(run["completed_at_utc"], "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc)
started = datetime.strptime(run["run_id"], "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc)
assert completion >= started
assert isinstance(run["backup_duration_seconds"], int) and run["backup_duration_seconds"] >= 0
assert set(run["database"]) == {"name", "archive", "bytes", "sha256", "logical_entry_count", "logical_table_count"}
assert run["database"]["name"] == "reactive_resume_dev_successor"
assert run["database"]["archive"] == "postgresql.dump.gz.age"
assert run["database"]["logical_entry_count"] > 0 and run["database"]["logical_table_count"] > 0
assert set(run["object_storage"]) == {"bucket", "archive", "bytes", "sha256", "object_count", "total_object_bytes"}
assert run["object_storage"]["bucket"] == "reactive-resume-dev"
assert run["object_storage"]["archive"] == "object-storage.tar.gz.age"
assert isinstance(run["object_storage"]["object_count"], int) and run["object_storage"]["object_count"] > 0
assert isinstance(run["object_storage"]["total_object_bytes"], int) and run["object_storage"]["total_object_bytes"] > 0
assert set(pg) == {"schema", "service", "database", "run_id", "completed_at_utc", "archive", "archive_bytes", "archive_sha256", "encryption", "source_cluster", "logical_entry_count", "logical_table_count"}
assert pg["schema"] == 2 and pg["run_id"] == os.environ["RUN_ID"] and pg["completed_at_utc"] == run["completed_at_utc"] and pg["database"] == "reactive_resume_dev_successor"
assert pg["archive_bytes"] > 0 and run["database"]["bytes"] == pg["archive_bytes"] == int(os.environ["PG_ACTUAL_BYTES"])
assert pg["archive_sha256"] == os.environ["PG_ACTUAL_SHA256"]
assert pg["logical_entry_count"] == run["database"]["logical_entry_count"] and pg["logical_table_count"] == run["database"]["logical_table_count"]
assert set(obj) == {"schema", "service", "bucket", "run_id", "completed_at_utc", "archive", "archive_bytes", "archive_sha256", "encryption", "object_count", "total_object_bytes", "objects"}
assert obj["schema"] == 2 and obj["service"] == "seaweedfs"
assert obj["run_id"] == os.environ["RUN_ID"] and obj["completed_at_utc"] == run["completed_at_utc"] and obj["bucket"] == "reactive-resume-dev"
assert isinstance(obj["objects"], list) and len(obj["objects"]) == obj["object_count"] > 0
assert obj["total_object_bytes"] == sum(item["size"] for item in obj["objects"]) > 0
keys = set()
for item in obj["objects"]:
    assert set(item) == {"key", "size", "sha256", "md5"}
    assert isinstance(item["key"], str) and item["key"] not in keys and item["key"].startswith(("uploads/user-pictures/", "pictures/", "uploads/user-agent/"))
    assert isinstance(item["size"], int) and item["size"] >= 0
    assert isinstance(item["sha256"], str) and len(item["sha256"]) == 64 and all(char in "0123456789abcdef" for char in item["sha256"])
    assert item["md5"] is None or (isinstance(item["md5"], str) and len(item["md5"]) == 32)
    keys.add(item["key"])
assert obj["archive_bytes"] > 0 and run["object_storage"]["bytes"] == obj["archive_bytes"] == int(os.environ["OBJECT_ACTUAL_BYTES"])
assert obj["archive_sha256"] == os.environ["OBJECT_ACTUAL_SHA256"]
assert run["object_storage"]["object_count"] == obj["object_count"]
assert run["object_storage"]["total_object_bytes"] == obj["total_object_bytes"]
assert run["database"]["sha256"] == pg["archive_sha256"]
assert run["object_storage"]["sha256"] == obj["archive_sha256"]
PY
object_source_bytes=$(/usr/bin/python3 - "$work/object-storage.manifest.json" <<'PY'
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))
assert isinstance(value.get("total_object_bytes"), int) and value["total_object_bytes"] > 0
print(value["total_object_bytes"])
PY
) || fail object_manifest_capacity
shm_capacity_preflight 8 "$postgresql_remote_archive_bytes" "$object_remote_archive_bytes" "$object_source_bytes" || fail shm_capacity
backup_duration_seconds=$(/usr/bin/python3 - "$work/run-manifest.json" <<'PY'
import json, sys
value = json.load(open(sys.argv[1], encoding="utf-8"))["backup_duration_seconds"]
assert isinstance(value, int) and value >= 0
print(value)
PY
)
case "$backup_duration_seconds" in
  ''|*[!0-9]*) fail backup_duration_contract ;;
esac
expected_pg_table_count=$(/usr/bin/python3 - "$work/run-manifest.json" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    value = json.load(stream)["database"]["logical_table_count"]
assert isinstance(value, int) and value > 0
print(value)
PY
) || fail pg_manifest_content
backup_completed_epoch=$(/usr/bin/python3 - "$work/run-manifest.json" <<'PY'
import json, sys
from datetime import datetime, timezone
with open(sys.argv[1], encoding="utf-8") as stream:
    value = json.load(stream)["completed_at_utc"]
print(int(datetime.strptime(value, "%Y%m%dT%H%M%SZ").replace(tzinfo=timezone.utc).timestamp()))
PY
) || fail completion_timestamp
restore_reference_epoch=$(/usr/bin/date +%s)
[ "$restore_reference_epoch" -ge "$backup_completed_epoch" ] || fail clock_skew

# Retrieve the age identity only for this explicitly approved restore.
"$infisical_launcher" secrets get SHARED_DATABASE_BACKUP_AGE_IDENTITY \
  --projectId "$project_id" --env prod --path "$infisical_path" --plain --silent >"$work/identity" || fail infisical_identity
/usr/bin/chmod 0600 "$work/identity"
/usr/bin/age -d -i "$work/identity" "$work/postgresql.dump.gz.age" >"$work/postgresql.dump.gz" || fail postgresql_decrypt
/usr/bin/gzip -d -c "$work/postgresql.dump.gz" >"$work/postgresql.dump" || fail postgresql_decompress
/usr/bin/age -d -i "$work/identity" "$work/object-storage.tar.gz.age" >"$work/object-storage.tar.gz" || fail object_decrypt
/usr/bin/rm -f -- "$work/identity" "$work/postgresql.dump.gz.age" "$work/object-storage.tar.gz.age" "$work/postgresql.dump.gz.age.sha256" "$work/object-storage.tar.gz.age.sha256" "$work/postgresql.dump.gz"
[ -s "$work/postgresql.dump" ] || fail pg_archive_empty
pg_plain_bytes=$(/usr/bin/stat -c %s "$work/postgresql.dump")
object_plain_bytes=$(/usr/bin/stat -c %s "$work/object-storage.tar.gz")
shm_capacity_preflight 2 "$pg_plain_bytes" "$object_plain_bytes" "$object_source_bytes" || fail shm_capacity
/usr/bin/pg_restore --list "$work/postgresql.dump" >"$work/restored-postgresql.list" || fail restored_pg_logical_list
restored_pg_counts=$(/usr/bin/python3 - "$work/restored-postgresql.list" <<'PY'
import re, sys
with open(sys.argv[1], encoding="utf-8") as stream:
    entries = [line for line in stream if line.strip() and not line.startswith(";")]
table_entry = re.compile(r"^\d+;\s+\d+\s+\d+\s+TABLE\s+(?!DATA\s|ATTACH\s)")
tables = [line for line in entries if table_entry.match(line)]
assert entries and tables
print(f"{len(entries)}:{len(tables)}")
PY
) || fail restored_pg_logical_content
restored_pg_logical_entry_count=${restored_pg_counts%%:*}
restored_pg_logical_table_count=${restored_pg_counts#*:}
[ "$restored_pg_logical_entry_count" -gt 0 ] && [ "$restored_pg_logical_table_count" -gt 0 ] || fail restored_pg_logical_content
[ -s "$work/object-storage.tar.gz" ] || fail object_archive_empty

# Validate object archive paths before extraction.
/usr/bin/tar -tzf "$work/object-storage.tar.gz" >"$work/tar-list" || fail object_archive_list
TAR_LIST="$work/tar-list" /usr/bin/python3 - <<'PY' || fail object_archive_paths
import os
for raw in open(os.environ["TAR_LIST"], encoding="utf-8"):
    path = raw.rstrip("\n")
    if path.startswith("/") or ".." in path.split("/") or "\\" in path or "\x00" in path or not path.startswith("objects/"):
        raise SystemExit(1)
PY
/usr/bin/rm -f -- "$work/tar-list"
/usr/bin/install -d -m 0700 "$work/object-verify"
shm_capacity_preflight 1 "$object_source_bytes" || fail shm_capacity
/usr/bin/tar -xzf "$work/object-storage.tar.gz" -C "$work/object-verify" || fail object_archive_extract
OBJECT_MANIFEST="$work/object-storage.manifest.json" OBJECT_ROOT="$work/object-verify/objects" TSV="$work/objects.tsv" /usr/bin/python3 - <<'PY' || fail object_archive_manifest
import hashlib, json, os
manifest = json.load(open(os.environ["OBJECT_MANIFEST"], encoding="utf-8"))
root = os.path.abspath(os.environ["OBJECT_ROOT"])
expected = {item["key"]: item for item in manifest["objects"]}
allowed_prefixes = ("uploads/user-pictures/", "pictures/", "uploads/user-agent/")
for key in expected:
    assert isinstance(key, str) and key and not key.startswith("/")
    assert ".." not in key.split("/") and "\\" not in key and "\x00" not in key
    assert key.startswith(allowed_prefixes)
    assert os.path.commonpath((root, os.path.abspath(os.path.join(root, key)))) == root
actual = set()
with open(os.environ["TSV"], "w", encoding="utf-8") as tsv:
    for key, item in sorted(expected.items()):
        path = os.path.join(root, key)
        assert os.path.isfile(path) and not os.path.islink(path)
        assert os.stat(path).st_size == item["size"]
        digest = hashlib.sha256()
        with open(path, "rb") as source:
            for chunk in iter(lambda: source.read(1024 * 1024), b""):
                digest.update(chunk)
        assert digest.hexdigest() == item["sha256"]
        actual.add(key)
        tsv.write(f"{key}\t{item['size']}\t{item['sha256']}\n")
for base, dirs, files in os.walk(root, followlinks=False):
    for name in files:
        path = os.path.join(base, name)
        assert not os.path.islink(path)
        assert os.path.relpath(path, root) in expected
assert actual == set(expected)
PY

