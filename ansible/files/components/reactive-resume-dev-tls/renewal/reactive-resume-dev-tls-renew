#!/bin/sh
set -eu
umask 077

PATH=/home/paul/.nvm/versions/node/v24.19.0/bin:/usr/local/bin:/usr/bin:/bin
export PATH

usage='usage: reactive-resume-dev-tls-renew renew'
[ "$#" -eq 1 ] && [ "$1" = renew ] || {
  printf '%s\n' "$usage" >&2
  exit 64
}

hostname=resume-dev.cristex-soft.com
challenge_name=_acme-challenge.resume-dev.cristex-soft.com
zone_id=3cbee16e56d7656440f93e685807e779
account_id=8b0f511214c7a4a52ddfb62ca92c5e80
project_id=619656da-14f3-4872-857b-be103cdc5326
environment=prod
infisical_path=/reactive-resume/dev/tls
cloudflare_token_file=/home/paul/.config/cristexweb/cloudflare-argo-dns-token
state_root=/var/lib/cristexweb/reactive-resume-dev-tls
work_root=$state_root/work
certbot_dir=$state_root/certbot
lock_file=/run/lock/cristexweb-reactive-resume-dev-tls-renew.lock
certbot=/usr/bin/certbot
# Pinned user-owned Infisical standalone binary; the service runs as paul.
infisical=/home/paul/.nvm/versions/node/v24.19.0/lib/node_modules/@infisical/cli/bin/infisical
validator=/usr/local/libexec/cristexweb/validate-reactive-resume-dev-tls-material
kubectl=/usr/local/bin/kubectl
kubeconfig=/etc/rancher/k3s/k3s.yaml
system_ca=/etc/ssl/certs/ca-certificates.crt
minimum_remaining_seconds=2592000
# The InfisicalStaticSecret source is contractually refreshInterval=1h and
# instantUpdates=false. Wait one full interval plus a 15-minute safety margin;
# shortening this window would turn a normal delayed reconcile into rollback.
infisical_sync_interval_seconds=3600
convergence_grace_seconds=900
convergence_timeout_seconds=$((infisical_sync_interval_seconds + convergence_grace_seconds))
convergence_command_timeout_seconds=30
convergence_interval_seconds=5
convergence_attempts=$(( (convergence_timeout_seconds + convergence_interval_seconds - 1) / convergence_interval_seconds ))
certbot_package_version=4.0.0-2+deb13u1
dns_cloudflare_package_version=4.0.0-1
infisical_cli_version=0.43.121

fail() {
  printf 'tls_renewal_status=failed stage=%s\n' "$1" >&2
  exit 1
}

[ "$(id -u)" -ne 0 ] || fail non_root_operator_required
[ -r "$system_ca" ] || fail system_ca_missing
[ -z "${INFISICAL_TOKEN+x}" ] || fail secret_environment_forbidden
[ -z "${INFISICAL_SERVICE_TOKEN+x}" ] || fail secret_environment_forbidden
[ -z "${INFISICAL_UNIVERSAL_AUTH_CLIENT_SECRET+x}" ] || fail secret_environment_forbidden

[ -d "$state_root" ] && [ ! -L "$state_root" ] || fail state_root_metadata
[ "$(stat -c '%U:%G:%a' "$state_root")" = 'paul:paul:700' ] || fail state_root_metadata
if [ -e "$work_root" ] || [ -L "$work_root" ]; then
  [ -d "$work_root" ] && [ ! -L "$work_root" ] || fail work_root_metadata
  [ "$(stat -c '%U:%G:%a' "$work_root")" = 'paul:paul:700' ] || fail work_root_metadata
else
  mkdir -m 0700 "$work_root"
fi
if [ -e "$certbot_dir" ] || [ -L "$certbot_dir" ]; then
  [ -d "$certbot_dir" ] && [ ! -L "$certbot_dir" ] || fail certbot_state_metadata
  [ "$(stat -c '%U:%G:%a' "$certbot_dir")" = 'paul:paul:700' ] || fail certbot_state_metadata
else
  mkdir -m 0700 "$certbot_dir"
fi
chmod 0700 "$work_root" "$certbot_dir"

exec 9>"$lock_file"
flock -n 9 || {
  printf '%s\n' 'tls_renewal_status=skipped reason=concurrent_run'
  exit 0
}

work=''
cloudflare_config=''
owned_challenge_ids=''
infisical_before=''
infisical_before_cert=''
infisical_before_key=''
infisical_rotation_armed=0
infisical_new_revision=''

extract_infisical_key() {
  wanted=$1
  input=$2
  output=$3
  awk -v wanted="$wanted" '
    $0 ~ ("^" wanted ":") {section=1; next}
    section && /^[^[:space:]][^:]*:/ {exit}
    section && /^  / {sub(/^  /, ""); print}
  ' "$input" >"$output"
  chmod 0600 "$output"
}

material_revision() {
  {
    sha256sum "$1" | awk '{print $1}'
    sha256sum "$2" | awk '{print $1}'
  } | sha256sum | awk '{print $1}'
}

verify_infisical_key_set() {
  input=$1
  output=$2
  /usr/bin/awk '/^[^[:space:]][^:]*:/{line=$0; sub(/:.*/, "", line); print line}' "$input" |
    LC_ALL=C /usr/bin/sort >"$output"
  chmod 0600 "$output"
  /usr/bin/cmp -s "$output" "$infisical_keys_expected"
}

certificate_fingerprint() {
  openssl x509 -in "$1" -outform DER |
    sha256sum | awk '{print $1}'
}

certificate_san_set() {
  openssl x509 -in "$1" -noout -ext subjectAltName |
    awk '/Subject Alternative Name/{capture=1; next} capture && /^[^[:space:]]/{exit} capture{gsub(/[[:space:]]/, ""); printf "%s", $0} END{print ""}'
}

certificate_expiry() {
  openssl x509 -in "$1" -noout -enddate | sed 's/^notAfter=//'
}

validate_existing_certificate_pair() {
  existing_certificate=$1
  existing_private_key=$2
  openssl x509 -in "$existing_certificate" -noout -checkhost "$hostname" >/dev/null 2>&1 || return 1
  [ "$(certificate_san_set "$existing_certificate")" = "DNS:$hostname" ] || return 1
  existing_certificate_key=$(
    openssl x509 -in "$existing_certificate" -pubkey -noout |
      openssl pkey -pubin -outform DER | sha256sum | awk '{print $1}'
  )
  existing_private_key_key=$(
    openssl pkey -in "$existing_private_key" -pubout -outform DER |
      sha256sum | awk '{print $1}'
  )
  [ "$existing_certificate_key" = "$existing_private_key_key" ]
}

convergence_remaining_seconds() {
  now=$(/usr/bin/date +%s)
  [ "$now" -lt "$convergence_deadline" ] || return 1
  remaining=$((convergence_deadline - now))
  if [ "$remaining" -gt "$convergence_command_timeout_seconds" ]; then
    remaining=$convergence_command_timeout_seconds
  fi
  [ "$remaining" -gt 0 ] || return 1
  printf '%s\n' "$remaining"
}

run_convergence_command() {
  command_timeout=$(convergence_remaining_seconds) || return 124
  /usr/bin/timeout "$command_timeout" "$@"
}

wait_for_convergence_interval() {
  remaining=$(convergence_remaining_seconds) || return 1
  sleep_seconds=$convergence_interval_seconds
  if [ "$remaining" -lt "$sleep_seconds" ]; then
    sleep_seconds=$remaining
  fi
  /usr/bin/sleep "$sleep_seconds"
}

wait_for_runtime_convergence() {
  convergence_deadline=$(( $(/usr/bin/date +%s) + convergence_timeout_seconds ))
  convergence_attempt=0
  materialized_cert=$work/materialized-tls.crt
  materialized_key=$work/materialized-tls.key
  materialized_cert_b64=$work/materialized-tls.crt.b64
  materialized_key_b64=$work/materialized-tls.key.b64
  materialized_type=$work/materialized-type
  materialized_version=$work/materialized-version
  reconcile_status=$work/infisical-reconcile-status
  served_handshake=$work/convergence-handshake.pem
  served_cert=$work/convergence-served.crt
  while [ "$convergence_attempt" -lt "$convergence_attempts" ]; do
    convergence_attempt=$((convergence_attempt + 1))
    reconcile_status_value=$(
      run_convergence_command "$kubectl" --kubeconfig="$kubeconfig" -n cristexhub-dev \
        get infisicalstaticsecret reactive-resume-dev-tls \
        -o 'jsonpath={.status.conditions[?(@.type=="secrets.infisical.com/LastReconcileStatus")].status}' \
        2>/dev/null || true
    )
    printf '%s' "$reconcile_status_value" >"$reconcile_status"
    [ "$reconcile_status_value" = True ] || {
      wait_for_convergence_interval || return 1
      continue
    }
    materialized_type_value=$(
      run_convergence_command "$kubectl" --kubeconfig="$kubeconfig" -n cristexhub-dev \
        get secret reactive-resume-dev-tls -o jsonpath='{.type}' 2>/dev/null || true
    )
    [ "$materialized_type_value" = kubernetes.io/tls ] || {
      wait_for_convergence_interval || return 1
      continue
    }
    materialized_version_value=$(
      run_convergence_command "$kubectl" --kubeconfig="$kubeconfig" -n cristexhub-dev \
        get secret reactive-resume-dev-tls \
        -o 'jsonpath={.metadata.annotations.secrets\.infisical\.com/version}' \
        2>/dev/null || true
    )
    [ -n "$materialized_version_value" ] || {
      wait_for_convergence_interval || return 1
      continue
    }
    if ! run_convergence_command "$kubectl" --kubeconfig="$kubeconfig" -n cristexhub-dev \
        get secret reactive-resume-dev-tls -o 'jsonpath={.data.tls\.crt}' \
        >"$materialized_cert_b64" 2>/dev/null ||
       ! /usr/bin/timeout 5 /usr/bin/base64 --decode "$materialized_cert_b64" >"$materialized_cert"; then
      wait_for_convergence_interval || return 1
      continue
    fi
    if ! run_convergence_command "$kubectl" --kubeconfig="$kubeconfig" -n cristexhub-dev \
        get secret reactive-resume-dev-tls -o 'jsonpath={.data.tls\.key}' \
        >"$materialized_key_b64" 2>/dev/null ||
       ! /usr/bin/timeout 5 /usr/bin/base64 --decode "$materialized_key_b64" >"$materialized_key"; then
      wait_for_convergence_interval || return 1
      continue
    fi
    chmod 0600 "$materialized_cert" "$materialized_key"
    if ! cmp -s "$certificate" "$materialized_cert" ||
       ! cmp -s "$private_key" "$materialized_key"; then
      wait_for_convergence_interval || return 1
      continue
    fi
    if ! run_convergence_command openssl s_client -connect "$hostname:443" -servername "$hostname" \
        -verify_hostname "$hostname" -verify_return_error -CAfile "$system_ca" \
        -showcerts </dev/null >"$served_handshake" 2>/dev/null; then
      wait_for_convergence_interval || return 1
      continue
    fi
    /usr/bin/awk '/-----BEGIN CERTIFICATE-----/{capture=1} capture{print} /-----END CERTIFICATE-----/{exit}' \
      "$served_handshake" >"$served_cert"
    if [ -s "$served_cert" ] &&
       run_convergence_command openssl x509 -in "$served_cert" -noout -checkhost "$hostname" >/dev/null 2>&1 &&
       [ "$(certificate_fingerprint "$served_cert")" = "$expected_certificate_fingerprint" ] &&
       [ "$(certificate_san_set "$served_cert")" = "$expected_certificate_san_set" ] &&
       [ "$(certificate_expiry "$served_cert")" = "$expected_certificate_expiry" ]; then
      return 0
    fi
    wait_for_convergence_interval || return 1
  done
  return 1
}

rollback_owned_infisical_state() {
  current=$work/infisical-rollback-current.yaml
  current_cert=$work/infisical-rollback-current.crt
  current_key=$work/infisical-rollback-current.key
  rollback_readback=$work/infisical-rollback-readback.yaml
  current_keys=$work/infisical-rollback-current-keys
  [ -s "${infisical_before_cert:-}" ] && [ -s "${infisical_before_key:-}" ] || return 1
  # Infisical exposes no CAS/If-Match write. A read/check followed by
  # secrets set could overwrite a concurrent writer between those operations;
  # therefore unattended rollback is deliberately refused and fails closed.
  "$infisical" export --env "$environment" --projectId "$project_id" \
    --path "$infisical_path" --format yaml --silent >"$current" 2>/dev/null || return 1
  chmod 0600 "$current"
  verify_infisical_key_set "$current" "$current_keys" || return 1
  extract_infisical_key TLS_CRT "$current" "$current_cert"
  extract_infisical_key TLS_KEY "$current" "$current_key"
  [ "$(material_revision "$current_cert" "$current_key")" = "${infisical_new_revision:-}" ] || {
    printf '%s\n' 'tls_renewal_status=failed stage=infisical_rollback reason=concurrent_remote_change no_cas_fail_closed' >&2
    return 1
  }
  # Keep a sanitized readback filename for evidence naming, but never write
  # stale pre-state without an atomic remote compare-and-set operation.
  cp "$current" "$rollback_readback"
  chmod 0600 "$rollback_readback"
  printf '%s\n' 'tls_renewal_status=failed stage=infisical_rollback reason=no_cas_fail_closed' >&2
  return 1
}

challenge_cleanup_armed=0
cleanup() {
  status=$?
  trap - EXIT HUP INT TERM
  if [ "${challenge_cleanup_armed:-0}" -eq 1 ] && [ -f "${cloudflare_config:-}" ]; then
    if ! cleanup_challenge_records; then
      printf '%s\n' 'tls_renewal_status=failed stage=challenge_cleanup' >&2
      status=1
    fi
  fi
  if [ "$status" -ne 0 ] && [ "${infisical_rotation_armed:-0}" -eq 1 ] &&
     [ -n "${infisical_new_revision:-}" ] && [ -s "${infisical_before:-}" ]; then
    if ! rollback_owned_infisical_state; then
      printf '%s\n' 'tls_renewal_status=failed stage=infisical_rollback reason=no_cas_fail_closed' >&2
      status=1
    fi
  fi
  if [ -n "${work:-}" ]; then
    /usr/bin/rm -rf -- "$work"
  fi
  exit "$status"
}
trap cleanup EXIT HUP INT TERM
work=$(/usr/bin/mktemp -d "$work_root.XXXXXX")
chmod 0700 "$work"
owned_challenge_ids=$work/owned-challenge-ids
: >"$owned_challenge_ids"

cloudflare_config=$work/cloudflare.conf

cf_api() {
  method=$1
  url=$2
  output=$3
  if [ "$#" -eq 4 ]; then
    body=$4
    /usr/bin/curl --silent --show-error --fail --proto '=https' --tlsv1.2 \
      --connect-timeout 15 --max-time 60 \
      --config "$cloudflare_config" --request "$method" --url "$url" \
      --data-binary "@$body" --output "$output" >/dev/null 2>&1
  else
    /usr/bin/curl --silent --show-error --fail --proto '=https' --tlsv1.2 \
      --connect-timeout 15 --max-time 60 \
      --config "$cloudflare_config" --request "$method" --url "$url" \
      --output "$output" >/dev/null 2>&1
  fi
}

cf_json_success() {
  /usr/bin/grep -Eq '"success"[[:space:]]*:[[:space:]]*true' "$1"
}

cf_json_compact() {
  /usr/bin/tr -d '[:space:]' <"$1"
}

cf_records_empty() {
  cf_json_compact "$1" | /usr/bin/grep -Fq '"result":[]'
}

cleanup_challenge_records() {
  records=$work/challenge-cleanup.json
  # Delete only record IDs created by this process (the scope probe). Never
  # infer ownership from an exact-name listing: another actor may have added a
  # TXT record after preflight. Unknown leftovers therefore fail closed.
  [ -f "$owned_challenge_ids" ] || return 1
  while IFS= read -r record_id; do
    [ -n "$record_id" ] || continue
    deleted=$work/challenge-delete.json
    cf_api DELETE "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records/$record_id" "$deleted" || return 1
    cf_json_success "$deleted" || return 1
  done <"$owned_challenge_ids"
  : >"$owned_challenge_ids"
  cf_api GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?type=TXT&name=$challenge_name&per_page=100" "$records" || return 1
  cf_json_success "$records" && cf_records_empty "$records"
}

# Refuse renewal unless the currently served certificate is browser-trusted,
# has exactly the private hostname SAN, and can be inspected safely.
handshake=$work/handshake.pem
current_cert=$work/current.crt
if ! timeout 45 openssl s_client -connect "$hostname:443" -servername "$hostname" \
    -verify_hostname "$hostname" -verify_return_error -CAfile "$system_ca" \
    -showcerts </dev/null >"$handshake" 2>/dev/null; then
  fail current_certificate_untrusted
fi
/usr/bin/awk '/-----BEGIN CERTIFICATE-----/{capture=1} capture{print} /-----END CERTIFICATE-----/{exit}' \
  "$handshake" >"$current_cert"
[ -s "$current_cert" ] || fail current_certificate_unreadable
openssl x509 -in "$current_cert" -noout -checkhost "$hostname" >/dev/null 2>&1 || fail current_certificate_hostname
current_san=$(openssl x509 -in "$current_cert" -noout -ext subjectAltName |
  awk '/Subject Alternative Name/{capture=1; next} capture && /^[^[:space:]]/{exit} capture{gsub(/[[:space:]]/, ""); printf "%s", $0} END{print ""}')
[ "$current_san" = "DNS:$hostname" ] || fail current_certificate_san
if openssl x509 -in "$current_cert" -noout -checkend "$minimum_remaining_seconds" >/dev/null 2>&1; then
  printf 'tls_renewal_status=skipped reason=certificate_valid san=exact trust=verified remaining_threshold_seconds=%s\n' "$minimum_remaining_seconds"
  exit 0
fi

# Renewal-only prerequisites are intentionally checked after the trusted
# certificate threshold, so a safe skip does not require provider or Infisical
# credentials and never materializes a token-bearing temporary file.
[ -x "$certbot" ] || fail certbot_missing
[ -x "$infisical" ] || fail infisical_cli_missing
[ -x "$validator" ] || fail validator_missing
[ -x "$kubectl" ] || fail kubectl_missing
[ -r "$kubeconfig" ] || fail kubeconfig_missing
[ -f "$cloudflare_token_file" ] && [ ! -L "$cloudflare_token_file" ] || fail cloudflare_token_metadata
[ "$(stat -c '%U:%G:%a' "$cloudflare_token_file")" = 'paul:paul:600' ] || fail cloudflare_token_metadata
[ "$(stat -c '%s' "$cloudflare_token_file")" -ge 20 ] || fail cloudflare_token_contract
! grep -q '[[:space:]]' "$cloudflare_token_file" || fail cloudflare_token_contract
[ "$(/usr/bin/dpkg-query -W -f='${Version}' certbot 2>/dev/null)" = "$certbot_package_version" ] || fail certbot_provenance
[ "$(/usr/bin/dpkg-query -W -f='${Version}' python3-certbot-dns-cloudflare 2>/dev/null)" = "$dns_cloudflare_package_version" ] || fail dns_cloudflare_provenance
certbot_version=$($certbot --version 2>&1) || fail certbot_version
printf '%s\n' "$certbot_version" | grep -Fq "certbot 4.0.0" || fail certbot_version
infisical_version=$($infisical --version 2>&1) || fail infisical_version
printf '%s\n' "$infisical_version" | grep -Fq "$infisical_cli_version" || fail infisical_version
# curl reads the token from this mode-0600 config file; the token is never an
# argument, environment value, journal field, or evidence value.
{
  printf 'header = "Authorization: Bearer '
  cat "$cloudflare_token_file"
  printf '"\nheader = "Content-Type: application/json"\n'
} >"$cloudflare_config"
chmod 0600 "$cloudflare_config"

# Validate token activity, account, zone identity, and read access to only the
# exact challenge name before arming the cleanup boundary.
token_verify=$work/token-verify.json
zone_response=$work/zone.json
zone_compact=$work/zone-compact.json
challenge_preflight=$work/challenge-preflight.json
cf_api GET https://api.cloudflare.com/client/v4/user/tokens/verify "$token_verify" || fail cloudflare_token_verify
cf_json_success "$token_verify" || fail cloudflare_token_verify
cf_json_compact "$token_verify" | /usr/bin/grep -Fq '"status":"active"' || fail cloudflare_token_inactive
cf_api GET "https://api.cloudflare.com/client/v4/zones/$zone_id" "$zone_response" || fail cloudflare_zone_verify
cf_json_success "$zone_response" || fail cloudflare_zone_verify
cf_json_compact "$zone_response" >"$zone_compact"
/usr/bin/grep -Fq "\"id\":\"$zone_id\"" "$zone_compact" || fail cloudflare_zone_verify
/usr/bin/grep -Fq '"name":"cristex-soft.com"' "$zone_compact" || fail cloudflare_zone_verify
/usr/bin/grep -Fq "\"account\":{\"id\":\"$account_id\"" "$zone_compact" || fail cloudflare_account_verify
cf_api GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?type=TXT&name=$challenge_name&per_page=100" "$challenge_preflight" || fail cloudflare_dns_scope
cf_json_success "$challenge_preflight" || fail cloudflare_dns_scope
cf_records_empty "$challenge_preflight" || fail challenge_record_preexisting
challenge_cleanup_armed=1

# Exercise the exact DNS write/delete permission before Certbot. This probe
# uses the same challenge name and is independently removed and read back.
scope_probe_body=$work/scope-probe.json
scope_probe_response=$work/scope-probe-response.json
scope_probe_delete=$work/scope-probe-delete.json
scope_probe_content=cristexweb-renewal-scope-$(openssl rand -hex 8)
printf '{"type":"TXT","name":"%s","content":"%s","ttl":60}\n' \
  "$challenge_name" "$scope_probe_content" >"$scope_probe_body"
chmod 0600 "$scope_probe_body"
cf_api POST "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records" \
  "$scope_probe_response" "$scope_probe_body" || fail cloudflare_dns_write_scope
cf_json_success "$scope_probe_response" || fail cloudflare_dns_write_scope
scope_probe_id=$(/usr/bin/grep -oE '"id"[[:space:]]*:[[:space:]]*"[^"]+"' "$scope_probe_response" |
  /usr/bin/sed -E 's/.*"id"[[:space:]]*:[[:space:]]*"([^"]+)".*/\1/' | head -n 1)
[ -n "$scope_probe_id" ] || fail cloudflare_dns_write_scope
printf '%s\n' "$scope_probe_id" >>"$owned_challenge_ids"
LC_ALL=C /usr/bin/sort -u -o "$owned_challenge_ids" "$owned_challenge_ids"
cf_api DELETE "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records/$scope_probe_id" \
  "$scope_probe_delete" || fail cloudflare_dns_write_scope
cf_json_success "$scope_probe_delete" || fail cloudflare_dns_write_scope
: >"$owned_challenge_ids"
cf_api GET "https://api.cloudflare.com/client/v4/zones/$zone_id/dns_records?type=TXT&name=$challenge_name&per_page=100" \
  "$challenge_preflight" || fail cloudflare_dns_cleanup
cf_json_success "$challenge_preflight" && cf_records_empty "$challenge_preflight" || fail cloudflare_dns_cleanup

credentials=$work/cloudflare.ini
{
  printf 'dns_cloudflare_api_token = '
  cat "$cloudflare_token_file"
  printf '\n'
} >"$credentials"
chmod 0600 "$credentials"
certbot_work=$work/certbot-work
certbot_logs=$work/logs
mkdir -m 0700 "$certbot_work" "$certbot_logs"

certificate_link=$certbot_dir/live/reactive-resume-dev/fullchain.pem
private_key_link=$certbot_dir/live/reactive-resume-dev/privkey.pem
local_certificate=$work/local-lineage.crt
local_private_key=$work/local-lineage.key
# A previously issued, validated local lineage is resumed instead of issuing a
# duplicate certificate after an interrupted Infisical upload.
use_local_lineage=0
if [ -f "$certificate_link" ] && [ -f "$private_key_link" ]; then
  /usr/bin/cp --dereference --no-preserve=mode "$certificate_link" "$local_certificate"
  /usr/bin/cp --dereference --no-preserve=mode "$private_key_link" "$local_private_key"
  chmod 0600 "$local_certificate" "$local_private_key"
  if "$validator" "$local_certificate" "$local_private_key" >/dev/null 2>&1; then
    use_local_lineage=1
  fi
fi
if [ "$use_local_lineage" -ne 1 ]; then
  "$certbot" certonly \
    --non-interactive \
    --agree-tos \
    --email tls-renewal@cristex-soft.com \
    --dns-cloudflare \
    --dns-cloudflare-credentials "$credentials" \
    --dns-cloudflare-propagation-seconds 30 \
    --cert-name reactive-resume-dev \
    --domains "$hostname" \
    --config-dir "$certbot_dir" \
    --work-dir "$certbot_work" \
    --logs-dir "$certbot_logs" \
    --keep-until-expiring \
    >/dev/null 2>&1 || fail certificate_issuance
fi
[ -f "$certificate_link" ] || fail certificate_missing
[ -f "$private_key_link" ] || fail private_key_missing
certificate=$work/fullchain.pem
private_key=$work/privkey.pem
/usr/bin/cp --dereference --no-preserve=mode "$certificate_link" "$certificate"
/usr/bin/cp --dereference --no-preserve=mode "$private_key_link" "$private_key"
chmod 0600 "$certificate" "$private_key"
"$validator" "$certificate" "$private_key" >/dev/null || fail certificate_contract
certificate_leaf=$work/certificate-leaf.pem
/usr/bin/awk '/-----BEGIN CERTIFICATE-----/{capture=1} capture{print} /-----END CERTIFICATE-----/{exit}' \
  "$certificate" >"$certificate_leaf"
[ -s "$certificate_leaf" ] || fail certificate_contract
expected_certificate_fingerprint=$(certificate_fingerprint "$certificate_leaf")
expected_certificate_san_set=$(certificate_san_set "$certificate_leaf")
expected_certificate_expiry=$(certificate_expiry "$certificate_leaf")
[ "$expected_certificate_san_set" = "DNS:$hostname" ] || fail certificate_contract

# Infisical's exact two-key state is read before mutation. Extra keys or a
# missing key refuse the rotation; the pre-state is retained for rollback.
infisical_before=$work/infisical-before.yaml
infisical_readback=$work/infisical-readback.yaml
infisical_readback_cert=$work/infisical-readback.crt
infisical_readback_key=$work/infisical-readback.key
infisical_keys=$work/infisical-keys
infisical_keys_expected=$work/infisical-keys-expected
infisical_prewrite=$work/infisical-prewrite-readback.yaml
infisical_prewrite_cert=$work/infisical-prewrite-readback.crt
infisical_prewrite_key=$work/infisical-prewrite-readback.key
infisical_prewrite_keys=$work/infisical-prewrite-readback-keys
"$infisical" export --env "$environment" --projectId "$project_id" \
  --path "$infisical_path" --format yaml --silent >"$infisical_before" 2>/dev/null || fail infisical_preflight
chmod 0600 "$infisical_before"
printf '%s\n' TLS_CRT TLS_KEY | LC_ALL=C /usr/bin/sort >"$infisical_keys_expected"
chmod 0600 "$infisical_keys_expected"
verify_infisical_key_set "$infisical_before" "$infisical_keys" || fail infisical_key_closure
infisical_before_cert=$work/infisical-before.crt
infisical_before_key=$work/infisical-before.key
extract_infisical_key TLS_CRT "$infisical_before" "$infisical_before_cert"
extract_infisical_key TLS_KEY "$infisical_before" "$infisical_before_key"
[ -s "$infisical_before_cert" ] && [ -s "$infisical_before_key" ] || fail infisical_prestate_unreadable
validate_existing_certificate_pair "$infisical_before_cert" "$infisical_before_key" || fail infisical_prestate_contract
prestate_revision=$(material_revision "$infisical_before_cert" "$infisical_before_key")
# Infisical's documented CLI exposes no CAS/If-Match operation. Treat the
# digest of the exact two-key export as a revision token: require an identical
# second read immediately before write, then verify every post-write readback.
"$infisical" export --env "$environment" --projectId "$project_id" \
  --path "$infisical_path" --format yaml --silent >"$infisical_prewrite" 2>/dev/null || fail infisical_prewrite_readback
chmod 0600 "$infisical_prewrite"
verify_infisical_key_set "$infisical_prewrite" "$infisical_prewrite_keys" || fail infisical_key_closure
extract_infisical_key TLS_CRT "$infisical_prewrite" "$infisical_prewrite_cert"
extract_infisical_key TLS_KEY "$infisical_prewrite" "$infisical_prewrite_key"
[ "$(material_revision "$infisical_prewrite_cert" "$infisical_prewrite_key")" = "$prestate_revision" ] || fail infisical_concurrent_change

payload=$work/infisical-upload.yaml
{
  printf 'TLS_CRT: |\n'
  sed 's/^/  /' "$certificate"
  printf 'TLS_KEY: |\n'
  sed 's/^/  /' "$private_key"
} >"$payload"
chmod 0600 "$payload"
# There is no Infisical CAS/If-Match operation. Arm the failure boundary before
# the first write; if a later stage fails, rollback refuses a non-atomic stale
# write and emits no_cas_fail_closed instead of overwriting a concurrent writer.
infisical_new_revision=$(material_revision "$certificate" "$private_key")
infisical_rotation_armed=1
"$infisical" secrets set --env "$environment" --projectId "$project_id" \
  --path "$infisical_path" --file "$payload" --silent >/dev/null 2>&1 || fail infisical_upload

"$infisical" export --env "$environment" --projectId "$project_id" \
  --path "$infisical_path" --format yaml --silent >"$infisical_readback" 2>/dev/null || fail infisical_readback
chmod 0600 "$infisical_readback"
verify_infisical_key_set "$infisical_readback" "$infisical_keys" || fail infisical_key_closure
extract_infisical_key TLS_CRT "$infisical_readback" "$infisical_readback_cert"
extract_infisical_key TLS_KEY "$infisical_readback" "$infisical_readback_key"
if ! cmp -s "$certificate" "$infisical_readback_cert" ||
   ! cmp -s "$private_key" "$infisical_readback_key"; then
  fail infisical_readback_mismatch
fi
"$validator" "$infisical_readback_cert" "$infisical_readback_key" >/dev/null || fail infisical_readback_contract

# The Certbot plugin must have removed its TXT record; remove only the
# process-owned probe IDs still present in the ledger and verify an empty
# readback before any success receipt.
cleanup_challenge_records || fail challenge_cleanup
challenge_cleanup_armed=0
wait_for_runtime_convergence || fail runtime_convergence
infisical_rotation_armed=0
printf 'tls_renewal_status=success hostname=%s san=exact trust=verified validity=30d custody=infisical path=%s keys=exact-two upload_readback=verified challenge=%s cleanup=verified convergence=verified private_residue=none values_output=false\n' \
  "$hostname" "$infisical_path" "$challenge_name"
