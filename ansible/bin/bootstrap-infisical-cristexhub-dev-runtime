#!/bin/sh
set -eu
[ "$#" -eq 1 ] && { [ "$1" = check ] || [ "$1" = apply ]; } || { echo 'usage: ansible/bin/bootstrap-infisical-cristexhub-dev-runtime check|apply' >&2; exit 64; }
mode=$1; script_directory=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd -P); repository_root=$(CDPATH= cd -- "$script_directory/../.." && pwd -P)
case "$repository_root" in /Users/paul/Projects/cristexweb|/home/paul/projects/cristexweb) ;; *) echo 'refusing unpinned repository path' >&2; exit 78;; esac
controller="$repository_root/.venv/bin/ansible-playbook"; [ -x "$controller" ] || { echo 'refusing missing pinned Ansible controller' >&2; exit 69; }
controller_user=$(id -un); cd "$repository_root/ansible"; umask 077
attestation=$(mktemp "${TMPDIR:-/tmp}/cristexweb-cristexhub-dev-runtime.XXXXXX"); token=$(openssl rand -hex 32); printf '%s:entrypoint\n' "$token" > "$attestation"; trap 'rm -f -- "$attestation"' EXIT HUP INT TERM
set -- "$controller" -i .ansible/inventory.local.yml playbooks/bootstrap_infisical_cristexhub_dev_runtime.yml --diff --limit crtxweb --extra-vars '{"cristexhub_dev_runtime_bootstrap_approved":true}'
[ "$mode" = apply ] || set -- "$@" --check
/usr/bin/env -i HOME="${HOME:-/home/paul}" USER="$controller_user" LOGNAME="$controller_user" PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 ANSIBLE_CONFIG="$PWD/ansible.cfg" CRISTEXWEB_CRISTEXHUB_DEV_RUNTIME_ENTRYPOINT=v1 CRISTEXWEB_CRISTEXHUB_DEV_RUNTIME_TOKEN="$token" CRISTEXWEB_CRISTEXHUB_DEV_RUNTIME_ATTESTATION_FILE="$attestation" "$@"
