#!/bin/sh
set -eu
usage='usage: ansible/bin/bootstrap-postgresql check|apply'
if [ "$#" -ne 1 ] || { [ "$1" != check ] && [ "$1" != apply ]; }; then
  printf '%s\n' "$usage" >&2
  printf '%s\n' 'refusing passthrough arguments or task selection' >&2
  exit 64
fi
mode=$1
script_path=$0
[ ! -L "$script_path" ] || { printf '%s\n' 'refusing a symlinked entrypoint' >&2; exit 66; }
script_directory="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script_path")" && pwd -P)"
repository_root="$(CDPATH= cd -- "$script_directory/../.." && pwd -P)"
controller_home="$(CDPATH= cd -- "$repository_root/../.." && pwd -P)"
controller_user="$(/usr/bin/id -un)"
[ "$repository_root" = "$controller_home/Projects/cristexweb" ] || { printf '%s\n' 'refusing a repository outside the pinned controller path' >&2; exit 78; }
controller="$repository_root/.venv/bin/ansible-playbook"
[ -f "$controller" ] && [ -x "$controller" ] && [ ! -L "$controller" ] || { printf '%s\n' 'refusing an unsafe pinned Ansible controller' >&2; exit 69; }
cd -- "$repository_root/ansible"
umask 077
attestation_file="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/cristexweb-postgresql-bootstrap.XXXXXX")"
attestation_token="$(/usr/bin/openssl rand -hex 32)"
printf '%s:entrypoint\n' "$attestation_token" >"$attestation_file"
cleanup() { /bin/rm -f -- "$attestation_file"; }
trap cleanup EXIT HUP INT TERM
set -- "$controller" -i .ansible/inventory.local.yml playbooks/bootstrap_postgresql.yml --diff --limit crtxweb --extra-vars '{"postgresql_bootstrap_approved":true}'
[ "$mode" != check ] || set -- "$@" --check
if [ -n "${SSH_AUTH_SOCK:-}" ]; then set -- "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" "$@"; fi
/usr/bin/env -i HOME="$controller_home" USER="$controller_user" LOGNAME="$controller_user" PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 ANSIBLE_CONFIG="$PWD/ansible.cfg" CRISTEXWEB_POSTGRESQL_BOOTSTRAP_ENTRYPOINT=v1 CRISTEXWEB_POSTGRESQL_BOOTSTRAP_TOKEN="$attestation_token" CRISTEXWEB_POSTGRESQL_BOOTSTRAP_ATTESTATION_FILE="$attestation_file" "$@"
