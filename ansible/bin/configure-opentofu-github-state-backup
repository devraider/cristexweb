#!/bin/sh
set -eu
usage='usage: ansible/bin/configure-opentofu-github-state-backup check|apply|test|restore|attest|restore-absence'
[ "$#" -eq 1 ] || { printf '%s\n' "$usage" >&2; exit 64; }
case "$1" in
  check) mode=install; check=true;;
  apply) mode=install; check=false;;
  test) mode=test; check=false;;
  restore) mode=restore; check=false;;
  attest) mode=attest; check=false;;
  restore-absence) mode=restore-absence; check=false;;
  *) printf '%s\n' "$usage" >&2; exit 64;;
esac
script=$0
[ ! -L "$script" ] || exit 66
dir=$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script")" && pwd -P)
root=$(CDPATH= cd -- "$dir/../.." && pwd -P)
[ "$root" = /home/paul/projects/cristexweb ] || exit 78
controller="$root/.venv/bin/ansible-playbook"
[ -x "$controller" ] && [ ! -L "$controller" ] || exit 69
attestation=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/cristexweb-opentofu-github-state-recovery.XXXXXX")
token=$(/usr/bin/openssl rand -hex 32)
chmod 0600 "$attestation"
printf '%s:entrypoint\n' "$token" >"$attestation"
cleanup() { /bin/rm -f -- "$attestation"; }
trap cleanup EXIT HUP INT TERM
cd "$root/ansible"
umask 077
set -- "$controller" -i .ansible/inventory.local.yml playbooks/configure_opentofu_github_state_backup.yml --diff --limit crtxweb --ask-become-pass --extra-vars "{\"opentofu_github_state_backup_mode\":\"$mode\"}"
[ "$check" = false ] || set -- "$@" --check
exec /usr/bin/env -i HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 ANSIBLE_CONFIG="$PWD/ansible.cfg" CRISTEXWEB_REPOSITORY_ROOT=/home/paul/projects/cristexweb CRISTEXWEB_OPENTOFU_GITHUB_STATE_BACKUP_ENTRYPOINT=v1 CRISTEXWEB_OPENTOFU_GITHUB_STATE_BACKUP_APPROVAL=v1 CRISTEXWEB_OPENTOFU_GITHUB_STATE_BACKUP_MODE="$mode" CRISTEXWEB_OPENTOFU_GITHUB_STATE_BACKUP_TOKEN="$token" CRISTEXWEB_OPENTOFU_GITHUB_STATE_BACKUP_ATTESTATION_FILE="$attestation" "$@"
