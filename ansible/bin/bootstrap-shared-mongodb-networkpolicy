[ "$(sha256_file "$python_real_source")" = "$python_sha256_expected" ] || { printf '%s\n' 'refusing Python interpreter drift' >&2; exit 69; }
[ "$(sha256_file "$controller")" = "$controller_sha256_expected" ] || { printf '%s\n' 'refusing controller drift' >&2; exit 69; }
lock_file='/tmp/cristexweb-shared-mongodb-networkpolicy.lock'
lock_owned=0
legacy_lock_fd_open=0
owner_written=0
owner_tmp=
attestation_file=
attestation_token=
child_pid=
child_process_group=0
pending_signal=
forced_cleanup_status=
cleanup_in_progress=0
wrapper_pid=$$
proc_starttime() {
  /usr/bin/awk '{print $22}' "/proc/$1/stat"
}
wrapper_starttime=$(proc_starttime "$wrapper_pid") || {
  printf '%s\n' 'refusing a wrapper without a process starttime' >&2
  exit 69
}
wrapper_argv_sha256=$(printf '%s\0%s\0%s' '/bin/sh' "$script_path" "$mode" | sha256_stdin)
wrapper_executable='/bin/sh'
wrapper_arg0='/bin/sh'

# Keep the old advisory lock held while removing its path.  A nonblocking lock
# acquisition on the already-open inode proves that no old wrapper still holds
# it; anything else is a fail-closed migration stop.
migrate_legacy_lock() {
  [ -f "$lock_file" ] && [ ! -L "$lock_file" ] && [ ! -s "$lock_file" ] &&
    is_owned_regular_mode "$lock_file" 600 || return 1
  [ -x /usr/bin/flock ] || return 1
  exec 9<> "$lock_file" || return 1
  legacy_lock_fd_open=1
  /usr/bin/flock -n 9 || return 1
  legacy_lock_inode=$(/usr/bin/stat -c '%d:%i' -- "$lock_file") || return 1
  [ "$legacy_lock_inode" = "$(/usr/bin/stat -c '%d:%i' -- "$lock_file")" ] || return 1
  [ -f "$lock_file" ] && [ ! -L "$lock_file" ] && [ ! -s "$lock_file" ] &&
    is_owned_regular_mode "$lock_file" 600 || return 1
  /bin/rm -f -- "$lock_file" || return 1
  [ ! -e "$lock_file" ] || return 1
  /usr/bin/flock -u 9 || return 1
  exec 9>&-
  legacy_lock_fd_open=0
  return 0
}

signal_handler() {
  pending_signal=$1
}

child_descendants() {
  ps -eo pid=,ppid= 2>/dev/null |
    awk -v root="$1" '$2 == root {print $1}'
}
process_tree_alive() {
  [ -n "${1:-}" ] || return 1
  if /bin/kill -0 "$1" 2>/dev/null; then
    return 0
  fi
  [ -n "$(child_descendants "$1")" ]
}
terminate_process_tree() {
  process_root=$1
  process_signal=$2
  for process_child in $(child_descendants "$process_root"); do
    terminate_process_tree "$process_child" "$process_signal"
  done
  /bin/kill -"$process_signal" "$process_root" 2>/dev/null || true
}
stop_child() {
  if [ -n "${child_pid:-}" ]; then
    if [ "$child_process_group" = 1 ]; then
      /bin/kill -TERM -- "-$child_pid" 2>/dev/null ||
        /bin/kill -TERM "$child_pid" 2>/dev/null || true
    else
      terminate_process_tree "$child_pid" TERM
    fi
    remaining=5
    while [ "$remaining" -gt 0 ]; do
      if [ "$child_process_group" = 1 ]; then
        /bin/kill -0 -- "-$child_pid" 2>/dev/null || break
      else
        process_tree_alive "$child_pid" || break
      fi
      /bin/sleep 1
      remaining=$((remaining - 1))
    done
    if [ "$child_process_group" = 1 ]; then
      /bin/kill -0 -- "-$child_pid" 2>/dev/null &&
        /bin/kill -KILL -- "-$child_pid" 2>/dev/null || true
      remaining=5
      while [ "$remaining" -gt 0 ] && /bin/kill -0 -- "-$child_pid" 2>/dev/null; do
        /bin/sleep 1
        remaining=$((remaining - 1))
      done
    elif process_tree_alive "$child_pid"; then
      terminate_process_tree "$child_pid" KILL
      remaining=5
      while [ "$remaining" -gt 0 ] && process_tree_alive "$child_pid"; do
        /bin/sleep 1
        remaining=$((remaining - 1))
      done
    fi
    wait "$child_pid" 2>/dev/null || true
    child_pid=
  fi
}
cleanup() {
  cleanup_status=$?
  if [ -n "${forced_cleanup_status:-}" ]; then
    cleanup_status=$forced_cleanup_status
  fi
  if [ "$cleanup_in_progress" = 1 ]; then
    exit "$cleanup_status"
  fi
  cleanup_in_progress=1
  trap '' EXIT HUP INT TERM
  stop_child
  if [ -n "${attestation_file:-}" ]; then
    /bin/rm -f -- "$attestation_file"
  fi
  if [ "$lock_owned" = 1 ]; then
    owner_path="$lock_file/owner"
    if [ -n "${owner_tmp:-}" ] && is_owned_regular_mode "$owner_tmp" 600; then
      /bin/rm -f -- "$owner_tmp"
    fi
    if [ "$owner_written" = 1 ] && is_owned_regular_mode "$owner_path" 600 &&
      [ "$(cat "$owner_path" 2>/dev/null || true)" = "$attestation_token:$wrapper_pid:$wrapper_starttime:$wrapper_argv_sha256" ]; then
      /bin/rm -f -- "$owner_path"
    fi
    /bin/rmdir -- "$lock_file" 2>/dev/null || true
  fi
  if [ "$legacy_lock_fd_open" = 1 ]; then
    /usr/bin/flock -u 9 2>/dev/null || true
    exec 9>&-
  fi
  exit "$cleanup_status"
}
trap cleanup EXIT
trap 'signal_handler 129' HUP
trap 'signal_handler 130' INT
trap 'signal_handler 143' TERM
if [ -L "$lock_file" ]; then
  printf '%s\n' 'shared MongoDB NetworkPolicy cooperative lock is held or unsafe' >&2
  exit 75
fi
if [ -e "$lock_file" ]; then
  migrate_legacy_lock || {
    printf '%s\n' 'refusing to migrate a held or unsafe legacy shared MongoDB NetworkPolicy lock' >&2
    exit 75
  }
fi
/bin/mkdir "$lock_file" 2>/dev/null || {
  printf '%s\n' 'shared MongoDB NetworkPolicy cooperative lock is held' >&2
  exit 75
}
