#!/bin/sh
set -eu
usage='usage: ansible/bin/bootstrap-shared-mongodb-networkpolicy check'
[ "$#" -eq 1 ] && [ "$1" = check ] || { printf '%s\n' "$usage" >&2; exit 64; }
[ ! -L "$0" ] || exit 66
dir="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")" && pwd -P)"
root="$(CDPATH= cd -- "$dir/../.." && pwd -P)"
case "$root" in /Users/paul/Projects/cristexweb|/home/paul/projects/cristexweb) ;; *) exit 78 ;; esac
controller="$root/.venv/bin/ansible-playbook"
[ -x "$controller" ] && [ ! -L "$controller" ] || exit 69
user=$(/usr/bin/id -un)
cd "$root/ansible"
umask 077
attestation="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/cristexweb-shared-mongodb-networkpolicy.XXXXXX")"
token="$(/usr/bin/openssl rand -hex 32)"
printf '%s:entrypoint\n' "$token" >"$attestation"
cleanup() { /bin/rm -f -- "$attestation"; }
trap cleanup EXIT HUP INT TERM
set -- "$controller" -i .ansible/inventory.local.yml playbooks/bootstrap_shared_mongodb_networkpolicy.yml --diff --check --limit crtxweb --extra-vars '{"shared_mongodb_networkpolicy_bootstrap_approved":true}'
/usr/bin/env -i HOME="${HOME:-/home/paul}" USER="$user" LOGNAME="$user" PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 ANSIBLE_CONFIG="$PWD/ansible.cfg" CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ENTRYPOINT=v1 CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_TOKEN="$token" CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ATTESTATION_FILE="$attestation" "$@"
