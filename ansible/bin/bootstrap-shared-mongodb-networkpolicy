plugins/module_utils/helm.py 2fe2e843b583f80c259c4c13c6ca278b3d6faa7036d314c2001f3d94161f842a
plugins/module_utils/helm_args_common.py 6561042a0092f0b1187d469b972acbc320b0d6a1355f1c0bf6bc6c894f78b074
plugins/module_utils/k8sdynamicclient.py 6b44b539981affc25ede49cc8a7f994fe19b5c60aaa1e400a480e735f7ed1be6
plugins/module_utils/selector.py d5e15a8ac4f916ee4b578450449a525dbda727b77178941a81c21e9e228e7987
plugins/module_utils/version.py c009a2e470b5c1e2cfc73efb061b3289f3da5064c85ad31dd664433ddb7b97b7'
python_sha256_expected='17b78e0a93175e86f9ac03141924fd7a7f0c0c52e66b34bfa0de20ffef989df1'
controller_sha256_expected='baf52d00491b00126ccc19ec1a2e018e107c134e663885e748e5fe4e3777b3fd'
[ "$(canonical_sha256 "$script_path")" = "$wrapper_canonical_sha256_expected" ] || { printf '%s\n' 'refusing wrapper source drift' >&2; exit 69; }
[ "$(sha256_file "$task_source")" = "$task_sha256_expected" ] || { printf '%s\n' 'refusing task source drift' >&2; exit 69; }
[ "$(sha256_file "$defaults_source")" = "$defaults_sha256_expected" ] || { printf '%s\n' 'refusing defaults source drift' >&2; exit 69; }
[ "$(sha256_file "$playbook_source")" = "$playbook_sha256_expected" ] || { printf '%s\n' 'refusing playbook source drift' >&2; exit 69; }
[ "$(canonical_action_sha256 "$action_source")" = "$action_canonical_sha256_expected" ] || { printf '%s\n' 'refusing action source drift' >&2; exit 69; }
[ "$(sha256_file "$create_module_source")" = "$create_module_sha256_expected" ] || { printf '%s\n' 'refusing create module source drift' >&2; exit 69; }
[ "$(sha256_file "$inventory")" = "$inventory_sha256_expected" ] || { printf '%s\n' 'refusing inventory drift' >&2; exit 69; }
[ "$(sha256_file "$ansible_config")" = "$ansible_config_sha256_expected" ] || { printf '%s\n' 'refusing Ansible configuration drift' >&2; exit 69; }
[ "$(sha256_file "$requirements_source")" = "$requirements_sha256_expected" ] || { printf '%s\n' 'refusing collection requirement drift' >&2; exit 69; }
[ "$(sha256_file "$collection_manifest")" = "$collection_manifest_sha256_expected" ] || { printf '%s\n' 'refusing collection manifest drift' >&2; exit 69; }
[ "$(sha256_file "$collection_files")" = "$collection_files_sha256_expected" ] || { printf '%s\n' 'refusing collection file closure drift' >&2; exit 69; }
[ "$(sha256_file "$k8s_action_target")" = "$k8s_action_target_sha256_expected" ] || { printf '%s\n' 'refusing kubernetes.core k8s action target drift' >&2; exit 69; }
[ "$(sha256_file "$k8s_info_module_source")" = "$k8s_info_module_sha256_expected" ] || { printf '%s\n' 'refusing kubernetes.core k8s_info module drift' >&2; exit 69; }
[ "$(sha256_file "$json_patch_real_source")" = "$json_patch_action_target_sha256_expected" ] || { printf '%s\n' 'refusing JSON patch action target drift' >&2; exit 69; }
[ "$(sha256_file "$json_patch_module_source")" = "$json_patch_module_sha256_expected" ] || { printf '%s\n' 'refusing JSON patch module drift' >&2; exit 69; }
while IFS=' ' read -r module_util_relative module_util_expected; do
  [ -n "$module_util_relative" ] || continue
  module_util_path="$collection_root/$module_util_relative"
  is_owned_regular_mode "$module_util_path" 644 || exit 69
  [ "$(sha256_file "$module_util_path")" = "$module_util_expected" ] || exit 69
done <<EOF
$collection_module_utils_expected
EOF
[ "$(sha256_file "$python_real_source")" = "$python_sha256_expected" ] || { printf '%s\n' 'refusing Python interpreter drift' >&2; exit 69; }
[ "$(sha256_file "$controller")" = "$controller_sha256_expected" ] || { printf '%s\n' 'refusing controller drift' >&2; exit 69; }
lock_file='/tmp/cristexweb-shared-mongodb-networkpolicy.lock'
lock_owned=0
legacy_lock_fd_open=0
owner_written=0
owner_tmp=
attestation_file=
attestation_token=
child_pid=
child_process_group=0
pending_signal=
forced_cleanup_status=
cleanup_in_progress=0
wrapper_pid=$$

# Keep the old advisory lock held while removing its path.  A nonblocking lock
# acquisition on the already-open inode proves that no old wrapper still holds
# it; anything else is a fail-closed migration stop.
migrate_legacy_lock() {
  [ -f "$lock_file" ] && [ ! -L "$lock_file" ] && [ ! -s "$lock_file" ] &&
    is_owned_regular_mode "$lock_file" 600 || return 1
  [ -x /usr/bin/flock ] || return 1
  exec 9<> "$lock_file" || return 1
  legacy_lock_fd_open=1
  /usr/bin/flock -n 9 || return 1
  legacy_lock_inode=$(/usr/bin/stat -c '%d:%i' -- "$lock_file") || return 1
  [ "$legacy_lock_inode" = "$(/usr/bin/stat -c '%d:%i' -- "$lock_file")" ] || return 1
  [ -f "$lock_file" ] && [ ! -L "$lock_file" ] && [ ! -s "$lock_file" ] &&
    is_owned_regular_mode "$lock_file" 600 || return 1
  /bin/rm -f -- "$lock_file" || return 1
  [ ! -e "$lock_file" ] || return 1
  /usr/bin/flock -u 9 || return 1
  exec 9>&-
  legacy_lock_fd_open=0
  return 0
}

signal_handler() {
  pending_signal=$1
}

child_descendants() {
  ps -eo pid=,ppid= 2>/dev/null |
    awk -v root="$1" '$2 == root {print $1}'
}
process_tree_alive() {
  [ -n "${1:-}" ] || return 1
  if /bin/kill -0 "$1" 2>/dev/null; then
    return 0
  fi
  [ -n "$(child_descendants "$1")" ]
}
terminate_process_tree() {
  process_root=$1
  process_signal=$2
  for process_child in $(child_descendants "$process_root"); do
    terminate_process_tree "$process_child" "$process_signal"
  done
  /bin/kill -"$process_signal" "$process_root" 2>/dev/null || true
}
stop_child() {
  if [ -n "${child_pid:-}" ]; then
    if [ "$child_process_group" = 1 ]; then
      /bin/kill -TERM -- "-$child_pid" 2>/dev/null ||
        /bin/kill -TERM "$child_pid" 2>/dev/null || true
    else
      terminate_process_tree "$child_pid" TERM
    fi
    remaining=5
    while [ "$remaining" -gt 0 ]; do
      if [ "$child_process_group" = 1 ]; then
        /bin/kill -0 -- "-$child_pid" 2>/dev/null || break
      else
        process_tree_alive "$child_pid" || break
      fi
      /bin/sleep 1
      remaining=$((remaining - 1))
    done
    if [ "$child_process_group" = 1 ]; then
      /bin/kill -0 -- "-$child_pid" 2>/dev/null &&
        /bin/kill -KILL -- "-$child_pid" 2>/dev/null || true
      remaining=5
      while [ "$remaining" -gt 0 ] && /bin/kill -0 -- "-$child_pid" 2>/dev/null; do
        /bin/sleep 1
        remaining=$((remaining - 1))
      done
    elif process_tree_alive "$child_pid"; then
      terminate_process_tree "$child_pid" KILL
      remaining=5
      while [ "$remaining" -gt 0 ] && process_tree_alive "$child_pid"; do
        /bin/sleep 1
        remaining=$((remaining - 1))
      done
    fi
    wait "$child_pid" 2>/dev/null || true
    child_pid=
  fi
}
cleanup() {
  cleanup_status=$?
  if [ -n "${forced_cleanup_status:-}" ]; then
    cleanup_status=$forced_cleanup_status
  fi
  if [ "$cleanup_in_progress" = 1 ]; then
    exit "$cleanup_status"
  fi
  cleanup_in_progress=1
  trap '' EXIT HUP INT TERM
  stop_child
  if [ -n "${attestation_file:-}" ]; then
    /bin/rm -f -- "$attestation_file"
  fi
  if [ "$lock_owned" = 1 ]; then
    owner_path="$lock_file/owner"
    if [ -n "${owner_tmp:-}" ] && is_owned_regular_mode "$owner_tmp" 600; then
      /bin/rm -f -- "$owner_tmp"
    fi
    if [ "$owner_written" = 1 ] && is_owned_regular_mode "$owner_path" 600 &&
      [ "$(cat "$owner_path" 2>/dev/null || true)" = "$attestation_token:$wrapper_pid" ]; then
      /bin/rm -f -- "$owner_path"
    fi
    /bin/rmdir -- "$lock_file" 2>/dev/null || true
  fi
  if [ "$legacy_lock_fd_open" = 1 ]; then
    /usr/bin/flock -u 9 2>/dev/null || true
    exec 9>&-
  fi
  exit "$cleanup_status"
}
trap cleanup EXIT
trap 'signal_handler 129' HUP
trap 'signal_handler 130' INT
trap 'signal_handler 143' TERM
if [ -L "$lock_file" ]; then
  printf '%s\n' 'shared MongoDB NetworkPolicy cooperative lock is held or unsafe' >&2
  exit 75
fi
if [ -e "$lock_file" ]; then
  migrate_legacy_lock || {
    printf '%s\n' 'refusing to migrate a held or unsafe legacy shared MongoDB NetworkPolicy lock' >&2
    exit 75
  }
fi
/bin/mkdir "$lock_file" 2>/dev/null || {
  printf '%s\n' 'shared MongoDB NetworkPolicy cooperative lock is held' >&2
  exit 75
}
lock_owned=1
# umask 077 makes the mkdir-created ownership boundary private from creation.
is_owned_directory_mode "$lock_file" 700 || exit 75
attestation_file=$(mktemp "${TMPDIR:-/tmp}/cristexweb-shared-mongodb-networkpolicy.XXXXXX")
attestation_token=$(od -An -N32 -tx1 /dev/urandom | tr -d ' \n')
/bin/chmod 600 "$attestation_file"
owner_tmp="$lock_file/.owner.$$"
printf '%s:%s\n' "$attestation_token" "$wrapper_pid" >"$owner_tmp"
/bin/chmod 600 "$owner_tmp"
/bin/mv -f -- "$owner_tmp" "$lock_file/owner"
owner_tmp=
owner_written=1
printf '%s:entrypoint\n' "$attestation_token" >"$attestation_file"
[ -z "$pending_signal" ] || exit "$pending_signal"
apply_approval=
case "$mode" in
  check) ansible_flags='--diff --check' ;;
  apply)
    [ "${CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_APPLY_APPROVED:-}" = v1 ] || {
      printf '%s\n' 'apply requires CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_APPLY_APPROVED=v1' >&2
      exit 77
    }
    ansible_flags='--diff'; apply_approval=v1 ;;
esac
cd "$repository_root/ansible"
set -- "$controller" -i .ansible/inventory.local.yml playbooks/bootstrap_shared_mongodb_networkpolicy.yml $ansible_flags --limit crtxweb --extra-vars "{\"shared_mongodb_networkpolicy_bootstrap_approved\":true,\"shared_mongodb_networkpolicy_bootstrap_mode\":\"$mode\"}"
if [ -x /usr/bin/setsid ]; then
  child_process_group=1
  /usr/bin/setsid /usr/bin/env -i \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_COLLECTION_FILES_SHA256=$collection_files_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_ACTION=$k8s_action_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_ACTION_TARGET=$k8s_action_target" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_ACTION_TARGET_SHA256=$k8s_action_target_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_INFO_MODULE=$k8s_info_module_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_INFO_MODULE_SHA256=$k8s_info_module_sha256_expected" \
    "HOME=${HOME:-$repository_root}" \
    "USER=$controller_user" \
    "LOGNAME=$controller_user" \
    'PATH=/usr/bin:/bin:/usr/sbin:/sbin' \
    'LC_ALL=C.UTF-8' \
    "ANSIBLE_CONFIG=$ansible_config" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ENTRYPOINT=v1" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_MODE=$mode" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_APPLY_APPROVED=$apply_approval" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_TOKEN=$attestation_token" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ATTESTATION_FILE=$attestation_file" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_LOCK_FILE=$lock_file" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_WRAPPER_PID=$wrapper_pid" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_TASK_SHA256=$task_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_DEFAULTS_SHA256=$defaults_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_PLAYBOOK_SHA256=$playbook_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_WRAPPER_CANONICAL_SHA256=$wrapper_canonical_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ACTION_CANONICAL_SHA256=$action_canonical_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_CREATE_MODULE_SHA256=$create_module_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_INVENTORY_SHA256=$inventory_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ANSIBLE_CONFIG_SHA256=$ansible_config_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_CONTROLLER_SHA256=$controller_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_PYTHON=$python_tool" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_PYTHON_REAL=$python_real_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_PYTHON_SHA256=$python_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_REQUIREMENTS_SHA256=$requirements_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_COLLECTION_MANIFEST_SHA256=$collection_manifest_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_ACTION=$json_patch_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_ACTION_TARGET=$json_patch_real_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_ACTION_TARGET_SHA256=$json_patch_action_target_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_MODULE=$json_patch_module_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_MODULE_SHA256=$json_patch_module_sha256_expected" \
    "$@" &
else
  child_process_group=0
  /usr/bin/env -i \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_COLLECTION_FILES_SHA256=$collection_files_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_ACTION=$k8s_action_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_ACTION_TARGET=$k8s_action_target" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_ACTION_TARGET_SHA256=$k8s_action_target_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_INFO_MODULE=$k8s_info_module_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_K8S_INFO_MODULE_SHA256=$k8s_info_module_sha256_expected" \
    "HOME=${HOME:-$repository_root}" \
    "USER=$controller_user" \
    "LOGNAME=$controller_user" \
    'PATH=/usr/bin:/bin:/usr/sbin:/sbin' \
    'LC_ALL=C.UTF-8' \
    "ANSIBLE_CONFIG=$ansible_config" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ENTRYPOINT=v1" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_MODE=$mode" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_APPLY_APPROVED=$apply_approval" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_TOKEN=$attestation_token" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ATTESTATION_FILE=$attestation_file" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_LOCK_FILE=$lock_file" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_WRAPPER_PID=$wrapper_pid" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_TASK_SHA256=$task_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_DEFAULTS_SHA256=$defaults_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_PLAYBOOK_SHA256=$playbook_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_WRAPPER_CANONICAL_SHA256=$wrapper_canonical_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ACTION_CANONICAL_SHA256=$action_canonical_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_CREATE_MODULE_SHA256=$create_module_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_INVENTORY_SHA256=$inventory_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ANSIBLE_CONFIG_SHA256=$ansible_config_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_CONTROLLER_SHA256=$controller_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_PYTHON=$python_tool" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_PYTHON_REAL=$python_real_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_PYTHON_SHA256=$python_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_REQUIREMENTS_SHA256=$requirements_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_COLLECTION_MANIFEST_SHA256=$collection_manifest_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_ACTION=$json_patch_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_ACTION_TARGET=$json_patch_real_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_ACTION_TARGET_SHA256=$json_patch_action_target_sha256_expected" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_MODULE=$json_patch_module_source" \
    "CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_JSON_PATCH_MODULE_SHA256=$json_patch_module_sha256_expected" \
    "$@" &
fi
child_pid=$!
if [ -n "$pending_signal" ]; then
  forced_cleanup_status=$pending_signal
  stop_child
  exit "$pending_signal"
fi
set +e
wait "$child_pid"
child_status=$?
set -e
if [ -n "$pending_signal" ]; then
  forced_cleanup_status=$pending_signal
fi
# Reap the direct child and terminate any remaining process-group/tree
# descendants before EXIT cleanup can release the cooperative lock.
stop_child
if [ -n "$pending_signal" ]; then
  exit "$pending_signal"
fi
trap - HUP INT TERM
exit "$child_status"
