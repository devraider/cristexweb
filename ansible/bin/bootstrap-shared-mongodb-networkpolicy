#!/bin/sh
set -eu
usage='usage: ansible/bin/bootstrap-shared-mongodb-networkpolicy check|apply'
[ "$#" -eq 1 ] && { [ "$1" = check ] || [ "$1" = apply ]; } || { printf '%s\n' "$usage" >&2; exit 64; }
mode=$1
apply_approval=
case "$mode" in
  check) ansible_flags='--diff --check' ;;
  apply)
    [ "${CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_APPLY_APPROVED:-}" = v1 ] || {
      printf '%s\n' 'apply requires CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_APPLY_APPROVED=v1' >&2
      exit 77
    }
    ansible_flags='--diff'
    apply_approval=v1
    ;;
esac
[ ! -L "$0" ] || exit 66
dir="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")" && pwd -P)"
root="$(CDPATH= cd -- "$dir/../.." && pwd -P)"
case "$root" in /Users/paul/Projects/cristexweb|/home/paul/projects/cristexweb) ;; *) exit 78 ;; esac
controller="$root/.venv/bin/ansible-playbook"
[ -x "$controller" ] && [ ! -L "$controller" ] || exit 69
user=$(/usr/bin/id -un)
cd "$root/ansible"
umask 077
attestation="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/cristexweb-shared-mongodb-networkpolicy.XXXXXX")"
token="$(/usr/bin/openssl rand -hex 32)"
printf '%s:entrypoint\n' "$token" >"$attestation"
cleanup() { /bin/rm -f -- "$attestation"; }
trap cleanup EXIT HUP INT TERM
set -- "$controller" -i .ansible/inventory.local.yml playbooks/bootstrap_shared_mongodb_networkpolicy.yml $ansible_flags --limit crtxweb --extra-vars "{\"shared_mongodb_networkpolicy_bootstrap_approved\":true,\"shared_mongodb_networkpolicy_bootstrap_mode\":\"$mode\"}"
/usr/bin/env -i HOME="${HOME:-/home/paul}" USER="$user" LOGNAME="$user" PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 ANSIBLE_CONFIG="$PWD/ansible.cfg" CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ENTRYPOINT=v1 CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_TOKEN="$token" CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_ATTESTATION_FILE="$attestation" CRISTEXWEB_SHARED_MONGODB_NETWORKPOLICY_APPLY_APPROVED="$apply_approval" "$@"
