printf '%s:%s:%s:%s\n' "$attestation_token" "$wrapper_pid" "$wrapper_starttime" "$wrapper_argv_sha256" >"$owner_tmp"
/bin/chmod 600 "$owner_tmp"
/bin/mv -f -- "$owner_tmp" "$lock_file/owner"
owner_tmp=
owner_written=1
printf '%s:entrypoint:%s:%s:%s\n' "$attestation_token" "$wrapper_pid" "$wrapper_starttime" "$wrapper_argv_sha256" >"$attestation_file"
[ -z "$pending_signal" ] || exit "$pending_signal"
