#!/bin/sh
set -eu
usage='usage: ansible/bin/bootstrap-keycloak-dev-identity-transition check'
[ "$#" -eq 1 ] && [ "$1" = check ] || { printf '%s\n' "$usage" >&2; exit 64; }
[ ! -L "$0" ] || { printf '%s\n' 'refusing symlinked DEV transition entrypoint' >&2; exit 66; }
dir="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$0")" && /bin/pwd -P)"
root="$(CDPATH= cd -- "$dir/../.." && /bin/pwd -P)"
case "$root" in /Users/paul/Projects/cristexweb|/home/paul/projects/cristexweb) ;; *) exit 78 ;; esac
controller="$root/.venv/bin/ansible-playbook"
[ -x "$controller" ] && [ ! -L "$controller" ] || exit 69
inventory="$root/ansible/.ansible/inventory.local.yml"
[ -s "$inventory" ] && [ -f "$inventory" ] && [ ! -L "$inventory" ] || exit 78
if inventory_state=$(/usr/bin/stat -c '%a %u' "$inventory" 2>/dev/null); then
  :
else
  inventory_state=$(/usr/bin/stat -f '%Lp %u' "$inventory")
fi
[ "$inventory_state" = "600 $(/usr/bin/id -u)" ] || exit 78
[ -z "${ANSIBLE_RUN_TAGS:-}${ANSIBLE_SKIP_TAGS:-}${ANSIBLE_START_AT_TASK:-}" ] || exit 78
[ -z "${CRISTEXWEB_KEYCLOAK_DEV_TRANSITION_ADMIN_TOKEN_FILE:-}" ] || exit 78
[ -z "${CRISTEXWEB_KEYCLOAK_DEV_TRANSITION_API_BASE_URL:-}" ] || exit 78
[ -z "${CRISTEXWEB_KEYCLOAK_DEV_TRANSITION_KUBECONFIG:-}" ] || exit 78
user=$(/usr/bin/id -un)
wrapper_pid=$$
cd "$root/ansible"
umask 077
attestation="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/cristexweb-keycloak-dev-transition.XXXXXX")"
token="$(/usr/bin/openssl rand -hex 32)"
printf '%s:entrypoint\n' "$token" >"$attestation"
cleanup() { /bin/rm -f -- "$attestation"; }
trap cleanup EXIT HUP INT TERM
set -- "$controller" -i .ansible/inventory.local.yml playbooks/bootstrap_keycloak_dev_identity_transition.yml --diff --limit crtxweb --check --extra-vars '{"keycloak_dev_identity_transition_bootstrap_approved":true}'
status=0
/usr/bin/env -i HOME="${HOME:-/home/paul}" USER="$user" LOGNAME="$user" PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 ANSIBLE_CONFIG="$PWD/ansible.cfg" CRISTEXWEB_KEYCLOAK_DEV_TRANSITION_ENTRYPOINT=v2 CRISTEXWEB_KEYCLOAK_DEV_TRANSITION_WRAPPER_PID="$wrapper_pid" CRISTEXWEB_KEYCLOAK_DEV_TRANSITION_TOKEN="$token" CRISTEXWEB_KEYCLOAK_DEV_TRANSITION_ATTESTATION_FILE="$attestation" "$@" || status=$?
exit "$status"
