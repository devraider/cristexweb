#!/bin/sh
set -eu
[ "$#" -eq 1 ] && { [ "$1" = check ] || [ "$1" = apply ]; } || { echo 'usage: ansible/bin/bootstrap-infisical-cristexhub-prod-runtime check|apply' >&2; exit 64; }
mode=$1; script_path=$0; [ ! -L "$script_path" ] || { echo 'refusing a symlinked PROD runtime entrypoint' >&2; exit 66; }; script_directory=$(CDPATH= cd -- "$(dirname -- "$script_path")" && pwd -P); repository_root=$(CDPATH= cd -- "$script_directory/../.." && pwd -P)
[ -e "$repository_root/.git" ] && [ ! -L "$repository_root/.git" ] && [ -f "$repository_root/AGENTS.md" ] && [ ! -L "$repository_root/AGENTS.md" ] || { echo 'refusing an unverified repository checkout' >&2; exit 78; }
git_root=$(/usr/bin/git -C "$repository_root" rev-parse --show-toplevel); [ "$git_root" = "$repository_root" ] || { echo 'refusing a noncanonical Git worktree root' >&2; exit 78; }
origin=$(/usr/bin/git -C "$repository_root" remote get-url origin); case "$origin" in git@github.com:devraider/cristexweb.git|https://github.com/devraider/cristexweb.git) ;; *) echo 'refusing an untrusted repository origin' >&2; exit 78;; esac
[ -z "$(/usr/bin/git -C "$repository_root" status --porcelain --untracked-files=all)" ] || { echo 'refusing a dirty repository checkout' >&2; exit 78; }
controller="$repository_root/.venv/bin/ansible-playbook"; [ -x "$controller" ] || { echo 'refusing missing pinned Ansible controller' >&2; exit 69; }
controller_user=$(id -un); cd "$repository_root/ansible"; umask 077
attestation=$(mktemp "${TMPDIR:-/tmp}/cristexweb-cristexhub-prod-runtime.XXXXXX"); token=$(openssl rand -hex 32); printf '%s:entrypoint\n' "$token" > "$attestation"; trap 'rm -f -- "$attestation"' EXIT HUP INT TERM
set -- "$controller" -i .ansible/inventory.local.yml playbooks/bootstrap_infisical_cristexhub_prod_runtime.yml --diff --limit crtxweb --extra-vars '{"cristexhub_prod_runtime_bootstrap_approved":true}'
[ "$mode" = apply ] || set -- "$@" --check
/usr/bin/env -i HOME="${HOME:-/home/paul}" USER="$controller_user" LOGNAME="$controller_user" PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 ANSIBLE_CONFIG="$PWD/ansible.cfg" CRISTEXWEB_REPOSITORY_ROOT="$repository_root" CRISTEXWEB_CRISTEXHUB_PROD_RUNTIME_ENTRYPOINT=v1 CRISTEXWEB_CRISTEXHUB_PROD_RUNTIME_TOKEN="$token" CRISTEXWEB_CRISTEXHUB_PROD_RUNTIME_ATTESTATION_FILE="$attestation" "$@"
