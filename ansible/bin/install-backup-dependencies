#!/bin/sh
set -eu

usage='usage: ansible/bin/install-backup-dependencies check|apply'
if [ "$#" -ne 1 ] || { [ "$1" != check ] && [ "$1" != apply ]; }; then
  printf '%s\n' "$usage" >&2
  printf '%s\n' 'refusing passthrough arguments or task selection' >&2
  exit 64
fi

mode=$1
script_path=$0
[ ! -L "$script_path" ] || {
  printf '%s\n' 'refusing a symlinked entrypoint' >&2
  exit 66
}
script_directory="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script_path")" && pwd -P)"
repository_root="$(CDPATH= cd -- "$script_directory/../.." && pwd -P)"
[ "$repository_root" = '/home/paul/projects/cristexweb' ] || {
  printf '%s\n' 'refusing a repository outside the pinned host path' >&2
  exit 78
}
controller="$repository_root/.venv/bin/ansible-playbook"
[ -f "$controller" ] && [ -x "$controller" ] && [ ! -L "$controller" ] || {
  printf '%s\n' 'refusing an unsafe pinned Ansible controller' >&2
  exit 69
}

cd -- "$repository_root/ansible"
umask 077
set -- "$controller" \
  -i .ansible/inventory.local.yml \
  playbooks/install_backup_dependencies.yml \
  --diff \
  --limit crtxweb \
  --ask-become-pass \
  --extra-vars '{"backup_dependencies_approved":true}'
[ "$mode" != check ] || set -- "$@" --check

exec /usr/bin/env -i \
  HOME=/home/paul \
  USER=paul \
  LOGNAME=paul \
  PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  LC_ALL=C.UTF-8 \
  ANSIBLE_CONFIG="$PWD/ansible.cfg" \
  CRISTEXWEB_BACKUP_DEPENDENCIES_ENTRYPOINT=v1 \
  "$@"
