#!/bin/sh
set -eu

case $- in
  *x*|*v*)
    printf '%s\n' 'refusing traced shell execution' >&2
    exit 65
    ;;
esac
if ! /usr/bin/env | /usr/bin/awk -F= \
  '/^(ANSIBLE_|PYTHONHOME=|PYTHONPATH=|PYTHONOPTIMIZE=|PYTHONINSPECT=|PYTHONBREAKPOINT=|VIRTUAL_ENV=)/ { found = 1 } END { exit found }'; then
  printf '%s\n' 'refusing inherited controller or Ansible override' >&2
  exit 65
fi

usage='usage: ansible/bin/configure-reactive-resume-dev-backup check|apply|test|restore|enable-check|enable-apply'
if [ "$#" -ne 1 ]; then
  printf '%s\n%s\n' "$usage" 'refusing passthrough arguments or task selection' >&2
  exit 64
fi
case "$1" in
  check) mode=install; check_mode=true ;;
  apply) mode=install; check_mode=false ;;
  test) mode=test; check_mode=false ;;
  restore) mode=restore; check_mode=false ;;
  enable-check) mode=enable; check_mode=true ;;
  enable-apply) mode=enable; check_mode=false ;;
  *) printf '%s\n%s\n' "$usage" 'refusing passthrough arguments or task selection' >&2; exit 64 ;;
esac
script_path=$0
[ ! -L "$script_path" ] || { printf '%s\n' 'refusing a symlinked entrypoint' >&2; exit 66; }
script_directory="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script_path")" && pwd -P)"
repository_root="$(CDPATH= cd -- "$script_directory/../.." && pwd -P)"
[ "$repository_root" = '/home/paul/projects/cristexweb' ] || {
  printf '%s\n' 'refusing a repository outside the pinned host path' >&2
  exit 78
}
script_path="$repository_root/ansible/bin/configure-reactive-resume-dev-backup"
controller="$repository_root/.venv/bin/ansible-playbook"
inventory="$repository_root/ansible/.ansible/inventory.local.yml"
ansible_config="$repository_root/ansible/ansible.cfg"
collection_manifest="$repository_root/ansible/.ansible/collections/ansible_collections/kubernetes/core/MANIFEST.json"
controller_expected='baf52d00491b00126ccc19ec1a2e018e107c134e663885e748e5fe4e3777b3fd'
inventory_expected='652a8455f8a050005ab783d20d4e60a0cd034d8a6439f1cffe551a91102773b0'
collection_manifest_expected='dc32e90ca987d6199e9091f749ecb40fd3380b40aabb7c18961ec75582cfc6df'
[ -f "$controller" ] && [ -x "$controller" ] && [ ! -L "$controller" ] || {
  printf '%s\n' 'refusing an unsafe pinned Ansible controller' >&2
  exit 69
}
# The self hash replaces this literal with zeros before hashing, so changing
# any wrapper logic or closure pin fails without creating a circular digest.
reactive_resume_dev_backup_wrapper_sha256='f26908edde000e5c8e6d8a5ef5d224123711cd557499f19b9356f466f340052d'
canonical_sha256() {
  /usr/bin/python3 -I - "$1" <<'PY'
import hashlib
import re
import sys
path = sys.argv[1]
with open(path, "r", encoding="utf-8") as source:
    text = source.read()
text, count = re.subn(
    r"(?m)^reactive_resume_dev_backup_wrapper_sha256='[0-9a-f]{64}'$",
    "reactive_resume_dev_backup_wrapper_sha256='" + ("0" * 64) + "'",
    text,
)
if path.endswith("configure_reactive_resume_dev_backup.yml"):
    if count != 0:
        raise SystemExit(69)
else:
    if count != 1:
        raise SystemExit(69)
text, count = re.subn(
    r"(?m)^(    reactive_resume_dev_backup_playbook_sha256: )[0-9a-f]{64}$",
    lambda match: match.group(1) + ("0" * 64),
    text,
)
if path.endswith("configure_reactive_resume_dev_backup.yml") and count != 1:
    raise SystemExit(69)
text, immutable_count = re.subn(
    r"(?m)^(\s+- reactive_resume_dev_backup_(?:wrapper|playbook)_sha256 == ')[0-9a-f]{64}(')$",
    lambda match: match.group(1) + ("0" * 64) + match.group(2),
    text,
)
if path.endswith("configure_reactive_resume_dev_backup.yml") and immutable_count != 2:
    raise SystemExit(69)
print(hashlib.sha256(text.encode("utf-8")).hexdigest())
PY
}

playbook="$repository_root/ansible/playbooks/configure_reactive_resume_dev_backup.yml"
playbook_expected=$(/usr/bin/awk '$1 == "reactive_resume_dev_backup_playbook_sha256:" { print $2 }' "$playbook")
[ "${#playbook_expected}" -eq 64 ] || { printf '%s\n' 'refusing an unpinned backup playbook' >&2; exit 69; }
case "$playbook_expected" in *[!0-9a-f]*) printf '%s\n' 'refusing an invalid backup playbook pin' >&2; exit 69 ;; esac
[ "$(canonical_sha256 "$script_path")" = "$reactive_resume_dev_backup_wrapper_sha256" ] || {
  printf '%s\\n' 'refusing backup wrapper source drift' >&2
  exit 69
}
[ "$(canonical_sha256 "$playbook")" = "$playbook_expected" ] || {
  printf '%s\\n' 'refusing backup playbook source drift' >&2
  exit 69
}
verify_source() {
  source_path=$1
  source_mode=$2
  source_sha256=$3
  [ -f "$source_path" ] && [ ! -L "$source_path" ] || exit 69
  [ "$(/usr/bin/stat -c '%U:%G:%a' "$source_path")" = "paul:paul:$source_mode" ] || exit 69
  [ "$(/usr/bin/sha256sum "$source_path" | /usr/bin/cut -d ' ' -f 1)" = "$source_sha256" ] || exit 69
}
verify_source "$ansible_config" 644 4e39dec40f1f0a0735e7f27e35f464093de3b16e8be1e5fa05299005528a85d9
verify_source "$repository_root/ansible/plugins/strategy/reactive_resume_dev_backup_guarded_linear.py" 644 852257239327e457e910980417e478ee28654d330df2ebeff88374ddb21c3e3c
verify_source "$repository_root/ansible/plugins/action/reactive_resume_dev_backup_entrypoint_guarded.py" 644 07fd0fbff6961574b25bb0ce6384af9a8dbcc41b3e12c38404a4ecf076fef7dc
verify_source "$controller" 755 "$controller_expected"
verify_source "$inventory" 600 "$inventory_expected"
verify_source "$collection_manifest" 644 "$collection_manifest_expected"
[ "$(/usr/bin/head -n 1 "$controller")" = "#!$repository_root/.venv/bin/python" ] || {
  printf '%s\n' 'refusing an Ansible controller outside the pinned project interpreter' >&2
  exit 69
}
/usr/bin/grep -Eq '"version"[[:space:]]*:[[:space:]]*"6\.1\.0"' "$collection_manifest" || {
  printf '%s\n' 'refusing an unpinned kubernetes.core collection' >&2
  exit 69
}
/usr/bin/awk '
  NR == 1 { ok = ($0 == "---") }
  NR == 2 { ok = ok && ($0 == "all:") }
  NR == 3 { ok = ok && ($0 == "  children:") }
  NR == 4 { ok = ok && ($0 == "    k3s_servers:") }
  NR == 5 { ok = ok && ($0 == "      hosts:") }
  NR == 6 { ok = ok && ($0 == "        crtxweb:") }
  NR == 7 { ok = ok && ($0 == "          ansible_connection: local") }
  NR == 8 { ok = ok && ($0 == "          ansible_python_interpreter: /usr/bin/python3") }
  NR == 9 { ok = ok && ($0 == "          ansible_user: paul") }
  END { exit !(ok && NR == 9) }
' "$inventory" || {
  printf '%s\n' 'refusing inventory target or identity drift' >&2
  exit 69
}
verify_source "$repository_root/ansible/files/backup/reactive-resume-dev-backup" 755 da128785db27a39c338ffad195b05ae745f315b55cd8ce84b4314560be7272ec
verify_source "$repository_root/ansible/files/backup/restore-reactive-resume-dev-backup-rehearsal" 755 8f39b40119c31fcf4ef4e3536321665443049dfed20620b89bdaa9b6b3bcba15
verify_source "$repository_root/ansible/files/backup/cristexweb-reactive-resume-dev-backup.service" 644 cd1a1cf09646d6675ebdefba085735755c00e229f1a21ae1d2a5ab2c196dbae2
verify_source "$repository_root/ansible/files/backup/cristexweb-reactive-resume-dev-backup.timer" 644 c0b4d246b523e46a375e55eb0aa4bb70d344b9a7a1c4a5f5e1c05e37ac315461
verify_source "$repository_root/ansible/files/backup/reactive-resume-dev-backup-networkpolicy.yaml" 644 4bfdf41939c1a6f3312c3f703c235efe14959fb1062c5573f16e8d337e1d1ec6

cd -- "$repository_root/ansible"
umask 077
entrypoint_attestation=
cleanup_entrypoint_attestation() {
  [ -z "$entrypoint_attestation" ] || /usr/bin/rm -f -- "$entrypoint_attestation"
}
trap cleanup_entrypoint_attestation EXIT HUP INT TERM
entrypoint_attestation=$(/usr/bin/mktemp "${TMPDIR:-/tmp}/cristexweb-reactive-resume-dev-backup.XXXXXX")
entrypoint_token=$(/usr/bin/openssl rand -hex 32)
printf '%s:entrypoint\n' "$entrypoint_token" >"$entrypoint_attestation"
/usr/bin/chmod 0600 "$entrypoint_attestation"
set -- "$controller" -i "$inventory" \
  "$playbook" --diff --limit crtxweb \
  --ask-become-pass \
  --extra-vars "{\"reactive_resume_dev_backup_approved\":true,\"reactive_resume_dev_backup_mode\":\"$mode\",\"reactive_resume_dev_backup_repository_root\":\"$repository_root\"}"
[ "$check_mode" = false ] || set -- "$@" --check
if [ "$mode" = restore ]; then
  /usr/bin/env -i HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 \
    ANSIBLE_CONFIG="$ansible_config" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_ENTRYPOINT=v1 \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_REPOSITORY_ROOT="$repository_root" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_ENTRYPOINT_TOKEN="$entrypoint_token" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_ENTRYPOINT_ATTESTATION_FILE="$entrypoint_attestation" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_CONTROLLER_PATH="$controller" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_CONTROLLER_SHA256="$controller_expected" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_INVENTORY_PATH="$inventory" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_INVENTORY_SHA256="$inventory_expected" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_ANSIBLE_CONFIG_SHA256="4e39dec40f1f0a0735e7f27e35f464093de3b16e8be1e5fa05299005528a85d9" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_STRATEGY_SHA256="852257239327e457e910980417e478ee28654d330df2ebeff88374ddb21c3e3c" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_COLLECTION_MANIFEST_SHA256="$collection_manifest_expected" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_ENTRYPOINT="${CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_ENTRYPOINT-}" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_APPROVED="${CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_APPROVED-}" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_ATTESTATION_FILE="${CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_ATTESTATION_FILE-}" \
    CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_TOKEN="${CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_RESTORE_TOKEN-}" \
    "$@"
  exit $?
fi
/usr/bin/env -i HOME=/home/paul USER=paul LOGNAME=paul PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 \
  ANSIBLE_CONFIG="$ansible_config" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_ENTRYPOINT=v1 \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_REPOSITORY_ROOT="$repository_root" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_ENTRYPOINT_TOKEN="$entrypoint_token" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_ENTRYPOINT_ATTESTATION_FILE="$entrypoint_attestation" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_CONTROLLER_PATH="$controller" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_CONTROLLER_SHA256="$controller_expected" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_INVENTORY_PATH="$inventory" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_INVENTORY_SHA256="$inventory_expected" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_ANSIBLE_CONFIG_SHA256="4e39dec40f1f0a0735e7f27e35f464093de3b16e8be1e5fa05299005528a85d9" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_STRATEGY_SHA256="852257239327e457e910980417e478ee28654d330df2ebeff88374ddb21c3e3c" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_BACKUP_COLLECTION_MANIFEST_SHA256="$collection_manifest_expected" \
  "$@"
