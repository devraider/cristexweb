#!/bin/dash
set -eu

usage='usage: ansible/bin/configure-reactive-resume-dev-tls-renewal check|apply|enable-check|enable-apply'
if [ "$#" -ne 1 ]; then
  printf '%s\n%s\n' "$usage" 'refusing passthrough arguments or task selection' >&2
  exit 64
fi
invocation=$1
case "$1" in
  check) mode=install; check_mode=true ;;
  apply) mode=install; check_mode=false ;;
  enable-check) mode=enable; check_mode=true ;;
  enable-apply) mode=enable; check_mode=false ;;
  *) printf '%s\n%s\n' "$usage" 'refusing passthrough arguments or task selection' >&2; exit 64 ;;
esac
case $- in
  *x*|*v*) printf '%s\n' 'refusing traced shell execution' >&2; exit 65 ;;
esac

script_path=$0
[ ! -L "$script_path" ] || {
  printf '%s\n' 'refusing a symlinked TLS renewal entrypoint' >&2
  exit 66
}
script_directory="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script_path")" && /bin/pwd -P)"
repository_root="$(CDPATH= cd -- "$script_directory/../.." && /bin/pwd -P)"
[ "$repository_root" = /home/paul/projects/cristexweb ] || {
  printf '%s\n' 'refusing a repository outside the pinned controller path' >&2
  exit 78
}
script_path="$repository_root/ansible/bin/configure-reactive-resume-dev-tls-renewal"
if [ "$0" != "$script_path" ]; then
  exec /bin/dash "$script_path" "$@"
fi
controller="$repository_root/.venv/bin/ansible-playbook"
python_tool=/usr/bin/python3
python_target=/usr/bin/python3.13
clean_python() {
  /usr/bin/env -i \
    PATH=/usr/bin:/bin \
    LC_ALL=C.UTF-8 \
    PYTHONNOUSERSITE=1 \
    PYTHONHASHSEED=0 \
    "$python_tool" -I "$@"
}
inventory="$repository_root/ansible/.ansible/inventory.local.yml"
ansible_config="$repository_root/ansible/ansible.cfg"
manifest="$repository_root/ansible/files/components/reactive-resume-dev-tls/MANIFESTS.sha256"
validator="$repository_root/ansible/files/components/reactive-resume-dev-tls/renewal/validate-reactive-resume-dev-tls-material"
renewal="$repository_root/ansible/files/components/reactive-resume-dev-tls/renewal/reactive-resume-dev-tls-renew"
service="$repository_root/ansible/files/components/reactive-resume-dev-tls/renewal/cristexweb-reactive-resume-dev-tls-renew.service"
timer="$repository_root/ansible/files/components/reactive-resume-dev-tls/renewal/cristexweb-reactive-resume-dev-tls-renew.timer"
playbook="$repository_root/ansible/playbooks/configure_reactive_resume_dev_tls_renewal.yml"
tasks="$repository_root/ansible/roles/reactive_resume_dev_tls_renewal/tasks/main.yml"
defaults="$repository_root/ansible/roles/reactive_resume_dev_tls_renewal/defaults/main.yml"
strategy="$repository_root/ansible/plugins/strategy/reactive_resume_dev_tls_renewal_guarded_linear.py"
mutation_action="$repository_root/ansible/plugins/action/reactive_resume_dev_tls_renewal_mutation_guarded.py"
mutation_module="$repository_root/ansible/library/reactive_resume_dev_tls_renewal_mutation_guarded.py"
mutation_action_expected_path="$repository_root/ansible/plugins/action/reactive_resume_dev_tls_renewal_mutation_guarded.py"
mutation_module_expected_path="$repository_root/ansible/library/reactive_resume_dev_tls_renewal_mutation_guarded.py"
[ -n "${mutation_action:-}" ] && [ "$mutation_action" = "$mutation_action_expected_path" ] || {
  printf '%s\n' 'refusing an undefined or non-canonical TLS mutation action path' >&2
  exit 69
}
[ -n "${mutation_module:-}" ] && [ "$mutation_module" = "$mutation_module_expected_path" ] || {
  printf '%s\n' 'refusing an undefined or non-canonical TLS mutation module path' >&2
  exit 69
}
sha_file() { /usr/bin/sha256sum -- "$1" | /usr/bin/awk '{print $1}'; }
source_file_contract() {
  source_path=$1
  source_mode=${2#0}
  source_owner=$3
  source_group=$4
  source_digest=$5
  [ -n "${source_path:-}" ] && [ -f "$source_path" ] && [ ! -L "$source_path" ] || return 1
  [ "$(/usr/bin/stat -c '%F:%U:%G:%a' -- "$source_path")" = "regular file:${source_owner}:${source_group}:${source_mode}" ] || return 1
  [ "$(sha_file "$source_path")" = "$source_digest" ] || return 1
}
canonical_sha256() {
  clean_python - "$1" wrapper_canonical_sha256_expected <<'PY'
import hashlib, re, sys
source = open(sys.argv[1], encoding='utf-8').read()
symbol = sys.argv[2]
source, count = re.subn(
    rf"(?m)^({re.escape(symbol)}\s*=\s*[\"'])([0-9a-f]{{64}})([\"']\s*)$",
    rf"\g<1>{'0' * 64}\g<3>",
    source,
)
if count != 1:
    raise SystemExit(69)
print(hashlib.sha256(source.encode()).hexdigest())
PY
}
normalized_defaults_sha256() {
  clean_python - "$1" <<'PY'
import hashlib, re, sys
source = open(sys.argv[1], encoding='utf-8').read()
replacements = (
    (
        r"(?m)^reactive_resume_dev_tls_renewal_defaults_self_hash:\s+[0-9a-f]{64}$",
        "reactive_resume_dev_tls_renewal_defaults_self_hash: __SELF_HASH__",
    ),
    (
        r"(?m)^(    normalized_digest_name: reactive_resume_dev_tls_renewal_defaults_self_hash\n    sha256: )[0-9a-f]{64}$",
        r"\1__SELF_HASH__",
    ),
    (
        r"(?m)^(  - path: >-\n      .*reactive_resume_dev_tls_renewal_guarded_linear\.py\n    mode: '0644'\n    sha256: )[0-9a-f]{64}$",
        r"\1__STRATEGY_HASH__",
    ),
    (
        r"(?m)^(  - path: >-\n      .*ansible/bin/configure-reactive-resume-dev-tls-renewal\n    mode: '0755'\n    sha256: )[0-9a-f]{64}$",
        r"\1__WRAPPER_HASH__"
    ),
)
for pattern, replacement in replacements:
    source, count = re.subn(pattern, replacement, source)
    if count != 1:
        raise SystemExit(69)
print(hashlib.sha256(source.encode()).hexdigest())
PY
}
normalized_task_sha256() {
  clean_python - "$1" <<'PY'
import hashlib, re, sys
source = open(sys.argv[1], encoding='utf-8').read()
replacements = (
    (
        r"(?ms)(lookup\('ansible\.builtin\.env',\s*'CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_STRATEGY_CANONICAL_SHA256'\)\s*==\s*')[0-9a-f]{64}(')",
        r"\1__STRATEGY_CANONICAL_HASH__\2",
    ),
    (
        r"(?ms)(lookup\('ansible\.builtin\.env',\s*'CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_STRATEGY_SHA256'\)\s*==\s*')[0-9a-f]{64}(')",
        r"\1__STRATEGY_HASH__\2",
    ),
    (
        r"(?ms)(lookup\('ansible\.builtin\.env',\s*'CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_STRATEGY_NORMALIZED_SHA256'\)\s*==\s*')[0-9a-f]{64}(')",
        r"\1__STRATEGY_NORMALIZED_HASH__\2",
    ),
    (
        r"(?ms)(lookup\('ansible\.builtin\.env',\s*'CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_WRAPPER_CANONICAL_SHA256'\)\s*==\s*')[0-9a-f]{64}(')",
        r"\1__WRAPPER_CANONICAL_HASH__\2",
    ),
    (
        r"(?ms)(lookup\('ansible\.builtin\.env',\s*'CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_TASK_SHA256'\)\s*==\s*')[0-9a-f]{64}(')",
        r"\1__TASK_HASH__\2",
    ),
    (
        r"(?ms)(lookup\('ansible\.builtin\.env',\s*'CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_DEFAULTS_SHA256'\)\s*==\s*')[0-9a-f]{64}(')",
        r"\1__DEFAULTS_HASH__\2",
    ),
    (
        r"(?m)^    reactive_resume_dev_tls_renewal_task_self_hash:\s*'?[0-9a-f]{64}'?$",
        "    reactive_resume_dev_tls_renewal_task_self_hash: __TASK_SELF_HASH__",
    ),
    (
        r"(?m)^    reactive_resume_dev_tls_renewal_defaults_raw_hash:\s*'?[0-9a-f]{64}'?$",
        "    reactive_resume_dev_tls_renewal_defaults_raw_hash: __DEFAULTS_RAW_HASH__",
    ),
)
for pattern, replacement in replacements:
    source, count = re.subn(pattern, replacement, source)
    if count != 1:
        raise SystemExit(69)
print(hashlib.sha256(source.encode()).hexdigest())
PY
}
normalized_strategy_sha256() {
  clean_python - "$1" <<'PY'
import hashlib, re, sys
source = open(sys.argv[1], encoding="utf-8").read()
for symbol, marker in (
    ("_STRATEGY_CANONICAL_SHA256", "__STRATEGY_CANONICAL_HASH__"),
    ("_STRATEGY_NORMALIZED_SHA256", "__STRATEGY_NORMALIZED_HASH__"),
    ("_WRAPPER_CANONICAL_SHA256", "__WRAPPER_CANONICAL_HASH__"),
):
    source, count = re.subn(
        rf"(?m)^({re.escape(symbol)}\s*=\s*[\"'])([0-9a-f]{{64}})([\"']\s*)$",
        rf"\g<1>{marker}\g<3>",
        source,
    )
    if count != 1:
        raise SystemExit(69)
print(hashlib.sha256(source.encode()).hexdigest())
PY
}
canonical_strategy_sha256() {
  clean_python - "$1" <<'PY'
import hashlib, re, sys
source = open(sys.argv[1], encoding="utf-8").read()
for symbol in (
    "_STRATEGY_CANONICAL_SHA256",
    "_STRATEGY_NORMALIZED_SHA256",
    "_WRAPPER_CANONICAL_SHA256",
):
    source, count = re.subn(
        rf"(?m)^({re.escape(symbol)}\s*=\s*[\"'])([0-9a-f]{{64}})([\"']\s*)$",
        rf"\g<1>__PIN__\g<3>",
        source,
    )
    if count != 1:
        raise SystemExit(69)
print(hashlib.sha256(source.encode()).hexdigest())
PY
}
# Immutable pre-launch pins. The normalized strategy pin excludes only its
# expected provenance markers; every other strategy byte remains covered.
controller_sha256_expected='baf52d00491b00126ccc19ec1a2e018e107c134e663885e748e5fe4e3777b3fd'
python_sha256_expected='17b78e0a93175e86f9ac03141924fd7a7f0c0c52e66b34bfa0de20ffef989df1'
inventory_sha256_expected='652a8455f8a050005ab783d20d4e60a0cd034d8a6439f1cffe551a91102773b0'
ansible_config_sha256_expected='4e39dec40f1f0a0735e7f27e35f464093de3b16e8be1e5fa05299005528a85d9'
playbook_sha256_expected='3e73c601399c1189829802c5c3d438107bd1f884ff50b9e76702658bfd07db05'
task_sha256_expected='8a5c2765a85ce1f6ffffc124414743c4f801792a31879179e7f6928b9536c3e1'
defaults_sha256_expected='378f8b86e527799847a1416f97a6c423ba45d85a392c0836b3a2c27c8ad57c79'
strategy_canonical_sha256_expected='95fef8ef4be10c654e5355c49a00b292ca327bac7fd5e8138d918c26cf4e807d'
strategy_normalized_sha256_expected='89eba957edf1d19145c3267ad589bedd4c3fd0af71018e2d70cd792078527260'
strategy_attestation_sha256_expected='aa8ef9124552f3d1a1f65d7fdbeb2ec37bc28f84f1a77e8fffdf3f636a9c6dbb'
mutation_action_sha256_expected='e0060109acc9fff92bae03c697f08697b81527f4e631cda86e7f33c581090d7d'
mutation_module_sha256_expected='38da36be88a0b530884b804b817ea5eb636f7008ec4272da4f2f0b2c0e58565a'
wrapper_canonical_sha256_expected='d9785dfc58c0757335ed329d7115f16b2f69cc5129b71d34200d410d344b3629'
source_file_contract "$mutation_action" '0644' 'paul' 'paul' "$mutation_action_sha256_expected" || {
  printf '%s\n' 'refusing TLS mutation action type, ownership, mode, or hash drift' >&2
  exit 69
}
source_file_contract "$mutation_module" '0644' 'paul' 'paul' "$mutation_module_sha256_expected" || {
  printf '%s\n' 'refusing TLS mutation module type, ownership, mode, or hash drift' >&2
  exit 69
}
[ -f "$controller" ] && [ -x "$controller" ] && [ ! -L "$controller" ] || exit 69
[ -L "$python_tool" ] || exit 69
[ "$(/usr/bin/readlink -f -- "$python_tool")" = "$python_target" ] || exit 69
[ -f "$python_target" ] && [ ! -L "$python_target" ] || exit 69
[ "$(/usr/bin/stat -c '%U:%G:%a' "$python_target")" = 'root:root:755' ] || exit 69
inventory_directory=$(/usr/bin/dirname -- "$inventory")
for forbidden in \
  "$inventory_directory/group_vars" \
  "$inventory_directory/host_vars" \
  "$inventory_directory/vars_plugins" \
  "$repository_root/ansible/inventory/group_vars" \
  "$repository_root/ansible/inventory/host_vars" \
  "$repository_root/ansible/inventory/vars_plugins" \
  "$repository_root/ansible/playbooks/group_vars" \
  "$repository_root/ansible/playbooks/host_vars" \
  "$repository_root/ansible/playbooks/vars_plugins" \
  "$repository_root/ansible/group_vars" \
  "$repository_root/ansible/host_vars" \
  "$repository_root/ansible/vars_plugins" \
  "$repository_root/group_vars" \
  "$repository_root/host_vars" \
  "$repository_root/vars_plugins"; do
  if [ -e "$forbidden" ] || [ -L "$forbidden" ]; then
    printf '%s\n' 'refusing inventory-adjacent variable or vars-plugin path' >&2
    exit 69
  fi
done
for source in "$inventory" "$ansible_config" "$manifest" "$validator" "$renewal" "$service" "$timer" "$playbook" "$tasks" "$defaults" "$strategy" "$mutation_action" "$mutation_module"; do
  [ -f "$source" ] && [ ! -L "$source" ] || exit 69
done
[ -f "$controller" ] && [ ! -L "$controller" ] || exit 69
[ "$(/usr/bin/stat -c '%U:%G:%a' "$controller")" = 'paul:paul:755' ] || exit 69
[ "$(/usr/bin/stat -c '%U:%G:%a' "$inventory")" = 'paul:paul:600' ] || exit 69
[ "$(/usr/bin/stat -c '%U:%G:%a' "$ansible_config")" = 'paul:paul:644' ] || exit 69
[ "$(canonical_sha256 "$script_path" wrapper_canonical_sha256_expected)" = "$wrapper_canonical_sha256_expected" ] || {
  printf '%s\n' 'refusing TLS renewal wrapper source drift' >&2
  exit 69
}
controller_user=$(/usr/bin/id -un)
[ "$controller_user" = paul ] || exit 78
cd -- "$repository_root/ansible"
wrapper_sha256=$(sha_file "$script_path")
controller_sha256=$(sha_file "$controller")
python_sha256=$(sha_file "$python_tool")
inventory_sha256=$(sha_file "$inventory")
ansible_config_sha256=$(sha_file "$ansible_config")
manifest_sha256=$(sha_file "$manifest")
validator_sha256=$(sha_file "$validator")
renewal_sha256=$(sha_file "$renewal")
service_sha256=$(sha_file "$service")
timer_sha256=$(sha_file "$timer")
playbook_sha256=$(sha_file "$playbook")
task_sha256=$(normalized_task_sha256 "$tasks")
defaults_sha256=$(normalized_defaults_sha256 "$defaults")
strategy_sha256=$(sha_file "$strategy")
strategy_normalized_sha256=$(normalized_strategy_sha256 "$strategy")
strategy_canonical_sha256=$(canonical_strategy_sha256 "$strategy")
mutation_action_sha256=$(sha_file "$mutation_action")
mutation_module_sha256=$(sha_file "$mutation_module")
[ "$controller_sha256" = "$controller_sha256_expected" ] || exit 69
[ "$python_sha256" = "$python_sha256_expected" ] || exit 69
[ "$inventory_sha256" = "$inventory_sha256_expected" ] || exit 69
[ "$ansible_config_sha256" = "$ansible_config_sha256_expected" ] || exit 69
[ "$playbook_sha256" = "$playbook_sha256_expected" ] || exit 69
[ "$task_sha256" = "$task_sha256_expected" ] || exit 69
[ "$defaults_sha256" = "$defaults_sha256_expected" ] || exit 69
[ "$strategy_canonical_sha256" = "$strategy_canonical_sha256_expected" ] || exit 69
[ "$strategy_normalized_sha256" = "$strategy_normalized_sha256_expected" ] || exit 69
[ "$mutation_action_sha256" = "$mutation_action_sha256_expected" ] || exit 69
[ "$mutation_module_sha256" = "$mutation_module_sha256_expected" ] || exit 69
wrapper_pid=$$
wrapper_starttime=$(/usr/bin/awk '{print $22}' "/proc/$wrapper_pid/stat")
case "$wrapper_starttime" in
  ''|*[!0-9]*) printf '%s\n' 'refusing an unidentifiable wrapper process' >&2; exit 69 ;;
esac
wrapper_canonical_sha256=$(canonical_sha256 "$script_path" wrapper_canonical_sha256_expected)
attestation_file="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/cristexweb-reactive-resume-dev-tls-renewal.XXXXXX")"
attestation_token="$(/usr/bin/openssl rand -hex 32)"
/bin/chmod 0600 "$attestation_file"
printf '%s:%s:%s:%s:%s:%s\n' "$attestation_token" "$wrapper_pid" "$wrapper_starttime" "$script_path" "$wrapper_sha256" "$invocation" >"$attestation_file"
cleanup() { /bin/rm -f -- "$attestation_file"; }
trap cleanup EXIT HUP INT TERM

set -- \
  "$controller" \
  -i "$inventory" \
  "$playbook" \
  --diff \
  --limit crtxweb \
  --ask-become-pass \
  --extra-vars "{\"reactive_resume_dev_tls_renewal_approved\":true,\"reactive_resume_dev_tls_renewal_mode\":\"$mode\",\"reactive_resume_dev_tls_renewal_repository_root\":\"$repository_root\"}"
[ "$check_mode" = false ] || set -- "$@" --check

/usr/bin/env -i \
  HOME=/home/paul \
  USER="$controller_user" \
  LOGNAME="$controller_user" \
  PATH=/usr/bin:/bin:/usr/sbin:/sbin \
  LC_ALL=C.UTF-8 \
  ANSIBLE_CONFIG="$ansible_config" \
  ANSIBLE_HOST_PATTERN_MISMATCH=error \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_ENTRYPOINT=v2 \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_CONTROLLER="$controller" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_PYTHON="$python_tool" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_PYTHON_SHA256="$python_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_ANSIBLE_CONFIG="$ansible_config" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_TOKEN="$attestation_token" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_ATTESTATION_FILE="$attestation_file" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_WRAPPER_PID="$wrapper_pid" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_WRAPPER_STARTTIME="$wrapper_starttime" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_WRAPPER_PATH="$script_path" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_WRAPPER_CANONICAL_SHA256="$wrapper_canonical_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_WRAPPER_SHA256="$wrapper_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_MANIFEST_SHA256="$manifest_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_VALIDATOR_SHA256="$validator_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_CERTBOT_SHA256="$renewal_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_SERVICE_SHA256="$service_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_TIMER_SHA256="$timer_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_PLAYBOOK_SHA256="$playbook_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_TASK_SHA256="$task_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_DEFAULTS_SHA256="$defaults_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_STRATEGY_PATH="$strategy" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_STRATEGY_SHA256="$strategy_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_STRATEGY_NORMALIZED_SHA256="$strategy_normalized_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_STRATEGY_CANONICAL_SHA256="$strategy_canonical_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_WRAPPER_CANONICAL_SHA256="$wrapper_canonical_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_STRATEGY_ATTESTATION_SHA256="$strategy_attestation_sha256_expected" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_MUTATION_ACTION_PATH="$mutation_action" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_MUTATION_ACTION_SHA256="$mutation_action_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_MUTATION_MODULE_PATH="$mutation_module" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_MUTATION_MODULE_SHA256="$mutation_module_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_PLAYBOOK_PATH="$playbook" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_CONTROLLER_SHA256="$controller_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_INVENTORY_SHA256="$inventory_sha256" \
  CRISTEXWEB_REACTIVE_RESUME_DEV_TLS_RENEWAL_ANSIBLE_CONFIG_SHA256="$ansible_config_sha256" \
  "$@"
