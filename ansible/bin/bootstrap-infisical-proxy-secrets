#!/bin/sh
set -eu

usage='usage: ansible/bin/bootstrap-infisical-proxy-secrets apply'
if [ "$#" -ne 1 ] || [ "$1" != apply ]; then
  printf '%s\n' "$usage" >&2
  printf '%s\n' 'refusing passthrough arguments, check mode, or task selection' >&2
  exit 64
fi

script_path=$0
if [ -L "$script_path" ]; then
  printf '%s\n' 'refusing a symlinked proxy secret-zero entrypoint' >&2
  exit 66
fi
script_directory="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script_path")" && pwd -P)"
repository_root="$(CDPATH= cd -- "$script_directory/../.." && pwd -P)"
controller_home="$(CDPATH= cd -- "$repository_root/../.." && pwd -P)"
controller_user="$(/usr/bin/id -un)"
if [ "$repository_root" != "$controller_home/Projects/cristexweb" ]; then
  printf '%s\n' 'refusing a repository outside the pinned controller path' >&2
  exit 78
fi
controller="$repository_root/.venv/bin/ansible-playbook"
if [ ! -f "$controller" ] || [ ! -x "$controller" ] || [ -L "$controller" ]; then
  printf '%s\n' 'refusing an unsafe pinned Ansible controller' >&2
  exit 69
fi
for tool in /opt/homebrew/bin/age /opt/homebrew/bin/age-keygen /opt/homebrew/bin/openssl; do
  if [ ! -f "$tool" ] || [ ! -x "$tool" ]; then
    printf '%s\n' "refusing an absent or non-executable pinned tool: $tool" >&2
    exit 69
  fi
done
[ "$(/opt/homebrew/bin/age --version)" = 'v1.3.1' ] || { printf '%s\n' 'refusing age version drift' >&2; exit 69; }
case "$(/opt/homebrew/bin/openssl version)" in
  'OpenSSL 3.5.0 '*) ;;
  *) printf '%s\n' 'refusing OpenSSL version drift' >&2; exit 69 ;;
esac

umask 077
temporary_directory="$(/usr/bin/mktemp -d "${TMPDIR:-/tmp}/cristexweb-infisical-proxy-secrets.XXXXXX")"
cleanup() {
  unset proxy_password proxy_hash recipient attestation_token identity_value keychain_identity
  /bin/rm -rf -- "$temporary_directory"
}
trap cleanup EXIT HUP INT TERM
attestation_file="$temporary_directory/attestation"
attestation_token="$(/opt/homebrew/bin/openssl rand -hex 32)"
printf '%s:entrypoint\n' "$attestation_token" >"$attestation_file"
identity_directory="$controller_home/Library/Application Support/CristexWeb/age"
identity_file="$identity_directory/infisical-proxy-recovery-key.txt"
recovery_directory="$controller_home/Library/Application Support/CristexWeb/recovery/infisical-proxy"
pending_marker="$recovery_directory/pending"
completed_marker="$recovery_directory/completed"
mkdir -p "$identity_directory" "$recovery_directory"
chmod 0700 "$identity_directory" "$recovery_directory"
keychain_identity=''
if /usr/bin/security find-generic-password -a cristexweb \
  -s cristexweb-infisical-proxy-age-identity -w \
  >"$temporary_directory/keychain-identity" 2>/dev/null; then
  keychain_identity="$(/bin/cat "$temporary_directory/keychain-identity")"
fi
if [ -L "$identity_file" ]; then
  printf '%s\n' 'refusing a symlinked age identity' >&2
  exit 77
fi
if [ ! -f "$identity_file" ]; then
  if [ -n "$keychain_identity" ]; then
    printf '%s\n' "$keychain_identity" >"$identity_file"
  else
    if [ -f "$pending_marker" ] || [ -f "$completed_marker" ]; then
      printf '%s\n' 'refusing recovery state without either age identity copy' >&2
      exit 77
    fi
    /opt/homebrew/bin/age-keygen -o "$identity_file" 2>"$temporary_directory/age-keygen.log"
  fi
fi
if [ "$(/usr/bin/stat -f '%OLp' "$identity_file")" != 600 ] || [ "$(/usr/bin/stat -f '%Su' "$identity_file")" != "$controller_user" ]; then
  printf '%s\n' 'refusing an unsafe age identity' >&2
  exit 77
fi
identity_value="$(/usr/bin/grep '^AGE-SECRET-KEY-' "$identity_file")"
if [ -n "$keychain_identity" ]; then
  [ "$identity_value" = "$keychain_identity" ] || {
    printf '%s\n' 'refusing mismatched age identity custody copies' >&2
    exit 77
  }
else
  printf '%s\n%s\n' "$identity_value" "$identity_value" | \
    /usr/bin/security add-generic-password -a cristexweb \
    -s cristexweb-infisical-proxy-age-identity -w \
    >/dev/null 2>"$temporary_directory/keychain.log"
  keychain_identity="$(/usr/bin/security find-generic-password -a cristexweb \
    -s cristexweb-infisical-proxy-age-identity -w 2>/dev/null)"
  [ "$identity_value" = "$keychain_identity" ] || {
    printf '%s\n' 'refusing unrecoverable age identity custody' >&2
    exit 77
  }
fi
recipient="$(/opt/homebrew/bin/age-keygen -y "$identity_file")"
unset identity_value keychain_identity

bundle_directory="$temporary_directory/bundle"
archive="$temporary_directory/recovered.tar.gz"
mkdir -p "$bundle_directory"
if [ -f "$pending_marker" ]; then
  encrypted_name="$(/bin/cat "$pending_marker")"
  case "$encrypted_name" in
    infisical-proxy-secret-zero-????????T??????Z.tar.gz.age) ;;
    *) printf '%s\n' 'refusing an invalid pending recovery marker' >&2; exit 77 ;;
  esac
  encrypted="$recovery_directory/$encrypted_name"
  checksum_file="$encrypted.sha256"
  [ -f "$encrypted" ] && [ -f "$checksum_file" ] || {
    printf '%s\n' 'refusing an incomplete pending recovery bundle' >&2
    exit 77
  }
  expected_checksum="$(/bin/cat "$checksum_file")"
  actual_checksum="$(/usr/bin/shasum -a 256 "$encrypted" | /usr/bin/awk '{print $1}')"
  [ "$expected_checksum" = "$actual_checksum" ] || {
    printf '%s\n' 'refusing a changed pending recovery bundle' >&2
    exit 77
  }
  timestamp="$(printf '%s' "$encrypted_name" | /usr/bin/sed -E 's/^infisical-proxy-secret-zero-([0-9TZ]+)\.tar\.gz\.age$/\1/')"
  /opt/homebrew/bin/age -d -i "$identity_file" -o "$archive" "$encrypted"
  /usr/bin/tar -xzf "$archive" -C "$bundle_directory"
else
  if [ -f "$completed_marker" ]; then
    printf '%s\n' 'refusing implicit proxy credential rotation after completed bootstrap' >&2
    exit 77
  fi
  timestamp="$(/bin/date -u +%Y%m%dT%H%M%SZ)"
  /opt/homebrew/bin/openssl req -x509 -newkey rsa:3072 -sha256 -nodes -days 825 \
    -subj '/CN=CristexWeb Infisical Proxy Recovery CA' \
    -keyout "$bundle_directory/ca.key" -out "$bundle_directory/ca.crt" \
    >"$temporary_directory/openssl-ca.log" 2>&1
  /opt/homebrew/bin/openssl req -newkey rsa:3072 -sha256 -nodes \
    -subj '/CN=infisical-egress-proxy.shared-services.svc' \
    -keyout "$bundle_directory/tls.key" -out "$temporary_directory/proxy.csr" \
    >"$temporary_directory/openssl-csr.log" 2>&1
  cat >"$temporary_directory/proxy.ext" <<'EOF'
basicConstraints=critical,CA:FALSE
keyUsage=critical,digitalSignature,keyEncipherment
extendedKeyUsage=serverAuth
subjectAltName=DNS:infisical-egress-proxy.shared-services.svc,DNS:infisical-egress-proxy.shared-services.svc.cluster.local
EOF
  /opt/homebrew/bin/openssl x509 -req -sha256 -days 397 \
    -in "$temporary_directory/proxy.csr" -CA "$bundle_directory/ca.crt" \
    -CAkey "$bundle_directory/ca.key" -CAcreateserial \
    -extfile "$temporary_directory/proxy.ext" -out "$bundle_directory/tls.crt" \
    >"$temporary_directory/openssl-sign.log" 2>&1
  proxy_user='infisical-operator'
  proxy_password="$(/opt/homebrew/bin/openssl rand -hex 32)"
  proxy_hash="$(printf '%s' "$proxy_password" | /opt/homebrew/bin/openssl passwd -6 -stdin)"
  printf '%s:%s\n' "$proxy_user" "$proxy_hash" >"$bundle_directory/users"
  printf 'https://%s:%s@infisical-egress-proxy.shared-services.svc:3129' \
    "$proxy_user" "$proxy_password" >"$bundle_directory/proxy-url"
  certificate_fingerprint="$(/opt/homebrew/bin/openssl x509 -in "$bundle_directory/tls.crt" -noout -fingerprint -sha256 | /usr/bin/cut -d= -f2)"
  cat >"$bundle_directory/metadata.txt" <<EOF
created_at_utc=$timestamp
proxy_user=$proxy_user
certificate_sha256=$certificate_fingerprint
secret_names=infisical-egress-proxy-tls,infisical-egress-proxy-auth,infisical-egress-proxy-client
EOF
  /usr/bin/tar -czf "$archive" -C "$bundle_directory" .
  encrypted="$recovery_directory/infisical-proxy-secret-zero-$timestamp.tar.gz.age"
  /opt/homebrew/bin/age -r "$recipient" -o "$encrypted" "$archive"
  checksum_file="$encrypted.sha256"
  (/usr/bin/shasum -a 256 "$encrypted" | /usr/bin/awk '{print $1}') >"$checksum_file"
  /usr/bin/basename "$encrypted" >"$pending_marker"
fi
encrypted_name="$(/usr/bin/basename "$encrypted")"
expected_checksum="$(/bin/cat "$checksum_file")"
/opt/homebrew/bin/openssl verify -CAfile "$bundle_directory/ca.crt" "$bundle_directory/tls.crt" >/dev/null
/opt/homebrew/bin/openssl x509 -in "$bundle_directory/tls.crt" -noout \
  -checkhost infisical-egress-proxy.shared-services.svc >/dev/null
/opt/homebrew/bin/openssl x509 -in "$bundle_directory/tls.crt" -pubkey -noout | \
  /usr/bin/shasum -a 256 >"$temporary_directory/cert-pubkey.sha256"
/opt/homebrew/bin/openssl pkey -in "$bundle_directory/tls.key" -pubout | \
  /usr/bin/shasum -a 256 >"$temporary_directory/key-pubkey.sha256"
/usr/bin/cmp -s "$temporary_directory/cert-pubkey.sha256" "$temporary_directory/key-pubkey.sha256"
/usr/bin/grep -Eq '^https://infisical-operator:[0-9a-f]{64}@infisical-egress-proxy\.shared-services\.svc:3129$' "$bundle_directory/proxy-url"
proxy_password_from_bundle="$(/usr/bin/sed -E 's#^https://infisical-operator:([0-9a-f]{64})@.*$#\1#' "$bundle_directory/proxy-url")"
proxy_hash_from_bundle="$(/usr/bin/cut -d: -f2- "$bundle_directory/users")"
proxy_salt="$(printf '%s' "$proxy_hash_from_bundle" | /usr/bin/cut -d'$' -f3)"
calculated_proxy_hash="$(printf '%s' "$proxy_password_from_bundle" | /opt/homebrew/bin/openssl passwd -6 -salt "$proxy_salt" -stdin)"
[ "$proxy_hash_from_bundle" = "$calculated_proxy_hash" ]
unset proxy_password_from_bundle proxy_hash_from_bundle proxy_salt calculated_proxy_hash

drive_verified_marker="$recovery_directory/drive-verified"
[ -f "$drive_verified_marker" ] && [ ! -L "$drive_verified_marker" ] && \
  [ "$(/usr/bin/stat -f '%OLp' "$drive_verified_marker")" = 600 ] && \
  [ "$(/usr/bin/stat -f '%Su' "$drive_verified_marker")" = "$controller_user" ] || {
  printf '%s\n' 'refusing Secret mutation before guarded host Drive transfer verification' >&2
  exit 77
}
expected_drive_marker="$temporary_directory/drive-verified.expected"
printf 'filename=%s\nsha256=%s\nremote=drive:cristexweb-recovery/infisical-proxy/%s/\n' \
  "$encrypted_name" "$expected_checksum" "$timestamp" >"$expected_drive_marker"
/usr/bin/cmp -s "$expected_drive_marker" "$drive_verified_marker" || {
  printf '%s\n' 'refusing a drive-verified marker not bound to the exact pending artifact' >&2
  exit 77
}

vars_file="$temporary_directory/secret-vars.yml"
ca_crt_base64="$(/usr/bin/base64 <"$bundle_directory/ca.crt" | /usr/bin/tr -d '\n')"
tls_crt_base64="$(/usr/bin/base64 <"$bundle_directory/tls.crt" | /usr/bin/tr -d '\n')"
tls_key_base64="$(/usr/bin/base64 <"$bundle_directory/tls.key" | /usr/bin/tr -d '\n')"
users_base64="$(/usr/bin/base64 <"$bundle_directory/users" | /usr/bin/tr -d '\n')"
proxy_url_base64="$(/usr/bin/base64 <"$bundle_directory/proxy-url" | /usr/bin/tr -d '\n')"
cat >"$vars_file" <<EOF
infisical_proxy_secret_zero_approved: true
infisical_proxy_secret_zero_definitions:
  - apiVersion: v1
    kind: Secret
    metadata:
      name: infisical-egress-proxy-tls
      namespace: shared-services
      labels: &proxy_labels
        app.kubernetes.io/part-of: cristex-platform
        app.kubernetes.io/managed-by: ansible
        cristex.io/component: infisical-operator
        cristex.io/value-owner: secret-zero
    type: kubernetes.io/tls
    data:
      ca.crt: $ca_crt_base64
      tls.crt: $tls_crt_base64
      tls.key: $tls_key_base64
  - apiVersion: v1
    kind: Secret
    metadata:
      name: infisical-egress-proxy-auth
      namespace: shared-services
      labels: *proxy_labels
    type: Opaque
    data:
      users: $users_base64
  - apiVersion: v1
    kind: Secret
    metadata:
      name: infisical-egress-proxy-client
      namespace: shared-services
      labels: *proxy_labels
    type: Opaque
    data:
      proxy-url: $proxy_url_base64
EOF
unset ca_crt_base64 tls_crt_base64 tls_key_base64 users_base64 proxy_url_base64

cd -- "$repository_root/ansible"
set -- "$controller" -i .ansible/inventory.local.yml playbooks/bootstrap_infisical_proxy_secrets.yml \
  --limit crtxweb --extra-vars "@$vars_file"
if [ -n "${SSH_AUTH_SOCK:-}" ]; then
  set -- "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" "$@"
fi
/usr/bin/env -i \
  "HOME=$controller_home" "USER=$controller_user" "LOGNAME=$controller_user" \
  'PATH=/usr/bin:/bin:/usr/sbin:/sbin' 'LC_ALL=C.UTF-8' \
  "ANSIBLE_CONFIG=$PWD/ansible.cfg" \
  'CRISTEXWEB_INFISICAL_PROXY_SECRET_ZERO_ENTRYPOINT=v1' \
  "CRISTEXWEB_INFISICAL_PROXY_SECRET_ZERO_TOKEN=$attestation_token" \
  "CRISTEXWEB_INFISICAL_PROXY_SECRET_ZERO_ATTESTATION_FILE=$attestation_file" \
  "$@"
/bin/mv -f -- "$pending_marker" "$completed_marker"
printf '%s\n' 'Proxy secret-zero recovery and exact guarded host Drive verification accepted.'
