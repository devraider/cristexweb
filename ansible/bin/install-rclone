#!/bin/sh
set -eu
usage='usage: ansible/bin/install-rclone check|apply|rollback-check|rollback-apply'
if [ "$#" -ne 1 ]; then printf '%s\n%s\n' "$usage" 'refusing passthrough arguments or task selection' >&2; exit 64; fi
mode=$1
case "$mode" in check|apply|rollback-check|rollback-apply) ;; *) printf '%s\n%s\n' "$usage" 'refusing passthrough arguments or task selection' >&2; exit 64 ;; esac
script_path=$0
[ ! -L "$script_path" ] || { printf '%s\n' 'refusing a symlinked rclone installer entrypoint' >&2; exit 66; }
script_directory="$(CDPATH= cd -- "$(/usr/bin/dirname -- "$script_path")" && pwd -P)"
repository_root="$(CDPATH= cd -- "$script_directory/../.." && pwd -P)"
controller_home="$(CDPATH= cd -- "$repository_root/../.." && pwd -P)"
controller_user="$(/usr/bin/id -un)"
[ "$repository_root" = "$controller_home/Projects/cristexweb" ] || { printf '%s\n' 'refusing a repository outside the pinned controller path' >&2; exit 78; }
controller="$repository_root/.venv/bin/ansible-playbook"
[ -f "$controller" ] && [ -x "$controller" ] && [ ! -L "$controller" ] || { printf '%s\n' 'refusing an unsafe pinned Ansible controller' >&2; exit 69; }
cd -- "$repository_root/ansible"
umask 077
attestation_file="$(/usr/bin/mktemp "${TMPDIR:-/tmp}/cristexweb-rclone-install.XXXXXX")"
attestation_token="$(/usr/bin/openssl rand -hex 32)"
printf '%s:entrypoint\n' "$attestation_token" >"$attestation_file"
cleanup() { /bin/rm -f -- "$attestation_file"; }
trap cleanup EXIT HUP INT TERM
state=present
rollback=false
case "$mode" in rollback-*) state=absent; rollback=true ;; esac
extra_vars="{\"rclone_install_approved\":true,\"rclone_install_state\":\"$state\",\"rclone_install_rollback_approved\":$rollback}"
set -- "$controller" -i .ansible/inventory.local.yml playbooks/install_rclone.yml --diff --limit crtxweb --ask-become-pass --extra-vars "$extra_vars"
case "$mode" in check|rollback-check) set -- "$@" --check ;; esac
if [ -n "${SSH_AUTH_SOCK:-}" ]; then set -- "SSH_AUTH_SOCK=$SSH_AUTH_SOCK" "$@"; fi
/usr/bin/env -i HOME="$controller_home" USER="$controller_user" LOGNAME="$controller_user" PATH=/usr/bin:/bin:/usr/sbin:/sbin LC_ALL=C.UTF-8 ANSIBLE_CONFIG="$PWD/ansible.cfg" CRISTEXWEB_RCLONE_INSTALL_ENTRYPOINT=v1 CRISTEXWEB_RCLONE_INSTALL_TOKEN="$attestation_token" CRISTEXWEB_RCLONE_INSTALL_ATTESTATION_FILE="$attestation_file" "$@"
